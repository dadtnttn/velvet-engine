{"ending_cool:1:dialogue": "Caminas solo a casa. La lluvia ha parado.", "ending_cool:2:dialogue": "Final: Aire fresco", "ending_warm:2:dialogue": "Mira, las nubes se abren.", "ending_warm:3:dialogue": "Quedate un poco mas.", "ending_warm:4:dialogue": "Final: Luces calidas", "main:10:choice:0": "Cumplo mis promesas.", "main:10:choice:1": "No lo pongas tan pesado.", "main:1:dialogue": "Vale. Mantenlo ligero.", "main:3:dialogue": "La lluvia suaviza el ruido de la ciudad tras la ventana.", "main:4:dialogue": "Dije que estaria aqui. Lo decia en serio.", "main:6:dialogue": "Siempre dices eso.", "main:8:dialogue": "Esta {b}ciudad{/b} nunca duerme, {i}verdad?{/i}"}
