// New/load/save, phase flow, main tick and presentation snapshot.

export function new_game(seed: int) {
    game_seed = seed
    random = rng_new(seed)
    phase = "intro"
    room = 1
    death_count = 0
    room_deaths = 0
    score = 0
    elapsed = 0.0
    next_id = 1
    phase_timer = 0.0
    death_timer = 0.0
    memory_timer = 0.0
    message_timer = 0.0
    slow_timer = 0.0
    overdrive_timer = 0.0
    combo_count = 0
    save_revision = 1
    memories = [false, false, false, false, false]
    weapons = {"pistol": false, "shotgun": false, "blade": false, "plasma": false, "grenade": false}
    endings = {"break_cycle": false, "remember_all": false}
    current_path = []
    echo_path = []
    events = []
    player = make_player()
    clear_list(enemies)
    clear_list(bullets)
    clear_list(obstacles)
    clear_list(pickups)
    clear_list(hazards)
    say("RADIO", "Sujeto 17. Pulso estable. Memoria... incompleta.", 5.5)
    return snapshot()
}

export function load_game(data: map) {
    game_seed = data.seed
    random = rng_new(game_seed + data.deaths * 7919)
    death_count = data.deaths
    score = data.score
    memories = [data.memory0, data.memory1, data.memory2, data.memory3, data.memory4]
    weapons = {
        "pistol": data.pistol,
        "shotgun": data.shotgun,
        "blade": data.blade,
        "plasma": data.plasma,
        "grenade": data.grenade
    }
    endings = {"break_cycle": data.ending_a, "remember_all": data.ending_b}
    player = make_player()
    if weapons.grenade { player.weapon = "grenade" }
    if weapons.plasma { player.weapon = "plasma" }
    if weapons.blade { player.weapon = "blade" }
    if weapons.shotgun { player.weapon = "shotgun" }
    if weapons.pistol && player.weapon == "none" { player.weapon = "pistol" }
    phase = "playing"
    current_path = []
    echo_path = []
    events = []
    room_deaths = 0
    slow_timer = 0.0
    setup_room(clamp(data.room, 1, 6))
    say("RADIO", "Continuidad restaurada. Tus recuerdos no tuvieron tanta suerte.", 5.0)
    return snapshot()
}

export function export_save() {
    return {
        "version": 2,
        "seed": game_seed,
        "room": room,
        "deaths": death_count,
        "score": score,
        "memory0": memories[0],
        "memory1": memories[1],
        "memory2": memories[2],
        "memory3": memories[3],
        "memory4": memories[4],
        "pistol": weapons.pistol,
        "shotgun": weapons.shotgun,
        "blade": weapons.blade,
        "plasma": weapons.plasma,
        "grenade": weapons.grenade,
        "ending_a": endings.break_cycle,
        "ending_b": endings.remember_all
    }
}

function update_phase_only(dt: float, input: map) {
    phase_timer += dt
    if phase == "intro" {
        if phase_timer > 4.5 || input.interact {
            phase = "playing"
            phase_timer = 0.0
            setup_room(1)
        }
        return true
    }
    if phase == "dead" {
        death_timer -= dt
        if death_timer <= 0.0 {
            phase = "playing"
            setup_room(room)
            if death_count >= 9 {
                say("RADIO", "La geometria ya no coincide con los planos.", 4.0)
            } else {
                say("RADIO", "Reconstruccion completa.", 2.5)
            }
            emit("respawn", player.pos, 1.5)
        }
        return true
    }
    if phase == "ending_a" || phase == "ending_b" {
        if phase_timer > 8.0 || input.interact {
            phase = "credits"
            phase_timer = 0.0
        }
        return true
    }
    if phase == "credits" {
        if phase_timer > 6.0 || input.interact {
            phase = "menu"
            phase_timer = 0.0
        }
        return true
    }
    return false
}

export function tick(raw_dt: float, input: map) {
    clear_list(events)
    let dt = clamp(raw_dt, 0.001, 0.05)
    elapsed += dt
    room_time += dt

    if message_timer > 0.0 {
        message_timer -= dt
        if message_timer <= 0.0 { message = "" }
    }

    if memory_timer > 0.0 {
        memory_timer -= dt
        if memory_timer <= 0.0 { memory_text = "" }
    }

    if slow_timer > 0.0 {
        slow_timer -= dt
        dt *= 0.35
    }

    if update_phase_only(dt, input) {
        update_prompt()
        return snapshot()
    }

    if phase == "playing" || phase == "choice" {
        record_path(dt)
        update_combat(dt, input)
        update_enemies(dt)
        update_room_state()
        handle_interaction(input)
    }

    update_prompt()
    return snapshot()
}

export function snapshot() {
    let boss_hp = 0.0
    let boss_max = 0.0
    for enemy in enemies {
        if enemy.kind == "zero" {
            boss_hp = max(enemy.hp, 0.0)
            boss_max = enemy.max_hp
        }
    }
    let distortion = 0.0
    if room == 4 { distortion = 0.15 }
    if room == 5 { distortion = 0.28 }
    if death_count > 4 { distortion += min(0.35, death_count * 0.03) }

    return {
        "phase": phase,
        "room": room,
        "room_name": room_name(),
        "room_time": room_time,
        "deaths": death_count,
        "score": score,
        "player": {
            "pos": player.pos,
            "aim": player.aim,
            "velocity": player.velocity,
            "hp": player.hp,
            "max_hp": player.max_hp,
            "weapon": player.weapon,
            "reload_timer": player.reload_timer,
            "dash_cooldown": player.dash_cooldown,
            "hit_flash": player.hit_flash,
            "invulnerable": player.invulnerable
        },
        "enemies": enemies,
        "bullets": bullets,
        "obstacles": obstacles,
        "hazards": hazards,
        "pickups": pickups,
        "events": events,
        "memories": memories,
        "memory_count": memory_count(),
        "message": message,
        "speaker": speaker,
        "prompt": prompt,
        "memory_text": memory_text,
        "room_clear": room_clear,
        "door_open": room_clear && room < 6,
        "ammo": current_ammo(),
        "magazine": current_magazine(),
        "boss_hp": boss_hp,
        "boss_max": boss_max,
        "distortion": distortion,
        "death_timer": death_timer,
        "ending_variant": ending_variant,
        "save_revision": save_revision
    }
}
