// Enemy perception, patrol, pursuit, sniper, shielder and boss behavior.

function enemy_shoot(enemy: map, direction: vec2, speed: float, damage: float) {
    spawn_bullet("enemy", enemy.pos + direction * 12.0, direction, speed, damage, 2.2)
    emit("enemy_shot", enemy.pos, 0.55)
}

function can_see_player(enemy: map, max_distance: float) {
    let delta = player.pos - enemy.pos
    if length(delta) > max_distance { return false }
    let sample = 1
    while sample <= 7 {
        let point = enemy.pos + delta * (sample / 8.0)
        for obstacle in obstacles {
            if point_in_rect(point, obstacle, 1.0) { return false }
        }
        sample += 1
    }
    return true
}

function patrol_enemy(enemy: map, dt: float, speed: float) {
    enemy.think -= dt
    if enemy.think <= 0.0 {
        enemy.think = rng_range_float(random, 0.8, 1.8)
        let angle = rng_range_float(random, 0.0, TAU)
        enemy.aim = vec2(cos(angle), sin(angle))
    }
    enemy.velocity = enemy.aim * speed
    let next = move_position(enemy.pos, enemy.velocity * dt, 10.0)
    if distance(next, enemy.pos) < 0.2 { enemy.aim = -enemy.aim }
    enemy.pos = next
}

function update_vigilante(enemy: map, dt: float) {
    let to_player = player.pos - enemy.pos
    let d = length(to_player)
    if d < 0.001 { return }
    let dir = normalize(to_player)
    let sees = can_see_player(enemy, 330.0)
    if enemy.state == "patrol" && sees { enemy.state = "pursuit" }
    if enemy.state == "pursuit" && !sees && d > 355.0 { enemy.state = "patrol" }
    if enemy.state == "patrol" {
        patrol_enemy(enemy, dt, 28.0)
        return
    }
    let lead = player.velocity * min(0.28, death_count * 0.025)
    let aim_target = player.pos + lead
    enemy.aim = normalize(aim_target - enemy.pos)
    let strafe_sign = -1.0
    if is_even(enemy.id + death_count) { strafe_sign = 1.0 }
    let strafe = vec2(-dir.y, dir.x) * strafe_sign
    let velocity = strafe * 48.0
    if d > 175.0 { velocity += dir * 72.0 }
    if d < 105.0 { velocity -= dir * 90.0 }
    enemy.velocity = velocity
    enemy.pos = move_position(enemy.pos, velocity * dt, 10.0)
    if enemy.cooldown <= 0.0 && d < 330.0 {
        enemy_shoot(enemy, enemy.aim, 300.0 + death_count * 3.0, 48.0)
        enemy.cooldown = max(0.58, 1.15 - death_count * 0.035)
    }
}

function update_hound(enemy: map, dt: float) {
    let to_player = player.pos - enemy.pos
    let d = length(to_player)
    if d < 0.001 { return }
    let dir = normalize(to_player)
    let sees = can_see_player(enemy, 285.0)
    if enemy.state == "patrol" && sees { enemy.state = "pursuit" }
    if enemy.state == "pursuit" && !sees && d > 320.0 { enemy.state = "patrol" }
    if enemy.state == "patrol" {
        patrol_enemy(enemy, dt, 38.0)
        return
    }
    let flank_sign = -1.0
    if is_even(enemy.id + death_count) { flank_sign = 1.0 }
    let flank = vec2(-dir.y, dir.x) * flank_sign
    let velocity = normalize(dir + flank * min(0.7, d / 240.0)) * (145.0 + min(death_count, 8) * 4.0)
    enemy.velocity = velocity
    enemy.aim = dir
    enemy.pos = move_position(enemy.pos, velocity * dt, 10.0)
    if d < 24.0 && enemy.cooldown <= 0.0 {
        hurt_player(72.0, enemy.pos)
        enemy.cooldown = 0.85
        emit("hound", enemy.pos, 1.0)
    }
}

function update_sniper(enemy: map, dt: float) {
    let to_player = player.pos - enemy.pos
    let d = length(to_player)
    if d < 0.001 { return }
    let dir = normalize(to_player)
    let sees = can_see_player(enemy, 450.0)
    if enemy.state == "patrol" && sees { enemy.state = "aiming" }
    if enemy.state == "aiming" && !sees { enemy.state = "patrol" }
    if enemy.state == "patrol" {
        patrol_enemy(enemy, dt, 20.0)
        return
    }
    enemy.aim = dir
    enemy.velocity = vec2(0, 0)
    enemy.charge_timer += dt
    emit("sniper_charge", enemy.pos, enemy.charge_timer / 1.2)
    if enemy.charge_timer >= 1.2 {
        enemy.charge_timer = 0.0
        spawn_bullet("sniper", enemy.pos + dir * 14.0, dir, 750.0, 65.0, 1.8)
        emit("sniper_shot", enemy.pos, 1.8)
        enemy.state = "patrol"
        enemy.cooldown = 1.5
    }
}

function update_shielder(enemy: map, dt: float) {
    let to_player = player.pos - enemy.pos
    let d = length(to_player)
    if d < 0.001 { return }
    let dir = normalize(to_player)
    enemy.aim = dir
    enemy.shield_active = true
    let velocity = dir * 42.0
    enemy.velocity = velocity
    enemy.pos = move_position(enemy.pos, velocity * dt, 12.0)
    if d < 32.0 && enemy.cooldown <= 0.0 {
        hurt_player(45.0, enemy.pos)
        enemy.cooldown = 1.0
        emit("shield_bash", enemy.pos, 1.2)
    }
}

function update_echo(enemy: map, dt: float) {
    let target = player.pos
    if len(echo_path) > 0 {
        let index = enemy.path_index
        if index >= len(echo_path) { index = 0 }
        target = echo_path[index]
        enemy.path_index = index + 1
    }
    let to_target = target - enemy.pos
    if length(to_target) > 4.0 {
        enemy.velocity = normalize(to_target) * 138.0
        enemy.aim = normalize(to_target)
        enemy.pos = move_position(enemy.pos, enemy.velocity * dt, 10.0)
    }
    if distance(enemy.pos, player.pos) < 22.0 && enemy.cooldown <= 0.0 {
        hurt_player(42.0, enemy.pos)
        enemy.cooldown = 0.65
        emit("echo_hit", enemy.pos, 1.0)
    }
}

function update_boss(boss: map, dt: float) {
    let hp_ratio = boss.hp / boss.max_hp
    if hp_ratio > 0.66 { boss.phase = 1 }
    else {
        if hp_ratio > 0.33 { boss.phase = 2 }
        else { boss.phase = 3 }
    }
    let to_player = player.pos - boss.pos
    let d = length(to_player)
    if d < 0.001 { return }
    let dir = normalize(to_player)
    boss.aim = dir

    if boss.phase == 1 {
        let strafe = vec2(-dir.y, dir.x)
        boss.velocity = strafe * 55.0
        if d > 200.0 { boss.velocity += dir * 45.0 }
        boss.pos = move_position(boss.pos, boss.velocity * dt, 14.0)
        if boss.cooldown <= 0.0 {
            enemy_shoot(boss, dir, 320.0, 42.0)
            enemy_shoot(boss, rotate_direction(dir, 0.15), 320.0, 42.0)
            enemy_shoot(boss, rotate_direction(dir, -0.15), 320.0, 42.0)
            boss.cooldown = 0.90
        }
    } else {
        if boss.phase == 2 {
            if !boss_phase_announced {
                boss_phase_announced = true
                slow_timer = 0.35
                say("CERO", "Segunda fase. Adaptacion activada.", 3.5)
                emit("boss_phase", boss.pos, 1.5)
            }
            boss.velocity = dir * 85.0
            boss.pos = move_position(boss.pos, boss.velocity * dt, 14.0)
            if boss.cooldown <= 0.0 {
                let ring = 0
                while ring < 12 {
                    let angle = ring * (TAU / 12.0)
                    let shoot_dir = vec2(cos(angle), sin(angle))
                    enemy_shoot(boss, shoot_dir, 260.0, 36.0)
                    ring += 1
                }
                boss.cooldown = 1.65
            }
        } else {
            // Phase 3: Spiral Bullet Hell + Echo Support
            boss.velocity = dir * 105.0
            boss.pos = move_position(boss.pos, boss.velocity * dt, 14.0)
            if boss.cooldown <= 0.0 {
                let spiral = 0
                while spiral < 16 {
                    let angle = elapsed * 2.0 + spiral * (TAU / 16.0)
                    let shoot_dir = vec2(cos(angle), sin(angle))
                    enemy_shoot(boss, shoot_dir, 290.0, 38.0)
                    spiral += 1
                }
                boss.cooldown = 1.10
            }
        }
    }
}

function update_enemies(dt: float) {
    for enemy in enemies {
        if enemy.alive {
            if enemy.hit_flash > 0.0 { enemy.hit_flash -= dt }
            if enemy.cooldown > 0.0 { enemy.cooldown -= dt }
            if enemy.stun_timer > 0.0 {
                enemy.stun_timer -= dt
                enemy.velocity = vec2(0, 0)
            } else {
                if enemy.kind == "vigilante" { update_vigilante(enemy, dt) }
                if enemy.kind == "hound" { update_hound(enemy, dt) }
                if enemy.kind == "sniper" { update_sniper(enemy, dt) }
                if enemy.kind == "shielder" { update_shielder(enemy, dt) }
                if enemy.kind == "echo" { update_echo(enemy, dt) }
                if enemy.kind == "zero" { update_boss(enemy, dt) }
            }
        }
    }
}
