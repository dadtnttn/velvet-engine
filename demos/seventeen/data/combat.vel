// Player movement, weapons, damage, death and projectiles.

function finish_reload() {
    if player.weapon == "pistol" { player.ammo_pistol = 7 }
    if player.weapon == "shotgun" { player.ammo_shotgun = 2 }
    if player.weapon == "plasma" { player.ammo_plasma = 3 }
    if player.weapon == "grenade" { player.ammo_grenade = 1 }
    emit("reload_complete", player.pos, 1.0)
}

function start_reload() {
    if player.reload_timer > 0.0 { return }
    if player.weapon == "pistol" && player.ammo_pistol < 7 {
        player.reload_timer = 0.75
        emit("reload", player.pos, 0.7)
    }
    if player.weapon == "shotgun" && player.ammo_shotgun < 2 {
        player.reload_timer = 1.45
        emit("reload", player.pos, 1.0)
    }
    if player.weapon == "plasma" && player.ammo_plasma < 3 {
        player.reload_timer = 1.80
        emit("reload", player.pos, 1.2)
    }
    if player.weapon == "grenade" && player.ammo_grenade < 1 {
        player.reload_timer = 2.10
        emit("reload", player.pos, 1.4)
    }
}

function trigger_aoe_damage(center: vec2, radius: float, damage: float, is_emp: bool) {
    for enemy in enemies {
        if enemy.alive && distance(enemy.pos, center) <= radius {
            enemy.hp -= damage
            enemy.hit_flash = 0.18
            if is_emp {
                enemy.stun_timer = 3.5
                emit("emp_stun", enemy.pos, 1.2)
            } else {
                emit("impact", enemy.pos, damage / 40.0)
            }
            if enemy.hp <= 0.0 {
                enemy.alive = false
                score += 120
                if enemy.kind == "zero" { score += 1700 }
                emit("enemy_down", enemy.pos, 1.0)
            }
        }
    }
}

function hurt_enemy(enemy: map, damage: float, hit_pos: vec2, bullet_owner: string) {
    if !enemy.alive { return }
    if enemy.kind == "shielder" && enemy.shield_active {
        let to_bullet = hit_pos - enemy.pos
        if length(to_bullet) > 0.001 && dot(enemy.aim, normalize(to_bullet)) > 0.25 {
            emit("shield_block", hit_pos, 1.2)
            return
        }
    }
    enemy.hp -= damage
    enemy.hit_flash = 0.12
    emit("impact", hit_pos, damage / 50.0)
    if enemy.hp <= 0.0 {
        enemy.alive = false
        score += 100
        combo_count += 1
        overdrive_timer = 4.0
        if enemy.kind == "zero" { score += 1700 }
        emit("enemy_down", enemy.pos, 1.0)
    }
}

function blade_attack() {
    let hit_any = false
    for enemy in enemies {
        if enemy.alive {
            let to_enemy = enemy.pos - player.pos
            let d = length(to_enemy)
            if d <= 54.0 && d > 0.001 && dot(normalize(to_enemy), player.aim) > 0.15 {
                hurt_enemy(enemy, 68.0, enemy.pos, "blade")
                hit_any = true
            }
        }
    }
    for bullet in bullets {
        if bullet.alive && bullet.owner != "player" && bullet.owner != "plasma" && bullet.owner != "grenade" && distance(bullet.pos, player.pos) <= 58.0 {
            bullet.owner = "player"
            bullet.velocity = reflect(bullet.velocity, player.aim)
            bullet.damage = 60.0
            hit_any = true
            emit("deflect", bullet.pos, 1.0)
        }
    }
    let blade_power = 0.5
    if hit_any { blade_power = 1.0 }
    emit("blade", player.pos + player.aim * 24.0, blade_power)
}

function try_fire() {
    if player.cooldown > 0.0 || player.reload_timer > 0.0 || player.weapon == "none" { return }

    let cooldown_mult = 1.0
    if overdrive_timer > 0.0 { cooldown_mult = 0.70 }

    if player.weapon == "blade" {
        player.cooldown = 0.32 * cooldown_mult
        blade_attack()
        return
    }
    if player.weapon == "pistol" {
        if player.ammo_pistol <= 0 {
            emit("empty", player.pos, 0.5)
            start_reload()
            player.cooldown = 0.18
            return
        }
        player.ammo_pistol -= 1
        player.cooldown = 0.19 * cooldown_mult
        spawn_bullet("player", player.pos + player.aim * 14.0, player.aim, 520.0, 38.0, 1.4)
        emit("pistol", player.pos, 0.75)
        if player.ammo_pistol == 0 { start_reload() }
        return
    }
    if player.weapon == "shotgun" {
        if player.ammo_shotgun <= 0 {
            emit("empty", player.pos, 0.6)
            start_reload()
            player.cooldown = 0.25
            return
        }
        player.ammo_shotgun -= 1
        player.cooldown = 0.68 * cooldown_mult
        for spread in [-0.18, -0.09, 0.0, 0.09, 0.18] {
            spawn_bullet("player", player.pos + player.aim * 15.0, rotate_direction(player.aim, spread), 470.0, 28.0, 0.55)
        }
        emit("shotgun", player.pos, 1.4)
        if player.ammo_shotgun == 0 { start_reload() }
        return
    }
    if player.weapon == "plasma" {
        if player.ammo_plasma <= 0 {
            emit("empty", player.pos, 0.6)
            start_reload()
            player.cooldown = 0.30
            return
        }
        player.ammo_plasma -= 1
        player.cooldown = 0.85 * cooldown_mult
        spawn_bullet("plasma", player.pos + player.aim * 16.0, player.aim, 380.0, 75.0, 1.1)
        emit("plasma", player.pos, 1.5)
        if player.ammo_plasma == 0 { start_reload() }
        return
    }
    if player.weapon == "grenade" {
        if player.ammo_grenade <= 0 {
            emit("empty", player.pos, 0.6)
            start_reload()
            player.cooldown = 0.35
            return
        }
        player.ammo_grenade -= 1
        player.cooldown = 1.10 * cooldown_mult
        spawn_bullet("emp_grenade", player.pos + player.aim * 16.0, player.aim, 320.0, 30.0, 0.85)
        emit("grenade", player.pos, 1.8)
        if player.ammo_grenade == 0 { start_reload() }
        return
    }
}

function begin_death() {
    if phase == "dead" { return }
    player.alive = false
    death_count += 1
    room_deaths += 1
    death_timer = 1.4
    phase = "dead"
    combo_count = 0
    overdrive_timer = 0.0
    emit("death", player.pos, 2.0)
}

function hurt_player(damage: float, source_pos: vec2) {
    if !player.alive || player.invulnerable > 0.0 || player.dash_timer > 0.0 { return }
    player.hp -= damage
    player.hit_flash = 0.20
    player.invulnerable = 0.35
    combo_count = 0
    overdrive_timer = 0.0
    emit("player_hit", player.pos, damage / 50.0)
    if player.hp <= 0.0 {
        player.hp = 0.0
        begin_death()
    }
}

function try_dash(direction: vec2) {
    if player.dash_cooldown > 0.0 || !player.alive || player.reload_timer > 0.0 { return }
    let dir = direction
    if length(dir) < 0.001 { dir = player.aim }
    dir = normalize(dir)
    player.dash_dir = dir
    player.dash_timer = 0.22
    player.dash_cooldown = 0.75
    player.dash_shield = 0.35
    emit("dash", player.pos, 1.0)
}

function update_bullets(dt: float) {
    for bullet in bullets {
        if bullet.alive {
            bullet.life -= dt
            if bullet.life <= 0.0 {
                bullet.alive = false
                if bullet.owner == "plasma" {
                    trigger_aoe_damage(bullet.pos, 65.0, 85.0, false)
                    emit("plasma_explode", bullet.pos, 1.8)
                }
                if bullet.owner == "emp_grenade" {
                    trigger_aoe_damage(bullet.pos, 85.0, 45.0, true)
                    emit("emp_explode", bullet.pos, 2.0)
                }
            } else {
                let next = bullet.pos + bullet.velocity * dt
                if position_blocked(next, bullet.radius) {
                    bullet.alive = false
                    if bullet.owner == "plasma" {
                        trigger_aoe_damage(next, 65.0, 85.0, false)
                        emit("plasma_explode", next, 1.8)
                    } else if bullet.owner == "emp_grenade" {
                        trigger_aoe_damage(next, 85.0, 45.0, true)
                        emit("emp_explode", next, 2.0)
                    } else {
                        emit("impact", next, 0.4)
                    }
                } else {
                    bullet.pos = next
                    if bullet.owner == "player" || bullet.owner == "plasma" {
                        for enemy in enemies {
                            if enemy.alive && distance(bullet.pos, enemy.pos) <= bullet.radius + 12.0 {
                                bullet.alive = false
                                if bullet.owner == "plasma" {
                                    trigger_aoe_damage(bullet.pos, 65.0, 85.0, false)
                                    emit("plasma_explode", bullet.pos, 1.8)
                                } else {
                                    hurt_enemy(enemy, bullet.damage, bullet.pos, bullet.owner)
                                }
                            }
                        }
                    }
                    if bullet.owner == "enemy" || bullet.owner == "sniper" {
                        if distance(bullet.pos, player.pos) <= bullet.radius + 10.0 {
                            if player.dash_shield > 0.0 {
                                bullet.owner = "player"
                                bullet.velocity = -bullet.velocity * 1.2
                                emit("deflect", bullet.pos, 1.2)
                            } else {
                                bullet.alive = false
                                hurt_player(bullet.damage, bullet.pos)
                            }
                        }
                    }
                }
            }
        }
    }
}

function update_combat(dt: float, input: map) {
    if player.invulnerable > 0.0 { player.invulnerable -= dt }
    if player.hit_flash > 0.0 { player.hit_flash -= dt }
    if player.cooldown > 0.0 { player.cooldown -= dt }
    if player.dash_cooldown > 0.0 { player.dash_cooldown -= dt }
    if player.dash_shield > 0.0 { player.dash_shield -= dt }
    if overdrive_timer > 0.0 { overdrive_timer -= dt }

    if player.reload_timer > 0.0 {
        player.reload_timer -= dt
        if player.reload_timer <= 0.0 { finish_reload() }
    }

    let speed = 150.0
    if overdrive_timer > 0.0 { speed = 195.0 }

    let move_dir = input.move
    if length(move_dir) > 0.001 { move_dir = normalize(move_dir) }

    if input.dash { try_dash(move_dir) }
    if input.weapon_1 && weapons.pistol { player.weapon = "pistol" }
    if input.weapon_2 && weapons.shotgun { player.weapon = "shotgun" }
    if input.weapon_3 && weapons.blade { player.weapon = "blade" }
    if input.weapon_4 && weapons.plasma { player.weapon = "plasma" }
    if input.weapon_5 && weapons.grenade { player.weapon = "grenade" }

    if player.dash_timer > 0.0 {
        player.dash_timer -= dt
        player.velocity = player.dash_dir * 380.0
        player.pos = move_position(player.pos, player.velocity * dt, 10.0)
    } else {
        if length(move_dir) > 0.001 {
            player.velocity = move_dir * speed
            player.pos = move_position(player.pos, player.velocity * dt, 10.0)
        } else {
            player.velocity = vec2(0, 0)
        }
    }

    if length(input.aim) > 0.001 { player.aim = normalize(input.aim) }
    if input.reload { start_reload() }
    if input.attack { try_fire() }

    update_bullets(dt)

    for hazard in hazards {
        if point_in_rect(player.pos, hazard, 6.0) {
            hurt_player(28.0 * dt, player.pos)
        }
    }
}
