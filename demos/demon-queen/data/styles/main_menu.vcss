/* Demon Queen — title menu. Geometry, assets and live states belong here. */

:root {
  --rose: #ff9fc7;
  --rose-muted: #bc6d8d;
  --gold: #f3bd73;
  --wine: #250718de;
  --text: #fff1f7;
  --text-disabled: #8f7d89;
  --chrome-surface-top: #241027ed;
  --chrome-surface-bottom: #0d0714f2;
  --chrome-edge: #d96c9f;
  --chrome-edge-inner: #7e315f;
  --chrome-gold: #e8b36f;
  --chrome-gem: #b741cf;
  --chrome-gem-core: #ffe2f4;
  --chrome-glow: #ff76b4;
}

.title-menu {
  x: 660;
  y: 705;
  width: 600;
  height: 69;
  gap: 14;
}

.title-menu .menu-item {
  background: var(--wine);
  color: var(--text);
  font-size: 27;
  opacity: 0.88;
  scale: 0.965;
  glow: #ff3f9a;
  glow-strength: 0;
  shadow-color: #050108;
  shadow-opacity: 0.72;
  shadow-offset-x: 5;
  shadow-offset-y: 8;
  transition: opacity 180ms cubic_out;
}

.title-menu .menu-item:hover {
  opacity: 1;
  scale: 0.985;
  glow-strength: 0.35;
}

.title-menu .menu-item:focus,
.title-menu .menu-item:selected {
  color: #ffffff;
  opacity: 1;
  scale: 1;
  glow: var(--rose);
  glow-strength: 0.78;
}

.title-menu .menu-item:active {
  scale: 0.975;
  glow-strength: 1;
}

.title-menu .menu-item:disabled {
  color: var(--text-disabled);
  opacity: 0.42;
  scale: 0.955;
  glow-strength: 0;
}

#quit {
  color: #eacbd8;
}

/* Ceremonial command bar: identity, save state, and grouped shortcuts. */
.title-footer {
  x: 18;
  y: 998;
  width: 1884;
  height: 64;
  gap: 17;
  chrome: arcane;
  background: #190b1aec;
  background-bottom: #08050df6;
  border-color: #d56b9de8;
  border-width: 2;
  corner-cut: 16;
  inner-border-color: #6e2c55cf;
  inner-border-width: 1;
  inner-inset: 7;
  color: #fff0f7;
  secondary-color: #cdb1c0;
  accent-color: var(--gold);
  divider-color: #b85c87;
  ornament-color: #df6b9e;
  ornament-secondary-color: var(--gold);
  ornament-opacity: 0.72;
  ornament-center: 0;
  ornament-sides: 1;
  corner-ornament-size: 30;
  rail-inset: 46;
  rail-offset: 7;
  gem-color: var(--chrome-gem);
  gem-core-color: var(--chrome-gem-core);
  gem-size: 6;
  font-size: 15.5;
  secondary-font-size: 12.5;
  content-padding-x: 28;
  brand-area-width: 430;
  control-group-gap: 32;
  status-font-size: 12.5;
  status-ready-color: #f4c77e;
  status-empty-color: #bda3b0;
  status-rule-color: #8f3f68;
  glow: #ff76ad;
  glow-strength: 0.24;
  glow-spread: 2;
  shadow-color: #050108;
  shadow-opacity: 0.62;
  shadow-offset-x: 0;
  shadow-offset-y: 5;
}

.title-footer .shortcut-key {
  height: 29;
  background: #2b1025f4;
  background-bottom: #160a18f6;
  border-color: #aa527dcf;
  border-width: 1;
  corner-cut: 5;
  inner-border-color: #5f2749aa;
  inner-border-width: 1;
  inner-inset: 3;
  color: #fff1f7;
  secondary-color: #d4bcca;
  font-size: 13;
  secondary-font-size: 14;
  key-padding-x: 9;
  label-gap: 8;
  glow: #ff76ad;
  glow-strength: 0.08;
  shadow-color: #030105;
  shadow-opacity: 0.38;
  shadow-offset-x: 0;
  shadow-offset-y: 2;
}

.title-footer .shortcut-key#select {
  background: #3a152ef5;
  background-bottom: #1b0a1cf7;
  border-color: #d5689ae6;
  color: #fff7fb;
  secondary-color: #efd3df;
  glow-strength: 0.14;
}

.title-footer .shortcut-key#reload {
  background: #26122ff4;
  background-bottom: #110917f7;
  border-color: #9b5abde0;
  inner-border-color: #4d2b65aa;
  color: #f5e7ff;
  secondary-color: #cfb9dc;
}

.title-footer .shortcut-key#show-art {
  background: #2e1b10f2;
  background-bottom: #180e08f6;
  border-color: #dfaa64e6;
  inner-border-color: #76502caa;
  color: #fff1d9;
  secondary-color: #f3cf98;
  glow: #efb868;
  glow-strength: 0.12;
}

.title-footer .shortcut-key#exit {
  background: #21101df2;
  background-bottom: #10080ff6;
  border-color: #8e476cbf;
  secondary-color: #bfa7b4;
}

.title-footer .shortcut-key#age {
  height: 24;
  background: #3a2514ee;
  background-bottom: #21150def;
  border-color: #d9a65ee6;
  inner-border-color: #6f4b24aa;
  color: #ffd99a;
  font-size: 11.5;
  key-padding-x: 7;
  glow: #efb868;
  glow-strength: 0.1;
  shadow-opacity: 0;
}

.options-menu {
  x: 735;
  y: 645;
  width: 450;
  height: 72;
  gap: 0;
}

.options-menu .menu-item {
  background: var(--wine);
  color: var(--text);
  font-size: 27;
  opacity: 1;
  scale: 1;
  glow: var(--rose);
  glow-strength: 0.58;
  shadow-color: #050108;
  shadow-opacity: 0.72;
  shadow-offset-x: 5;
  shadow-offset-y: 8;
}

/* Options — dense royal archive with stable, non-shifting interaction states. */
.options-shell {
  chrome: arcane;
  background: #150916f1;
  background-bottom: #08050cf8;
  border-color: #d86a9c;
  border-width: 2;
  corner-cut: 30;
  inner-border-color: #6f2d55;
  inner-border-width: 1;
  inner-inset: 10;
  ornament-color: #d86a9c;
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.82;
  ornament-center: 1;
  ornament-sides: 1;
  corner-ornament-size: 44;
  rail-inset: 74;
  rail-offset: 10;
  gem-color: var(--chrome-gem);
  gem-core-color: var(--chrome-gem-core);
  gem-size: 8;
  glow: var(--chrome-glow);
  glow-strength: 0.26;
  glow-spread: 3;
  shadow-color: #030105;
  shadow-opacity: 0.76;
  shadow-offset-x: 8;
  shadow-offset-y: 13;
}

.options-section {
  background: #1f0d20d9;
  background-bottom: #0d0713e8;
  border-color: #743253c9;
  border-width: 1;
  corner-cut: 18;
  inner-border-color: #4f203f9e;
  inner-border-width: 1;
  inner-inset: 7;
  ornament-color: #b44c79;
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.34;
  ornament-center: 0;
  ornament-sides: 1;
  corner-ornament-size: 22;
  rail-inset: 46;
  rail-offset: 7;
  glow: #ff76ad;
  glow-strength: 0.07;
  shadow-color: #030105;
  shadow-opacity: 0.42;
  shadow-offset-x: 3;
  shadow-offset-y: 5;
}

.language-option {
  background: #211021e8;
  background-bottom: #0e0813ee;
  border-color: #743353cf;
  border-width: 1;
  corner-cut: 10;
  inner-border-color: #51213fa0;
  inner-border-width: 1;
  inner-inset: 5;
  ornament-color: #c15786;
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.22;
  ornament-center: 0;
  ornament-sides: 1;
  corner-ornament-size: 14;
  rail-inset: 32;
  rail-offset: 5;
  glow: var(--chrome-glow);
  glow-strength: 0.04;
  shadow-color: #030105;
  shadow-opacity: 0.34;
  shadow-offset-x: 2;
  shadow-offset-y: 3;
}

.language-option:hover {
  background: #32142bf0;
  background-bottom: #130918f3;
  border-color: #d16a98;
  inner-border-color: #8e3d68;
  ornament-opacity: 0.58;
  glow-strength: 0.18;
}

.language-option:focus,
.language-option:selected {
  background: #481936f5;
  background-bottom: #190a20f7;
  border-color: #ff9fc7;
  border-width: 2;
  inner-border-color: #d86e9f;
  ornament-opacity: 0.88;
  glow-strength: 0.35;
}

.language-option:active {
  background: #5c1d43f7;
  glow-strength: 0.48;
}

.language-code {
  background: #37132df0;
  background-bottom: #180a1cf4;
  border-color: #b75683d9;
  border-width: 1;
  corner-cut: 7;
  inner-border-color: #69294faa;
  inner-border-width: 1;
  inner-inset: 3;
  shadow-color: #030105;
  shadow-opacity: 0.28;
  shadow-offset-y: 2;
}

.options-action,
.gallery-action,
.end-action {
  background: #34132ced;
  background-bottom: #130919f5;
  border-color: #c45d8c;
  border-width: 2;
  corner-cut: 18;
  inner-border-color: #7e315f;
  inner-border-width: 1;
  inner-inset: 6;
  ornament-color: #d96b9c;
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.66;
  ornament-center: 0;
  ornament-sides: 1;
  corner-ornament-size: 22;
  rail-inset: 42;
  rail-offset: 6;
  gem-color: var(--chrome-gem);
  gem-core-color: var(--chrome-gem-core);
  gem-size: 5;
  glow: var(--chrome-glow);
  glow-strength: 0.16;
  shadow-color: #030105;
  shadow-opacity: 0.58;
  shadow-offset-x: 4;
  shadow-offset-y: 6;
}

.options-action:hover,
.gallery-action:hover,
.end-action:hover,
.options-action:focus,
.options-action:selected {
  background: #50183bf5;
  background-bottom: #1b0a23f8;
  border-color: #ff9fc7;
  inner-border-color: #da77a5;
  ornament-opacity: 0.94;
  glow-strength: 0.38;
}

.options-action:active,
.gallery-action:active,
.end-action:active {
  background: #681e49f8;
  glow-strength: 0.52;
}

/* Gallery — illustration stays full-resolution; UI forms an archival frame. */
.gallery-sidebar {
  chrome: arcane;
  background: #160916f6;
  background-bottom: #07040bfa;
  border-color: #d86a9c;
  border-width: 2;
  corner-cut: 22;
  inner-border-color: #6f2d55;
  inner-border-width: 1;
  inner-inset: 9;
  ornament-color: #d86a9c;
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.78;
  ornament-center: 1;
  ornament-sides: 1;
  corner-ornament-size: 34;
  rail-inset: 58;
  rail-offset: 9;
  gem-color: var(--chrome-gem);
  gem-core-color: var(--chrome-gem-core);
  gem-size: 7;
  glow: var(--chrome-glow);
  glow-strength: 0.22;
  glow-spread: 3;
  shadow-color: #020104;
  shadow-opacity: 0.84;
  shadow-offset-x: 8;
  shadow-offset-y: 10;
}

.gallery-item {
  background: #201020e8;
  background-bottom: #0d0712ef;
  border-color: #70304fbd;
  border-width: 1;
  corner-cut: 9;
  inner-border-color: #4e203ca0;
  inner-border-width: 1;
  inner-inset: 4;
  ornament-color: #b74e78;
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.2;
  ornament-center: 0;
  ornament-sides: 1;
  corner-ornament-size: 13;
  rail-inset: 28;
  rail-offset: 4;
  glow: var(--chrome-glow);
  glow-strength: 0.03;
}

.gallery-item:hover {
  background: #35142df0;
  border-color: #cb618f;
  ornament-opacity: 0.54;
  glow-strength: 0.16;
}

.gallery-item:focus,
.gallery-item:selected {
  background: #4a1838f6;
  background-bottom: #180a20f7;
  border-color: #ff9fc7;
  border-width: 2;
  inner-border-color: #d876a3;
  ornament-opacity: 0.9;
  glow-strength: 0.34;
}

.gallery-caption {
  chrome: arcane;
  background: #180a19f1;
  background-bottom: #08050cf8;
  border-color: #ca5f8e;
  border-width: 2;
  corner-cut: 24;
  inner-border-color: #6c2a51;
  inner-border-width: 1;
  inner-inset: 8;
  ornament-color: #d66898;
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.66;
  ornament-center: 1;
  ornament-sides: 1;
  corner-ornament-size: 32;
  rail-inset: 58;
  rail-offset: 8;
  gem-color: var(--chrome-gem);
  gem-core-color: var(--chrome-gem-core);
  gem-size: 7;
  glow: var(--chrome-glow);
  glow-strength: 0.2;
  shadow-color: #020104;
  shadow-opacity: 0.72;
  shadow-offset-x: 6;
  shadow-offset-y: 9;
}

/* Narrative screen — cinematic dialogue and responsive choices. */
.dialogue-panel {
  x: 115;
  y: 846;
  width: 1690;
  height: 208;
  chrome: arcane;
  background: #1f0d2bdc;
  background-bottom: #0b0512ea;
  border-color: var(--chrome-edge);
  border-width: 2;
  corner-cut: 28;
  inner-border-color: var(--chrome-edge-inner);
  inner-border-width: 1;
  inner-inset: 9;
  ornament-color: var(--chrome-edge);
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.82;
  ornament-center: 1;
  ornament-sides: 1;
  corner-ornament-size: 52;
  rail-inset: 64;
  rail-offset: 9;
  gem-color: var(--chrome-gem);
  gem-core-color: var(--chrome-gem-core);
  gem-size: 9;
  color: #fff8fc;
  secondary-color: #d4aabd;
  error-color: #ffa0a8;
  action-color: #e6b9ce;
  action-hover-color: #ffe0ad;
  font-size: 30;
  line-height: 44;
  meta-font-size: 13;
  content-padding-x: 60;
  content-padding-top: 46;
  text-max-width: 1510;
  footer-inset: 46;
  glow: var(--chrome-glow);
  glow-strength: 0.28;
  glow-spread: 3;
  shadow-color: #050108;
  shadow-opacity: 0.68;
  shadow-offset-x: 7;
  shadow-offset-y: 12;
}

/* Compact controls share the dialogue's native arcane chrome. */
.dialogue-action {
  chrome: arcane;
  background: #2a112ae6;
  background-bottom: #150a1ade;
  border-color: #9c4f7c;
  border-width: 1;
  corner-cut: 9;
  inner-border-color: #5b2a4a;
  inner-border-width: 1;
  inner-inset: 3;
  ornament-color: var(--chrome-edge);
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.3;
  ornament-center: 0;
  ornament-sides: 0;
  corner-ornament-size: 11;
  rail-inset: 20;
  rail-offset: 4;
  color: #f9ddec;
  glow: var(--chrome-glow);
  glow-strength: 0.12;
  glow-spread: 1;
}
.dialogue-action:hover, .dialogue-action:focus {
  background: #50213cf9;
  background-bottom: #2c1128f5;
  border-color: var(--chrome-gold);
  color: #ffe5b2;
  ornament-opacity: 1;
}
.dialogue-action:active {
  background: #612448;
  background-bottom: #38142d;
  color: #fff4df;
}
.dialogue-action:disabled {
  background: #180f1b;
  background-bottom: #130c17;
  border-color: #69455d;
  inner-border-color: #806275;
  ornament-opacity: 0.28;
  glow-strength: 0;
  color: #bba6b5;
}

.speaker-plate {
  x: 170;
  y: 814;
  width: 640;
  height: 64;
  chrome: arcane;
  background: #37152ef6;
  background-bottom: #160b1bef;
  border-color: var(--chrome-gold);
  border-width: 2;
  corner-cut: 22;
  inner-border-color: #9e4776;
  inner-border-width: 1;
  inner-inset: 7;
  ornament-color: var(--chrome-edge);
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.92;
  ornament-center: 0;
  ornament-sides: 1;
  corner-ornament-size: 26;
  rail-inset: 42;
  rail-offset: 7;
  gem-color: var(--chrome-gem);
  gem-core-color: var(--chrome-gem-core);
  gem-size: 7;
  color: #fff0d9;
  text-shadow-color: #160c1faa;
  font-size: 31;
  glow: var(--chrome-glow);
  glow-strength: 0.34;
  glow-spread: 2;
  shadow-color: #050108;
  shadow-opacity: 0.68;
  shadow-offset-x: 4;
  shadow-offset-y: 7;
}

.story-choices {
  x: 410;
  y: 0;
  width: 1100;
  height: 80;
  gap: 12;
}

.resume-choices {
  x: 330;
  y: 405;
  width: 1260;
  height: 94;
  gap: 18;
}

.story-choice-single {
  x: 480;
  y: 0;
  width: 960;
  height: 84;
  gap: 15;
}

.story-choice-pair {
  x: 390;
  y: 0;
  width: 1140;
  height: 84;
  gap: 15;
}

.hub-choices {
  x: 345;
  y: 0;
  width: 1230;
  height: 93;
  gap: 15;
}

.choice-item {
  chrome: arcane;
  background: #251022f2;
  background-bottom: #0e0713f5;
  border-color: #bd5887;
  border-width: 2;
  corner-cut: 22;
  inner-border-color: #6d2a51;
  inner-border-width: 1;
  inner-inset: 7;
  ornament-color: #d9679a;
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.66;
  ornament-center: 0;
  ornament-sides: 1;
  corner-ornament-size: 34;
  rail-inset: 74;
  rail-offset: 7;
  gem-color: var(--chrome-gem);
  gem-core-color: var(--chrome-gem-core);
  gem-size: 6;
  color: #f8eaf1;
  font-size: 25;
  opacity: 1;
  glow: var(--chrome-glow);
  glow-strength: 0.12;
  glow-spread: 2;
  feedback-color: #ff9cc9;
  feedback-inset: 82;
  marker-size: 40;
  marker-offset-x: 54;
  marker-font-size: 14;
  marker-background: #250b1c;
  marker-border-color: var(--chrome-gold);
  marker-color: #ef9cbd;
  secondary-color: #c99bb0;
  shadow-color: #050108;
  shadow-opacity: 0.66;
  shadow-offset-x: 5;
  shadow-offset-y: 7;
  transition: opacity 180ms cubic_out;
}

.choice-item:hover {
  background: #3a1531f4;
  background-bottom: #16091cf7;
  border-color: #eb78a8;
  inner-border-color: #a84b78;
  marker-background: #3b1029;
  marker-border-color: #f1c184;
  ornament-opacity: 0.88;
  glow-strength: 0.32;
}

.choice-item:focus,
.choice-item:selected {
  background: #4b1738f8;
  background-bottom: #1c0a24fa;
  border-color: #ffabd0;
  border-width: 2;
  color: #ffffff;
  inner-border-color: #e793b8;
  marker-background: #8d2857;
  marker-border-color: #ffe0aa;
  marker-color: #ffffff;
  secondary-color: #ffd0e2;
  ornament-opacity: 1;
  glow-strength: 0.54;
}

.choice-item:active {
  background: #641b45fa;
  background-bottom: #240b2cfa;
  glow-strength: 0.68;
}

.choice-item:disabled {
  background: #171018dc;
  background-bottom: #0b080ddd;
  border-color: #6d5260;
  color: #9d8994;
  opacity: 0.46;
  ornament-opacity: 0.28;
  glow-strength: 0;
}

.hub-choices .choice-item:primary {
  background: #24170fee;
  border-color: #b98652;
  color: #ffe9c9;
  glow: var(--gold);
  inner-border-color: #ffe0ac;
  marker-background: #382312;
  marker-border-color: #c9955d;
  marker-color: #ffd699;
  secondary-color: #e9bd7f;
  glow-strength: 0.2;
}

.hub-choices .choice-item:primary:hover {
  background: #382416f2;
  border-color: #e6b873;
  marker-background: #553417;
  glow-strength: 0.34;
}

.hub-choices .choice-item:primary:focus,
.hub-choices .choice-item:primary:selected {
  background: #513219f7;
  border-color: #ffd493;
  border-width: 2;
  color: #fff8e9;
  inner-border-color: #ffe5b5;
  marker-background: #a66b2f;
  marker-border-color: #ffe5b5;
  marker-color: #ffffff;
  secondary-color: #ffe2ad;
  glow-strength: 0.58;
}

.hub-choices .choice-item:primary:active {
  background: #66401ffa;
  scale: 0.995;
  glow-strength: 0.68;
}

.stats-hud {
  x: 28;
  y: 38;
  width: 438;
  height: 220;
  chrome: arcane;
  background: #1b0b1de8;
  background-bottom: #09050ef3;
  border-color: var(--chrome-edge);
  border-width: 2;
  corner-cut: 18;
  inner-border-color: #6e2c55cf;
  inner-border-width: 1;
  inner-inset: 7;
  ornament-color: var(--chrome-edge);
  ornament-secondary-color: var(--chrome-gold);
  ornament-opacity: 0.74;
  ornament-center: 1;
  ornament-sides: 0;
  corner-ornament-size: 26;
  rail-inset: 46;
  rail-offset: 7;
