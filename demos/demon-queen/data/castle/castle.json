on":"book","label":"Escritorio","text":"El diario de la Reina y los libros de hechizos."},{"id":"sello","room":"sello","level":0,"x":-18,"z":15,"radius":3,"icon":"seal","label":"El sello","text":"El círculo que mantiene cerrada la puerta de abajo. Late cuando ella se acerca."},{"id":"hogar","room":"comedor","level":0,"x":23.6,"z":-2.6,"radius":2,"icon":"tea","label":"Cocina","text":"Lira cocina aquí: comidas que dan ventajas antes de salir."},{"id":"lira","room":"comedor","level":0,"x":21.8,"z":2.2,"radius":1.6,"icon":"maid","label":"Lira","text":"¿Qué necesitas, mi señora? La chimenea necesita más leña."},{"id":"nemi","room":"servicio","level":0,"x":14.6,"z":15.6,"radius":1.6,"icon":"maid","label":"Nemi","text":"Estoy lista para ayudar. ¿Preparo el baño?"},{"id":"retratos","room":"galeria","level":1,"x":3,"z":9.8,"radius":2.4,"icon":"frame","label":"Retratos","text":"Las reinas que hubo antes, en sus marcos dorados."},{"id":"botiquin","room":"enfermeria","level":1,"x":-13.5,"z":9.8,"radius":2,"icon":"cross","label":"Botiquín","text":"Vendas, ungüentos y frascos con etiquetas que no sabe leer."},{"id":"nyxara","room":"enfermeria","level":1,"x":-22.2,"z":11.6,"radius":1.9,"icon":"maid","label":"Nyxara","text":"La doctora del castillo, de ronda."},{"id":"armero","room":"armeria","level":1,"x":18,"z":9.4,"radius":2.4,"icon":"sword","label":"Armero","text":"Lanzas, espadas y escudos con el emblema del corazón con cuernos."},{"id":"literas","room":"barracones","level":1,"x":14.5,"z":19.4,"radius":2.2,"icon":"bed","label":"Literas","text":"Camas para una guardia que todavía no tiene."},{"id":"despensa","room":"almacen","level":1,"x":-18,"z":-4.2,"radius":2.4,"icon":"box","label":"Despensa","text":"Sacos, barriles y jamones colgados. Lira lleva la cuenta de todo."}],"spawn":{"x":0,"z":19.4},"lamps":[{"level":0,"x":-3.3,"y":1.6,"z":-15.5,"color":"#b56cff","power":1.6,"wall":-1},{"level":0,"x":-3.2,"y":1.41,"z":-8,"color":"#b56cff","power":1.6,"wall":-1},{"level":0,"x":3.3,"