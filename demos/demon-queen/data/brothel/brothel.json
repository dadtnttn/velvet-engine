    "who": "Rosalía",
    "look": "rosalia",
    "text": "Bienvenida al Corazón Carmesí. Aquí todo es discreto… y todo tiene su precio."
   },
   {
    "who": "Rosalía",
    "look": "rosalia",
    "text": "Las habitaciones están arriba. La primera y la segunda están libres; la tercera, ocupada."
   },
   {
    "who": "Rosalía",
    "look": "rosalia",
    "text": "Te quito el cordón de la escalera. Sube cuando quieras, cariño."
   }
  ],
  "escalera-cerrada": [
   {
    "who": "Rosalía",
    "look": "rosalia",
    "text": "¡Eh, eh! Las habitaciones son solo para clientes. Pasa primero por el mostrador."
   }
  ],
  "tablon": [
   {
    "who": "Tablón",
    "text": "«Se busca camarera para el turno de noche. Buen sueldo y mejores propinas.»"
   },
   {
    "who": "Tablón",
    "text": "«Se ruega no encender velas junto a las cortinas. La dirección.»"
   },
   {
    "who": "Tablón",
    "text": "«Objeto perdido: un guante de terciopelo rojo. Preguntar a Rosalía.»"
   }
  ],
  "servicio": [
   {
    "who": "Nina",
    "look": "nina",
    "text": "¿Vino especiado o cerveza negra? Invita la casa si vienes recomendada."
   },
   {
    "who": "Nina",
    "look": "nina",
    "text": "Si buscas a alguien, pregunta a Rosalía. Aquí nadie pregunta nada."
   }
  ],
  "alba": [
   {
    "who": "Alba",
    "look": "alba",
    "text": "Esta noche hay poca gente. Ven, siéntate junto al fuego."
   },
   {
    "who": "Alba",
    "look": "alba",
    "text": "El vino de la mesa es bueno. El de la barra… bueno, es de la barra."
   }
  ],
  "noa": [
   {
    "who": "Noa",
    "look": "noa",
    "text": "Shhh. Estoy contando las velas. Voy por la treinta y siete."
   }
  ],
  "lounge": [
   {
    "who": "Salón",
    "text": "Un fuego bajo, dos copas y música lenta. Aquí se espera con calma."
   }
  ],
  "espera": [
   {
    "who": "Sala de espera",
    "text": "Un sillón, un farol y un cuadro de montañas. Nadie tiene prisa."
   }
  ],
  "hab1": [
   {
    "who": "Habitación 1",
    "text": "Una cortina rosa y una puerta con un corazón grabado. Está libre."
   }
  ],
  "hab2": [
   {
    "who": "Habitación 2",
    "text": "Cortinas gruesas, luz de velas y un dosel carmesí. Está libre."
   }
  ],
  "hab3": [
   {
    "who": "Cliente",
    "look": "cliente",
    "text": "…Ocupado. Vuelve más tarde."
   },
   {
    "who": "Habitación 3",
    "text": "La puerta está cerrada. Se oye una charla tranquila al otro lado."
   }
  ]
 },
