function camp_tent(items: list, x: int, y: int, w: int, h: int, color: int, layer: int) {
    list_push(items, v_alpha_ellipse(x + w / 2, y + h, w / 2, 10, rgba8(0, 0, 0, 70), layer))
    let row = 0
    while row < h {
        let half = row * w / (h * 2)
        list_push(items, v_rect(x + w / 2 - half, y + row, half * 2 + 1, 1, color, layer + 1))
        row += 1
    }
    list_push(items, v_line(x + w / 2, y, x + 8, y + h, 4, rgba8(77, 40, 36, 255), layer + 2))
    list_push(items, v_line(x + w / 2, y, x + w - 8, y + h, 4, rgba8(77, 40, 36, 255), layer + 2))
    list_push(items, v_rect(x + w / 2 - 7, y + h / 2, 14, h / 2, rgba8(50, 28, 28, 255), layer + 3))
}

function camp_palisade_h(items: list, x: int, y: int, width: int) {
    let px = x
    while px < x + width {
        list_push(items, v_rect(px, y, 12, 36, rgba8(102, 63, 39, 255), 28))
        list_push(items, v_rect(px + 2, y + 3, 8, 29, rgba8(150, 95, 53, 255), 29))
        px += 18
    }
    list_push(items, v_line(x, y + 24, x + width, y + 24, 7, rgba8(78, 47, 33, 255), 30))
}

function camp_visuals(time: float, stage: string) {
    let items = base_ground("ground_camp", rgba8(79, 73, 48, 255))
    let road = [[0, 360], [150, 350], [300, 340], [455, 330], [620, 320], [780, 305], [960, 290]]
    let fort_road = [[475, 330], [535, 275], [610, 225], [690, 185]]
    push_line_path(items, road, 78, rgba8(91, 61, 42, 255), 6)
    push_line_path(items, fort_road, 62, rgba8(91, 61, 42, 255), 6)
    push_line_path(items, road, 58, rgba8(151, 108, 67, 255), 7)
    push_line_path(items, fort_road, 44, rgba8(151, 108, 67, 255), 7)

    list_push(items, v_alpha_ellipse(475, 335, 150, 95, rgba8(88, 68, 44, 170), 8))
    list_push(items, v_alpha_ellipse(255, 235, 175, 125, rgba8(88, 68, 44, 125), 8))
    list_push(items, v_alpha_ellipse(720, 450, 170, 105, rgba8(88, 68, 44, 130), 8))

    camp_palisade_h(items, 545, 55, 350)
    camp_palisade_h(items, 545, 205, 125)
    camp_palisade_h(items, 795, 205, 100)
    let py = 70
    while py < 245 {
        list_push(items, v_rect(535, py, 13, 35, rgba8(139, 83, 48, 255), 28))
        list_push(items, v_rect(895, py, 13, 35, rgba8(139, 83, 48, 255), 28))
        py += 22
    }

    list_push(items, v_sprite("barracks", 585, 55, 210, 170, "content", 42))
    list_push(items, v_sprite("tower", 805, 72, 120, 150, "content", 43))

    camp_tent(items, 100, 145, 155, 110, rgba8(132, 49, 41, 255), 35)
    camp_tent(items, 275, 120, 145, 105, rgba8(112, 43, 37, 255), 35)
    camp_tent(items, 135, 400, 160, 112, rgba8(143, 54, 42, 255), 35)
    camp_tent(items, 315, 430, 135, 96, rgba8(111, 45, 39, 255), 35)

    let cx = 485
    let cy = 335
    list_push(items, v_alpha_ellipse(cx, cy + 26, 44, 12, rgba8(0, 0, 0, 80), 39))
    let stone = 0
    while stone < 10 {
        let sx = cx - 40 + (stone % 5) * 20
        let sy = cy + 16 + (stone / 5) * 15
        list_push(items, v_circle(sx, sy, 8, rgba8(83, 78, 83, 255), 40))
        stone += 1
    }
    list_push(items, v_circle(cx, cy, 28, rgba8(246, 96, 39, 255), 41))
    list_push(items, v_circle(cx, cy - 15, 18, rgba8(255, 180, 62, 255), 42))
    list_push(items, v_circle(cx, cy - 29, 9, rgba8(255, 226, 103, 255), 43))

    for crate in [[665, 410, 48], [720, 430, 52], [775, 405, 45], [835, 445, 50]] {
        list_push(items, v_rect(crate[0], crate[1], crate[2], crate[2], rgba8(116, 75, 42, 255), 35))
        list_push(items, v_border(crate[0], crate[1], crate[2], crate[2], 4, rgba8(67, 43, 31, 255), 36))
        list_push(items, v_line(crate[0], crate[1], crate[0] + crate[2], crate[1] + crate[2], 3, rgba8(82, 51, 34, 255), 37))
    }
    for barrel in [[700, 500], [760, 505], [820, 500]] {
        list_push(items, v_ellipse(barrel[0], barrel[1], 19, 28, rgba8(102, 61, 39, 255), 36))
        list_push(items, v_border(barrel[0] - 18, barrel[1] - 27, 36, 54, 3, rgba8(61, 38, 30, 255), 37))
    }

    for banner in [[565, 185], [875, 185], [630, 250], [820, 250]] {
        list_push(items, v_line(banner[0], banner[1], banner[0], banner[1] + 58, 6, rgba8(64, 42, 31, 255), 45))
        list_push(items, v_rect(banner[0] + 3, banner[1] + 4, 30, 40, rgba8(130, 35, 35, 255), 46))
        list_push(items, v_rect(banner[0] + 8, banner[1] + 9, 20, 7, rgba8(218, 157, 61, 255), 47))
    }

    let ember = 0
    while ember < 16 {
        let ex = 450 + (ember * 37 % 72)
        let ey = 250 + (ember * 29 % 70)
        list_push(items, v_alpha_ellipse(ex, ey, 3, 5, rgba8(255, 146, 53, 120), 70))
        ember += 1
    }
    return items
}
