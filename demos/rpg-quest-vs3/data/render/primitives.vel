function rgba8(r: int, g: int, b: int, a: int) {
    return a * 16777216 + r * 65536 + g * 256 + b
}

function v_clear(color: int, layer: int) {
    return {"op": "clear", "color": color, "layer": layer}
}

function v_rect(x: float, y: float, w: float, h: float, color: int, layer: int) {
    return {"op": "rect", "x": x, "y": y, "w": w, "h": h, "color": color, "layer": layer}
}

function v_alpha_rect(x: float, y: float, w: float, h: float, color: int, layer: int) {
    return {"op": "alpha_rect", "x": x, "y": y, "w": w, "h": h, "color": color, "layer": layer}
}

function v_border(x: float, y: float, w: float, h: float, thickness: float, color: int, layer: int) {
    return {"op": "border", "x": x, "y": y, "w": w, "h": h, "thickness": thickness, "color": color, "layer": layer}
}

function v_circle(x: float, y: float, radius: float, color: int, layer: int) {
    return {"op": "circle", "x": x, "y": y, "radius": radius, "color": color, "layer": layer}
}

function v_ellipse(x: float, y: float, rx: float, ry: float, color: int, layer: int) {
    return {"op": "ellipse", "x": x, "y": y, "rx": rx, "ry": ry, "color": color, "layer": layer}
}

function v_alpha_ellipse(x: float, y: float, rx: float, ry: float, color: int, layer: int) {
    return {"op": "alpha_ellipse", "x": x, "y": y, "rx": rx, "ry": ry, "color": color, "layer": layer}
}

function v_line(x: float, y: float, x2: float, y2: float, thickness: float, color: int, layer: int) {
    return {"op": "line", "x": x, "y": y, "x2": x2, "y2": y2, "thickness": thickness, "color": color, "layer": layer}
}

function v_sprite(asset: string, x: float, y: float, w: float, h: float, fit: string, layer: int) {
    return {"op": "sprite", "asset": asset, "x": x, "y": y, "w": w, "h": h, "fit": fit, "layer": layer}
}

function v_frame(asset: string, frame_width: int, fps: float, frame: int, x: float, y: float, w: float, h: float, flip_x: bool, layer: int) {
    return {
        "op": "sprite_frame",
        "asset": asset,
        "frame_width": frame_width,
        "fps": fps,
        "frame": frame,
        "x": x,
        "y": y,
        "w": w,
        "h": h,
        "flip_x": flip_x,
        "layer": layer
    }
}

function v_tile(asset: string, source_x: int, source_y: int, source_w: int, source_h: int, x: float, y: float, w: float, h: float, tile_w: int, tile_h: int, layer: int) {
    return {
        "op": "tile_fill",
        "asset": asset,
        "source_x": source_x,
        "source_y": source_y,
        "source_w": source_w,
        "source_h": source_h,
        "x": x,
        "y": y,
        "w": w,
        "h": h,
        "tile_w": tile_w,
        "tile_h": tile_h,
        "layer": layer
    }
}

function push_line_path(items: list, points: list, thickness: float, color: int, layer: int) {
    let index = 0
    while index + 1 < len(points) {
        let start = points[index]
        let finish = points[index + 1]
        list_push(items, v_line(start[0], start[1], finish[0], finish[1], thickness, color, layer))
        index += 1
    }
}

function push_sprite_points(items: list, asset: string, points: list, frame_width: int, fps: float, w: float, h: float, layer: int) {
    let index = 0
    while index < len(points) {
        let point = points[index]
        list_push(items, v_frame(asset, frame_width, fps, index, point[0], point[1], w, h, false, layer))
        index += 1
    }
}

function base_ground(asset: string, fallback: int) {
    let items = []
    list_push(items, v_clear(fallback, 0))
    list_push(items, v_tile(asset, 64, 64, 64, 64, 0, 0, 960, 640, 64, 64, 1))
    return items
}


function v_text(text: string, font: string, x: float, y: float, size: float, color: int, align: string, layer: int) {
    return {"op": "text", "text": text, "font": font, "x": x, "y": y, "size": size, "color": color, "align": align, "layer": layer}
}

function v_text_wrap(text: string, font: string, x: float, y: float, width: float, size: float, line_height: float, color: int, layer: int) {
    return {"op": "text_wrap", "text": text, "font": font, "x": x, "y": y, "w": width, "size": size, "line_height": line_height, "color": color, "layer": layer}
}

function v_panel(x: float, y: float, w: float, h: float, fill: int, stroke: int, thickness: float, layer: int) {
    return {"op": "panel", "x": x, "y": y, "w": w, "h": h, "color": fill, "stroke": stroke, "thickness": thickness, "layer": layer}
}

function v_bar(x: float, y: float, w: float, h: float, ratio: float, background: int, fill: int, layer: int) {
    return {"op": "bar", "x": x, "y": y, "w": w, "h": h, "ratio": ratio, "background": background, "fill": fill, "stroke": rgba8(42, 21, 25, 255), "thickness": 2.0, "layer": layer}
}

function v_button(id: string, text: string, icon: string, x: float, y: float, w: float, h: float, layer: int) {
    return {
        "op": "button",
        "action": id,
        "text": text,
        "icon": icon,
        "asset": "button",
        "hover_asset": "button_selected",
        "pressed_asset": "button_selected",
        "font": "pixel",
        "size": 16.0,
        "color": rgba8(255, 225, 182, 255),
        "background": rgba8(82, 48, 39, 255),
        "fill": rgba8(125, 73, 53, 255),
        "stroke": rgba8(185, 121, 76, 255),
        "thickness": 3.0,
        "x": x,
        "y": y,
        "w": w,
        "h": h,
        "layer": layer
    }
}

function v_keycap(text: string, x: float, y: float, w: float, h: float, layer: int) {
    return {
        "op": "keycap",
        "text": text,
        "asset": "keycap",
        "font": "pixel",
        "size": 12.0,
        "color": rgba8(255, 223, 176, 255),
        "background": rgba8(85, 48, 39, 255),
        "stroke": rgba8(185, 121, 76, 255),
        "thickness": 2.0,
        "x": x,
        "y": y,
        "w": w,
        "h": h,
        "layer": layer
    }
}


function v_rounded_rect(x: float, y: float, w: float, h: float, radius: float, color: int, layer: int) {
    return {"op": "rounded_rect", "x": x, "y": y, "w": w, "h": h, "radius": radius, "color": color, "layer": layer}
}

function v_nine_slice(asset: string, source_border: int, destination_border: int, x: float, y: float, w: float, h: float, layer: int) {
    return {"op": "nine_slice", "asset": asset, "source_border": source_border, "destination_border": destination_border, "x": x, "y": y, "w": w, "h": h, "layer": layer}
}

function v_clip_push(x: float, y: float, w: float, h: float, layer: int) {
    return {"op": "clip_push", "x": x, "y": y, "w": w, "h": h, "layer": layer}
}

function v_clip_pop(layer: int) {
    return {"op": "clip_pop", "layer": layer}
}

function v_translate_push(x: float, y: float, layer: int) {
    return {"op": "translate_push", "x": x, "y": y, "layer": layer}
}

function v_transform_pop(layer: int) {
    return {"op": "transform_pop", "layer": layer}
}

function v_opacity_push(opacity: float, layer: int) {
    return {"op": "opacity_push", "ratio": opacity, "layer": layer}
}

function v_opacity_pop(layer: int) {
    return {"op": "opacity_pop", "layer": layer}
}
