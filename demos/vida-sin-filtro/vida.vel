    "nuevo_look": {"n": "Nuevo look", "good": true, "d": "Un cambio de imagen que todos notan.", "mods": {"looks": 4, "flirt": 3}},
    "viral": {"n": "Viral", "good": true, "d": "Todo internet habla de ti (por ahora).", "mods": {"flirt": 5, "hire": 2}},
