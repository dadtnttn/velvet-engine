    {"id": "torpe", "n": "Torpe", "d": "Tropiezas con tus propios pies.", "soc": "skill", "pts": -8, "fx": {"pay": -3}, "goal": "Llega a Destreza 3."},
    {"id": "enfermizo", "n": "Enfermiz{a}", "d": "Te enfermas de todo.", "soc": "", "pts": 0, "fx": {"hp": -1}, "goal": "Llega a los 18 con salud de 85 o más."},
    {"id": "flojo", "n": "Floj{a}", "d": "Mañana. Siempre mañana.", "soc": "", "pts": 0, "fx": {"grades": -5, "pay": -3}, "goal": "Rinde al 85% en un trabajo o saca 90 de calificación."},
