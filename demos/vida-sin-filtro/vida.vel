const INT_SHORT = {"cine": "CINE", "musica": "MÚSICA", "baile": "BAILE", "cocina": "COCINA", "deporte": "DEPORTE", "naturaleza": "NATURALEZA",
                   "videojuegos": "VIDEOJUEGOS", "lectura": "LECTURA", "viajes": "VIAJES", "fiesta": "FIESTA", "arte": "ARTE", "juegos": "JUEGOS DE MESA"}

const HEIGHTS = [["baja", "Baja"], ["media", "Media"], ["alta", "Alta"]]
const FAMILY_OPTS = [["azar", "Al azar"], ["pobre", "Humilde"], ["media", "Media"], ["rica", "Adinerada"]]
const SIB_OPTS = [["azar", "Al azar"], ["no", "Ninguno"], ["si", "Uno"], ["muchos", "Dos o tres"]]
const DESTINY_OPTS = [["tranquilo", "Tranquilo"], ["normal", "Normal"], ["caotico", "Caótico"]]

function gfmt(s: string, gender: string) {
    let r = str_replace(s, "{a}", by_gender(gender, "o", "a"))
    r = str_replace(r, "{ra}", by_gender(gender, "", "a"))
    r = str_replace(r, "{na}", by_gender(gender, "", "a"))
    return r
}

function talent_def(id: string) {
    for t in TALENTS {
        if t.id == id { return t }
    }
    return TALENTS[0]
}

function flaw_def(id: string) {
    for f in FLAWS {
        if f.id == id { return f }
    }
    return FLAWS[0]
}

function pair_index(opts: list, id: string) {
    let i = 0
    while i < len(opts) {
        if opts[i][0] == id { return i }
        i += 1
    }
    return 0
}

function pair_name(opts: list, id: string, gender: string) {
    return gfmt(opts[pair_index(opts, id)][1], gender)
}

// Campos nuevos del creador (también para los herederos, que no pasan por él).
function cre_defaults(c: map) {
    if c.talent == null { c.talent = TALENTS[rint(0, len(TALENTS) - 1)].id }
    if c.flaw == null { c.flaw = "ninguno" }
    if c.ints == null { c.ints = [] }
    if c.city == null { c.city = "" }
    if c.fam == null { c.fam = "azar" }
    if c.sibs == null { c.sibs = "azar" }
    if c.bm == null { c.bm = -1 }
    if c.height == null { c.height = "media" }
    if c.destiny == null { c.destiny = "normal" }
    return c
}

function vida_creator_action(cmd: string, action: string, value: string) {
    let c = cre_defaults(G.cre)
    if cmd == "talent" { c.talent = TALENTS[cycle(id_index(TALENTS, c.talent), action, len(TALENTS))].id }
    if cmd == "flaw" { c.flaw = FLAWS[cycle(id_index(FLAWS, c.flaw), action, len(FLAWS))].id }
    if cmd == "int" {
        if list_contains(c.ints, value) {
            let keep = []
            for x in c.ints {
                if x != value { list_push(keep, x) }
            }
            c.ints = keep
        } else if len(c.ints) < 3 {
            list_push(c.ints, value)
        }
    }
    if cmd == "city" {
        let cities = cre_city_options(cre_ctry_defaults(c))
        if len(cities) == 0 { return null }
        let i = 0
        if c.city != "" { i = list_index(cities, c.city) + 1 }
        i = cycle(i, action, len(cities) + 1)
        if i == 0 { c.city = "" } else { c.city = cities[i - 1] }
    }
    if cmd == "fam" { c.fam = value }
    if cmd == "sibs" { c.sibs = value }
    if cmd == "bm" { c.bm = cycle(c.bm + 1, action, 13) - 1 }
    if cmd == "height" { c.height = value }
    if cmd == "destiny" { c.destiny = value }
    return null
}

function list_index(xs: list, v: string) {
    let i = 0
    while i < len(xs) {
        if xs[i] == v { return i }
        i += 1
    }
    return 0
}

function cre_city_name(c: map) {
    if c.city == "" { return "AL AZAR" }
    return str_upper(c.city)
}

function cre_month_name(c: map) {
    if c.bm < 0 { return "AL AZAR" }
    return str_upper(MONTH_NAMES[c.bm]) + " · " + str_upper(SIGNS[c.bm].n)
}

// Resumen de lo que te dan tus elecciones (en el creador).
function cre_preview(c: map) {
    let g = c.gender
    let t = talent_def(c.talent)
    let f = flaw_def(c.flaw)
    let s = "Talento: " + gfmt(t.n, g) + " (" + SOCIAL_NAMES[t.soc] + " +" + str(t.pts) + ", " + stat_name(t.stat) + " +" + str(t.sv) + ")."
    if f.id != "ninguno" { s = s + " Defecto: " + gfmt(f.n, g) + ". Para superarlo: " + f.goal }
    return s
}

function stat_name(k: string) {
    if k == "happy" { return "Felicidad" }
    if k == "health" { return "Salud" }
    if k == "smarts" { return "Inteligencia" }
    if k == "looks" { return "Atractivo" }
    return SOCIAL_NAMES[k]
}

// Ajustes de origen antes de crear la familia.
function cre_city_in(cid: string) {
    let c = cre_defaults(G.cre)
    let cities = ctry(cid).cities
    if c.city != "" && list_contains(cities, c.city) { return c.city }
    return pick(cities)
}

function cre_bmonth() {
    let c = cre_defaults(G.cre)
    if c.bm >= 0 { return c.bm }
    return rint(0, 11)
}

function cre_family(rolled: string) {
    let c = cre_defaults(G.cre)
    if c.fam != "azar" { return c.fam }
    return rolled
}

// Cuántos hermanos (-1: al azar como siempre).
function cre_sibs() {
    let c = cre_defaults(G.cre)
    if c.sibs == "no" { return 0 }
    if c.sibs == "si" { return 1 }
    if c.sibs == "muchos" { return rint(2, 3) }
    return -1
}

// Herederos: un talento al azar y el historial desde hoy.
function vida_heir() {
    L.talent = TALENTS[rint(0, len(TALENTS) - 1)].id
    L.flaw = "ninguno"
    vd_snapshot()
    vd_hist_push()
    return null
}

// Se aplica al nacer, después de la familia.
function vida_birth() {
    let c = cre_defaults(G.cre)
    let g = L.gender
    let d = vd()
    let t = talent_def(c.talent)
    L.talent = t.id
    gain(t.soc, t.pts)
    L[t.stat] = clamp100(L[t.stat] + t.sv)
    let f = flaw_def(c.flaw)
    L.flaw = f.id
    if f.soc != "" { gain(f.soc, f.pts) }
    if f.id == "enfermizo" { L.health = clamp100(L.health - 15) }
    if f.id == "vanidoso" { L.looks = clamp100(L.looks + 5) }
    let sg = SIGNS[L.bmonth]
    gain(sg.soc, 4)
    L.sign = sg.n
    L.height = c.height
    if c.height == "alta" { L.looks = clamp100(L.looks + 2) }
    if c.height == "baja" { gain("skill", 2) }
    L.chaos = c.destiny
    let ints = []
    for x in c.ints { list_push(ints, x) }
    if !list_contains(ints, t.int) && len(ints) < 3 { list_push(ints, t.int) }
    let pool = list_slice(INTERESTS, 0, len(INTERESTS))
    shuffle(G.rng, pool)
    for x in pool {
        if len(ints) < 3 && !list_contains(ints, x) { list_push(ints, x) }
    }
    L.interests = ints
    log_add("Naciste bajo el signo de " + sg.n + ": " + gfmt(sg.d, g), "x")
    log_add("Tu talento: " + gfmt(t.n, g) + ". " + gfmt(t.d, g), "g")
    if f.id != "ninguno" { log_add("Tu defecto: " + gfmt(f.n, g) + ". " + gfmt(f.d, g), "n") }
    vd_snapshot()
    vd_hist_push()
    return null
}

// ---------------------------------------------------------------- estado

function vd() {
    if L.vd == null {
        L.vd = {"goals": [], "goal": "", "gstage": "", "gpend": false, "hist": [], "tfx": {}, "res": null, "hol": {}, "bucket": [],
                "decades": [], "snap": null, "stage_hitos": 0, "stage_love": false, "crisis": false, "addict": false, "last_alc": 0,
                "last_drg": 0, "nest": false, "flaw_done": false}
    }
    return L.vd
}

// ---------------------------------------------------------------- 2. etapas

