function stage_of(age: int) {
    for s in STAGES {
        if age >= s.min && age <= s.max { return s }
    }
    return STAGES[len(STAGES) - 1]
}

function stage_def(id: string) {
    for s in STAGES {
        if s.id == id { return s }
    }
    return STAGES[0]
}

function stage_goal_def(stage: string, id: string) {
    let gs = GOALS[stage]
    if gs == null { return null }
    for g in gs {
        if g.id == id { return g }
    }
    return null
}

function has_grandkid(min_bond: int) {
    for p in L.people {
        if p.alive && p.rel == "nieto" && p.bond >= min_bond { return true }
    }
    return false
}

function loved_by() {
    let n = 0
    for p in L.people {
        if p.alive && p.bond >= 60 && p.age >= 4 { n += 1 }
    }
    return n
}

function goal_met(stage: string, id: string) {
    let d = vd()
    let p = partner()
    if stage == "teen" {
        if id == "popular" { return rank("charm") >= 3 }
        if id == "notas" { return L.grades >= 80 }
        if id == "amor" { return d.stage_love }
        return L.happy >= 70
    }
    if stage == "joven" {
        if id == "carrera" { return (L.job != null && L.job.level >= 2) || L.edu >= 3 }
        if id == "amor" { return L.married || (p != null && p.bond >= 70) }
        if id == "ahorro" { return net_worth() >= 50000 }
        return d.stage_hitos >= 8
    }
    if stage == "adulto" {
        if id == "familia" { return L.kids >= 1 }
        if id == "cima" { return L.job != null && L.job.level >= 3 }
        if id == "patrimonio" { return net_worth() >= 300000 }
        return L.happy >= 70 && L.health >= 70
    }
    if stage == "maduro" {
        if id == "huella" { return L.fame >= 40 || L.karma >= 75 }
        if id == "nietos" { return has_grandkid(0) }
        if id == "retiro" { return net_worth() >= 1000000 }
        return L.health >= 75
    }
    if stage == "mayor" {
        if id == "abuelo" { return has_grandkid(60) }
        if id == "deseos" { return len(d.bucket) >= 5 }
        if id == "paz" { return L.happy >= 75 }
        return L.health >= 55
    }
    if id == "cien" { return L.age >= 100 }
    if id == "rodeado" { return loved_by() >= 5 }
    if id == "sabio" { return rank("know") >= 5 || rank("kind") >= 5 }
    return L.happy >= 70
}

function open_goal_choice() {
    let d = vd()
    let s = stage_of(L.age)
    let gs = GOALS[s.id]
    if gs == null || G.modal != null { return false }
    let labels = []
    let locks = []
    let txt = []
    for g in gs {
        list_push(labels, gfmt(g.n, L.gender))
        list_push(locks, "")
        list_push(txt, gfmt(g.n, L.gender) + ": " + gfmt(g.d, L.gender))
    }
    d.gpend = false
    open_choice("NUEVA ETAPA: " + str_upper(s.n), s.d + " ¿Qué quieres de esta etapa? " + str_join(txt, " · "), labels, locks, "vd_goal", {})
    return true
}

// Cierra el propósito de la etapa que termina (o con tu último aliento).
function close_goal(dying: bool) {
    let d = vd()
    if d.goal == "" || d.gstage == "" { return null }
    let g = stage_goal_def(d.gstage, d.goal)
    let st = stage_def(d.gstage)
    if g == null { return null }
    let ok = goal_met(d.gstage, d.goal)
    list_push(d.goals, {"stage": st.n, "goal": gfmt(g.n, L.gender), "ok": ok})
    let n = gfmt(g.n, L.gender)
    if ok {
        if !dying { L.happy += 10 }
        hito_me("Vida", "Cumpliste tu propósito de la " + str_lower(st.n) + ": " + str_lower(n))
        let met = 0
        for x in d.goals {
            if x.ok { met += 1 }
        }
        if met >= 3 { flag("goals3") }
    } else if !dying {
        L.happy -= 3
        log_add("Se acabó tu " + str_lower(st.n) + " y no cumpliste tu propósito («" + n + "»). La vida no siempre sale como la planeas.", "n")
    }
    d.goal = ""
    d.gstage = ""
    return null
}

// Cada cumpleaños: etapas, resumen del año, década, nido vacío y defectos.
function vida_year() {
    let d = vd()
    let s = stage_of(L.age)
    let prev = stage_of(L.age - 1)
    if s.id != prev.id {
        close_goal(false)
        d.stage_hitos = 0
        d.stage_love = false
        list_push(G.toasts, {"head": "NUEVA ETAPA", "title": str_upper(s.n), "sub": "A los " + str(L.age) + " años", "t0": G.t})
        log_add("Empieza tu " + str_lower(s.n) + ". " + s.d, "x")
        if GOALS[s.id] != null { d.gpend = true }
    }
    // Resumen del año
    let sn = d.snap
    if sn != null && L.age > 1 {
        let parts = []
        let dh = L.happy - sn.happy
        if dh != 0 { list_push(parts, "felicidad " + sign_str(dh)) }
        let dl = L.health - sn.health
        if dl != 0 { list_push(parts, "salud " + sign_str(dl)) }
        let dm = L.money - sn.money
        if L.age >= 14 && dm != 0 {
            let ms = money_str(dm)
            if dm > 0 { ms = "+" + ms }
            list_push(parts, "dinero " + ms)
        }
        let dhit = hito_count() - sn.hitos
        if dhit > 0 { list_push(parts, str(dhit) + " " + plural(dhit, "hito", "hitos")) }
        if len(parts) > 0 { log_add("Tu año en resumen: " + str_join(parts, " · ") + ".", "n") }
    }
    vd_hist_push()
    vd_snapshot()
    // Década
    if L.age % 10 == 0 && L.age >= 10 {
        let a0 = L.age - 10
        let tot = 0
        let n = 0
        for h in d.hist {
            if h.a >= a0 && h.a < L.age {
                tot += h.happy
                n += 1
            }
        }
        let hn = 0
        if L.hitos != null {
            for h in L.hitos {
                if h.a >= a0 && h.a < L.age { hn += 1 }
            }
        }
        let avg = 0
        if n > 0 { avg = tot / n }
        let txt = "De los " + str(a0) + " a los " + str(L.age - 1) + ": " + str(hn) + " " + plural(hn, "hito", "hitos") + ", felicidad promedio de " + str(avg) + " (" + str_lower(happy_word(avg)) + ")"
        list_push(d.decades, {"a": a0, "t": txt})
        log_add("Tu década en resumen. " + txt + ".", "x")
    }
    if L.kids > 0 && kids_living() == 0 && !d.nest && len(kids_alive()) > 0 {
        d.nest = true
        tfx_add("nido_vacio", 8)
        log_add("Tu último hijo se fue de casa. El silencio retumba en los pasillos.", "n")
    }
    flaw_check()
    if L.age >= 100 { flag("centenarian") }
    if L.age >= 40 && L.age <= 46 && !d.crisis && chance(30) {
        d.crisis = true
        // Si otra ventana del cumpleaños llegó primero, la crisis espera su turno.
        if G.modal == null { open_midlife() } else { d.crisis_pend = true }
    }
    return null
}

function sign_str(n: int) {
    if n > 0 { return "+" + str(n) }
    return str(n)
}

function vd_snapshot() {
    vd().snap = {"happy": L.happy, "health": L.health, "money": L.money, "hitos": hito_count()}
    return null
}

function vd_hist_push() {
    let d = vd()
    list_push(d.hist, {"a": L.age, "happy": L.happy, "health": L.health, "smarts": L.smarts, "looks": L.looks, "know": L.social.know, "guts": L.social.guts, "skill": L.social.skill, "kind": L.social.kind, "charm": L.social.charm})
    if len(d.hist) > 110 { d.hist = list_slice(d.hist, len(d.hist) - 110, len(d.hist)) }
    return null
}

function flaw_check() {
    let d = vd()
    if L.flaw == null || L.flaw == "ninguno" || d.flaw_done { return null }
    let f = L.flaw
    let ok = false
    if f == "timido" { ok = rank("charm") >= 3 }
    if f == "torpe" { ok = rank("skill") >= 3 }
    if f == "enfermizo" { ok = L.age >= 18 && L.health >= 85 }
    if f == "flojo" { ok = (L.job != null && L.job.perf >= 85) || L.grades >= 90 }
    if f == "impulsivo" { ok = L.savings >= 50000 }
    if f == "celoso" { ok = rank("kind") >= 4 }
    if f == "vanidoso" { ok = rank("kind") >= 3 }
    if f == "despistado" { ok = rank("know") >= 4 }
    if !ok { return null }
    d.flaw_done = true
    let n = gfmt(flaw_def(f).n, L.gender)
    L.happy += 10
    gain("guts", 5)
    flag("flaw_beaten")
    hito_me("Vida", "Superaste tu defecto: dejaste de ser " + str_lower(n))
    return null
}

function open_midlife() {
    let p = partner()
    open_choice("LA CRISIS DE LOS 40", "Te miras al espejo y te preguntas qué hiciste con tu vida. Algo tiene que cambiar.",
        ["Comprarte un auto deportivo ($30,000)", "Correr un maratón", "Hacerte un tatuaje", "Aprender algo totalmente nuevo", "Aceptarte como eres"],
        [if_str(L.money < 30000, "$30,000", ""), if_str(L.health < 40, "Salud 40", ""), "", "", ""], "vd_crisis", {})
    return null
}

// Cada mes: efectos temporales, propósitos, fiestas, adicciones y hitos de estado.
function vida_month() {
    if !L.alive { return null }
    let d = vd()
    tfx_tick()
    if partner() != null { d.stage_love = true }
    // Resaca y abstinencia según cómo cambian tus vicios.
    if L.alcohol >= d.last_alc + 3 && L.age >= 16 { tfx_add("resaca", 1) }
    if L.alcohol >= 40 || L.drugs >= 40 { d.addict = true }
    if d.addict && (L.alcohol < d.last_alc - 4 || L.drugs < d.last_drg - 4) && L.alcohol + L.drugs >= 15 { tfx_add("abstinencia", 2) }
    d.last_alc = L.alcohol
    d.last_drg = L.drugs
    if L.age >= 18 && L.job != null && (L.job.perf < 40 || L.money < 0) && chance(12) && !tfx_has("estres") {
        tfx_add("estres", 3)
        log_add("El estrés te está comiendo vivo: duermes mal y todo te irrita.", "b")
    }
    if L.job != null && L.job2 != null && chance(8) && !tfx_has("burnout") {
        tfx_add("burnout", 3)
        log_add("Dos trabajos te dejaron sin energía. Estás quemad" + oa(L.gender) + ".", "b")
    }
    if L.flaw == "impulsivo" && !d.flaw_done && L.age >= 14 && L.money > 500 && chance(15) {
        let m = min(L.money / 10, rint(2, 20) * 50)
        L.money -= m
        log_add("Compra impulsiva: " + money_str(m) + " en algo que no necesitabas.", "n")
    }
    if L.flaw == "celoso" && !d.flaw_done && chance(10) {
        let p = partner()
        if p != null && both_adults(p) {
            bond_gain(p, -2)
            log_add("Le hiciste una escena de celos a " + p.first + ". Otra vez.", "b")
        }
    }
    if L.flaw == "despistado" && !d.flaw_done && L.age >= 10 && chance(6) {
        L.money -= min(max(0, L.money), 100)
        log_add(pick(["Perdiste las llaves. Cerrajero: $100.", "Dejaste la cartera en el taxi.", "Olvidaste dónde estacionaste. Dos horas buscando."]), "n")
    }
    vida_state_hitos()
    if G.modal != null { return null }
    if d.gpend {
        open_goal_choice()
        return null
    }
    if d.crisis_pend == true {
        d.crisis_pend = false
        open_midlife()
        return null
    }
    resolution_tick()
    return null
}

function vida_state_hitos() {
    if L.health <= 15 && L.age >= 5 { hito_once("near_death", "Salud", "Estuviste al borde de la muerte") }
    if L.smarts >= 95 { hito_once("genius", "Estudios", "Tu inteligencia es de genio") }
    if L.looks >= 95 && L.age >= 16 { hito_once("stunning", "Vida", "Tu belleza para el tráfico") }
    if L.happy >= 98 && L.age >= 5 { hito_once("bliss", "Vida", "Viviste un momento de felicidad plena") }
    if L.karma >= 90 { hito_once("saint", "Vida", "Todos dicen que eres un alma buena") }
    if L.karma <= 8 && L.age >= 14 { hito_once("devil", "Vida", "Te ganaste fama de mala persona") }
    if L.money <= -50000 { hito_once("rock_bottom", "Vida", "Tocaste fondo con las deudas") }
    let n = hito_count()
    if n >= 50 { hito_once("hitos50", "Vida", "Cincuenta momentos que recordar") }
    if n >= 100 {
        if hito_once("hitos100", "Vida", "Cien momentos que recordar") { flag("hitos100") }
    }
    return null
}

// Hitos que se suman a la etapa y a algunos efectos temporales.
function vida_on_hito(cat: string, text: string) {
    if L.vd == null { return null }
    L.vd.stage_hitos += 1
    if str_starts_with(text, "Te despidieron") { tfx_add("despedido", 4) }
    if str_starts_with(text, "Te jubilaste") { tfx_add("jubilado", 12) }
    if str_starts_with(text, "Terminaste la secundaria") || str_starts_with(text, "Te graduaste") || str_starts_with(text, "Te titulaste") { tfx_add("orgullo", 4) }
    if str_starts_with(text, "Perdiste a tu") { tfx_add("duelo", 6) }
    return null
}

// ---------------------------------------------------------------- propósitos de año nuevo y fiestas

const RESOLUTIONS = [
    {"id": "forma", "n": "Ponerme en forma", "d": "Subir 5 de salud o mantener un hábito de ejercicio."},
    {"id": "ahorrar", "n": "Ahorrar", "d": "Terminar el año con $10,000 más."},
    {"id": "leer", "n": "Leer más", "d": "Subir 5 de Conocimiento."},
    {"id": "vicio", "n": "Dejar un vicio", "d": "Bajar alcohol y drogas a menos de 10."},
    {"id": "amable", "n": "Ser mejor persona", "d": "Subir 5 de karma o de Amabilidad."},
    {"id": "amor", "n": "Encontrar el amor", "d": "Terminar el año con pareja."}
]

function resolution_tick() {
    let d = vd()
    let m = month_name()
    if m == "Enero" && L.age >= 10 && (d.res == null || d.res.age != L.age) && chance(70) {
        let labels = []
        let locks = []
        for r in RESOLUTIONS {
            list_push(labels, r.n)
            list_push(locks, "")
        }
        d.res = {"age": L.age, "id": "", "base": {}}
        open_choice("PROPÓSITO DE AÑO NUEVO", "Doce uvas, doce deseos. Pero este año eliges uno de verdad. Lo revisas en diciembre.", labels, locks, "vd_res", {})
        return null
    }
    if m == "Diciembre" && d.res != null && d.res.id != "" && d.res.done != true {
        d.res.done = true
        let r = d.res
        let b = r.base
        let ok = false
        if r.id == "forma" { ok = L.health >= b.health + 5 || has_habit("gym") || has_habit("correr") }
        if r.id == "ahorrar" { ok = L.money + L.savings >= b.money + 10000 }
        if r.id == "leer" { ok = L.social.know >= b.know + 5 }
        if r.id == "vicio" { ok = L.alcohol < 10 && L.drugs < 10 && !has_habit("fumar") && !has_habit("vapear") }
        if r.id == "amable" { ok = L.karma >= b.karma + 5 || L.social.kind >= b.kind + 5 }
        if r.id == "amor" { ok = partner() != null }
        if ok {
            L.happy += 6
            d.res_ok = map_get(d, "res_ok", 0) + 1
            if d.res_ok >= 3 { flag("resolutions3") }
            hito_once("res_ok", "Vida", "Cumpliste un propósito de año nuevo")
            log_add("¡Cumpliste tu propósito de año nuevo! Orgullo puro.", "g")
        } else {
            log_add("Tu propósito de año nuevo se quedó en eso: un propósito. Como cada año.", "n")
        }
        return null
    }
    maybe_holiday()
    return null
}

function maybe_holiday() {
    let d = vd()
    let m = month_name()
    if G.modal != null || L.jail > 0 || d.hol[m] == L.age || !chance(45) { return null }
    // La misma fiesta no pregunta cada año: como mucho cada tres, y al
    // adelantar el año cuenta dentro de sus sorpresas.
    if d.hol_last == null { d.hol_last = {} }
    if L.age - map_get(d.hol_last, m, -10) < 3 { return null }
    if G.yr != null && G.yr.pops >= 2 { return null }
    if G.skip != null && !chance(30) { return null }
    maybe_holiday_open(d, m)
    if G.modal != null {
        d.hol_last[m] = L.age
        if G.yr != null { G.yr.pops += 1 }
    }
    return null
}

function maybe_holiday_open(d: map, m: string) {
    let p = partner()
    if m == "Febrero" && L.age >= 15 && p != null {
        d.hol[m] = L.age
        open_choice("SAN VALENTÍN", "Es 14 de febrero y " + p.first + " te mira con ojitos de «¿y mi regalo?».", ["Cena romántica ($300)", "Una carta escrita a mano", "Se te olvidó por completo"], [if_str(L.money < 300, "$300", ""), "", ""], "vd_hol", {"kind": "vale", "person": p})
        return null
    }
    if m == "Noviembre" && L.age >= 6 && list_contains(["mx", "gt", "sv", "hn", "ni", "bo", "pe", "ec"], here_id()) {
        let lost = null
        for q in L.people {
            if !q.alive && q.blocked != true && q.bond >= 40 { lost = q }
        }
        if lost != null {
            d.hol[m] = L.age
            open_choice("DÍA DE MUERTOS", "Cempasúchil, pan de muerto y la foto de " + lost.first + ". ¿Cómo l" + oa(lost.gender) + " recuerdas este año?", ["Ponerle una ofrenda con su comida favorita ($200)", "Visitar su tumba con flores", "Prefieres no pensar en eso"], [if_str(L.money < 200, "$200", ""), "", ""], "vd_hol", {"kind": "muertos", "person": lost})
            return null
        }
    }
    if m == "Diciembre" && christmas_here() {
        d.hol[m] = L.age
        // Un bebé no espera a Santa: solo se lo cuentan después.
        if L.age < 3 {
            log_add(pick(["Tu Navidad: el papel de regalo te emocionó más que el regalo.", "Tu Navidad: te durmiste antes de la cena, abrazad" + oa(L.gender) + " a un peluche nuevo.", "Tu Navidad: todos se pelearon por cargarte."]), "g")
            return null
        }
        if L.age < 14 {
            open_choice("NAVIDAD", if_str(mx_style_here(), "Es Nochebuena. Hay ponche, tamales y un árbol con regalos.", "Es Nochebuena. La casa huele a cena especial y hay un árbol con regalos."), ["Esperar despiert" + oa(L.gender) + " a Santa", "Abrir los regalos a escondidas", "Ayudar a cocinar con la familia"], ["", "", ""], "vd_hol", {"kind": "navidad_kid"})
            return null
        }
        open_choice("NAVIDAD", "Las fiestas llegaron. ¿Cómo las pasas este año?", ["Cena con toda la familia", "Viaje de fin de año ($2,000)", "Trabajar el turno doble (pagan triple)", "Organizar el intercambio de regalos ($300)"], ["", if_str(L.money < 2000, "$2,000", ""), if_str(L.job == null, "Sin trabajo", ""), if_str(L.money < 300, "$300", "")], "vd_hol", {"kind": "navidad"})
        return null
    }
    if m == "Octubre" && L.age >= 5 && L.age <= 35 && halloween_here() {
        d.hol[m] = L.age
        open_choice("HALLOWEEN", "Noche de disfraces. ¿De qué te vistes?", ["De algo aterrador", "De algo gracioso", "De algo sexy", "Te quedas en casa repartiendo dulces"], ["", "", if_str(L.age < 18, "Edad 18", ""), ""], "vd_hol", {"kind": "halloween"})
        return null
    }
    if m == summer_month() && L.age >= 6 && L.age <= 22 && (L.school != "" || L.study != null) {
        d.hol[m] = L.age
        open_choice("VACACIONES DE VERANO", "Dos meses sin clases. ¿Qué haces?", ["Campamento de verano ($500)", "Trabajo de verano", "Dormir hasta mediodía y ver series", "Curso de verano"], [if_str(L.money < 500 && L.age >= 14, "$500", ""), if_str(L.age < 14, "Edad 14", ""), "", ""], "vd_hol", {"kind": "verano"})
        return null
    }
    if m == mothers_day_month() && len(kids_alive()) == 0 && L.age >= 6 && L.age <= 50 {
        let mom = null
        for q in parents_alive() {
            if q.rel == "madre" { mom = q }
        }
        if mom != null {
            d.hol[m] = L.age
            open_choice("DÍA DE LAS MADRES", "Es el Día de las madres. " + mom.first + " finge que no espera nada.", [if_str(mx_style_here(), "Llevarle serenata con mariachi ($800)", "Flores y un regalo especial ($800)"), "Comida en familia", "Una tarjeta hecha a mano", "Un mensaje rápido"], [if_str(L.money < 800, "$800", ""), "", "", ""], "vd_hol", {"kind": "madres", "person": mom})
            return null
        }
    }
    return null
}

// ---------------------------------------------------------------- lista de deseos y epitafio

const BUCKET = [
    {"id": "paracaidas", "n": "Saltar en paracaídas", "cost": 3000, "hp": 50, "hap": 15, "soc": "guts", "d": "Diez mil metros de caída libre y un grito que se oyó hasta el suelo."},
    {"id": "aurora", "n": "Ver una aurora boreal", "cost": 8000, "hp": 30, "hap": 12, "soc": "know", "d": "El cielo bailó en verde y morado. Lloraste sin pena."},
    {"id": "memorias", "n": "Escribir tus memorias", "cost": 0, "hp": 0, "hap": 8, "soc": "know", "d": "Trescientas páginas de tu vida. Algunas, muy picantes."},
    {"id": "crucero", "n": "Un crucero por el Caribe", "cost": 6000, "hp": 25, "hap": 12, "soc": "charm", "d": "Bufé infinito, bingo y atardeceres naranjas."},
    {"id": "mar", "n": "Nadar en el mar al amanecer", "cost": 500, "hp": 35, "hap": 8, "soc": "guts", "d": "El agua fría, el sol saliendo y la sensación de estar viv{a}."},
    {"id": "natal", "n": "Volver a tu ciudad natal", "cost": 1500, "hp": 20, "hap": 10, "soc": "kind", "d": "Caminaste por las calles de tu infancia. Todo era más pequeño."},
    {"id": "tatuaje", "n": "Tu primer tatuaje a esta edad", "cost": 300, "hp": 0, "hap": 6, "soc": "guts", "d": "Una golondrina en el brazo. Tus nietos no lo pueden creer."},
    {"id": "piano", "n": "Aprender a tocar el piano", "cost": 1000, "hp": 0, "hap": 6, "soc": "skill", "d": "Ya tocas una canción completa. Sin errores (casi)."},
    {"id": "perdon", "n": "Pedir perdón a quien heriste", "cost": 0, "hp": 0, "hap": 8, "soc": "kind", "d": "Dijiste «lo siento» después de muchos años. Pesaba más de lo que creías."},
    {"id": "cartas", "n": "Escribirle una carta a cada hijo", "cost": 0, "hp": 0, "hap": 8, "soc": "kind", "d": "Cartas para leer cuando ya no estés. Las guardaron como tesoros."},
    {"id": "bailar", "n": "Bailar hasta el amanecer", "cost": 200, "hp": 40, "hap": 8, "soc": "charm", "d": "Te dolió todo al día siguiente. Valió cada paso."},
    {"id": "globo", "n": "Volar en globo aerostático", "cost": 2500, "hp": 30, "hap": 10, "soc": "guts", "d": "El mundo desde arriba, en silencio."}
]

function bucket_def(id: string) {
    for b in BUCKET {
        if b.id == id { return b }
    }
    return BUCKET[0]
}

function epitaph_options() {
    let out = ["Vivió, amó y se equivocó como cualquiera."]
    let best = "know"
    for k in SOCIAL_KEYS {
        if L.social[k] > L.social[best] { best = k }
    }
    let by = {"know": "Nunca dejó de aprender.", "guts": "No le tuvo miedo a nada.", "skill": "Lo que tocaba, lo hacía bien.", "kind": "Dio más de lo que recibió.", "charm": "Nadie olvidó su sonrisa."}
    list_push(out, by[best])
    if L.kids > 0 { list_push(out, "Amó a su familia por encima de todo.") }
    if L.money >= 1000000 { list_push(out, "Se lo quiso llevar todo. No pudo.") }
    if L.partners >= 20 { list_push(out, "Amó mucho. A mucha gente.") }
    list_push(out, "Aquí yace alguien que nunca leyó los términos y condiciones.")
    return list_slice(out, 0, min(5, len(out)))
}

// ---------------------------------------------------------------- menú «Vida» (actividades)

function vditem(id: string, t: string, s: string, desc: string, lock: string) {
    return {"action": "vd:" + id, "t": t, "s": s, "desc": desc, "lock": lock}
}

function vida_items() {
    let d = vd()
    let items = []
    let s = stage_of(L.age)
    list_push(items, {"action": "fin:info:vida", "t": "Etapa: " + s.n, "s": str(L.age) + " años · " + str(s.min) + " a " + if_str(s.max > 150, "...", str(s.max)), "desc": s.d, "lock": ""})
    if d.goal != "" {
        let g = stage_goal_def(d.gstage, d.goal)
        if g != null {
            let st = if_str(goal_met(d.gstage, d.goal), "Vas bien", "Todavía no")
            list_push(items, {"action": "fin:info:vida", "t": "Propósito: " + gfmt(g.n, L.gender), "s": st, "desc": gfmt(g.d, L.gender) + " Se revisa al terminar la etapa.", "lock": ""})
        }
    } else if GOALS[s.id] != null {
        list_push(items, vditem("goal", "Elegir el propósito de tu " + str_lower(s.n), "Meta de etapa", "Un objetivo para esta etapa. Si lo cumples al terminarla, ganas felicidad y un hito.", ""))
    }
    let met = 0
    for x in d.goals {
        if x.ok { met += 1 }
    }
    if len(d.goals) > 0 { list_push(items, vditem("goals", "Propósitos de tus etapas", str(met) + " de " + str(len(d.goals)) + " cumplidos", "Lo que quisiste en cada etapa y si lo lograste.", "")) }
    if d.res != null && d.res.id != "" && d.res.done != true {
        let r = res_def(d.res.id)
        list_push(items, {"action": "fin:info:vida", "t": "Propósito de año nuevo: " + r.n, "s": "Se revisa en diciembre", "desc": r.d, "lock": ""})
    }
    if L.flaw != null && L.flaw != "ninguno" {
        let f = flaw_def(L.flaw)
        let fs = "Pendiente"
        if d.flaw_done { fs = "¡Superado!" }
        list_push(items, {"action": "fin:info:vida", "t": "Defecto: " + gfmt(f.n, L.gender), "s": fs, "desc": gfmt(f.d, L.gender) + " Para superarlo: " + f.goal, "lock": ""})
    }
    if L.talent != null {
        let t = talent_def(L.talent)
        list_push(items, {"action": "fin:info:vida", "t": "Talento: " + gfmt(t.n, L.gender), "s": "Signo: " + map_get(L, "sign", "?"), "desc": gfmt(t.d, L.gender) + " Efecto: " + fx_summary(t.fx) + ".", "lock": ""})
    }
    list_push(items, vditem("history", "Mirar atrás", "Tus estadísticas año a año", "Cómo cambiaron tu felicidad, salud, inteligencia y atractivo con los años.", ""))
    if len(d.decades) > 0 { list_push(items, vditem("decades", "Tus décadas", str(len(d.decades)) + " resumidas", "Un resumen de cada década que viviste.", "")) }
    if L.age >= 60 {
        list_push(items, dninfo("Lista de deseos", str(len(d.bucket)) + " de " + str(len(BUCKET)) + " cumplidos", "Lo que siempre quisiste hacer antes de irte."))
        for b in BUCKET {
            if list_contains(d.bucket, b.id) { continue }
            let lock = ""
            if b.cost > 0 && L.money < b.cost { lock = money_str(b.cost) }
            if L.health < b.hp { lock = "Salud " + str(b.hp) }
            if b.id == "cartas" && L.kids == 0 { lock = "Sin hijos" }
            if L.used["vd_wish"] != null { lock = "Este mes ya" }
            let cs = "Gratis"
            if b.cost > 0 { cs = money_str(b.cost) }
            list_push(items, vditem("wish:" + b.id, b.n, cs + " · felicidad", "Tachar algo de tu lista de deseos.", lock))
        }
    }
    if L.age >= 65 {
        let ep = "Elegir tu epitafio"
        if L.epitaph != null && L.epitaph != "" { ep = "Cambiar tu epitafio" }
        list_push(items, vditem("epitaph", ep, if_str(L.epitaph != null && L.epitaph != "", "«" + map_get(L, "epitaph", "") + "»", "Lo que dirá tu lápida"), "Las últimas palabras que el mundo leerá de ti.", ""))
    }
    return items
}

function res_def(id: string) {
    for r in RESOLUTIONS {
        if r.id == id { return r }
    }
    return RESOLUTIONS[0]
}

function vida_action(action: string) {
    let d = vd()
    let parts = str_split(action, ":")
    let cmd = parts[1]
    let arg = ""
    if len(parts) > 2 { arg = parts[2] }
    if cmd == "goal" {
        G.modal = null
        open_goal_choice()
        return null
    }
    if cmd == "goals" {
        let lines = []
        for x in d.goals { list_push(lines, x.stage + ": " + x.goal + if_str(x.ok, " ✓", " ✗")) }
        return info("Propósitos de tus etapas", str_join(lines, " · "))
    }
    if cmd == "decades" {
        let lines = []
        for x in d.decades { list_push(lines, x.t + ".") }
        return info("Tus décadas", str_join(lines, " "))
    }
    if cmd == "history" { return open_stat("happy") }
    if cmd == "wish" {
        let b = bucket_def(arg)
        if list_contains(d.bucket, b.id) || L.money < b.cost || L.health < b.hp || L.used["vd_wish"] != null { return null }
        L.used["vd_wish"] = 1
        G.modal = null
        L.money -= b.cost
        L.happy += b.hap
        gain(b.soc, 3)
        list_push(d.bucket, b.id)
        let msg = gfmt(b.d, L.gender)
        if b.id == "natal" { msg = "Volviste a " + L.city + ". " + msg }
        if b.id == "perdon" {
            let q = null
            for x in L.people {
                if x.alive && (x.rel == "ex" || x.rel == "rival" || x.bond < 30) { q = x }
            }
            if q != null {
                bond_gain(q, 20)
                msg = "Buscaste a " + q.first + " y le pediste perdón. Se abrazaron como si nada."
            }
            L.karma += 5
        }
        if b.id == "cartas" {
            for k in kids_alive() { bond_gain(k, 8) }
        }
        if b.id == "memorias" { L.memoirs = true }
        if b.id == "bailar" { L.health -= 3 }
        hito_me("Vida", "Lista de deseos: " + str_lower(b.n))
        if len(d.bucket) >= 5 { flag("bucket5") }
        if len(d.bucket) >= len(BUCKET) { hito_once("bucket_all", "Vida", "Cumpliste toda tu lista de deseos") }
        return finish(b.n, msg, "g")
    }
    if cmd == "epitaph" {
        G.modal = null
        let opts = epitaph_options()
        let locks = []
        for x in opts { list_push(locks, "") }
        return open_choice("TU EPITAFIO", "¿Qué dirá tu lápida?", opts, locks, "vd_epitaph", {"opts": opts})
    }
    return null
}

function vida_choice(handler: string, index: int, ctx: map) {
    G.modal = null
    let d = vd()
    if handler == "vd_goal" {
        let s = stage_of(L.age)
        let gs = GOALS[s.id]
        if gs == null || index >= len(gs) { return null }
        d.goal = gs[index].id
        d.gstage = s.id
        return finish("Propósito", "Tu propósito para la " + str_lower(s.n) + ": " + str_lower(gfmt(gs[index].n, L.gender)) + ". " + gfmt(gs[index].d, L.gender), "n")
    }
    if handler == "vd_epitaph" {
        let opts = ctx.opts
        if index >= len(opts) { return null }
        L.epitaph = opts[index]
        return finish("Epitafio", "«" + L.epitaph + "» Así te recordarán.", "n")
    }
    if handler == "vd_res" {
        if index >= len(RESOLUTIONS) { return null }
        let r = RESOLUTIONS[index]
        d.res = {"age": L.age, "id": r.id, "base": {"health": L.health, "money": L.money + L.savings, "know": L.social.know, "karma": L.karma, "kind": L.social.kind}}
        return finish("Año nuevo", "Tu propósito: " + str_lower(r.n) + ". " + r.d, "n")
    }
    if handler == "vd_crisis" {
        if index == 0 {
            L.money -= 30000
            L.happy += 12
            gain("charm", 3)
            return finish("Crisis de los 40", "Un convertible rojo. Te sientes de veinte otra vez... hasta que llega el recibo del seguro.", "g")
        }
        if index == 1 {
            L.health += 8
            gain("guts", 5)
            tfx_add("motivado", 6)
            hito_me("Salud", "Corriste un maratón a los " + str(L.age))
            return finish("Crisis de los 40", "Cuarenta y dos kilómetros. Cruzaste la meta llorando. Te sientes invencible.", "g")
        }
        if index == 2 {
            L.happy += 6
            L.looks += 1
            return finish("Crisis de los 40", pick(["Un dragón en la espalda. Tu mamá casi se desmaya.", "La fecha de nacimiento de tus hijos en el brazo. Tu mamá lloró.", "Una frase en latín que no sabes pronunciar."]), "g")
        }
        if index == 3 {
            gain("know", 5)
            gain("skill", 3)
            tfx_add("motivado", 6)
            return finish("Crisis de los 40", pick(["Clases de cerámica. Tu primer jarrón parece un cenicero, pero es tuyo.", "Aprendiste italiano. Ahora pides la pizza con acento.", "Aprendiste a surfear. Te caíste doscientas veces."]), "g")
        }
        L.happy += 6
        gain("kind", 3)
        tfx_add("paz", 12)
        return finish("Crisis de los 40", "Te miraste otra vez al espejo y te gustó lo que viste. Las canas, las arrugas y todo lo vivido.", "g")
    }
    if handler == "vd_hol" { return holiday_result(index, ctx) }
    if handler == "vd_ev" { return null }
    return null
}

function holiday_result(index: int, ctx: map) {
    let k = ctx.kind
    let p = ctx.person
    if k == "vale" {
        if index == 0 {
            L.money -= 300
            bond_gain(p, 8)
            return finish("San Valentín", "Velas, vino y postre compartido. " + p.first + " no dejó de sonreír.", "x")
        }
        if index == 1 {
            bond_gain(p, 6)
            gain("kind", 1)
            return finish("San Valentín", p.first + " leyó tu carta tres veces y la guardó en su cartera.", "g")
        }
        bond_gain(p, -8)
        return finish("San Valentín", p.first + " te esperó con un regalo. Tú llegaste con las manos vacías. Silencio incómodo.", "b")
    }
    if k == "muertos" {
        if index == 0 {
            L.money -= 200
            L.happy += 5
            fe_add_faith(1)
            return finish("Día de muertos", "La ofrenda quedó preciosa: su comida favorita, su foto y velas. Sentiste que vino de visita.", "g")
        }
        if index == 1 {
            L.happy += 3
            return finish("Día de muertos", "Limpiaste la tumba de " + p.first + ", le dejaste flores y le contaste tus novedades.", "g")
        }
        L.happy -= 2
        return finish("Día de muertos", "Evitaste el tema. Pero esa noche soñaste con " + p.first + ".", "n")
    }
    if k == "navidad_kid" {
        if index == 0 { return finish("Navidad", "Te quedaste dormid" + oa(L.gender) + " en el sillón. Al despertar, los regalos ya estaban ahí. ¡Magia!", "g") }
        if index == 1 {
            L.karma -= 1
            return finish("Navidad", "Los abriste a escondidas... y tuviste que fingir sorpresa al día siguiente. Gran actuación.", "n")
        }
        for q in parents_alive() { bond_gain(q, 3) }
        gain("kind", 1)
        if mx_style_here() { return finish("Navidad", "Batiste el ponche y ayudaste con los tamales. La familia entera te aplaudió.", "g") }
        return finish("Navidad", "Ayudaste en la cocina y te tocó probar todo antes que nadie. La familia entera te aplaudió.", "g")
    }
    if k == "navidad" {
        if index == 0 {
            for q in L.people {
                if q.alive && (rel_group(q) == "parent" || rel_group(q) == "sibling" || rel_group(q) == "child" || rel_group(q) == "partner") { bond_gain(q, 3) }
            }
            L.happy += 5
            return finish("Navidad", pick(["Cena larga, chistes del tío y abrazos a medianoche.", "Alguien quemó el pavo. Igual fue la mejor cena del año.", "Discutieron de política, pero terminaron cantando villancicos."]), "g")
        }
        if index == 1 {
            L.money -= 2000
            L.happy += 8
            tfx_add("vacaciones", 2)
            return finish("Navidad", "Año nuevo en la playa. Uvas bajo la luna y los pies en la arena.", "g")
        }
        if index == 2 {
            let m = max(1000, job_pay(L.job) / 40)
            L.money += m
            L.happy -= 3
            return finish("Navidad", "Trabajaste en Nochebuena. Ganaste " + money_str(m) + ", pero cenaste un sándwich en la oficina.", "n")
        }
        L.money -= 300
        for q in L.people {
            if q.alive && rel_group(q) == "friend" && chance(60) { bond_gain(q, 3) }
        }
        L.happy += 4
        return finish("Navidad", "El intercambio fue un caos: a alguien le tocó un calcetín usado. Todos rieron.", "g")
    }
    if k == "halloween" {
        L.happy += 4
        if index == 0 { return finish("Halloween", "Tu disfraz de zombi asustó hasta al perro del vecino.", "g") }
        if index == 1 {
            gain("charm", 1)
            return finish("Halloween", "Te disfrazaste de aguacate. Ganaste el concurso de disfraces.", "g")
        }
        if index == 2 {
            gain("charm", 2)
            return finish("Halloween", "Todas las miradas de la fiesta fueron tuyas.", "x")
        }
        gain("kind", 1)
        return finish("Halloween", "Repartiste dulces a cuarenta niños. Uno disfrazado de ti. Te halagó.", "g")
    }
    if k == "verano" {
        if index == 0 {
            if L.age >= 14 { L.money -= 500 }
            gain("guts", 3)
            L.happy += 8
            return finish("Verano", "Fogatas, canoas y una amistad para toda la vida.", "g")
        }
        if index == 1 {
            let m = rint(15, 40) * 100
            L.money += m
            gain("skill", 2)
            return finish("Verano", "Trabajaste todo el verano y juntaste " + money_str(m) + ". Tu primer dinero de verdad.", "g")
        }
        if index == 2 {
            L.happy += 6
            return finish("Verano", "Viste tres temporadas completas y dormiste hasta las 2 p. m. Perfección.", "g")
        }
        gain("know", 3)
        L.smarts += 2
        return finish("Verano", "Un curso de verano de programación. Saliste con un videojuego hecho por ti.", "g")
    }
    if k == "madres" {
        if index == 0 {
            L.money -= 800
            bond_gain(p, 12)
            if mx_style_here() { return finish("Día de las madres", "El mariachi cantó «Las mañanitas» a las 7 a. m. " + p.first + " lloró de emoción (los vecinos, de sueño).", "g") }
            return finish("Día de las madres", "Flores, su regalo favorito y un abrazo largo. " + p.first + " lloró de emoción.", "g")
        }
        if index == 1 {
            bond_gain(p, 6)
            return finish("Día de las madres", "Comida en familia. " + p.first + " no paró de presumirte.", "g")
        }
        if index == 2 {
            bond_gain(p, 5)
            return finish("Día de las madres", p.first + " guardó tu tarjeta en la caja de los tesoros.", "g")
        }
        bond_gain(p, -2)
        return finish("Día de las madres", "«Feliz día, ma.» Te contestó con un «gracias» seco.", "n")
    }
    return null
}

// ---------------------------------------------------------------- muerte

function vida_on_death() {
    if L.vd == null { return null }
    close_goal(true)
    if L.age >= 100 { flag("centenarian") }
    let p = partner()
    let words = ["¿Ya se acabó? Qué rápido.", "Apaguen la luz al salir.", "No se peleen por la herencia.", "Fue un buen viaje.", "Díganles que los quise."]
    if L.kids > 0 { list_push(words, "Díganle a mis hijos que estoy orgullos" + oa(L.gender) + ".") }
    if p != null { list_push(words, p.first + ", gracias por todo.") }
    if L.money >= 1000000 { list_push(words, "El dinero... no sirvió de mucho al final.") }
    if L.karma < 30 { list_push(words, "No me arrepiento de nada. Bueno, de casi nada.") }
    if L.happy >= 80 { list_push(words, "Lo volvería a vivir todo.") }
    L.lastwords = pick(words)
    return null
}

function vida_epitaph() {
    if L.epitaph != null && L.epitaph != "" { return L.epitaph }
    return ""
}

// ---------------------------------------------------------------- 3. estadísticas

const STAT_INFO = {
    "happy": {"n": "Felicidad", "up": "Pareja y amigos cercanos, fiestas, hobbies, viajes, logros, mascotas, dormir bien y meditar.", "down": "Rupturas, duelos, deudas, enfermedades, trabajos que odias, vicios y la soledad."},
    "health": {"n": "Salud", "up": "Ejercicio, buena dieta, dormir, el médico a tiempo, vacunas y dejar los vicios.", "down": "Alcohol, drogas, tabaco, desvelos, accidentes, enfermedades y la edad (desde los 50)."},
    "smarts": {"n": "Inteligencia", "up": "Escuela, estudiar, leer, la universidad, juegos de mente y talentos como la memoria.", "down": "Drogas, faltar a clases, desvelos y algunas enfermedades en la vejez."},
    "looks": {"n": "Atractivo", "up": "Gimnasio, dieta, ropa, cuidados, cirugías y la juventud. Los efectos lo suben o lo bajan.", "down": "La edad (desde los 30), vicios, ojeras, enfermedades y el sol sin bloqueador."},
    "know": {"n": "Conocimiento", "up": "Estudiar, leer, la universidad, cursos y trabajos de oficina.", "down": "Casi nada lo baja: lo que aprendes se queda."},
    "guts": {"n": "Valor", "up": "Riesgos, peleas, deportes extremos, defender a alguien y enfrentar tus miedos.", "down": "Huir de los problemas."},
    "skill": {"n": "Destreza", "up": "Trabajar, practicar oficios y hobbies, minijuegos bien hechos.", "down": "Nada: la práctica se acumula."},
    "kind": {"n": "Amabilidad", "up": "Ayudar, voluntariados, cuidar a tu familia y escuchar.", "down": "Ser cruel, mentir y abandonar a los tuyos."},
    "charm": {"n": "Encanto", "up": "Fiestas, citas, redes sociales, hablar en público y la seguridad en ti mism{a}.", "down": "Encerrarte y evitar a la gente."}
}

const SOCIAL_PERKS = {
    "know": ["", "", "Rango 3: estudias mejor (+3 calificaciones).", "", "Rango 5: genio contratable (+5 contratación, +5% sueldo)."],
    "guts": ["", "", "Rango 3: sin miedo (+3 ligue).", "", "Rango 5: temple de acero (+1 felicidad al mes)."],
    "skill": ["", "", "Rango 3: buen oficio (+3% sueldo).", "", "Rango 5: virtuosismo (+8% sueldo)."],
    "kind": ["", "", "Rango 3: corazón grande (tus vínculos te quieren más).", "", "Rango 5: santidad (+1 felicidad, +3 contratación)."],
    "charm": ["", "", "Rango 3: magnetismo (+4 ligue).", "", "Rango 5: irresistible (+10 ligue, +3 contratación)."]
}

function happy_word(v: int) {
    if v >= 90 { return "Radiante" }
    if v >= 70 { return "Feliz" }
    if v >= 50 { return "Tranquil" + oa(L.gender) }
    if v >= 30 { return "Triste" }
    return "Hundid" + oa(L.gender)
}

function stat_word(key: string, v: int) {
    if key == "happy" { return happy_word(v) }
    if key == "health" {
        if v >= 90 { return "Salud de hierro" }
        if v >= 70 { return "Buena salud" }
        if v >= 40 { return "Con achaques" }
        return "Salud delicada"
    }
    if key == "smarts" {
        if v >= 90 { return "Genio" }
        if v >= 70 { return "Brillante" }
        if v >= 40 { return "Promedio" }
        return "Le cuesta"
    }
    if v >= 90 { return "Deslumbrante" }
    if v >= 70 { return "Guapísim" + oa(L.gender) }
    if v >= 40 { return "Normal" }
    return "Poco agraciad" + oa(L.gender)
}

function open_stat(key: string) {
    let d = vd()
    let info_def = STAT_INFO[key]
    if info_def == null { return null }
    G.modal = null
    let vals = []
    let labs = []
    let hs = d.hist
    let start = max(0, len(hs) - 12)
    let i = start
    while i < len(hs) {
        list_push(vals, hs[i][key])
        list_push(labs, str(hs[i].a))
        i += 1
    }
    let social = list_contains(SOCIAL_KEYS, key)
    let v = 0
    let text = ""
    if social {
        v = L.social[key]
        let r = rank(key)
        text = "Rango " + str(r) + ": " + rank_title(key, r) + " (" + str(v) + " puntos)."
        if r < 5 { text = text + " Te faltan " + str(r * 20 - v) + " para " + rank_title(key, r + 1) + "." }
        let perks = []
        for p in SOCIAL_PERKS[key] {
            if p != "" { list_push(perks, p) }
        }
        text = text + " " + str_join(perks, " ")
    } else {
        v = L[key]
        text = str(v) + " · " + stat_word(key, v) + "."
        if key == "looks" && looks_eff() != L.looks { text = text + " Con tus efectos: " + str(looks_eff()) + "." }
    }
    text = text + " Sube con: " + gfmt(info_def.up, L.gender) + " Baja con: " + info_def.down
    if len(vals) < 2 { text = text + " (La gráfica se llena con los años.)" }
    open_choice(str_upper(info_def.n), text, ["Cerrar"], [""], "vd_ev", {})
    G.modal.chart = {"vals": vals, "labs": labs}
    return null
}

// Gráfica de barras (detalle de estadísticas).
function draw_chart(x: int, y: int, w: int, h: int, chart: map) {
    let vals = chart.vals
    let n = len(vals)
    rect(x, y + h, w, 2, C_GRAY)
    if n == 0 { return null }
    let bw = w / max(n, 1)
    let i = 0
    while i < n {
        let v = clamp(vals[i], 0, 100)
        let bh = v * (h - 18) / 100
        let bx = x + i * bw + 4
        rect(bx, y + h - bh, bw - 8, bh, stat_color(v))
        ctext(bx + (bw - 8) / 2, y + h - bh - 4, str(v), 11, C_WHITE, "bold")
        ctext(bx + (bw - 8) / 2, y + h + 16, chart.labs[i], 10, C_GRAY, "bold")
        i += 1
    }
    return null
}

// ---------------------------------------------------------------- 4. efectos temporales

