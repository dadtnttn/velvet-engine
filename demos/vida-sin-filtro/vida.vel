function vida_meets(tag: string) {
    if tag == "sibling" {
        for p in L.people {
            if p.alive && p.rel == "hermano" { return true }
        }
        return false
    }
    return false
}

function vida_special(name: string, ctx: map) {
    if name == "vd_license" {
        hito_once("license", "Vida", "Sacaste tu licencia de manejo")
        return ""
    }
    if name == "vd_jackpot" {
        hito_me("Vida", "Ganaste el premio mayor de la lotería")
        flag("jackpot")
        return ""
    }
    if name == "vd_dog" {
        add_pet("perro", "Suerte")
        hito_once("stray_dog", "Vida", "Adoptaste un perrito callejero")
        return ""
    }
    if name == "vd_kidpet" {
        add_pet("perro", "Firulais")
        return ""
    }
    if name == "vd_friend_away" {
        // Tu amigo más cercano de verdad se va: menos contacto y un hito.
        let best = null
        for q in L.people {
            if q.alive && q.rel == "amigo" && (best == null || q.bond > best.bond) { best = q }
        }
        if best != null {
            best.bond = clamp100(best.bond - 10)
            best.far = true
            add_hito(best, "Se mudó a otro país")
            return " (" + best.first + " ya vive lejos.)"
        }
        return ""
    }
    if name == "vd_hero" {
        hito_me("Vida", "Salvaste a un niño de ahogarse")
        flag("hero")
        L.fame = clamp100(L.fame + 5)
        return ""
    }
    if name == "vd_fame10" {
        L.fame = clamp100(L.fame + 10)
        hito_once("reality", "Vida", "Saliste en un reality show")
        return ""
    }
    if name == "vd_abroad" {
        // Una mudanza de verdad: país lejano, con economía igual o mejor, y tu
        // empresa te conserva el puesto con un 20% más.
        let job = L.job
        let here_c = here_id()
        let gdp = here().gdp
        let opts = []
        for c in COUNTRIES {
            if c.id != here_c && c.gdp >= gdp && dist_km(here_c, c.id) > 2500 && !at_war(c.id) { list_push(opts, c.id) }
        }
        if len(opts) == 0 {
            if L.job != null { L.job.bonus = L.job.bonus + 20 }
            hito_me("Trabajo", "Te fuiste a trabajar al extranjero")
            return ""
        }
        let dest = pick(opts)
        L.job = null
        pais_move(dest, "residente")
        L.job = job
        if L.job != null { L.job.bonus = L.job.bonus + 20 }
        hito_me("Trabajo", "Tu empresa te mandó a trabajar a " + cname(dest))
        return " Destino: " + cname(dest) + "."
    }
    if name == "vd_tribute" {
        hito_me("Vida", "Tu comunidad te hizo un homenaje")
        return ""
    }
    return ""
}

function goals_text() {
    if L.vd == null || len(L.vd.goals) == 0 { return "Ninguno" }
    let met = 0
    for x in L.vd.goals {
        if x.ok { met += 1 }
    }
    return str(met) + " de " + str(len(L.vd.goals)) + " cumplidos"
}
