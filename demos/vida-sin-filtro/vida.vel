// @edition 3
// La base de toda vida, ampliada:
// 1. Creador: talento, defecto (que puedes superar), aficiones, ciudad, familia,
//    hermanos, mes de nacimiento (signo), estatura y destino (cuántos eventos).
// 2. Tiempo: etapas de la vida con un propósito para cada una, propósitos de año
//    nuevo, fiestas del año, crisis de los 40, lista de deseos en la vejez,
//    epitafio, últimas palabras y resumen de cada año y de cada década.
// 3. Estadísticas: historial año a año, detalle de cada barra (qué la sube, qué
//    la baja, gráfica) y ventajas reales por rango social y por estadísticas altas.
// 4. Efectos temporales: duelo, luna de miel, desvelos, resaca, estrés, lesiones,
//    rachas... con meses restantes; soledad y sobriedad.
// 5. Hitos: favoritos, línea del tiempo por etapas, más hitos automáticos.
// 6. Eventos aleatorios nuevos para cada etapa de la vida.
// Acciones "vd:" y "st:"; elecciones "vd_".

// ---------------------------------------------------------------- 1. creador

const TALENTS = [
    {"id": "musica", "n": "Oído musical", "d": "Cantas afinad{a} desde la cuna.", "soc": "skill", "pts": 12, "stat": "happy", "sv": 5, "int": "musica", "fx": {"flirt": 2, "hap": 1}},
    {"id": "deporte", "n": "Atleta nat{a}", "d": "Corres, saltas y no te cansas.", "soc": "guts", "pts": 10, "stat": "health", "sv": 10, "int": "deporte", "fx": {"hp": 1, "looks": 2}},
    {"id": "arte", "n": "Mano de artista", "d": "Dibujas lo que imaginas.", "soc": "skill", "pts": 10, "stat": "smarts", "sv": 4, "int": "arte", "fx": {"pay": 3}},
    {"id": "numeros", "n": "Cabeza para los números", "d": "Las cuentas te salen solas.", "soc": "know", "pts": 10, "stat": "smarts", "sv": 12, "int": "juegos", "fx": {"grades": 4}},
    {"id": "labia", "n": "Pico de oro", "d": "Convences a quien sea de lo que sea.", "soc": "charm", "pts": 14, "stat": "happy", "sv": 3, "int": "fiesta", "fx": {"flirt": 4, "hire": 3}},
    {"id": "belleza", "n": "Belleza natural", "d": "Sales bien hasta en las fotos de la credencial.", "soc": "charm", "pts": 4, "stat": "looks", "sv": 12, "int": "baile", "fx": {"looks": 3}},
    {"id": "memoria", "n": "Memoria de elefante", "d": "No olvidas nada (ni las ofensas).", "soc": "know", "pts": 12, "stat": "smarts", "sv": 5, "int": "lectura", "fx": {"grades": 3, "hire": 2}},
    {"id": "corazon", "n": "Corazón de oro", "d": "Sabes lo que sienten los demás.", "soc": "kind", "pts": 14, "stat": "happy", "sv": 3, "int": "cocina", "fx": {"hap": 1}}
]

