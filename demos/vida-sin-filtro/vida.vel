function tfx_add(id: string, months: int) {
    if L.vd == null || TFX[id] == null { return null }
    let cur = map_get(L.vd.tfx, id, 0)
    L.vd.tfx[id] = max(cur, L.tm + months)
    return null
}

function tfx_has(id: string) {
    return L.vd != null && map_get(L.vd.tfx, id, 0) > L.tm
}

function tfx_tick() {
    let d = vd()
    for id in map_keys(d.tfx) {
        if d.tfx[id] <= L.tm {
            map_remove(d.tfx, id)
            let t = TFX[id]
            if t != null && !t.good { log_add("Se te pasó: " + str_lower(gfmt(t.n, L.gender)) + ".", "g") }
        }
    }
    return null
}

function vida_fx(out: list) {
    if L.vd == null { return null }
    let d = L.vd
    let g = L.gender
    for id in map_keys(d.tfx) {
        let left = d.tfx[id] - L.tm
        let t = TFX[id]
        if left > 0 && t != null {
            list_push(out, fx("t_" + id, gfmt(t.n, g), t.good, gfmt(t.d, g) + " (" + str(left) + " " + plural(left, "mes", "meses") + ")", t.mods))
        }
    }
    if L.talent != null {
        let tl = talent_def(L.talent)
        list_push(out, fx("talento", gfmt(tl.n, g), true, gfmt(tl.d, g), tl.fx))
    }
    if L.flaw != null && L.flaw != "ninguno" && !d.flaw_done {
        let f = flaw_def(L.flaw)
        list_push(out, fx("defecto", gfmt(f.n, g), false, gfmt(f.d, g) + " Para superarlo: " + f.goal, f.fx))
    }
    if L.height == "alta" && L.age >= 16 { list_push(out, fx("alto", "Alt" + oa(g), true, "Sacas una cabeza a todos (y te pegas en los marcos).", {"flirt": 2})) }
    // Rangos sociales
    if rank("know") >= 5 { list_push(out, fx("r_know", "Genialidad", true, "Tu cabeza vale oro.", {"hire": 5, "pay": 5})) } else if rank("know") >= 3 { list_push(out, fx("r_know", "Estudios" + oa(g), true, "Aprendes rápido.", {"grades": 3})) }
    if rank("guts") >= 5 { list_push(out, fx("r_guts", "Temple de acero", true, "Nada te quiebra.", {"hap": 1})) } else if rank("guts") >= 3 { list_push(out, fx("r_guts", "Sin miedo", true, "Te lanzas.", {"flirt": 3})) }
    if rank("skill") >= 5 { list_push(out, fx("r_skill", "Virtuosismo", true, "Lo que tocas sale perfecto.", {"pay": 8})) } else if rank("skill") >= 3 { list_push(out, fx("r_skill", "Buen oficio", true, "Sabes hacer las cosas.", {"pay": 3})) }
    if rank("kind") >= 5 { list_push(out, fx("r_kind", "Santidad", true, "Tu bondad se nota a kilómetros.", {"hap": 1, "hire": 3})) }
    if rank("charm") >= 5 { list_push(out, fx("r_charm", "Irresistible", true, "Entras a un lugar y todos voltean.", {"flirt": 10, "hire": 3})) } else if rank("charm") >= 3 { list_push(out, fx("r_charm", "Magnetismo", true, "La gente quiere estar cerca de ti.", {"flirt": 4})) }
    // Estadísticas altas o bajas
    if L.smarts >= 90 { list_push(out, fx("s_smart", "Mente brillante", true, "Resuelves todo antes que los demás.", {"grades": 5, "hire": 3})) }
    if L.happy >= 90 && L.age >= 5 { list_push(out, fx("s_happy", "Radiante", true, "Tu felicidad es contagiosa.", {"flirt": 4})) }
    if L.happy < 20 && L.age >= 10 { list_push(out, fx("s_sad", "Al límite", false, "Te cuesta levantarte de la cama.", {"flirt": -5, "hire": -5})) }
    if L.looks >= 90 && L.age >= 16 { list_push(out, fx("s_looks", "Belleza deslumbrante", true, "Detienes el tráfico.", {"flirt": 5})) }
    // Soledad y sobriedad
    if L.age >= 25 && partner() == null && !has_close_friend() { list_push(out, fx("soledad", "Soledad", false, "Nadie te pregunta cómo estás.", {"hap": -1})) }
    if d.addict && L.alcohol < 10 && L.drugs < 10 { list_push(out, fx("sobrio", "Sobriedad", true, "Dejaste atrás tu adicción. Cada día cuenta.", {"hap": 1, "hire": 3})) }
    return null
}

function has_close_friend() {
    for p in L.people {
        if p.alive && rel_group(p) == "friend" && p.bond >= 50 { return true }
    }
    return false
}

// Lo que pasa en eventos: "tfx": "id:meses".
function apply_tfx(spec: string) {
    let parts = str_split(spec, ":")
    let m = 3
    if len(parts) > 1 { m = parse_int(parts[1], 3) }
    tfx_add(parts[0], m)
    return null
}

// ---------------------------------------------------------------- 5. hitos

function vida_hito_action(action: string) {
    let i = parse_int(str_replace(action, "hito:", ""), -1)
    if L.hitos == null || i < 0 || i >= len(L.hitos) { return null }
    let h = L.hitos[i]
    h.fav = h.fav != true
    return null
}

function hito_item(i: int, h: map) {
    let fav = h.fav == true
    let t = h.t
    if fav { t = "★ " + t }
    let s = h.c + " · " + str(h.a) + " años"
    let tip = "Toca para marcarlo como favorito."
    if fav { tip = "Es uno de tus favoritos. Toca para quitarlo." }
    return {"action": "hito:" + str(i), "t": t, "s": s, "desc": "A los " + str(h.a) + " años. " + h.t + ". " + tip, "lock": "", "done": fav || h.c == "Amor" || h.c == "Familia"}
}

function hito_list_items(cat: string) {
    let items = []
    if L.hitos == null { return items }
    if cat == "Línea" {
        let si = 0
        while si < len(STAGES) {
            let s = STAGES[si]
            let n = 0
            for h in L.hitos {
                if h.a >= s.min && h.a <= s.max { n += 1 }
            }
            if n > 0 {
                list_push(items, {"action": "hito:none", "t": "— " + str_upper(s.n) + " —", "s": str(s.min) + "-" + if_str(s.max > 150, "...", str(s.max)) + " años · " + str(n) + " " + plural(n, "hito", "hitos"), "desc": s.d, "lock": ""})
                let i = 0
                while i < len(L.hitos) {
                    let h = L.hitos[i]
                    if h.a >= s.min && h.a <= s.max { list_push(items, hito_item(i, h)) }
                    i += 1
                }
            }
            si += 1
        }
        return items
    }
    let i = len(L.hitos) - 1
    while i >= 0 {
        let h = L.hitos[i]
        if cat == "Todos" || h.c == cat || (cat == "Favoritos" && h.fav == true) { list_push(items, hito_item(i, h)) }
        i -= 1
    }
    return items
}

function fav_hitos() {
    let out = []
    if L.hitos == null { return out }
    for h in L.hitos {
        if h.fav == true { list_push(out, h) }
    }
    return out
}

// ---------------------------------------------------------------- 6. eventos

function vida_event_rate() {
    let c = map_get(L, "chaos", "normal")
    if c == "tranquilo" { return 13 }
    if c == "caotico" { return 34 }
    return 22
}

