function career_def(id: string) {
    for c in CAREERS {
        if c.id == id { return c }
    }
    return null
}

function career_job() {
    if L.job == null || L.job.career == null { return null }
    return career_def(L.job.career)
}

function career_rank_name() {
    let c = career_job()
    if c == null { return "" }
    return c.ranks[L.job.level]
}

function career_pay() {
    let c = career_def(L.job.career)
    let base = c.pay[L.job.level] * L.job.bonus / 100
    return base * (50 + L.looks) / 100
}

function start_career(id: string) {
    let c = career_def(id)
    if c == null { return null }
    if L.jail > 0 { return info("Casting", "Desde la cárcel no se puede.") }
    if L.age < 18 { return info("Casting", "Solo para mayores de 18.") }
    if L.looks < c.looks {
        L.happy -= 4
        return finish("Casting", "No pasaste el casting: buscan a alguien con más atractivo (" + str(c.looks) + "%).", "b")
    }
    if L.job != null { L.last_job = L.job.title }
    L.job = {"id": id, "career": id, "title": by_gender(L.gender, c.m, c.f), "salary": 0, "var": 0, "perf": 60, "years": 0, "level": 0, "xp": 0, "bonus": 100}
    L.fame = clamp100(L.fame + 5)
    list_push(G.toasts, {"head": "¡NUEVA CARRERA!", "title": str_upper(c.ranks[0]), "sub": by_gender(L.gender, c.m, c.f), "t0": G.t})
    return finish("Casting", "¡Pasaste el casting! Ahora eres " + str_lower(by_gender(L.gender, c.m, c.f)) + ". " + c.pitch, "x")
}

// Suma experiencia y sube de rango con notificación.
function career_xp(amount: int) {
    let c = career_job()
    if c == null { return null }
    L.job.xp = max(0, L.job.xp + amount)
    while L.job.level < 4 && L.job.xp >= c.xp[L.job.level + 1] {
        L.job.level += 1
        L.fame = clamp100(L.fame + 8)
        L.happy += 6
        list_push(G.toasts, {"head": "¡ASCENSO!", "title": str_upper(c.ranks[L.job.level]), "sub": by_gender(L.gender, c.m, c.f) + " · rango " + str(L.job.level + 1) + " de 5", "t0": G.t})
        log_add("Subiste de rango: ahora eres " + c.ranks[L.job.level] + ".", "x")
    }
    return null
}

function career_items() {
    let items = []
    let c = career_job()
    for a in CAREER_ACTIONS[L.job.career] {
        let lock = ""
        if a.need != null && rank(a.need) < a.rank { lock = SOCIAL_NAMES[a.need] + " " + str(a.rank) }
        list_push(items, {"action": "cact:" + a.id, "t": a.t, "s": a.s, "desc": a.desc, "lock": lock})
    }
    let next = "Rango máximo alcanzado."
    if L.job.level < 4 { next = "Siguiente rango: " + c.ranks[L.job.level + 1] + " (" + str(L.job.xp) + "/" + str(c.xp[L.job.level + 1]) + " exp)." }
    list_push(items, {"action": "act:quit", "t": "Retirarte", "s": c.ranks[L.job.level], "desc": "Colgar los tacones para siempre. " + next, "lock": ""})
    return items
}

function do_career_act(id: string) {
    G.modal = null
    let c = career_job()
    if c == null { return null }
    for a in CAREER_ACTIONS[L.job.career] {
        if a.id != id { continue }
        if a.need != null && rank(a.need) < a.rank {
            return info(a.t, "Necesitas " + SOCIAL_NAMES[a.need] + " rango " + str(a.rank) + ".")
        }
        let key = "c_" + id
        let used = L.used[key]
        if used == null { used = 0 }
        if used >= 3 { return info(a.t, "Ya trabajaste suficiente este año. Descansa.") }
        L.used[key] = used + 1
        let o = pick_outcome(a.o)
        let msg = apply(o, {})
        return finish(a.t, msg, outcome_kind(o))
    }
    return null
}

// Opciones de casting en la Noche +18.
function casting_items() {
    let items = []
    let titles = {"porn": "Casting de cine para adultos", "stripper": "Audición de striptease", "escort": "Unirte a una agencia de escorts", "cam": "Abrir cuenta de contenido +18"}
    for c in CAREERS {
        let lock = ""
        if L.looks < c.looks { lock = "Atractivo " + str(c.looks) }
        if L.job != null && L.job.career == c.id { lock = "Ya es tu carrera" }
        list_push(items, {"action": "career:" + c.id, "t": titles[c.id], "s": "Rango inicial: " + c.ranks[0], "desc": c.pitch + " Rangos: " + str_join(c.ranks, " › ") + ".", "lock": lock})
    }
    return items
}

