function flag(name: string) {
    L.flags[name] = true
}

function has_flag(name: string) {
    return L.flags[name] == true
}

function mission_met(id: string) {
    if id == "grad" { return L.edu >= 3 }
    if id == "wed" { return L.marriages > 0 }
    if id == "family" { return L.kids >= 3 }
    if id == "heart" { return L.partners >= 10 }
    if id == "trio" { return has_flag("trio") }
    if id == "kink" { return has_flag("kink") }
    if id == "career3" { return job_is_adult(L.job) && L.job.level >= 2 }
    if id == "career5" { return job_is_adult(L.job) && L.job.level >= 4 }
    if id == "twojobs" { return L.job2 != null }
    if id == "spec" { return has_flag("spec") }
    if id == "spec18" { return has_flag("spec18") && !job_def(L.job.id).adult }
    if id == "fusion" { return has_flag("fusion") }
    if id == "award" { return has_flag("award") }
    if id == "famous" { return L.fame >= 80 }
    if id == "million" { return L.money >= 1000000 }
    if id == "assets" { return len(L.assets) >= 3 }
    if id == "tokyo" { return has_flag("tokyo") }
    if id == "social5" {
        for k in SOCIAL_KEYS {
            if rank(k) >= 5 { return true }
        }
        return false
    }
    if id == "allsocial" {
        for k in SOCIAL_KEYS {
            if rank(k) < 3 { return false }
        }
        return true
    }
    if id == "confidant" {
        for p in L.people {
            if p.alive && conf_rank(p) >= 10 { return true }
        }
        return false
    }
    if id == "jail" { return L.jail_total > 0 }
    if id == "escape" { return has_flag("escape") }
    if id == "clean" { return L.age >= 40 && L.alcohol == 0 && L.drugs == 0 && L.record == 0 }
    if id == "saint" { return L.karma >= 90 }
    if id == "villain" { return L.karma <= 10 }
    if id == "hundred" { return L.age >= 100 }
    if id == "gigm" { return L.gig_done >= 5 }
    if id == "healthy" {
        let good = 0
        for h in L.habits {
            if habit_def(h).bad { return false }
            good += 1
        }
        return good >= 3
    }
    if id == "grandpa" { return has_rel("nieto") }
    if id == "goodparent" { return L.kids > 0 && L.parent_score >= 75 }
    if id == "dynasty" { return L.gen >= 2 }
    if id == "investor" { return L.mk != null && portfolio_value() >= 100000 }
    if id == "tecnico" {
        for d in L.degrees {
            if degree_def(d).type == "tec" { return true }
        }
        return false
    }
    if id == "medals5" { return L.sc != null && L.sc.medals >= 5 }
    if id == "popular" { return L.sc != null && L.sc.pop >= 90 }
    if id == "mg_master" || id == "reflex_fast" || id == "simon_master" || id == "spell_master" {
        let best = L.mgbest
        if best == null { return false }
        if id == "reflex_fast" { return map_get(best, "reflex", 0) >= 95 }
        if id == "simon_master" { return map_get(best, "simon", 0) >= 100 }
        if id == "spell_master" { return map_get(best, "spell", 0) >= 100 }
        return list_count(map_values(best), fn(v) => v >= 70) >= 12
    }
    if has_flag(id) { return true }
    return false
}

function mission_cat(id: string) {
    let c = MISSION_CATS[id]
    if c == null { return "Vida" }
    return c
}

// Revisa misiones pendientes y entrega recompensas.
function check_missions() {
    if !L.alive && L.age < 100 { return null }
    for m in MISSIONS {
        if list_contains(L.done, m.id) { continue }
        if !mission_met(m.id) { continue }
        list_push(L.done, m.id)
        let r = m.reward
        for key in ["happy", "health", "money"] {
            if map_has(r, key) { L[key] = L[key] + r[key] }
        }
        for key in SOCIAL_KEYS {
            if map_has(r, key) { gain(key, r[key]) }
        }
        clamp_stats()
        list_push(G.toasts, {"head": "¡MISIÓN CUMPLIDA!", "title": str_upper(m.t), "sub": "Recompensa: " + m.r, "t0": G.t})
        log_add("Misión cumplida: " + m.t + ".", "x")
    }
    return null
}

function mission_items(cat: string) {
    let items = []
    for m in MISSIONS {
        if cat != "" && mission_cat(m.id) != cat { continue }
        let done = list_contains(L.done, m.id)
        let s = "Recompensa: " + m.r
        if done { s = "CUMPLIDA" }
        list_push(items, {"action": "mission:" + m.id, "t": m.t, "s": s, "desc": m.d, "lock": "", "done": done})
    }
    return items
}
