const MAX_KINKS = 3

function kink_name(id: string, gender: string) {
    for k in KINKS {
        if k.id == id { return by_gender(gender, k.m, k.f) }
    }
    return id
}

function has_kink(id: string) {
    return L.tags != null && list_contains(L.tags, id)
}

function random_kinks(count: int) {
    let pool = []
    for k in KINKS { list_push(pool, k.id) }
    shuffle(G.rng, pool)
    return list_slice(pool, 0, count)
}

function shared_kinks(p: map) {
    let out = []
    if p.tags == null || L.tags == null { return out }
    for t in p.tags {
        if list_contains(L.tags, t) { list_push(out, t) }
    }
    return out
}

function kinks_text(tags: list, gender: string) {
    let names = []
    for t in tags { list_push(names, kink_name(t, gender)) }
    if len(names) == 0 { return "Nada en especial" }
    return str_join(names, ", ")
}

