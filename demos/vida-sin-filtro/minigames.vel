// Para la primaria: preguntas de su edad.
const QUIZ_KIDS = [
    {"q": "¿Cuánto es 3 + 4?", "a": ["6", "7", "8", "9"], "c": 1},
    {"q": "¿Cuánto es 5 × 2?", "a": ["7", "10", "12", "52"], "c": 1},
    {"q": "¿Cuántas patas tiene una araña?", "a": ["4", "6", "8", "10"], "c": 2},
    {"q": "¿De qué color es el cielo en un día despejado?", "a": ["Verde", "Azul", "Rojo", "Morado"], "c": 1},
    {"q": "¿Qué animal dice «muu»?", "a": ["El perro", "La vaca", "El gato", "El pato"], "c": 1},
    {"q": "¿Cuántos días tiene una semana?", "a": ["5", "6", "7", "10"], "c": 2},
    {"q": "¿Qué figura tiene tres lados?", "a": ["Cuadrado", "Círculo", "Triángulo", "Rectángulo"], "c": 2},
    {"q": "¿En qué planeta vivimos?", "a": ["Marte", "La Tierra", "Júpiter", "La Luna"], "c": 1},
    {"q": "¿Cuánto es 10 − 3?", "a": ["6", "7", "8", "13"], "c": 1},
    {"q": "¿Qué necesitan las plantas para crecer?", "a": ["Agua y luz", "Dulces", "Ruido", "Hielo"], "c": 0},
    {"q": "¿Cuál es el animal más grande del mundo?", "a": ["El elefante", "La ballena azul", "La jirafa", "El león"], "c": 1},
    {"q": "¿Cuántas horas tiene un día?", "a": ["12", "20", "24", "30"], "c": 2},
    {"q": "¿Qué estación viene después del invierno?", "a": ["El otoño", "La primavera", "El verano", "Ninguna"], "c": 1},
    {"q": "¿Cuántos meses tiene un año?", "a": ["10", "11", "12", "13"], "c": 2},
    {"q": "¿Qué se pone primero: el calcetín o el zapato?", "a": ["El zapato", "El calcetín", "Los dos juntos", "Ninguno"], "c": 1},
    {"q": "¿Cuánto es la mitad de 20?", "a": ["5", "10", "15", "40"], "c": 1}
]

const ARROW_KEYS = ["up", "down", "left", "right"]

// ---------------------------------------------------------------- ciclo

function mg_start(kind: string, title: string, purpose: string, ctx: map) {
    let info = MG_INFO[kind]
    G.mg = {
        "type": kind, "title": title, "purpose": purpose, "ctx": ctx,
        "phase": "intro", "round": 0, "rounds": info.rounds, "limit": info.limit,
        "points": 0, "round_t0": G.t, "fb": "", "fb_ok": false, "fb_t0": -10.0, "q": {}
    }
    G.modal = {"kind": "minigame"}
    G.modal_t0 = G.t
    return null
}

function mg_begin() {
    G.mg.phase = "play"
    G.mg.round = 0
    mg_new_round()
}

function mg_new_round() {
    let m = G.mg
    m.round_t0 = G.t
    let k = m.type
    if k == "bar" {
        let d = pick(DRINKS)
        let opts = list_slice(d.ing, 0, 3)
        let pool = []
        for i in ING_POOL {
            if !list_contains(d.ing, i) { list_push(pool, i) }
        }
        shuffle(G.rng, pool)
        for i in list_slice(pool, 0, 3) { list_push(opts, i) }
        shuffle(G.rng, opts)
        m.q = {"drink": d, "opts": opts, "sel": []}
    } else if k == "memory" {
        let pool = list_slice(DISHES, 0, len(DISHES))
        shuffle(G.rng, pool)
        let order = list_slice(pool, 0, 4)
        let opts = list_slice(pool, 0, 8)
        shuffle(G.rng, opts)
        m.q = {"order": order, "opts": opts, "sel": [], "show_until": G.t + 3.0}
        m.round_t0 = G.t + 3.0
    } else if k == "math" {
        let total = rint(3, 190)
        let paid = 20
        for note in [20, 50, 100, 200, 500] {
            if note > total { paid = note; break }
        }
        let change = paid - total
        let opts = [change]
        for delta in [1, 5, 10, -1, -5, 2] {
            let v = change + delta
            if v > 0 && !list_contains(opts, v) && len(opts) < 4 { list_push(opts, v) }
        }
        shuffle(G.rng, opts)
        m.q = {"total": total, "paid": paid, "change": change, "opts": opts}
    } else if k == "timing" {
        m.q = {"zone": rint(18, 82), "width": 12, "speed": 0.9 + m.round * 0.18}
    } else if k == "arrows" {
        let seq = []
        let n = 0
        while n < 3 + m.round {
            list_push(seq, pick(ARROW_KEYS))
            n += 1
        }
        m.q = {"seq": seq, "pos": 0}
    } else if k == "typing" {
        m.q = {"word": pick(mg_words()), "typed": ""}
    } else if k == "news" {
        m.q = {"tokens": news_tokens()}
    } else if k == "spell" {
        let set = pick(mg_spelling())
        let opts = list_slice(set, 0, 4)
        shuffle(G.rng, opts)
        m.q = {"opts": opts, "c": list_index_of(opts, set[0])}
    } else if k == "mental" {
        m.q = mental_question(m.round)
    } else if k == "simon" {
        let seq = []
        while len(seq) < 3 + m.round { list_push(seq, rint(0, 3)) }
        let show = 0.65 * len(seq) + 0.4
        m.q = {"seq": seq, "pos": 0, "start": G.t, "show_until": G.t + show}
        m.round_t0 = G.t + show
    } else if k == "interview" {
        let used = map_get(m, "used", [])
        let q = pick(INTERVIEW)
        let tries = 0
        while list_contains(used, q.q) && tries < 20 {
            q = pick(INTERVIEW)
            tries += 1
        }
        list_push(used, q.q)
        m.used = used
        let answers = list_slice(q.a, 0, len(q.a))
        shuffle(G.rng, answers)
        m.q = {"q": q.q, "a": answers}
    } else if k == "sort" {
        if map_get(m, "theme", null) == null { m.theme = pick(SORT_SETS) }
        m.q = {"item": pick(m.theme.items)}
    } else if k == "reflex" {
        m.q = {"go": G.t + 1.0 + rint(0, 15) / 10.0, "done": false}
    } else if k == "race" {
        let obs = []
        let at = 10
        while at < 96 {
            let kind = "cell"
            if chance(22) { kind = "boost" }
            list_push(obs, {"lane": rint(0, 2), "at": at, "kind": kind, "done": false})
            if chance(20) && kind == "cell" { list_push(obs, {"lane": rint(0, 2), "at": at, "kind": "cell", "done": false}) }
            at += rint(4, 8)
        }
        let rivals = []
        for lane in [0, 1, 2] {
            list_push(rivals, {"lane": lane, "d": 0.0, "v": 5.3 + rint(0, 14) / 10.0})
        }
        m.q = {"lane": 1, "d": 0.0, "last": G.t, "slow": -1.0, "fast": -1.0, "hits": 0, "obs": obs, "rivals": rivals}
    } else {
        let subject = map_get(m.ctx, "subject", "")
        let pool = QUIZ
        if subject != "" && QUIZ_SUBJECTS[subject] != null {
            pool = QUIZ_SUBJECTS[subject]
        } else if L.age < 13 {
            pool = QUIZ_KIDS
        } else if L.age < 18 {
            // Nada de temas de adultos en los exámenes de la secundaria.
            let teen = []
            for qq in QUIZ {
                if qq.adult != true { list_push(teen, qq) }
            }
            pool = teen
        }
        m.q = pick(pool)
    }
}

// Operación de cálculo mental, más difícil en cada ronda.
function mental_question(round: int) {
    let op = pick(["+", "-", "×"])
    let a = rint(4, 20 + round * 12)
    let b = rint(3, 15 + round * 8)
    if op == "×" {
        a = rint(3, 6 + round * 2)
        b = rint(3, 12)
    }
    if op == "-" && b > a {
        let t = a
        a = b
        b = t
    }
    let answer = a + b
    if op == "-" { answer = a - b }
    if op == "×" { answer = a * b }
    let opts = [answer]
    for delta in [1, -1, 10, -10, 2, 5, -2] {
        let v = answer + delta
        if v >= 0 && !list_contains(opts, v) && len(opts) < 4 { list_push(opts, v) }
    }
    shuffle(G.rng, opts)
    return {"text": str(a) + " " + op + " " + str(b), "opts": opts, "c": list_index_of(opts, answer)}
}

// Termina la ronda: suma puntos (0-1) y avanza.
function mg_round_end(value: int) {
    let m = G.mg
    m.points = m.points + value
    m.fb_ok = value >= 60
    m.fb_t0 = G.t
    m.fb = "¡FALLASTE!"
    if value >= 99 { m.fb = "¡PERFECTO!" } else if value >= 60 { m.fb = "¡BIEN!" } else if value > 0 { m.fb = "REGULAR" }
    m.round += 1
    if m.round >= m.rounds {
        m.phase = "done"
        return null
    }
    mg_new_round()
    return null
}

function mg_score() {
    return G.mg.points / G.mg.rounds
}

// Avanza el reloj; se llama cada frame desde app_update.
function mg_tick() {
    let m = G.mg
    if m == null || m.phase != "play" { return null }
    if G.t < m.round_t0 { return null }
    if m.type == "race" { return race_tick() }
    if m.type == "reflex" && G.t - m.q.go > 1.2 { return mg_round_end(0) }
    if m.type == "news" && G.t - m.round_t0 > m.limit { return mg_round_end(news_score()) }
    if G.t - m.round_t0 > m.limit {
        if m.type == "memory" {
            return mg_round_end(mg_memory_value())
        }
        return mg_round_end(0)
    }
    return null
}

function mg_memory_value() {
    let hits = 0
    for s in G.mg.q.sel {
        if list_contains(G.mg.q.order, s) { hits += 1 }
    }
    return hits * 25
}

function mg_timing_pos() {
    let m = G.mg
    let t = (G.t - m.round_t0) * m.q.speed
    let phase = fract(t / 2.0)
    if phase < 0.5 { return phase * 200.0 }
    return (1.0 - phase) * 200.0
}

// ---------------------------------------------------------------- entrada

function mg_pick(i: int) {
    let m = G.mg
    if m == null || m.phase != "play" || G.t < m.round_t0 { return null }
    let k = m.type
    if k == "bar" {
        if i >= len(m.q.opts) { return null }
        let ing = m.q.opts[i]
        if list_contains(m.q.sel, ing) { return null }
        list_push(m.q.sel, ing)
        if len(m.q.sel) == 3 {
            let hits = 0
            for s in m.q.sel {
                if list_contains(m.q.drink.ing, s) { hits += 1 }
            }
            let value = 0
            if hits == 3 { value = 100 } else if hits == 2 { value = 40 }
            return mg_round_end(value)
        }
        return null
    }
    if k == "memory" {
        if i >= len(m.q.opts) { return null }
        let d = m.q.opts[i]
        if list_contains(m.q.sel, d) { return null }
        list_push(m.q.sel, d)
        if len(m.q.sel) == 4 { return mg_round_end(mg_memory_value()) }
        return null
    }
    if k == "math" {
        if i >= len(m.q.opts) { return null }
        let v = 0
        if m.q.opts[i] == m.q.change { v = 100 }
        return mg_round_end(v)
    }
    if k == "quiz" || k == "spell" || k == "mental" {
        if i >= 4 { return null }
        let v = 0
        if i == m.q.c { v = 100 }
        return mg_round_end(v)
    }
    if k == "interview" {
        if i >= len(m.q.a) { return null }
        // Con encanto convences un poco más.
        return mg_round_end(min(100, m.q.a[i][1] + rank("charm") * 2))
    }
    if k == "sort" {
        if i >= 3 { return null }
        let v = 0
        if i == m.q.item[1] { v = 100 }
        return mg_round_end(v)
    }
    if k == "simon" {
        if i >= 4 { return null }
        if m.q.seq[m.q.pos] == i {
            m.q.pos = m.q.pos + 1
            if m.q.pos >= len(m.q.seq) { return mg_round_end(100) }
            return null
        }
        return mg_round_end(m.q.pos * 60 / len(m.q.seq))
    }
    return null
}

// ---------------------------------------------------------------- carrera

function race_tick() {
    let q = G.mg.q
    let dt = clamp(G.t - q.last, 0.0, 0.1)
    q.last = G.t
    let v = 6.4
    if G.t < q.slow { v = 2.4 }
    if G.t < q.fast { v = 10.5 }
    q.d = q.d + v * dt
    for r in q.rivals {
        r.d = r.d + (r.v + sin(G.t * 2.0 + r.lane) * 0.8) * dt
    }
    for o in q.obs {
        if o.done || o.lane != q.lane { continue }
        if abs(o.at - q.d) < 1.3 {
            o.done = true
            if o.kind == "boost" {
                q.fast = G.t + 1.6
            } else {
                q.slow = G.t + 1.2
                q.hits = q.hits + 1
            }
        }
    }
    if q.d >= 100.0 {
        let ahead = 0
        for r in q.rivals {
            if r.d >= 100.0 { ahead += 1 }
        }
        let scores = [100, 70, 45, 25]
        return mg_round_end(clamp(scores[ahead] - q.hits * 4, 0, 100))
    }
    if G.t - G.mg.round_t0 > G.mg.limit {
        let partial = 0
        while partial < 25 && (partial + 1) * 4 <= q.d { partial += 1 }
        return mg_round_end(partial)
    }
    return null
}

function news_score() {
    let keys = 0
    let hits = 0
    let wrong = 0
    for t in G.mg.q.tokens {
        if t.key { keys += 1 }
        if t.sel && t.key { hits += 1 }
        if t.sel && !t.key { wrong += 1 }
    }
    return clamp(hits * 100 / max(1, keys) - wrong * 12, 0, 100)
}

function draw_mg_news(x: int, y: int, w: int) {
    let q = G.mg.q
    rect(x + 40, y + 88, w - 80, 380, rgb(242, 236, 220))
    text(x + 60, y + 118, "EL DIARIO FINANCIERO", 22, C_INK, "impact")
    rect(x + 60, y + 128, w - 120, 3, C_INK)
    let tx = x + 60
    let ty = y + 162
    let maxx = x + w - 60
    let i = 0
    let sel = 0
    while i < len(q.tokens) {
        let t = q.tokens[i]
        let tw = measure(t.w, 18, "bold") + 12
        if tx + tw > maxx {
            tx = x + 60
            ty += 36
        }
        let action = "mg:word:" + str(i)
        if t.sel {
            rect(tx - 2, ty - 21, tw, 28, C_YELLOW)
            sel += 1
        } else if hovered(action) {
            rect(tx - 2, ty - 21, tw, 28, rgb(255, 205, 205))
        }
        text(tx + 4, ty, t.w, 18, C_INK, "bold")
        hot(tx - 2, ty - 21, tw, 28, action)
        tx += tw + 6
        i += 1
    }
    text(x + 60, y + 448, "Marcadas: " + str(sel) + " · Tip: las empresas y sectores casi siempre importan.", 14, C_GRAY_D, "bold")
    menu_word(x + w / 2 - 150, y + 470, 300, 54, "ENTREGAR", "mg:submit", 26)
    return null
}

function mg_lane(delta: int) {
    let m = G.mg
    if m == null || m.phase != "play" || m.type != "race" { return null }
    m.q.lane = clamp(m.q.lane + delta, 0, 2)
    return null
}

function sperm_doc(fill: string, wiggle: float) {
    let w = floor(sin(wiggle) * 6.0)
    let body = "<path d='M30 34 Q" + str(30 + w) + " 50 30 62 Q" + str(30 - w) + " 74 30 88' fill='none' stroke='" + fill + "' stroke-width='4' stroke-linecap='round'/>"
    body = body + "<ellipse cx='30' cy='20' rx='13' ry='17' fill='" + fill + "' stroke='#0d0d0d' stroke-width='3'/>"
    body = body + "<ellipse cx='26' cy='14' rx='4' ry='5' fill='#ffffff' opacity='0.7'/>"
    return svg_doc(60, 92, body)
}

function draw_mg_race(x: int, y: int, w: int) {
    let q = G.mg.q
    let tx = x + 120
    let tw = w - 240
    let top = y + 90
    let bot = y + 470
    let lane_w = tw / 3
    rect(tx, top, tw, bot - top, rgb(58, 10, 16))
    let i = 1
    while i < 3 {
        rect(tx + lane_w * i - 1, top, 2, bot - top, rgb(110, 30, 40))
        i += 1
    }
    let py = bot - 100
    let scale = 13.0
    push({"op": "clip_push", "x": tx, "y": top, "w": tw, "h": bot - top})
    // Meta: el óvulo
    let gy = py - (100.0 - q.d) * scale
    if gy > top - 200 {
        svg(tx + tw / 2 - 110, gy - 190, 220, 220, svg_doc(220, 220, "<circle cx='110' cy='110' r='104' fill='#ffd8e4' opacity='0.35'/><circle cx='110' cy='110' r='84' fill='#ffc2d6' stroke='#0d0d0d' stroke-width='5'/><circle cx='88' cy='86' r='18' fill='#ffffff' opacity='0.6'/>"))
    }
    for o in q.obs {
        if o.done { continue }
        let oy = py - (o.at - q.d) * scale
        if oy < top - 40 || oy > bot + 40 { continue }
        let ox = tx + lane_w * o.lane + lane_w / 2
        if o.kind == "boost" {
            svg(ox - 22, oy - 22, 44, 44, burst_doc(44, 44, 8, HEX_YELLOW, HEX_INK, 3, 2))
        } else {
            svg(ox - 26, oy - 26, 52, 52, svg_doc(52, 52, "<circle cx='26' cy='26' r='22' fill='#f7f7f2' stroke='#0d0d0d' stroke-width='3'/><circle cx='20' cy='22' r='7' fill='#c9c9ff'/><circle cx='32' cy='30' r='5' fill='#c9c9ff'/>"))
        }
    }
    for r in q.rivals {
        let ry = py - (r.d - q.d) * scale
        if ry < top - 90 || ry > bot + 10 { continue }
        let rx = tx + lane_w * r.lane + lane_w / 2 + 34
        svg(rx - 20, ry - 10, 40, 62, sperm_doc("#9a9a9a", G.t * 9.0 + r.lane))
    }
    let fill = HEX_WHITE
    if G.t < q.fast { fill = HEX_YELLOW }
    if G.t < q.slow { fill = "#ff9b9b" }
    svg(tx + lane_w * q.lane + lane_w / 2 - 30, py - 10, 60, 92, sperm_doc(fill, G.t * 12.0))
    push({"op": "clip_pop"})
    // Posición y progreso
    let ahead = 0
    for r in q.rivals {
        if r.d > q.d { ahead += 1 }
    }
    text(x + 40, y + 130, "LUGAR", 14, C_GRAY, "impact")
    otext(x + 40, y + 176, str(ahead + 1) + "º", 40, C_YELLOW, "impact", false)
    text(x + 40, y + 220, str(floor(q.d)) + "%", 18, C_WHITE, "impact")
    text(x + w - 104, y + 130, "CHOQUES", 14, C_GRAY, "impact")
    otext(x + w - 104, y + 176, str(q.hits), 40, C_BAD, "impact", false)
    let la = "mg:lane:l"
    let ra = "mg:lane:r"
    let lf = HEX_WHITE
    let rf = HEX_WHITE
    if hovered(la) { lf = HEX_RED }
    if hovered(ra) { rf = HEX_RED }
    svg(x + 30, y + 360, 70, 70, arrow_doc("left", lf))
    hot(x + 30, y + 360, 70, 70, la)
    svg(x + w - 100, y + 360, 70, 70, arrow_doc("right", rf))
    hot(x + w - 100, y + 360, 70, 70, ra)
    return null
}

function mg_hit() {
    let m = G.mg
    if m == null || m.phase != "play" { return null }
    if m.type == "reflex" { return reflex_hit() }
    if m.type != "timing" { return null }
    let pos = mg_timing_pos() / 2.0
    let dist = abs(pos - m.q.zone)
    let v = 0
    if dist <= m.q.width / 2 {
        v = 100
    } else if dist <= m.q.width {
        v = 60
    } else if dist <= m.q.width * 2 {
        v = 25
    }
    return mg_round_end(v)
}

// Reflejos: 0.25 s o menos vale 100; 0.85 s o más, nada. Adelantarse, nada.
function reflex_hit() {
    let m = G.mg
    if G.t < m.q.go {
        m.fb = "¡MUY PRONTO!"
        return mg_round_end(0)
    }
    let reaction = G.t - m.q.go
    m.last_ms = int(reaction * 1000.0)
    return mg_round_end(clamp(int(100.0 - (reaction - 0.25) * 166.0), 0, 100))
}

function mg_arrow(dir: string) {
    let m = G.mg
    if m == null || m.phase != "play" || m.type != "arrows" { return null }
    if m.q.seq[m.q.pos] == dir {
        m.q.pos = m.q.pos + 1
        if m.q.pos >= len(m.q.seq) { return mg_round_end(100) }
        return null
    }
    return mg_round_end(m.q.pos * 50 / len(m.q.seq))
}

function mg_type(letter: string) {
    let m = G.mg
    if m == null || m.phase != "play" || m.type != "typing" { return null }
    let next = m.q.typed + letter
    if str_starts_with(m.q.word, next) {
        m.q.typed = next
        if next == m.q.word { return mg_round_end(100) }
    } else {
        m.q.typed = ""
        m.fb = "¡ERROR!"
        m.fb_ok = false
        m.fb_t0 = G.t
    }
    return null
}

function mg_keys(input: map) {
    let m = G.mg
    if m.phase == "intro" {
        if list_contains(input.pressed, "Enter") || list_contains(input.pressed, "Space") { mg_begin() }
        return null
    }
    if m.phase == "done" {
        if list_contains(input.pressed, "Enter") || list_contains(input.pressed, "Space") { mg_close() }
        return null
    }
    for key in input.pressed {
        if (m.type == "timing" || m.type == "reflex") && key == "Space" { mg_hit() }
        if key == "ArrowUp" { mg_arrow("up") }
        if key == "ArrowDown" { mg_arrow("down") }
        if key == "ArrowLeft" { mg_arrow("left") }
        if key == "ArrowRight" { mg_arrow("right") }
        if m.type == "race" && (key == "ArrowLeft" || key == "KeyA") { mg_lane(-1) }
        if m.type == "race" && (key == "ArrowRight" || key == "KeyD") { mg_lane(1) }
        if str_starts_with(key, "Digit") {
            let i = 0
            while i < 9 {
                if key == "Digit" + str(i + 1) { mg_pick(i) }
                i += 1
            }
        }
        if m.type == "typing" && str_starts_with(key, "Key") && len(key) == 4 {
            mg_type(str_replace(key, "Key", ""))
        }
        if G.mg == null || G.mg.phase != "play" { return null }
    }
    return null
}

function mg_action(action: string) {
    if G.mg == null { return null }
    if action == "mg:start" { return mg_begin() }
    if action == "mg:done" { return mg_close() }
    if action == "mg:hit" { return mg_hit() }
    if str_starts_with(action, "mg:arrow:") { return mg_arrow(str_replace(action, "mg:arrow:", "")) }
    if action == "mg:lane:l" { return mg_lane(-1) }
    if str_starts_with(action, "mg:word:") {
        if G.mg.type == "news" && G.mg.phase == "play" {
            let i = action_num(action, "mg:word:", 120)
            let t = G.mg.q.tokens[i]
            t.sel = !t.sel
        }
        return null
    }
    if action == "mg:submit" {
        if G.mg.type == "news" && G.mg.phase == "play" { return mg_round_end(news_score()) }
        return null
    }
    if action == "mg:lane:r" { return mg_lane(1) }
    if str_starts_with(action, "mg:pick:") { return mg_pick(action_num(action, "mg:pick:", 10)) }
    if action == "mg:quit" {
        // Con el resultado ya en pantalla, Esc cobra el puntaje igual que CONTINUAR.
        if G.mg.phase == "done" { return mg_close() }
        G.mg.points = 0
        G.mg.phase = "done"
    }
    return null
}

// Cierra el minijuego y entrega el puntaje a quien lo pidió.
function mg_close() {
    let m = G.mg
    let score = mg_score()
    G.mg = null
    G.modal = null
    if score >= 100 { flag("mg100") }
    let best = map_get(L, "mgbest", null)
    if best == null {
        best = {}
        L.mgbest = best
    }
    if m.points > 0 || score > 0 { best[m.type] = max(map_get(best, m.type, 0), score) }
    if m.purpose == "escuela" { return school_mg_result(score, m.ctx) }
    if m.purpose == "oficio" { return work_mg_result(score, m.ctx) }
    if m.purpose == "practice" { return practice_result(score) }
    if m.purpose == "rel" { return rel_mg_result(score, m.ctx) }
    if m.purpose == "news" { return news_result(score) }
    if m.purpose == "route" { return route_mg_result(score, m.ctx) }
    if m.purpose == "velo" { return velo_mg_result(score, m.ctx) }
    if m.purpose == "apps" { return apps_mg_result(score, m.ctx) }
    if m.purpose == "phone" { return phone_mg_result(score, m.ctx) }
    if m.purpose == "lazos" { return lazos_mg_result(score, m.ctx) }
    if m.purpose == "ocio" { return ocio_mg_result(score, m.ctx) }
    if m.purpose == "prision" { return prison_mg_result(score, m.ctx) }
    if m.purpose == "taxes" { return taxes_result(score, m.ctx) }
    if m.purpose == "sweet" { return sweet_mg_result(score, m.ctx) }
    if m.purpose == "conceive" { return conceive_result(score, m.ctx) }
    if m.purpose == "certify" { return certify_result(score) }
    if m.purpose == "gig" { return gig_shift_result(score) }
    if m.purpose == "audition" { return audition_result(score, m.ctx) }
    if m.purpose == "exam" { return exam_result(score, m.ctx) }
    return null
}

function mg_rating(score: int) {
    if score >= 95 { return "¡PERFECTO!" }
    if score >= 75 { return "¡EXCELENTE!" }
    if score >= 50 { return "BIEN" }
    if score >= 25 { return "REGULAR" }
    return "DESASTRE"
}

// ---------------------------------------------------------------- dibujo

function draw_minigame() {
    let m = G.mg
    if m == null { return null }
    arect(0, 0, W, H, rgba(0, 0, 0, 200))
    push({"op": "alpha_rect", "x": 0, "y": 0, "w": W, "h": H, "color": 0, "action": "noop"})
    svg(-120, 0, 700, 720, slant_doc(640, 720, 200, HEX_RED, "", 0, HEX_INK, 60))
    svg(24, 4, 760, 136, tilt_title_doc(MG_INFO[m.type].title, 760, 136, 72, HEX_WHITE, HEX_INK))
    let x = 160
    let y = 150
    let w = 960
    let h = 500
    svg(x, y, w + 12, h + 12, slant_doc(w, h, 24, HEX_INK, HEX_WHITE, 4, HEX_RED, 12))
    textw(x + 50, y + 44, str_upper(m.title), 22, C_YELLOW, "impact", 520)

    if m.phase == "intro" {
        let ty = y + 110
        for line in wrap_px(MG_INFO[m.type].help, 820, 20) {
            text(x + 60, ty, line, 20, C_WHITE, "bold")
            ty += 32
        }
        text(x + 60, ty + 20, str(m.rounds) + " rondas · " + str(floor(m.limit)) + " segundos por ronda", 16, C_GRAY, "bold")
        menu_word(x + 300, y + h - 120, 360, 70, "¡EMPEZAR!", "mg:start", 36)
        return null
    }
    if m.phase == "done" {
        let score = mg_score()
        otext(x + w / 2, y + 190, str(score), 120, C_YELLOW, "impact", true)
        otext(x + w / 2, y + 250, "PUNTOS · " + mg_rating(score), 34, C_WHITE, "impact", true)
        menu_word(x + 300, y + h - 120, 360, 70, "CONTINUAR", "mg:done", 34)
        return null
    }

    // Barra de tiempo y ronda
    let remaining = clamp(1.0 - (G.t - m.round_t0) / m.limit, 0.0, 1.0)
    if G.t < m.round_t0 { remaining = 1.0 }
    text(x + w - 230, y + 44, "RONDA " + str(m.round + 1) + "/" + str(m.rounds), 20, C_WHITE, "impact")
    rect(x + 50, y + 62, w - 120, 10, C_GRAY_D)
    let bar_col = C_WHITE
    if remaining < 0.3 { bar_col = C_RED }
    rect(x + 50, y + 62, floor((w - 120) * remaining), 10, bar_col)

    let k = m.type
    if k == "bar" { draw_mg_bar(x, y, w) }
    if k == "memory" { draw_mg_memory(x, y, w) }
    if k == "math" { draw_mg_math(x, y, w) }
    if k == "timing" { draw_mg_timing(x, y, w) }
    if k == "arrows" { draw_mg_arrows(x, y, w) }
    if k == "typing" { draw_mg_typing(x, y, w) }
    if k == "quiz" { draw_mg_quiz(x, y, w) }
    if k == "race" { draw_mg_race(x, y, w) }
    if k == "news" { draw_mg_news(x, y, w) }
    if k == "spell" { draw_mg_spell(x, y, w) }
    if k == "mental" { draw_mg_mental(x, y, w) }
    if k == "simon" { draw_mg_simon(x, y, w) }
    if k == "interview" { draw_mg_interview(x, y, w) }
    if k == "sort" { draw_mg_sort(x, y, w) }
    if k == "reflex" { draw_mg_reflex(x, y, w) }

    if G.t - m.fb_t0 < 0.7 {
        let col = C_RED
        if m.fb_ok { col = C_YELLOW }
        otext(x + w - 140, y + h - 40, m.fb, 34, col, "impact", true)
    }
    small_button(x + w - 180, y + h + 26, 150, 38, "RENDIRSE", "mg:quit")
    return null
}

function mg_option(x: int, y: int, w: int, i: int, label: string, selected: bool) {
    let action = "mg:pick:" + str(i)
    let fill = "#262626"
    let color = C_WHITE
    if selected {
        fill = HEX_WHITE
        color = C_INK
    } else if hovered(action) {
        fill = HEX_RED
    }
    svg(x, y, w + 4, 52, slant_doc(w, 48, 12, fill, HEX_WHITE, 2, HEX_INK, 4))
    svg(x + 16, y + 10, 28, 28, slant_doc(28, 28, 6, HEX_YELLOW, "", 0, "", 0))
    ctext(x + 30, y + 31, str(i + 1), 17, C_INK, "impact")
    textw(x + 56, y + 32, label, 18, color, "bold", w - 70)
    hot(x, y, w, 48, action)
}

function draw_mg_bar(x: int, y: int, w: int) {
    let q = G.mg.q
    text(x + 60, y + 130, "PIDEN:", 18, C_GRAY, "impact")
    otext(x + 60, y + 190, str_upper(q.drink.n), 52, C_WHITE, "impact", false)
    text(x + 60, y + 224, "Elegidos: " + str(len(q.sel)) + "/3", 16, C_YELLOW, "bold")
    let i = 0
    while i < len(q.opts) {
        mg_option(x + 60 + (i % 3) * 290, y + 270 + (i / 3) * 70, 270, i, q.opts[i], list_contains(q.sel, q.opts[i]))
        i += 1
    }
}

function draw_mg_memory(x: int, y: int, w: int) {
    let q = G.mg.q
    if G.t < q.show_until {
        text(x + 60, y + 130, "MEMORIZA EL PEDIDO", 20, C_YELLOW, "impact")
        let i = 0
        while i < 4 {
            svg(x + 60 + i * 215, y + 180, 204, 90, slant_doc(200, 86, 14, HEX_WHITE, HEX_INK, 3, HEX_RED, 4))
            ctext(x + 160 + i * 215, y + 236, q.order[i], 24, C_INK, "impact")
            i += 1
        }
        let left = q.show_until - G.t
        text(x + 60, y + 330, "Desaparece en " + str(floor(left) + 1) + "...", 18, C_WHITE, "bold")
        return null
    }
    text(x + 60, y + 130, "¿QUÉ PIDIERON? (" + str(len(q.sel)) + "/4)", 20, C_YELLOW, "impact")
    let i = 0
    while i < len(q.opts) {
        mg_option(x + 60 + (i % 4) * 215, y + 170 + (i / 4) * 70, 200, i, q.opts[i], list_contains(q.sel, q.opts[i]))
        i += 1
    }
    return null
}

function draw_mg_math(x: int, y: int, w: int) {
    let q = G.mg.q
    text(x + 60, y + 140, "TOTAL A PAGAR", 18, C_GRAY, "impact")
    otext(x + 60, y + 200, money_str(q.total), 56, C_WHITE, "impact", false)
    text(x + 460, y + 140, "EL CLIENTE PAGÓ CON", 18, C_GRAY, "impact")
    otext(x + 460, y + 200, money_str(q.paid), 56, C_YELLOW, "impact", false)
    text(x + 60, y + 250, "¿Cuánto cambio devuelves?", 18, C_WHITE, "bold")
    let i = 0
    while i < len(q.opts) {
        mg_option(x + 60 + (i % 2) * 430, y + 290 + (i / 2) * 70, 400, i, money_str(q.opts[i]), false)
        i += 1
    }
}

function draw_mg_timing(x: int, y: int, w: int) {
    let q = G.mg.q
    let bx = x + 80
    let bw = w - 160
    let by = y + 220
    rect(bx, by, bw, 50, C_GRAY_D)
    let zx = bx + bw * (q.zone - q.width) / 100
    rect(zx, by, bw * q.width * 2 / 100, 50, C_YELLOW)
    rect(bx + bw * (q.zone - q.width / 2) / 100, by, bw * q.width / 100, 50, rgb(80, 220, 120))
    let pos = mg_timing_pos() / 2.0
    let cx = bx + bw * pos / 100.0
    rect(cx - 4, by - 18, 8, 86, C_WHITE)
    svg(cx - 14, by - 46, 28, 28, arrow_doc("down", HEX_RED))
    text(x + 80, y + 330, "ESPACIO cuando el marcador esté en verde", 18, C_WHITE, "bold")
    menu_word(x + 320, y + 370, 320, 64, "¡AHORA!", "mg:hit", 30)
}

function draw_mg_arrows(x: int, y: int, w: int) {
    let q = G.mg.q
    text(x + 60, y + 130, "REPITE LA SECUENCIA", 20, C_YELLOW, "impact")
    let i = 0
    while i < len(q.seq) {
        let fill = HEX_WHITE
        if i < q.pos { fill = HEX_YELLOW }
        svg(x + 60 + i * 110, y + 160, 96, 96, slant_doc(92, 92, 10, "#262626", HEX_WHITE, 2, HEX_RED, 4))
        svg(x + 78 + i * 110, y + 178, 56, 56, arrow_doc(q.seq[i], fill))
        i += 1
    }
    let dirs = ["left", "up", "down", "right"]
    let j = 0
    while j < 4 {
        let action = "mg:arrow:" + dirs[j]
        let fill = HEX_WHITE
        if hovered(action) { fill = HEX_RED }
        svg(x + 260 + j * 110, y + 320, 90, 90, slant_doc(86, 86, 10, HEX_INK, HEX_WHITE, 2, HEX_RED, 4))
        svg(x + 276 + j * 110, y + 336, 56, 56, arrow_doc(dirs[j], fill))
        hot(x + 260 + j * 110, y + 320, 86, 86, action)
        j += 1
    }
}

function draw_mg_typing(x: int, y: int, w: int) {
    let q = G.mg.q
    text(x + 60, y + 130, "ESCRIBE:", 20, C_YELLOW, "impact")
    otext(x + w / 2, y + 240, q.word, 80, C_WHITE, "impact", true)
    let shown = q.typed
    if shown == "" { shown = "_" }
    otext(x + w / 2, y + 340, shown, 56, C_YELLOW, "impact", true)
}

function draw_mg_quiz(x: int, y: int, w: int) {
    let q = G.mg.q
    let ty = y + 140
    for line in wrap_px(q.q, 820, 26) {
        otext(x + 60, ty, line, 26, C_WHITE, "impact", false)
        ty += 36
    }
    let i = 0
    while i < 4 {
        mg_option(x + 60 + (i % 2) * 430, y + 260 + (i / 2) * 70, 400, i, q.a[i], false)
        i += 1
    }
}

function draw_mg_spell(x: int, y: int, w: int) {
