    otext(x + 60, y + 150, "¿CUÁL ESTÁ BIEN ESCRITA?", 30, C_WHITE, "impact", false)
    let i = 0
    while i < 4 {
        mg_option(x + 60 + (i % 2) * 430, y + 220 + (i / 2) * 70, 400, i, q.opts[i], false)
        i += 1
    }
}

function draw_mg_mental(x: int, y: int, w: int) {
    let q = G.mg.q
    text(x + 60, y + 130, "RESUELVE", 18, C_GRAY, "impact")
    otext(x + w / 2, y + 220, q.text + " = ?", 72, C_YELLOW, "impact", true)
    let i = 0
    while i < 4 {
        mg_option(x + 60 + (i % 2) * 430, y + 280 + (i / 2) * 70, 400, i, str(q.opts[i]), false)
        i += 1
    }
}

function draw_mg_simon(x: int, y: int, w: int) {
    let q = G.mg.q
    let showing = G.t < q.show_until
    let lit = -1
    if showing {
        let slot = int((G.t - q.start) / 0.65)
        let within = (G.t - q.start) - slot * 0.65
        if slot < len(q.seq) && within < 0.45 { lit = q.seq[slot] }
        text(x + 60, y + 130, "MIRA LA SECUENCIA...", 20, C_YELLOW, "impact")
    } else {
        text(x + 60, y + 130, "REPÍTELA (" + str(q.pos) + "/" + str(len(q.seq)) + ")", 20, C_YELLOW, "impact")
    }
    let i = 0
    while i < 4 {
        let px = x + 70 + i * 215
        let pad = SIMON_PADS[i]
        let action = "mg:pick:" + str(i)
        let fill = "#262626"
        if lit == i { fill = pad[1] }
        if !showing && hovered(action) { fill = pad[1] }
        svg(px, y + 170, 200, 200, slant_doc(196, 196, 18, fill, pad[1], 6, HEX_INK, 6))
        ctext(px + 98, y + 290, pad[0], 22, C_WHITE, "impact")
        ctext(px + 98, y + 320, str(i + 1), 18, C_GRAY, "bold")
        if !showing { hot(px, y + 170, 196, 196, action) }
        i += 1
    }
}

function draw_mg_interview(x: int, y: int, w: int) {
    let q = G.mg.q
    text(x + 60, y + 128, "TE PREGUNTAN:", 18, C_GRAY, "impact")
    otextw(x + 60, y + 172, "«" + q.q + "»", 28, C_WHITE, "impact", false, w - 120)
    let i = 0
    while i < len(q.a) {
        mg_option(x + 60, y + 200 + i * 62, w - 120, i, q.a[i][0], false)
        i += 1
    }
}

function draw_mg_sort(x: int, y: int, w: int) {
    let m = G.mg
    text(x + 60, y + 130, str_upper(m.theme.t) + " · ¿A DÓNDE VA?", 20, C_YELLOW, "impact")
    otext(x + w / 2, y + 230, str_upper(m.q.item[0]), 64, C_WHITE, "impact", true)
    let i = 0
    while i < 3 {
        mg_option(x + 60 + i * 290, y + 300, 270, i, m.theme.bins[i], false)
        i += 1
    }
}

function draw_mg_reflex(x: int, y: int, w: int) {
    let q = G.mg.q
    let go = G.t >= q.go
    let fill = "#7a0d12"
    let caption = "ESPERA..."
    if go {
        fill = "#1f9a45"
        caption = "¡YA!"
    }
    svg(x + w / 2 - 160, y + 120, 320, 220, burst_doc(320, 220, 14, fill, HEX_WHITE, 5, 3))
    otext(x + w / 2, y + 250, caption, 56, C_WHITE, "impact", true)
    let last = map_get(G.mg, "last_ms", 0)
    if last > 0 { ctext(x + w / 2, y + 380, "Último: " + str(last) + " ms", 18, C_GRAY, "bold") }
    menu_word(x + 320, y + 400, 320, 64, "¡AHORA!", "mg:hit", 30)
}

// Palabras del minijuego de tecleo en el idioma del jugador (solo letras A-Z,
// que son las que se teclean); si no hay, las de siempre.
function mg_words() {
    let g = I18N_GAME[CFG.lang]
    if g != null && g.typing != null {
        let out = []
        for w in g.typing {
            let ok = len(w) > 0
            for ch in str_chars(w) {
                if !str_contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) { ok = false }
            }
            if ok { list_push(out, w) }
        }
        if len(out) >= 5 { return out }
    }
    return WORDS
}

// Grupos de ortografía (la buena primero) en el idioma del jugador.
function mg_spelling() {
    let g = I18N_GAME[CFG.lang]
    if g != null && g.spelling != null && len(g.spelling) >= 5 { return g.spelling }
    return SPELLING
}
