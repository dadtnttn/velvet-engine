    "news": {"title": "EL PERIÓDICO", "help": "Marca las palabras clave de las noticias de negocios: empresas, sectores y señales (auge, crisis, quiebra, récord...). No marques las noticias que no importan. Luego entrega.", "rounds": 1, "limit": 35.0},
    "race": {"title": "LA GRAN CARRERA", "help": "Guía a tu campeón hasta el óvulo antes que los demás. Cambia de carril con ← → (o A/D, o los botones). Esquiva los glóbulos blancos (te frenan) y toma los turbos amarillos.", "rounds": 1, "limit": 24.0},
    "spell": {"title": "ORTOGRAFÍA", "help": "Elige la palabra que está bien escrita. Cuidado con los acentos. Teclas 1-4 o clic.", "rounds": 6, "limit": 6.0},
    "mental": {"title": "CÁLCULO MENTAL", "help": "Resuelve la operación antes de que se acabe el tiempo. Teclas 1-4 o clic.", "rounds": 6, "limit": 6.0},
    "simon": {"title": "SECUENCIA", "help": "Mira el orden en que se iluminan los colores y repítelo. Cada ronda es más larga. Teclas 1-4 o clic.", "rounds": 4, "limit": 9.0},
    "interview": {"title": "ENTREVISTA", "help": "Te hacen preguntas difíciles. Elige la respuesta más convincente: no hay respuestas perfectas, pero sí algunas muy malas. Teclas 1-4 o clic.", "rounds": 4, "limit": 14.0},
    "sort": {"title": "CLASIFICAR", "help": "¿A qué grupo va cada cosa? Decide rápido. Teclas 1-3 o clic.", "rounds": 8, "limit": 3.5},
    "reflex": {"title": "REFLEJOS", "help": "Espera la luz verde y presiona ESPACIO (o el botón) lo más rápido que puedas. Si te adelantas, pierdes la ronda.", "rounds": 5, "limit": 4.6}
}

