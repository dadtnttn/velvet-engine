// @edition 3
// Minijuegos: bartender, memoria, cambio de caja, precisión, flechas, mecanografía,
// examen (general o por materia), periódico, la gran carrera, ortografía, cálculo
// mental, secuencia de colores, entrevista, clasificar y reflejos.
// Cada minijuego da un puntaje de 0 a 100 que usan los trabajos, audiciones y
// exámenes; el mejor puntaje de cada uno queda en L.mgbest.

const MG_INFO = {
    "bar": {"title": "BARTENDER", "help": "Prepara cada trago: elige sus 3 ingredientes antes de que se acabe el tiempo. Teclas 1-6 o clic.", "rounds": 5, "limit": 9.0},
    "memory": {"title": "MEMORIA", "help": "Memoriza el pedido. Cuando desaparezca, elige los 4 platillos correctos. Teclas 1-8 o clic.", "rounds": 3, "limit": 10.0},
