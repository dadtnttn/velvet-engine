const INTERVIEW = [
    {"q": "¿Por qué quieres trabajar aquí?", "a": [["Admiro lo que hacen y sé que puedo aportar desde el primer día.", 100], ["Necesito el dinero, la verdad.", 35], ["Me queda cerca de casa.", 15], ["Mi mamá me obligó a venir.", 0]]},
    {"q": "¿Cuál es tu mayor defecto?", "a": [["A veces me cuesta delegar, pero estoy aprendiendo a confiar en el equipo.", 100], ["Soy demasiado perfeccionista.", 50], ["No tengo defectos.", 10], ["Llego tarde casi siempre.", 0]]},
    {"q": "¿Dónde te ves en cinco años?", "a": [["Liderando proyectos aquí y creciendo con la empresa.", 100], ["Con mi propio negocio, probablemente.", 40], ["No sé, en la playa.", 10], ["En tu silla.", 25]]},
    {"q": "Cuéntame de un conflicto con un compañero.", "a": [["Hablamos en privado, escuché su punto y llegamos a un acuerdo.", 100], ["Le pedí al jefe que lo resolviera.", 45], ["Nunca tengo conflictos.", 20], ["Le dejé de hablar para siempre.", 0]]},
    {"q": "¿Cuánto esperas ganar?", "a": [["Investigué el rango del puesto; busco algo justo según mi experiencia.", 100], ["Lo que ustedes digan está bien.", 40], ["El doble de lo que ofrecen.", 15], ["¿Aquí pagan?", 0]]},
    {"q": "¿Por qué dejaste tu último trabajo?", "a": [["Buscaba un reto mayor y aprender cosas nuevas.", 100], ["Me aburría.", 30], ["Mi jefe era un idiota.", 0], ["Me corrieron, pero no fue mi culpa.", 15]]},
    {"q": "¿Qué sabes de nosotros?", "a": [["Leí sobre su último proyecto y me encantó cómo lo resolvieron.", 100], ["Lo que dice su página.", 45], ["Que pagan bien, espero.", 15], ["Nada, vine por curiosidad.", 0]]},
    {"q": "¿Trabajas mejor solo o en equipo?", "a": [["Disfruto ambas cosas: depende de lo que necesite el proyecto.", 100], ["En equipo, siempre.", 60], ["Solo. La gente me estorba.", 10], ["Como me dejen dormir.", 0]]},
    {"q": "Si tu jefe se equivoca, ¿qué haces?", "a": [["Se lo comento en privado, con datos y respeto.", 100], ["Me quedo callado: él sabrá.", 35], ["Se lo digo frente a todos.", 10], ["Lo publico en redes.", 0]]},
    {"q": "¿Cómo manejas la presión?", "a": [["Priorizo, hago una lista y voy resolviendo lo urgente primero.", 100], ["Trabajo mejor bajo presión.", 55], ["Lloro un poco y sigo.", 25], ["Renuncio.", 0]]},
    {"q": "¿Qué te hace diferente a los demás candidatos?", "a": [["Combino experiencia práctica con muchas ganas de aprender.", 100], ["Soy muy buena onda.", 35], ["Que yo sí vine bañado.", 15], ["Nada, la verdad.", 0]]},
    {"q": "¿Tienes alguna pregunta para nosotros?", "a": [["¿Cómo se ve el éxito en este puesto durante el primer año?", 100], ["¿Cuántas vacaciones tengo?", 40], ["¿Puedo traer a mi perro?", 20], ["No, ya me quiero ir.", 0]]}
]

