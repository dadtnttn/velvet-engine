// @edition 3
// Simulación de una vida: estado, envejecimiento, efectos y muerte.

state {
    L: map = {},
    G: map = {
        "mode": "title",
        "modal": null,
        "cfg_on": false,
        "cfg_t0": 0.0,
        "i18n_g": "",
        "redraw": false,
        "bgm": "",
        "logc": null,
        "scroll": 0,
        "dirty": true,
        "frames": 0,
        "lives": 0,
        "rng": null,
        "cache": [],
        "quit": false,
        "t": 0.0,
        "hover": "",
        "hot": [],
        "pointer": null,
        "floats": [],
        "toasts": [],
        "cre": {},
        "menu_cat": 0,
        "menu_page": 0,
        "react": null,
        "last_kind": "",
        "anim_tick": 0,
        "title_look": {},
        "title_gender": "f",
        "blink": 0,
        "px": -1.0,
        "py": -1.0,
        "modal_t0": 0.0,
        "menu_t0": 0.0,
        "cut_t0": -10.0,
        "screen_t0": 0.0,
        "mg": null,
        "dlg": null,
        "dlg_tree": "",
        "pending_deg": "",
        "pending_tier": "",
        "tuition_no": "",
        "legacy": null,
        "roul": null,
        "sex_mode": "",
        "ph_on": false,
        "ph_app": "",
        "ph_msg": "",
        "ph_msg_t0": -10.0,
        "ph_card_t0": -10.0,
        "back_pid": 0,
        "chat": null,
        "bj": null,
        "vp": null,
        // Eventos para el host (guardado, tareas) que salen en el próximo frame.
        "out": [],
        // Avance de varios años en curso (tarea del runtime).
        "skip": null
    }
}

// ---------------------------------------------------------------- azar

function ensure_rng() {
    if G.rng == null {
        G.rng = rng_new(G.frames * 7919 + 104729)
    }
}

function rint(a: int, b: int) {
    if b <= a { return a }
    return rng_range_int(G.rng, a, b + 1)
}

function chance(p: int) {
    return rng_range_int(G.rng, 0, 100) < p
}

function pick(items: list) {
    return choose(G.rng, items)
}

function clamp100(v: int) {
    return clamp(v, 0, 100)
}

// ---------------------------------------------------------------- texto

function oa(g: string) {
    if g == "f" { return "a" }
    return "o"
}

function by_gender(g: string, m: string, f: string) {
    if g == "f" { return f }
    return m
}

function full_name(p: map) {
    return p.first + " " + p.last
}

// Precio base del juego ajustado al costo de vida del país, redondeado a una
// cifra «de etiqueta» ($1,100 y no $1,096).
function local_price(n: int) {
    let v = n * pais_cost_mult() / 100
    let a = abs(v)
    let step = 1
    if a >= 10000 { step = 500 } else if a >= 1000 { step = 50 } else if a >= 100 { step = 10 }
    let r = (a + step / 2) / step * step
    if r == 0 && a > 0 { r = a }
    if v < 0 { return 0 - r }
    return r
}

// Cambia en un texto el precio base por el precio local («$800» → «$1,100»).
// Un texto con precio, en el idioma activo y con el precio de tu país: se
// traduce el original (los catálogos conservan el monto tal cual) y luego se
// cambia el monto.
function local_text(s: string, n: int) {
    if n == 0 { return s }
    return str_replace(tr(s), money_str(n), money_str(local_price(n)))
}

function money_str(v: int) {
    let neg = v < 0
    let n = v
    if neg { n = -v }
    let out = ""
    while n >= 1000 {
        let part = n % 1000
        let pad = str(part)
        if part < 10 { pad = "00" + pad } else if part < 100 { pad = "0" + pad }
        out = "," + pad + out
        n = n / 1000
    }
    out = "$" + str(n) + out
    if neg { return "-" + out }
    return out
}

function wrap(text: string, max_chars: int) {
    let lines = []
    for paragraph in str_split(text, "\n") {
        let line = ""
        for word in str_split(paragraph, " ") {
            if line == "" {
                line = word
            } else if len(line) + 1 + len(word) > max_chars {
                list_push(lines, line)
                line = word
            } else {
                line = line + " " + word
            }
        }
        list_push(lines, line)
    }
    return lines
}

// Sustituye {marcadores} de género y nombres en los textos de eventos.
// Cómo se nombra a alguien en los textos: a tus padres, abuelos y suegros
// por lo que son para ti («tu mamá»); a los demás, por su nombre.
function who(p: map) {
    if p.rel == "madre" { return "tu mamá" }
    if p.rel == "padre" { return "tu papá" }
    if p.rel == "abuelo" { return by_gender(p.gender, "tu abuelo", "tu abuela") }
    if p.rel == "suegro" { return by_gender(p.gender, "tu suegro", "tu suegra") }
    return p.first
}

function fmt(text: string, ctx: map) {
    let out = str_replace(text, "{a}", oa(L.gender))
    out = str_replace(out, "{tia}", by_gender(L.gender, "tío", "tía"))
    out = str_replace(out, "{el}", by_gender(L.gender, "el", "la"))
    out = str_replace(out, "{nombre}", L.first)
    let p = partner()
    if p != null {
        out = str_replace(out, "{p}", p.first)
        out = str_replace(out, "{pa}", oa(p.gender))
        out = str_replace(out, "{pel}", by_gender(p.gender, "él", "ella"))
        out = str_replace(out, "l{plo}", by_gender(p.gender, "lo", "la"))
        out = str_replace(out, "{plo}", by_gender(p.gender, "lo", "la"))
    }
    let x = ctx["person"]
    if x != null {
        // A tus padres y abuelos se les dice «tu mamá», «tu abuelo»...: con
        // mayúscula si abren la frase.
        let xn = who(x)
        if xn != x.first {
            let cap = cap_first(xn)
            if str_starts_with(out, "{x}") { out = cap + str_sub(out, 3) }
            for lead in ["¡", "¿", ". ", "! ", "? ", "» ", "\n"] { out = str_replace(out, lead + "{x}", lead + cap) }
        }
        out = str_replace(out, "{x}", xn)
        out = str_replace(out, "{xa}", oa(x.gender))
        out = str_replace(out, "{xel}", by_gender(x.gender, "él", "ella"))
        // Los textos escriben "l{xlo}" (Invitarl{xlo}) o "{xlo}" a secas: ambos dan lo/la.
        out = str_replace(out, "l{xlo}", by_gender(x.gender, "lo", "la"))
        out = str_replace(out, "{xlo}", by_gender(x.gender, "lo", "la"))
        out = str_replace(out, "{xun}", by_gender(x.gender, "Un", "Una"))
        out = str_replace(out, "{edad}", str(x.age))
    }
    if L.job != null {
        out = str_replace(out, "{trabajo}", L.job.title)
    }
    for key in map_keys(ctx) {
        let v = ctx[key]
        if type_of(v) == "string" || type_of(v) == "int" {
            out = str_replace(out, "{" + key + "}", str(v))
        }
    }
    return out
}

// ---------------------------------------------------------------- bitácora

// Se guarda la frase entera: se traduce y se parte en líneas al dibujarla.
function log_add(text: string, kind: string) {
    list_push(L.log, {"t": text, "k": kind})
    G.scroll = 0
}

// Encabezado del año; los años sin sucesos se fusionan ("Edad 14–17").
function log_year(age: int) {
    let n = len(L.log)
    if n > 0 {
        let last = L.log[n - 1]
        if last.k == "h" && last.a0 != null {
            last.t = "Edad " + str(last.a0) + "–" + str(age)
            return null
        }
    }
    list_push(L.log, {"t": "Edad " + str(age), "k": "h", "a0": age})
    G.scroll = 0
    return null
}

// ---------------------------------------------------------------- personas

function make_person(gender: string, rel: string, age: int) {
    let names = NAMES_M
    if gender == "f" { names = NAMES_F }
    let first = pick(names)
    if first == L.first { first = pick(names) }
    let pc = person_ctry(rel)
    let p = {
        "id": L.next_id,
        "first": first,
        "last": pick(SURNAMES),
        "gender": gender,
        "age": age,
        "rel": rel,
        "bond": rint(55, 90),
        "looks": rint(15, 100),
        "alive": true,
        "known": false,
        "slept": false,
        "look": random_look(gender),
        "tags": random_kinks(2),
        "wild": rint(0, 100)
    }
    pais_person(p, pc)
    if p.first == L.first { p.first = pais_first(gender, pc) }
    L.next_id += 1
    return p
}

function random_look(gender: string) {
    let styles = [0, 1, 4, 5, 7, 8, 0, 1, 11, 12, 14, 17, 18, 14]
    let accs = [0, 0, 0, 1, 3, 4, 4]
    let lips = [0, 0, 0, 0, 3]
    if gender == "f" {
        styles = [2, 3, 6, 5, 0, 9, 10, 11, 2, 1, 12, 13, 15, 16, 17, 19]
        accs = [0, 0, 1, 2, 2, 3]
        lips = [0, 1, 2, 2, 3, 1]
    }
    return {
        "skin": rint(0, len(SKINS) - 1),
        "hair": pick(styles),
        "hcolor": weighted_choose(G.rng, [30, 25, 18, 12, 4, 4, 2, 3, 2]),
        "eyes": weighted_choose(G.rng, [30, 25, 12, 12, 8, 3]),
        "outfit": rint(0, len(OUTFITS) - 1),
        "acc": pick(accs),
        "face": rint(0, len(FACES) - 1),
        "body": rint(0, len(BODIES) - 1),
        "mark": weighted_choose(G.rng, [60, 15, 15, 10]),
        "lips": pick(lips)
    }
}

function copy_look(look: map) {
    return {"skin": look.skin, "hair": look.hair, "hcolor": look.hcolor, "eyes": look.eyes, "outfit": look.outfit, "acc": look.acc,
            "face": look.face, "body": look.body, "mark": look.mark, "lips": look.lips}
}

// ---------------------------------------------------------------- personalidad

function trait_def(id: string) {
    for t in TRAITS {
        if t.id == id { return t }
    }
    return TRAITS[0]
}

function trait_name(id: string, gender: string) {
    let t = trait_def(id)
    return by_gender(gender, t.m, t.f)
}

function has_trait(id: string) {
    return L.trait == id
}

function rank(key: string) {
    return min(5, 1 + L.social[key] / 20)
}

function rank_title(key: string, r: int) {
    return SOCIAL_RANKS[key][r - 1]
}

function gain(key: string, amount: int) {
    L.social[key] = clamp(L.social[key] + amount, 0, 100)
}

function conf_rank(p: map) {
    return clamp(1 + p.bond / 11, 1, 10)
}

function arcana(p: map) {
    let a = ARCANA[p.rel]
    if a == null { return "La Luna" }
    return a
}

function add_person(p: map) {
    p.known = true
    list_push(L.people, p)
    return p
}

function find_person(id: int) {
    for p in L.people {
        if p.id == id { return p }
    }
    return null
}

function partner() {
    if L.partner_id == 0 { return null }
    return find_person(L.partner_id)
}

function attracted_gender() {
    if L.likes == "ambos" { return pick(["m", "f"]) }
    return L.likes
}

// Un desconocido adulto del género que le atrae al personaje, de edad parecida.
function stranger() {
    // Entre menores solo aparece gente de su edad (y nunca nada sexual: sex_with lo impide).
    if L.age < 18 {
        return make_person(attracted_gender(), "ligue", rint(max(13, L.age - 1), min(17, L.age + 1)))
    }
    let lo = max(18, L.age - 8)
    let hi = max(lo, L.age + 8)
    if has_kink("maduros") {
        lo = max(18, L.age + 5)
        hi = lo + 20
    }
    return make_person(attracted_gender(), "ligue", rint(lo, hi))
}

function stranger_aged(lo: int, hi: int) {
    return make_person(attracted_gender(), "ligue", rint(max(18, lo), max(18, hi)))
}

function rel_label(p: map) {
    let r = p.rel
    if r == "padre" { return "Padre" }
    if r == "madre" { return "Madre" }
    if r == "hermano" { return by_gender(p.gender, "Hermano", "Hermana") }
    if r == "pareja" { return by_gender(p.gender, "Novio", "Novia") }
    if r == "esposo" { return by_gender(p.gender, "Esposo", "Esposa") }
    if r == "ex" { return "Ex" }
    if r == "hijo" { return by_gender(p.gender, "Hijo", "Hija") }
    if r == "amigo" { return by_gender(p.gender, "Amigo", "Amiga") }
    if r == "amante" { return by_gender(p.gender, "Amante", "Amante") }
    if r == "nieto" { return by_gender(p.gender, "Nieto", "Nieta") }
    if r == "abuelo" { return by_gender(p.gender, "Abuelo", "Abuela") }
    if r == "tio" { return by_gender(p.gender, "Tío", "Tía") }
    if r == "primo" { return by_gender(p.gender, "Primo", "Prima") }
    if r == "suegro" { return by_gender(p.gender, "Suegro", "Suegra") }
    if r == "exsuegro" { return by_gender(p.gender, "Ex suegro", "Ex suegra") }
    if r == "sobrino" { return by_gender(p.gender, "Sobrino", "Sobrina") }
    if r == "colega" { return by_gender(p.gender, "Colega", "Colega") }
    if r == "excolega" { return by_gender(p.gender, "Excolega", "Excolega") }
    if r == "rival" { return by_gender(p.gender, "Rival", "Rival") }
    if r == "recluso" { return by_gender(p.gender, "Compañero de celda", "Compañera de celda") }
    return "Ligue"
}

function has_rel(rel: string) {
    for p in L.people {
        if p.alive && p.rel == rel { return true }
    }
    return false
}

function first_rel(rel: string) {
    for p in L.people {
        if p.alive && p.rel == rel { return p }
    }
    return null
}

// ---------------------------------------------------------------- nueva vida

function new_life() {
    new_life_core(0)
    pais_player_look()
    let c = G.cre
    let dad_last = L.last1
    let mom_last = str_trim(str_replace(L.last, L.last1, ""))
    if mom_last == "" { mom_last = pais_surname(born_id()) }
    let gender = L.gender
    let dad = make_person("m", "padre", rint(20, 45))
    dad.last = dad_last
    dad.look.skin = L.look.skin
    add_person(dad)
    let mom = make_person("f", "madre", rint(18, 42))
    mom.last = mom_last
    add_person(mom)
    let nsib = cre_sibs()
    if nsib < 0 {
        nsib = 0
        if chance(45) { nsib = 1 }
    }
    if nsib > 0 && mom.age < 20 + nsib * 2 { mom.age = 20 + nsib * 2 + rint(0, 8) }
    let si = 0
    while si < nsib {
        let sib = make_person(pick(["m", "f"]), "hermano", rint(1, min(9, mom.age - 19)))
        sib.last = L.last
        sib.look.skin = L.look.skin
        add_person(sib)
        si += 1
    }
    log_add("Naciste en " + L.city + ".", "h")
    hito_quiet("Vida", "Naciste en " + L.city)
    log_add(by_gender(gender, "Eres hijo", "Eres hija") + " de " + full_name(dad) + " y " + full_name(mom) + ".", "n")
    log_add("Te llamaron " + L.first + " " + L.last + ".", "n")
    log_add("Personalidad: " + trait_name(L.trait, gender) + ".", "x")
    setup_family()
    pais_birth()
    vida_birth()
    setup_religion()
    add_extended_family()
    fix_family_surnames()
    if G.cre.route != null { L.route = G.cre.route }
    route_setup()
    L.grades = clamp(30 + L.smarts / 2 + rint(-10, 10), 0, 100)
}

// Crea el estado de una vida (sin familia) a partir de G.cre, con la edad indicada.
function new_life_core(age: int) {
    ensure_rng()
    G.ph_on = false
    G.ph_app = ""
    G.lives += 1
    let c = G.cre
    let gender = c.gender
    let likes = c.likes
    if likes == "auto" { likes = by_gender(gender, "f", "m") }
    let names = NAMES_M
    if gender == "f" { names = NAMES_F }
    let cid = cre_country()
    let dad_last = pais_surname(cid)
    let mom_last = pais_surname(cid)
    let first = c.first
    if first == "" { first = pais_first(gender, cid) }
    if c.last != "" {
        let parts = str_split(c.last, " ")
        dad_last = parts[0]
        if len(parts) > 1 { mom_last = parts[1] }
    }
    L = {
        "first": first,
        "last": if_str(ctry(cid).ss == 2, dad_last + " " + mom_last, dad_last),
        "ctry": cid,
        "born": cid,
        "last1": dad_last,
        "gender": gender,
        "likes": likes,
        "look": copy_look(c.look),
        "trait": c.trait,
        "social": {"know": rint(0, 10), "guts": rint(0, 10), "skill": rint(0, 10), "kind": rint(0, 10), "charm": rint(0, 10)},
        "assets": [],
        "tags": c.tags,
        "fame": 0,
        "done": [],
        "flags": {},
        "age": age,
        "city": cre_city_in(cid),
        "alive": true,
        "happy": rint(65, 95),
        "health": rint(70, 100),
        "smarts": rint(10, 95),
        "looks": rint(10, 95),
        "karma": 50,
        "money": 0,
        "edu": 0,
        "school": "",
        "month": 0,
        "bmonth": cre_bmonth(),
        "grades": 0,
        "degrees": [],
        "study": null,
        "study_gpa_final": 0,
        "family": "media",
        "gig": null,
        "gig_done": 0,
        "workxp": 0,
        "preg_m": 0,
        "ppreg_m": 0,
        "debt": 0,
        "job": null,
        "job2": null,
        "jail": 0,
        "jail_total": 0,
        "record": 0,
        "people": [],
        "next_id": 1,
        "partner_id": 0,
        "married": false,
        "partners": 0,
        "marriages": 0,
        "divorces": 0,
        "kids": 0,
        "alcohol": 0,
        "drugs": 0,
        "ill": [],
        "habits": [],
        "habit_months": {},
        "gen": 1,
        "lineage": [],
        "heir_id": 0,
        "parent_score": 50,
        "past_jobs": [],
        "legacy_kid": 0,
        "parent_star": "",
        "parent_star_g": "m",
        "care": "",
        "pension": 0,
        "funeral": null,
        "heartbreak": 0,
        "hitos": [],
        "tm": 0,
        "interests": null,
        "hito_keys": {},
        "fert": rint(50, 95),
        "route": "normal",
        "rd": {},
        "rstage": 0,
        "rdone": false,
        "religion": "ninguna",
        "faith": 0,
        "pregnant": false,
        "preg_with": "",
        "partner_preg": false,
        "claim": "",
        "used": {},
        "seen": {},
        "cause": "",
        "dying": "",
        "in_red": false,
        "last_job": "",
        "log": []
    }
    apply_trait()
    clamp_stats()
    G.pending_deg = ""
    G.tuition_no = ""
    G.dlg = null
    G.mg = null
    G.legacy = null
    G.roul = null
    G.bj = null
    G.vp = null
    L.mk = null
    fin_init()

    G.mode = "game"
    G.modal = null
    G.scroll = 0
}

function apply_trait() {
    let t = trait_def(L.trait)
    gain(t.social, 25)
    if L.trait == "carisma" { L.looks += 10 }
    if L.trait == "rebelde" { L.karma -= 5 }
    if L.trait == "cerebro" { L.smarts += 15 }
    if L.trait == "fiesta" { L.happy += 10 }
    if L.trait == "ambicion" { L.smarts += 5 }
}

// ---------------------------------------------------------------- año a año

// Avanza un mes. Devuelve true si fue tu cumpleaños (para la animación de edad).
function advance_month() {
    if !L.alive || G.modal != null { return false }
    L.used = {}
    L.month += 1
    let birthday = false
    if L.month >= 12 {
        L.month = 0
        L.age += 1
        birthday = true
        log_year(L.age)
        yearly()
        parenting_year()
        if L.alive { health_year() }
        if L.alive { medicina_year() }
        if L.alive {
            escuela_year()
            oficio_year()
        }
        if L.alive {
            kids_year()
            old_age_year()
            finance_year()
            apps_year()
            vida_year()
            service_check()
        }
        clamp_stats()
        if !L.alive { return true }
        death_check()
        if !L.alive { return true }
    }
    monthly()
    clamp_stats()
    if !L.alive { return birthday }
    if L.health <= 0 {
        die(worst_cause())
        return birthday
    }
    if G.modal != null { return birthday }
    if L.claim != "" {
        let person = make_person(by_gender(L.gender, "f", "m"), "ligue", max(18, L.age + rint(-5, 5)))
        person.first = L.claim
        L.claim = ""
        open_event(find_event("baby_claim"), {"person": person})
        return birthday
    }
    if maybe_caught_event() { return birthday }
    if maybe_work_found_event() { return birthday }
    if maybe_bw_event() { return birthday }
    if maybe_anniversary() { return birthday }
    // Respiro entre decisiones: el destino (tranquilo, normal o caótico) marca cada
    // cuántos meses puede interrumpirte algo; al adelantar años, aún menos.
    let gap = 2
    let chaos = map_get(L, "chaos", "normal")
    if chaos == "tranquilo" { gap = 3 }
    if chaos == "caotico" { gap = 1 }
    if L.last_pop != null && L.tm - L.last_pop < gap { return birthday }
    if G.skip != null && !chance(35) { return birthday }
    if G.yr != null && G.yr.pops >= 2 { return birthday }
    if !maybe_school_event() && !maybe_work_event() && !maybe_gig_event() && !maybe_prison_event() && !maybe_ocio_event() && !maybe_health_event() && !maybe_lazos_event() && !maybe_kid_event() && !maybe_partner_initiative() && !maybe_npc_initiative() && !maybe_faith_event() && !maybe_money_event() && !maybe_route_event() && !maybe_apps_event() && !maybe_ping() { maybe_event() }
    if G.modal != null {
        L.last_pop = L.tm
        if G.yr != null { G.yr.pops += 1 }
    }
    return birthday
}

// Avanza hasta tu próximo cumpleaños, deteniéndose si algo requiere una decisión.
function advance_year() {
    let n = 0
    while n < 12 {
        let birthday = advance_month()
        n += 1
        if birthday || G.modal != null || !L.alive { return birthday }
    }
    return false
}

const MONTH_NAMES = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"]

function month_name() {
    return MONTH_NAMES[(L.bmonth + L.month) % 12]
}

// Lo que pasa cada mes: sueldo, chambas, escuela, colegiatura y embarazos.
function monthly() {
    if L.job != null && L.jail == 0 && !in_barracks() {
        // Impuestos y estilo de vida se llevan la mitad del sueldo.
        // Impuestos (30%); los gastos de vida se cobran aparte en finanzas.
        let net = job_pay(L.job) * 70 / 100 / 12
        L.money += net
        if L.debt > 0 {
            let payment = min(L.debt, net * 20 / 100)
            L.debt -= payment
            L.money -= payment
            if L.debt == 0 { log_add("Terminaste de pagar tu préstamo estudiantil.", "g") }
        }
    }
    if L.pension > 0 { L.money += L.pension / 12 }
    gig_month()
    school_month()
    study_month()
    health_month()
    kids_month()
    effects_month()
    moods_month()
    state_hitos()
    bonds_month()
    finance_month()
    religion_month()
    route_month()
    phone_month()
    apps_month()
    vida_month()
    pais_month()
    lazos_month()
    ocio_month()
    prison_month()
    medicina_month()
    escuela_month()
    oficio_month()
    if L.pregnant {
        if L.preg_m <= 0 {
            L.preg_m = 8
        } else {
            L.preg_m -= 1
            if L.preg_m == 0 {
                L.pregnant = false
                add_child(L.preg_with)
            }
        }
    }
    if L.partner_preg {
        if L.ppreg_m <= 0 {
            L.ppreg_m = 8
        } else {
            L.ppreg_m -= 1
            if L.ppreg_m == 0 {
                L.partner_preg = false
                let p = partner()
                let other = "tu pareja"
                if p != null { other = p.first }
                add_child(other)
            }
        }
    }
    return null
}

function clamp_stats() {
    L.happy = clamp100(L.happy)
    L.health = clamp100(L.health)
    L.smarts = clamp100(L.smarts)
    L.looks = clamp100(L.looks)
    L.karma = clamp100(L.karma)
    L.alcohol = clamp100(L.alcohol)
    L.drugs = clamp100(L.drugs)
    L.fame = clamp100(L.fame)
}

function yearly() {
    // Familia y conocidos
    for p in L.people {
        if !p.alive { continue }
        p.age += 1
        p.bond = clamp100(p.bond - rint(0, 3))
        let risk = 0
        if p.age > 60 { risk = (p.age - 60) / 3 + max(0, pais_life_shift()) / 3 }
        if p.age > 85 { risk = risk + 10 }
        if p.cared == true && risk > 0 { risk = risk * 2 / 3 }
        // Antes de irse, quien te quiere pide verte (y ese año no muere).
        if maybe_goodbye(p, risk) { continue }
        if risk > 0 && chance(risk) {
            p.alive = false
            log_add("Tu " + str_lower(rel_label(p)) + " " + p.first + " murió a los " + str(p.age) + " años.", "b")
            if p.bond >= 40 || p.rel == "padre" || p.rel == "madre" || p.id == L.partner_id { hito_me("Familia", "Perdiste a tu " + str_lower(rel_label(p)) + " " + p.first) }
            if p.id == L.partner_id { add_hito(p, "Partió antes que tú") }
            lazos_on_death(p)
            if p.bond > 50 { L.happy -= 15 }
            if p.rel == "padre" || p.rel == "madre" {
                let heritage = parent_estate(p)
                if heritage > 0 {
                    L.money += heritage
                    log_add("Heredaste " + money_str(heritage) + ".", "g")
                }
            }
            if p.id == L.partner_id {
                let w = spouse_died(p, false)
                if w != "" { log_add(w, "n") }
            } else if (p.rel == "padre" || p.rel == "madre" || p.rel == "hijo" || p.rel == "hermano" || p.rel == "abuelo") && p.bond >= 50 && L.funeral_id == null {
                L.funeral_id = p.id
                L.funeral_poison = false
            }
        }
    }

    childhood_friends()
    sweet_year()
    lazos_year()
    ocio_year()
    age_hitos()
    // Infancia
    if L.age <= 5 && chance(70) {
        // Un recuerdo propio de esa edad, sin repetir.
        if L.kid_mem == null { L.kid_mem = [] }
        let opts = []
        for c in CHILDHOOD {
            if L.age >= c[0] && L.age <= c[1] && !list_contains(L.kid_mem, c[2]) { list_push(opts, c[2]) }
        }
        if len(opts) > 0 {
            let line = pick(opts)
            list_push(L.kid_mem, line)
            log_add(fmt(line, {}), "n")
        }
    }

    // Escuela
    if L.age == 6 {
        L.school = "primaria"
        log_add("Empezaste la primaria.", "n")
    }
    if L.age == 12 {
        L.school = "secundaria"
        L.edu = 1
        log_add("Terminaste la primaria y entraste a la secundaria.", "n")
    }
    if L.school != "" && L.age < 18 {
        L.smarts += rint(0, 3)
        gain("know", rint(1, 3))
        // La calidad de las escuelas de tu país también cuenta.
        let edu = map_get(here(), "edu", 50)
        if edu >= 70 && chance(50) { L.smarts += 1 }
        if edu < 35 && chance(40) { L.smarts -= 1 }
    }
    if L.age == 18 && L.school == "secundaria" {
        L.school = ""
        L.edu = 2
        log_add("Te graduaste de la secundaria. Ya eres mayor de edad: la noche es tuya.", "g")
        hito_me("Estudios", "Terminaste la secundaria")
        escuela_graduation()
        if len(L.tags) > 0 { log_add("Descubriste lo que te gusta en la cama: " + kinks_text(L.tags, L.gender) + ".", "x") }
    }
    if L.study != null { L.smarts += rint(1, 3) }

    // Prisión (la condena corre por meses: ver prison_month).
    if L.jail > 0 {
        L.happy -= 6
        prison_year()
    }

    // Trabajo y dinero
    if L.job != null && L.jail == 0 {
        L.job.years += 1
        L.job.perf = clamp100(L.job.perf + rint(-4, 4))
        if L.job.perf < 15 && chance(50) {
            let t = L.job.title
            log_add("Te despidieron de tu trabajo como " + t + "." + fire_job("Tu desempeño se vino abajo."), "b")
        }
    }
    let kids_cost = local_price(3000) * kids_living()
    if kids_cost > 0 && L.jail == 0 { L.money -= kids_cost }
    if L.money < 0 && L.age >= 18 {
        L.happy -= 2
        if !L.in_red { log_add("Estás en números rojos. Los cobradores ya saben tu nombre.", "b") }
    }
    L.in_red = L.money < 0

    // Carrera +18 y fama
    if L.job != null && L.jail == 0 {
        career_xp(10 + rank("skill") * 3)
        if job_is_adult(L.job) && chance(30) { log_add("Otro año en el negocio: ahora eres " + career_rank_name() + ".", "x") }
    }
    second_job_year()
    if L.fame > 0 { L.fame -= 2 }

    // Vicios
    if L.alcohol > 0 {
        L.health -= L.alcohol / 12
        L.alcohol -= 3
        if L.alcohol > 50 && chance(30) { log_add("Tu hígado te manda saludos. Bebes demasiado.", "b") }
    }
    if L.drugs > 0 {
        L.health -= L.drugs / 8
        L.happy -= L.drugs / 15
        L.drugs -= 4
        if L.drugs >= 70 && chance(L.drugs / 8) {
            die("una sobredosis")
            return null
        }
    }

    // Pareja
    let p = partner()
    if p != null && p.alive {
        if p.bond < 20 && chance(45) && !velo_loyal(p) {
            log_add(p.first + " te dejó. Dice que ya no siente nada.", "b")
            breakup()
            L.happy -= 15
        }
    }

    // Edad
    L.happy += rint(-3, 3)
    if L.age >= 30 { L.looks -= rint(0, 1) }
    if L.age >= 45 { L.looks -= rint(0, 2) }
    if L.age >= 50 { L.health -= rint(0, 3) }
    if L.age >= 70 { L.health -= rint(1, 4) }
    if L.age >= 8 && L.age < 30 { L.health += rint(0, 2) }
    return null
}

function kids_living() {
    return list_count(L.people, fn(p) => p.alive && p.rel == "hijo" && p.age < 18)
}

function job_pay(job: map) {
    if job.career != null { return pay_of(job) }
    if job.var != null && job.var > 0 {
        return L.looks * L.looks * job.var
    }
    return job.salary
}

function add_child(other: string) {
    let g = lazos_baby_sex()
    let child = make_person(g, "hijo", 0)
    let chosen = lazos_baby_name(g)
    if chosen != "" { child.first = chosen }
    child.last = L.last1
    if g == "f" { child.last = fem_surname(here_id(), child.last) }
    child.look.skin = L.look.skin
    if chance(50) { child.look.hcolor = L.look.hcolor }
    child.bond = 90
    add_person(child)
    L.kids += 1
    L.happy += 10
    tfx_add("desvelos", 6)
    log_add("¡Nació tu " + by_gender(g, "hijo", "hija") + " " + child.first + "! (con " + other + ")", "g")
    if !hito_once("first_child", "Familia", "Nació tu primer hijo: " + child.first) { hito_me("Familia", "Nació " + child.first) }
    child.hitos = [{"a": L.age, "t": "Nació"}]
    let mate = partner()
    if mate != null && mate.first == other {
        add_hito(mate, "Nació " + child.first)
        child.other_parent = mate.id
    }
    lazos_after_birth(child, other)
}

function death_check() {
    if L.health <= 0 {
        die(worst_cause())
        return null
    }
    if L.age + pais_life_shift() >= 60 {
        let over = L.age - 60 + pais_life_shift()
        let risk = over * over / 40 + (100 - L.health) / 10
        if L.age >= 105 { risk = 100 }
        if chance(risk) { die(pick(OLD_AGE_CAUSES)) }
    }
    return null
}

function die(cause: string) {
    L.alive = false
    L.cause = cause
    log_add("Moriste a los " + str(L.age) + " años por " + cause + ".", "b")
    G.modal = null
    G.mode = "dead"
    forget_save()
    on_death()
}

// ---------------------------------------------------------------- relaciones

function breakup() {
    let p = partner()
    if p == null { return null }
    if L.married {
        L.married = false
        L.divorces += 1
        hito_me("Amor", "Te divorciaste de " + p.first)
        log_add("Divorcio." + divorce_settlement(p), "b")
        lazos_divorce(p)
    }
    dn_breakup(p)
    p.rel = "ex"
    L.partner_id = 0
    L.heartbreak = 6
    G.snd_next = "break"
    add_hito(p, "Terminaron")
    hito_once("first_heartbreak", "Amor", "Tu primer corazón roto")
    return null
}

// Un menor (menos de 18) y un adulto nunca forman pareja ni amantes.
function minor_mix(p: map) {
    if L.age < 18 { return p.age >= 18 }
    return p.age < 18
}

function make_partner(p: map) {
    if minor_mix(p) { return false }
    if !p.known { add_person(p) }
    let current = partner()
    if current != null && current.id != p.id {
        p.rel = "amante"
        return false
    }
    p.rel = "pareja"
    p.bond = max(p.bond, 60)
    L.partner_id = p.id
    if p.since == null { p.since = L.age }
    if both_adults(p) {
        add_hito(p, "Empezaron a salir")
    }
    return true
}

function marry() {
    return marry_cost(min(max(L.money, 0), 8000))
}

function marry_cost(cost: int) {
    let p = partner()
    if p == null { return null }
    p.rel = "esposo"
    p.wed_tm = L.tm
    L.married = true
    L.marriages += 1
    L.money -= cost
    p.bond = clamp100(p.bond + 15)
    add_hito(p, "Se casaron")
    tfx_add("luna_miel", 3)
    if L.age >= 18 { pa().honey = true }
    if p.childhood == true || p.teen_start != null { flag("childhood_love") }
    if p.pinky == true {
        add_hito(p, "Cumplieron su promesa de meñique")
        L.happy += 10
    }
    lazos_on_marry(p)
    return null
}

// ---------------------------------------------------------------- efectos

// Aplica un resultado {w, log, happy, health, ..., special} y devuelve el texto.
function apply(o: map, ctx: map) {
    let msg = ""
    if map_has(o, "log") { msg = fmt(o.log, ctx) }
    // Variante para niños, si el resultado la trae.
    if L.age < 13 && map_has(o, "log_kid") { msg = fmt(o.log_kid, ctx) }
    for key in ["happy", "health", "smarts", "looks", "karma", "alcohol", "drugs"] {
        if map_has(o, key) { L[key] = L[key] + o[key] }
    }
    for key in SOCIAL_KEYS {
        if map_has(o, key) { gain(key, o[key]) }
    }
    if map_has(o, "money") {
        let m = o.money
        if type_of(m) == "list" { m = rint(m[0] / 100, m[1] / 100) * 100 }
        // Los montos del contenido están en precios base: se ajustan al costo de
        // vida del país, y el texto dice lo que de verdad pagaste o ganaste.
        let base = m
        m = local_price(m)
        if base != m && msg != "" { msg = str_replace(msg, money_str(abs(base)), money_str(abs(m))) }
        L.money += m
        ctx["monto"] = money_str(m)
        msg = str_replace(msg, "{monto}", money_str(m))
    }
    if map_has(o, "xp") { career_xp(o.xp) }
    if map_has(o, "fame") { L.fame = L.fame + o.fame }
    if map_has(o, "flag") { flag(o.flag) }
    if map_has(o, "tfx") { apply_tfx(o.tfx) }
    if map_has(o, "gigperf") && L.gig != null { L.gig.perf = clamp100(L.gig.perf + o.gigperf) }
    // Escuela, universidad y trabajo.
    if map_has(o, "pop") { sc().pop = clamp100(sc().pop + o.pop) }
    if map_has(o, "grades") { L.grades = clamp(L.grades + o.grades, 0, 100) }
    if map_has(o, "gpa") && L.study != null { L.study.gpa = clamp(L.study.gpa + o.gpa, 0, 100) }
    if map_has(o, "perf") && L.job != null { L.job.perf = clamp100(L.job.perf + o.perf) }
    if map_has(o, "boss") && L.job != null { boss_mood(o.boss) }
    if map_has(o, "bond") {
        let target = ctx["person"]
        if target == null || !target.known { target = partner() }
        if target != null { target.bond = clamp100(target.bond + o.bond) }
    }
    if map_has(o, "count") { L.partners += o.count }
    if map_has(o, "sex") { msg = msg + sex_with(ctx["person"]) }
    // Con una persona concreta, el contagio depende de lo que esa persona tenga
    // (sex_with); "std" es el riesgo de un encuentro anónimo.
    if map_has(o, "std") && (ctx["person"] == null || !map_has(o, "sex")) {
        if chance(o.std * (100 + fx_sum("its")) / 100) { msg = msg + catch_its_random() }
    }
    if map_has(o, "parent") { L.parent_score = clamp100(L.parent_score + o.parent) }
    if map_has(o, "kgrades") && ctx["person"] != null && ctx["person"].grades != null {
        ctx["person"].grades = clamp(ctx["person"].grades + o.kgrades, 0, 100)
    }
    if map_has(o, "preg") { msg = msg + maybe_pregnancy(ctx["person"], o.preg) }
    if map_has(o, "special") { msg = msg + special(o.special, ctx) }
    if map_has(o, "detention") { msg = msg + detention() }
    if map_has(o, "fire") { msg = msg + fire_job(o.fire) }
    if map_has(o, "layoff") { msg = msg + layoff_roll(o.layoff) }
    if map_has(o, "severance") { msg = msg + severance(o.severance) }
    if map_has(o, "jail") { msg = msg + go_to_jail(o.jail) }
    clamp_stats()
    if map_has(o, "die") {
        L.dying = o.die
    } else if L.health <= 0 {
        L.dying = "complicaciones de salud"
        if map_has(o, "drugs") || map_has(o, "alcohol") { L.dying = "los excesos" }
    }
    return msg
}

function sex_with(person: any) {
    let out = ""
    // Candado: nada sexual si alguno de los dos es menor de edad.
    if L.age < 18 { return "" }
    if person != null && person.age < 18 { return "" }
    if blood_rel(person) { return "" }
    if person != null && !person.slept {
        person.slept = true
        L.partners += 1
    }
    if person != null { out = out + sex_contact(person) }
    if L.partners >= 1 { hito_once("first_time", "Amor", "Tu primera vez") }
    let p = partner()
    // En la Orden del Velo Rojo tus consortes no se ponen celosos; la Orden sí.
    if L.route == "profeta" && velo_active() && (p == null || p.velo == true) {
        if person == null || person.velo != true { out = out + velo_infidelity(person) }
        return out
    }
    if p != null && p.open != true && (person == null || person.id != p.id) {
        p.cheated = true
        L.karma -= 5
        if chance(30) {
            p.cheated = false
            p.bond -= 45
            L.happy -= 10
            out = " " + p.first + " se enteró de tu infidelidad."
            if p.bond < 25 {
                breakup()
                out = out + " Te dejó y tiró tu ropa por la ventana."
            }
        }
    }
    return out
}

function maybe_pregnancy(person: any, p: int) {
    if person == null || person.gender == L.gender { return "" }
    if !both_adults(person) { return "" }
    if !chance(p) { return "" }
    if L.gender == "f" {
        if L.pregnant || L.age > 45 { return "" }
        L.pregnant = true
        L.preg_with = person.first
        return " Semanas después, la prueba sale positiva: estás embarazada."
    }
    if person.known && person.id == L.partner_id {
        L.partner_preg = true
        return " " + person.first + " está embarazada."
    }
    L.claim = person.first
    return ""
}

function go_to_jail(years: int) {
    L.jail = years
    L.jail_mo = 0
    prison_enter()
    L.jail_total += years
    L.record += 1
    hito_once("first_jail", "Vida", "Tu primera vez en prisión")
    if L.job != null {
        L.last_job = L.job.title
        L.job = null
    }
    L.job2 = null
    L.gig = null
    if L.study != null {
        L.study = null
        L.school = ""
    }
    let out = " Te condenaron a " + str(years) + " " + plural(years, "año", "años") + " de prisión."
    let p = partner()
    if p != null && chance(50) {
        breakup()
        out = out + " Tu pareja no piensa esperarte."
    }
    return out
}

function plural(n: int, one: string, many: string) {
    if n == 1 { return one }
    return many
}

// Lo que te deja papá o mamá: depende de cuánto tenía la familia y del país,
// se reparte entre los hermanos vivos y pesa cuánto se querían.
function parent_estate(p: map) {
    let base = 0
    if L.family == "pobre" { base = rint(0, 15) * 1000 }
    if L.family == "media" { base = rint(30, 200) * 1000 }
    if L.family == "rica" { base = rint(500, 5000) * 1000 }
    // Si queda el otro progenitor, la mayor parte se queda con él o ella.
    if has_rel("padre") || has_rel("madre") { base = base / 3 }
    let heirs = 1
    for q in L.people {
        if q.alive && q.rel == "hermano" { heirs += 1 }
    }
    let share = base * pais_pay_mult() / 100 / heirs
    return share * (50 + p.bond / 2) / 100
}
