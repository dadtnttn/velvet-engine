const GIG_MISSIONS = [
    {"id": "shifts", "t": "Turnos completos", "d": "Trabaja 3 turnos este mes."},
    {"id": "tips", "t": "Rey de las propinas", "d": "Junta {meta} en propinas este mes."},
    {"id": "perfect", "t": "Turno perfecto", "d": "Saca 90 o más en un turno."},
    {"id": "good2", "t": "Constancia", "d": "Saca 70 o más en 2 turnos este mes."}
]

state {
    GIGC: map = {}
}

// ---------------------------------------------------------------- definiciones

function gig_def(id: string) {
    let cached = GIGC[id]
    if cached != null { return cached }
    for r in GIG_ROWS {
        if r[0] == id {
            // La tabla guarda el sueldo de tiempo completo; la chamba es de medio tiempo.
            let d = {"id": r[0], "m": r[1], "f": r[2], "set": r[3], "pay": r[4] / 3, "min_age": r[5], "game": r[6]}
            GIGC[id] = d
            return d
        }
    }
    return null
}

function gig_items(place: string) {
    let items = []
    for r in GIG_ROWS {
        if r[3] != place { continue }
        let d = gig_def(r[0])
        let lock = ""
        if L.age < d.min_age { lock = "Edad " + str(d.min_age) }
        if L.gig != null && L.gig.id == d.id { lock = "Ya trabajas aquí" }
        list_push(items, {
            "action": "gig:" + d.id,
            "t": by_gender(L.gender, d.m, d.f),
            "s": money_str(d.pay) + "/mes",
            "desc": "Sin experiencia. Medio tiempo: puedes estudiar a la vez. Minijuego del turno: " + MG_INFO[d.game].title + ". Lugar: " + GIG_PLACES[d.set] + ".",
            "lock": lock
        })
    }
    return items
}

function take_gig(id: string) {
    let d = gig_def(id)
    G.modal = null
    if d == null || L.age < d.min_age { return null }
    if L.jail > 0 { return info("Trabajo", "Desde la cárcel no se puede.") }
    let old = ""
    if L.gig != null { old = " Dejaste tu trabajo como " + L.gig.title + "." }
    L.gig = {"id": id, "title": by_gender(L.gender, d.m, d.f), "pay": d.pay, "months": 0, "shifts": 0, "tips": 0, "good": 0, "perf": 50, "mission": null}
    new_gig_mission()
    flag("gig")
    return finish("Nuevo trabajo", "¡Empiezas como " + str_lower(L.gig.title) + "! Sueldo: " + money_str(d.pay) + " al mes." + old, "g")
}

function new_gig_mission() {
    let m = pick(GIG_MISSIONS)
    let goal = 3
    if m.id == "tips" { goal = L.gig.pay / 5 }
    if m.id == "perfect" { goal = 1 }
    if m.id == "good2" { goal = 2 }
    L.gig.mission = {"id": m.id, "t": m.t, "d": str_replace(m.d, "{meta}", money_str(goal)), "goal": goal, "done": false}
    L.gig.shifts = 0
    L.gig.tips = 0
    L.gig.good = 0
}

function gig_mission_progress() {
    let g = L.gig
    let m = g.mission
    if m == null || m.done { return 0 }
    if m.id == "shifts" { return g.shifts }
    if m.id == "tips" { return g.tips }
    return g.good
}

function check_gig_mission() {
    let g = L.gig
    let m = g.mission
    if m == null || m.done { return null }
    if gig_mission_progress() >= m.goal {
        m.done = true
        L.gig_done += 1
        let bonus = g.pay / 3
        L.money += bonus
        L.happy += 5
        g.perf = clamp100(g.perf + 10)
        L.workxp += 3
        list_push(G.toasts, {"head": "¡MINIMISIÓN!", "title": str_upper(m.t), "sub": "Bono de " + money_str(bonus) + " · " + g.title, "t0": G.t})
        log_add("Minimisión cumplida en tu trabajo: " + m.t + " (+" + money_str(bonus) + ").", "g")
    }
    return null
}

// Pago, experiencia y minimisión de cada mes.
function gig_month() {
    let g = L.gig
    if g == null { return null }
    if L.jail > 0 {
        L.gig = null
        return null
    }
    L.money += g.pay
    g.months += 1
    L.workxp += 1
    if g.mission != null && !g.mission.done {
        g.perf = clamp100(g.perf - 5)
    }
    if g.perf < 10 && chance(50) {
        log_add("Te corrieron de tu trabajo como " + g.title + " por mal desempeño.", "b")
        L.gig = null
        return null
    }
    new_gig_mission()
    return null
}

function gig_action_items() {
    let g = L.gig
    let items = []
    let d = gig_def(g.id)
    let m = g.mission
    let mdesc = "Sin minimisión."
    let ms = ""
    if m != null {
        mdesc = m.d + " Progreso: " + str(gig_mission_progress()) + "/" + str(m.goal) + ". Recompensa: bono de " + money_str(g.pay / 3) + "."
        ms = "MISIÓN: " + m.t
        if m.done { ms = "MISIÓN CUMPLIDA" }
    }
    list_push(items, {"action": "gigwork", "t": "Trabajar un turno (" + MG_INFO[d.game].title + ")", "s": ms, "desc": "Minijuego: tu puntaje decide las propinas. " + mdesc, "lock": ""})
    list_push(items, {"action": "gigeasy", "t": "Turno tranquilo", "s": "Sin minijuego", "desc": "Haces lo justo. Poca propina, poco esfuerzo. Cuenta para la minimisión de turnos.", "lock": ""})
    list_push(items, {"action": "gigquit", "t": "Renunciar a " + g.title, "s": money_str(g.pay) + "/mes", "desc": "Llevas " + str(g.months) + " meses aquí. Desempeño: " + str(g.perf) + "%.", "lock": ""})
    return items
}

function gig_work(easy: bool) {
    G.modal = null
    let g = L.gig
    if g == null { return null }
    let used = L.used["gig"]
    if used == null { used = 0 }
    if used >= 4 { return info(g.title, "Ya trabajaste todos tus turnos de este mes.") }
    L.used["gig"] = used + 1
    if easy {
        return gig_shift_result(40)
    }
    let d = gig_def(g.id)
    return mg_start(d.game, "Turno: " + g.title, "gig", {})
}

function gig_shift_result(score: any) {
    let g = L.gig
    if g == null { return null }
    let tips = g.pay * score / 400
    L.money += tips
    g.tips += tips
    g.shifts += 1
    if score >= 70 { g.good += 1 }
    if score >= 90 && g.mission != null && g.mission.id == "perfect" { g.good = max(g.good, 1) }
    g.perf = clamp100(g.perf + (score - 50) / 10)
    L.workxp += 1
    check_gig_mission()
    let mood = "Turno normal."
    if score >= 90 { mood = "¡Turno perfecto! Clientes felices." }
    if score < 30 { mood = "Turno desastroso. Tu jefe te miró feo." }
    return finish(g.title, mood + " Propinas: " + money_str(tips) + ".", outcome_kind({"happy": score - 50}))
}

function gig_quit() {
    G.modal = null
    if L.gig == null { return null }
    let t = L.gig.title
    L.gig = null
    return finish("Trabajo", "Renunciaste a tu trabajo como " + str_lower(t) + ".", "n")
}

// ---------------------------------------------------------------- eventos del trabajo

function gig_event_ok(ev: map) {
    if L.gig == null { return false }
    let place = gig_def(L.gig.id).set
    if ev.adult == true && (L.age < 18 || place == "cuidado") { return false }
    if L.age < ev.min || L.age > ev.max { return false }
    let last = L.seen[ev.id]
    if last != null && L.age - last < 2 { return false }
    for tag in str_split(ev.req, ",") {
        if !meets(str_trim(tag)) { return false }
    }
    if list_contains(ev.set, place) { return true }
    return list_contains(ev.set, "any") && place != "cuidado" && place != "online18"
}

function maybe_gig_event() {
    if L.gig == null || G.modal != null || !chance(30) { return false }
    let pool = []
    let weights = []
    for ev in GIG_EVENTS {
        if gig_event_ok(ev) {
            list_push(pool, ev)
            list_push(weights, ev.w)
        }
    }
    if len(pool) == 0 { return false }
    let ev = pool[weighted_choose(G.rng, weights)]
    let ctx = {}
    let spec = ev["person"]
    if spec == "near" { ctx = {"person": stranger()} }
    if spec == "peer" { ctx = {"person": peer()} }
    if spec != null && type_of(spec) == "list" { ctx = {"person": stranger_aged(spec[0], spec[1])} }
    open_event(ev, ctx)
    G.modal.title = L.gig.title + " · " + ev.title
    return true
}

// Compañero de trabajo de edad parecida (adulto si tú eres adulto).
function peer() {
    if L.age >= 18 { return stranger() }
    let p = make_person(pick(["m", "f"]), "ligue", L.age)
    return p
}
