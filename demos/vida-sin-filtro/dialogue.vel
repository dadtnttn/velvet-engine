// @edition 3
// Conversaciones con decisiones: árboles de diálogo con padres, pareja, amigos y ex.
// Cada persona tiene un estilo (los padres: amoroso, estricto...; los demás: dulce,
// celoso...) que cambia lo que dice y la probabilidad de convencerla. Las opciones
// pueden exigir rango social y algunas se resuelven con una tirada (se muestra el %).
//
// Nodo: {"say": texto o {estilo: texto}, "opts": [...], "fx": efectos, "end": código, "k": tipo}
// Opción: {"t", "if", "need", "rank", "go"} o con tirada {"roll", "stat", "money", "grades",
//          "looks", "ok", "fail"}; "fx" se aplica al elegirla.

const STYLE_MOD = {"amoroso": 15, "estricto": -5, "relajado": 5, "ausente": -15, "toxico": -20,
                   "dulce": 10, "celoso": -5, "libre": 5, "intenso": 0, "rebelde": -10, "genio": 0, "flojo": 5}
