}

// ---------------------------------------------------------------- personas

function npc_style(p: map) {
    if p.style != null { return p.style }
    p.style = NPC_STYLES[p.id % len(NPC_STYLES)]
    return p.style
}

// Etapas de la vida: cambian el tono de lo que se dice y las opciones.
function age_band(a: int) {
    if a < 13 { return "kid" }
    if a < 18 { return "teen" }
    if a < 60 { return "adult" }
    return "elder"
}

// Quién marca el tono: con tus hijos y nietos, su edad; con los demás, la tuya.
function dlg_band(p: map) {
    if G.dlg != null && (G.dlg.tree == "child" || G.dlg.tree == "grandkid" || G.dlg.tree == "nephew") { return age_band(p.age) }
    return age_band(L.age)
}

function tree_for(p: map) {
    let r = p.rel
    if r == "padre" || r == "madre" {
        if L.age < 4 { return "" }
        return "parent"
    }
    if r == "hijo" {
        if p.age >= 4 { return "child" }
        return ""
    }
    if r == "nieto" {
        if p.age >= 4 && L.age >= 4 { return "grandkid" }
        return ""
    }
    if r == "abuelo" {
        if L.age >= 4 { return "elder" }
        return ""
    }
    if r == "tio" {
        if L.age >= 4 { return "uncle" }
        return ""
    }
    if r == "primo" {
        // Un primo chiquito no platica como adulto: solo entre niños o desde los 13.
        if L.age >= 4 && p.age >= 4 && (p.age >= 13 || L.age < 13) { return "cousin" }
        return ""
    }
    if r == "sobrino" {
        if L.age >= 13 && p.age >= 4 { return "nephew" }
        return ""
    }
    if L.age < 18 || p.age < 18 {
        if r == "pareja" && L.age >= 13 && p.age >= 13 { return "teen_partner" }
        if r == "amigo" || r == "hermano" { return "friend" }
        return ""
    }
    if r == "pareja" || r == "esposo" || r == "amante" { return "partner" }
    if r == "amigo" { return "friend" }
    if r == "hermano" { return "sibling" }
    if r == "suegro" { return "inlaw" }
    if r == "colega" { return "coworker" }
    if r == "ex" { return "ex" }
    return ""
}

function dlg_cond(cond: string, p: map) {
    if cond == "" { return true }
    if cond == "kidme" { return L.age < 13 }
    if cond == "notkid" { return L.age >= 13 }
    if cond == "elderme" { return L.age >= 60 }
    if cond == "adultnojail" { return L.age >= 18 && L.jail == 0 }
    if cond == "married" { return L.married && L.age >= 18 }
    if cond == "haskids" { return L.kids > 0 && L.age >= 18 }
    if cond == "grandbaby" { return (L.pregnant || L.partner_preg) && L.age >= 18 }
    if cond == "oldparent" { return p.age >= 65 && L.age >= 18 }
    if cond == "veryold" { return p.age >= 75 && L.age >= 13 }
    if cond == "notrecorded" { return p.recorded != true && L.age >= 13 }
    if cond == "smallkid" { return p.age < 10 }
    if cond == "adultkid" { return p.age >= 18 }
    if cond == "youngadult" { return p.age >= 18 && p.age < 30 && L.age >= 18 }
    if cond == "parentsold" {
        for q in parents_alive() {
            if q.age >= 60 { return true }
        }
        return false
    }
    if cond == "school" { return L.school != "" && L.age >= 7 }
    if cond == "teen" { return L.age >= 13 && L.age < 18 }
    if cond == "adult" { return L.age >= 18 && p.age >= 18 }
    if cond == "nojail" { return L.jail == 0 }
    if cond == "cheated" { return p.cheated == true }
    if cond == "nolive" { return p.livein != true && p.rel != "esposo" }
    if cond == "pareja" { return p.rel == "pareja" }
    if cond == "opp" { return p.gender != L.gender && p.rel != "amante" }
    if cond == "closed" { return p.open != true }
    if cond == "kinks" { return len(L.tags) > 0 }
    if cond == "single" { return L.partner_id == 0 }
    if cond == "cheated_you" { return p.cheated_you == true }
    if cond == "kidschool" { return p.age >= 6 && p.age < 18 }
    if cond == "kidteen" { return p.age >= 13 && p.age < 18 }
    if cond == "kid_hurt" { return p.bond < 50 && p.age >= 12 }
    if cond == "old_me" { return L.age >= 60 && p.age >= 25 && L.care == "" }
    if cond == "crush" {
        return p.rel == "amigo" && L.age >= 18 && p.age >= 18 && L.partner_id == 0 && (L.likes == "ambos" || L.likes == p.gender)
    }
    if str_starts_with(cond, "style:") { return npc_style(p) == str_replace(cond, "style:", "") }
    return true
}

// ---------------------------------------------------------------- flujo

function start_dialog(tree: string, p: map) {
    G.modal = null
    let ctx = {"person": p, "grades": str(L.grades), "gusto": "", "pa_word": parent_word()}
    if p.rel == "hijo" {
        kid_init(p)
        ctx["kgrades"] = str(p.grades)
        ctx["pa_word"] = by_gender(L.gender, "pa", "ma")
    }
    if len(L.tags) > 0 { ctx["gusto"] = kink_name(L.tags[0], L.gender) }
    if tree == "tuition" && G.pending_deg != "" {
        let d = degree_def(G.pending_deg)
        ctx["deg"] = d.n
        ctx["costo"] = money_str(d.cost)
    }
    G.dlg = {"tree": tree, "pid": p.id, "ctx": ctx, "opts": []}
    return dlg_show("n0", "")
}

function dlg_person() {
    if G.dlg == null { return null }
    return find_person(G.dlg.pid)
}

function dlg_say(node: map, p: map) {
    let say = node.say
    if type_of(say) != "string" {
        let b = say[dlg_band(p)]
        if b != null { say = b }
    }
    if type_of(say) == "string" { return fmt(say, G.dlg.ctx) }
    let line = say[npc_style(p)]
    if line == null { line = say["default"] }
    return fmt(line, G.dlg.ctx)
}

function dlg_chance(o: map, p: map) {
    let c = o.roll + (p.bond - 50) / 3
    let mod = STYLE_MOD[npc_style(p)]
    if mod != null { c += mod }
    if o.stat != null { c += rank(o.stat) * 6 }
    if o.money == true {
        let w = WEALTH_MOD[L.family]
        if w != null { c += w }
    }
    if o.grades == true { c += L.grades - 60 }
    if o.looks == true { c += (looks_eff() - 50) / 2 + flirt_bonus() / 2 }
    return clamp(c, 5, 95)
}

function dlg_show(id: string, prefix: string) {
    let p = dlg_person()
    if p == null { return null }
    let node = DIALOGS[G.dlg.tree][id]
    if node.opts == null { return dlg_finish(node, p, prefix) }
    let labels = []
    let locks = []
    let tags = []
    let opts = []
    for o in node.opts {
        let cond = o["if"]
        if cond != null && !dlg_cond(cond, p) { continue }
        list_push(opts, o)
        list_push(labels, fmt(o.t, G.dlg.ctx))
        let lock = ""
        if o.need != null && rank(o.need) < o.rank { lock = need_text(o.need, o.rank) }
        list_push(locks, lock)
        let tg = ""
        if o.roll != null {
            tg = str(dlg_chance(o, p)) + "%"
        } else if o.need != null {
            tg = need_text(o.need, o.rank)
        }
        list_push(tags, tg)
    }
    G.dlg.opts = opts
    let title = str_upper(p.first) + " · " + str_upper(style_name(npc_style(p), p))
    open_choice(title, dlg_tagged(prefix, dlg_say(node, p)), labels, locks, "dialog", {"person": p})
    G.modal.tags = tags
    return null
}

function dlg_choose(index: int) {
    G.modal = null
    let p = dlg_person()
    if p == null || index >= len(G.dlg.opts) { return null }
    let o = G.dlg.opts[index]
    let ctx = {"person": p}
    if o.fx != null { apply(o.fx, ctx) }
    if o.roll != null {
        if chance(dlg_chance(o, p)) { return dlg_show(o.ok, "ok") }
        return dlg_show(o.fail, "fail")
    }
    return dlg_show(o.go, "")
}

// Resultado de una tirada delante de lo que se dice: plantilla entera para
// que cada idioma la traduzca («[ÉXITO] {0}»).
function dlg_tagged(tag: string, said: string) {
    if tag == "ok" { return "[ÉXITO] " + said }
    if tag == "fail" { return "[FALLO] " + said }
    return said
}

function dlg_finish(node: map, p: map, prefix: string) {
    let ctx = {"person": p}
    let msg = dlg_tagged(prefix, dlg_say(node, p))
    if node.fx != null {
        let extra = apply(node.fx, ctx)
        if extra != "" { msg = msg + " " + extra }
    }
    let kind = node.k
    if kind == null { kind = "n" }
    let title = "Conversación con " + p.first
    let code = node.end
    G.dlg_tree = G.dlg.tree
    G.dlg = null
    if code == null { return finish(title, msg, kind) }
    return dlg_end(code, p, msg, title, kind)
}

// Consecuencias de cerrar una conversación.
function dlg_end(code: string, p: map, msg: string, title: string, kind: string) {
    if code == "pay_full" { return finish("Inscripción", msg + " " + enroll_do(G.pending_deg, "padres"), "g") }
    if code == "pay_half" { return finish("Inscripción", msg + " " + enroll_do(G.pending_deg, "mitad"), "g") }
    if code == "refuse" || code == "self" {
        if code == "refuse" { G.tuition_no = G.pending_deg }
        log_add(p.first + ": " + msg, kind)
        open_enroll_pay(G.pending_deg)
        if G.modal != null { G.modal.text = msg + "\n\n" + G.modal.text }
        return null
    }
    if code == "parent_money" {
        let r = parent_money_range()
        let amount = rint(r[0], r[1])
        if amount >= 100 { amount = amount / 10 * 10 }
        L.money += amount
        return finish(title, msg + " Te da " + money_str(amount) + ".", kind)
    }
    if code == "teen_break" {
        breakup()
        return finish(title, msg, kind)
    }
    if code == "record" {
        p.recorded = true
        add_hito(p, "Grabaste sus historias")
        return finish(title, msg, kind)
    }
    if code == "parent_better" {
        if p.style == "toxico" || p.style == "ausente" { p.style = "relajado" }
        return finish(title, msg + " Su relación cambió para bien.", kind)
    }
    if code == "livein" {
        p.livein = true
        flag("livein")
        add_hito(p, "Se fueron a vivir juntos")
        return finish(title, msg, kind)
    }
    if code == "marry" {
        add_hito(p, "Se comprometieron")
        hito_once("engaged", "Amor", "Te comprometiste")
        if msg != "" { log_add(msg, kind) }
        return begin_wedding(p)
    }
    if code == "baby" { return finish(title, msg + try_baby(p), kind) }
    if code == "open" {
        p.open = true
        flag("open")
        return finish(title, msg, kind)
    }
    if code == "kink_yes" {
        sex_with(p)
        flag("kink")
        return finish(title, msg, kind)
    }
    if code == "kink_ask" {
        let likes = "nada en especial"
        if p.tags != null && len(p.tags) > 0 { likes = kinks_text(p.tags, p.gender) }
        let out = msg + " Le gusta: " + likes + "."
        if len(shared_kinks(p)) > 0 { out = out + " ¡Comparten gustos!" }
        return finish(title, out, kind)
    }
    if code == "kink_new" {
        sex_with(p)
        let options = []
        for k in KINKS {
            if !has_kink(k.id) { list_push(options, k.id) }
        }
        let out = msg
        if len(options) > 0 { out = out + special("kink:" + pick(options), {}) }
        return finish(title, out, kind)
    }
    if code == "tests" {
        let theirs = npc_ills(p)
        let out = msg
        if len(theirs) > 0 {
            let names = []
            for id in theirs { list_push(names, ill_def(id).n) }
            out = out + " " + p.first + " salió positiv" + oa(p.gender) + " a " + str_join(names, ", ") + ". Empieza tratamiento."
            let keep = []
            for id in theirs {
                if !ill_def(id).cure { list_push(keep, id) }
            }
            p.ills = keep
        } else {
            out = out + " " + p.first + " está limpi" + oa(p.gender) + "."
        }
        let mine = []
        for i in L.ill {
            if ill_def(i.id).type == "its" {
                i.known = true
                list_push(mine, ill_def(i.id).n)
            }
        }
        if len(mine) > 0 { out = out + " Tú saliste positiv" + oa(L.gender) + " a " + str_join(mine, ", ") + "." } else { out = out + " Tú también." }
        return finish(title, out, kind)
    }
    if code == "clear_them" {
        p.cheated_you = false
        return finish(title, msg, kind)
    }
    if code == "care" {
        p.carer = true
        L.care = "kid"
        return finish(title, msg, kind)
    }
    if code == "clear_cheat" {
        p.cheated = false
        return finish(title, msg, kind)
    }
    if code == "dumped" {
        p.cheated = false
        breakup()
        return finish(title, msg, kind)
    }
    if code == "calm" {
        p.style = "dulce"
        return finish(title, msg, kind)
    }
    if code == "friend_money" {
        let amount = rint(5, 30) * 100
        L.money += amount
        return finish(title, msg + " Te presta " + money_str(amount) + ".", kind)
    }
    if code == "lovers" || code == "back" {
        let out = msg
        if make_partner(p) { out = out + " Ahora " + p.first + " es tu " + str_lower(rel_label(p)) + "." }
        return finish(title, out, kind)
    }
    if code == "biz_win" {
        let amount = rint(5, 30) * 1000
        L.money += amount
        bond_gain(p, 8)
        return finish(title, msg + " Ganaron " + money_str(amount) + " cada quien.", kind)
    }
    if code == "hookup" {
        log_add(msg, kind)
        return open_hookup({"person": p})
    }
    return finish(title, msg, kind)
}

function try_baby(p: map) {
    if L.pregnant || L.partner_preg { return " Ya viene un bebé en camino." }
    let age = p.age
    if L.gender == "f" { age = L.age }
    if age > 45 { return " A estas alturas ya no es posible." }
    if p.gender == L.gender { return " Entre ustedes dos, así no va a pasar. Pueden adoptar o buscar un tratamiento." }
    let f = my_fertility() * their_fertility(p) / 100
    if f <= 0 { return " Los médicos lo dijeron claro: así no va a pasar. ¿Adopción o tratamiento?" }
    G.sex_mode = "raw"
    sex_with(p)
    G.sex_mode = ""
    if !chance(15 + f * 45 / 100) { return " Este mes no hubo suerte (pero sí diversión)." }
    if L.gender == "f" {
        L.pregnant = true
        L.preg_with = p.first
        return " ¡Estás embarazada!"
    }
    L.partner_preg = true
    return " ¡" + p.first + " está embarazada!"
}
