    {"id": "msgs", "n": "Mensajes", "fill": "#2fbf71", "min": 12},
    {"id": "flama", "n": "Flama", "fill": "#ff5a36", "min": 18},
    {"id": "alma", "n": "Alma Gemela", "fill": "#ff7ac8", "min": 18},
    {"id": "gram", "n": "Velvetgram", "fill": "#9b3cf0", "min": 12},
    {"id": "vfans", "n": "VelvetFans", "fill": "#1e9bff", "min": 18},
    {"id": "vhub", "n": "VelvetHub", "fill": "#ff9a00", "min": 18},
    {"id": "bank", "n": "Banco", "fill": "#ffd21f", "min": 12},
    {"id": "stocks", "n": "Bolsa", "fill": "#f7f7f2", "min": 18},
    {"id": "casino", "n": "Casino", "fill": "#0d0d0d", "min": 18},
    {"id": "jobs", "n": "Empleos", "fill": "#3a3a3a", "min": 14},
    {"id": "shop", "n": "Tienda", "fill": "#e3141b", "min": 12},
    {"id": "health", "n": "Salud", "fill": "#f7f7f2", "min": 12},
    {"id": "memories", "n": "Recuerdos", "fill": "#ffd21f", "min": 12},
    {"id": "agenda", "n": "Agenda", "fill": "#e3141b", "min": 12},
    {"id": "route", "n": "Mi Ruta", "fill": "#0d0d0d", "min": 12},
    {"id": "faith", "n": "Fe", "fill": "#f7f7f2", "min": 12},
    {"id": "settings", "n": "Ajustes", "fill": "#3a3a3a", "min": 12}
]

const PHONE_MODELS = [
    {"n": "Ladrillo con tapa", "cost": 0, "d": "Indestructible, con juego de la viborita. Las fotos parecen pinturas impresionistas."},
    {"n": "VelvetPhone 12", "cost": 800, "d": "Buena cámara y batería decente. Tus selfies mejoran."},
    {"n": "VelvetPhone Pro", "cost": 2500, "d": "Tres cámaras, modo retrato y una pantalla que brilla. Más seguidores, más matches."},
    {"n": "VelvetPhone Pro Max dorado", "cost": 12000, "d": "Bañado en oro. No hace nada distinto, pero todos lo notan."}
]

const WALLS = [["#ff2b31", "#8f0b11"], ["#2a2a2a", "#050505"], ["#ff7ac8", "#6a1546"], ["#ffd21f", "#b86b00"], ["#2f63b8", "#0b1a3d"]]
const WALL_NAMES = ["Rojo Velvet", "Noche", "Rosa", "Oro", "Azul medianoche"]

const FLAMA_LINES_GOOD = [
    "Vi que te gusta {int}. ¿Me recomiendas algo? Quiero entender qué te apasiona.",
    "Tu foto haciendo {int} me sacó una sonrisa. ¿Desde cuándo te gusta?",
    "Pregunta seria: ¿{int} un domingo en la tarde o un sábado de noche?"
]
