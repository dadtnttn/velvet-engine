const FLAMA_LINES_BAD = [
    "¿Eres un préstamo bancario? Porque tienes todo mi interés.",
    "Mándame tu número, que no uso mucho la app.",
    "¿Te dolió cuando caíste del cielo? A mí sí, me torcí el tobillo.",
