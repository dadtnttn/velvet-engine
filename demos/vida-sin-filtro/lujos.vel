    {"id": "chofer", "n": "Chofer", "c": 2500, "d": "Te lleva a todas partes: elígelo como transporte en Finanzas › Gastos.", "fx": {}},
    {"id": "entrenador", "n": "Entrenador personal", "c": 1500, "d": "Te saca de la cama a las 6 a. m. para entrenar.", "fx": {"looks": 3, "hp": 1}},
    {"id": "asistente", "n": "Asistente personal", "c": 3500, "d": "Agenda, correos y pendientes: rindes más en el trabajo.", "fx": {"pay": 4}},
    {"id": "ninera", "n": "Niñera", "c": 1800, "d": "Cuida a tus hijos pequeños mientras trabajas.", "fx": {}},
    {"id": "mayordomo", "n": "Mayordomo", "c": 4000, "d": "Elegancia en tu puerta: tus invitados quedan impresionados. Necesitas casa propia.", "fx": {"flirt": 3}},
    {"id": "jardinero", "n": "Jardinero", "c": 500, "d": "Tu jardín parece de revista. Necesitas casa propia.", "fx": {}},
    {"id": "guardaespaldas", "n": "Guardaespaldas", "c": 5000, "d": "Nadie se acerca sin permiso: te protege de robos y extorsiones.", "fx": {}},
    {"id": "estilista", "n": "Estilista personal", "c": 2000, "d": "Siempre perfect{a} para cualquier foto.", "fx": {"looks": 5}}
]

