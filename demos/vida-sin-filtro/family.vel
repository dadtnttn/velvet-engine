// ---------------------------------------------------------------- hijos

function kids_alive() {
    return list_filter(L.people, fn(p) => p.alive && p.rel == "hijo")
}

function kid_init(p: map) {
    if p.kinit == true { return p }
    p.kinit = true
    if p.style == null || !list_contains(KID_STYLES, p.style) { p.style = pick(KID_STYLES) }
    p.smarts = clamp(L.smarts / 2 + rint(10, 50), 5, 100)
    if p.style == "genio" { p.smarts = clamp(p.smarts + 25, 0, 100) }
    p.grades = clamp(30 + p.smarts / 2, 0, 100)
    p.home = true
    p.tuition = ""
    p.degree = ""
    p.job = ""
    p.wed = false
    p.study_m = 0
    return p
}

function setup_family_styles() {
    for p in L.people {
        if (p.rel == "padre" || p.rel == "madre") && p.style == null {
            p.style = PARENT_STYLES[weighted_choose(G.rng, [30, 25, 20, 15, 10])]
        }
    }
}

function hij(p: map) {
    return by_gender(p.gender, "hijo", "hija")
}

function parent_word() {
    return by_gender(L.gender, "padre", "madre")
}

function parenting_label() {
    let s = L.parent_score
    if s >= 75 { return by_gender(L.gender, "Padre ejemplar", "Madre ejemplar") }
    if s >= 55 { return by_gender(L.gender, "Buen padre", "Buena madre") }
    if s >= 40 { return by_gender(L.gender, "Padre normal", "Madre normal") }
    if s >= 25 { return by_gender(L.gender, "Padre ausente", "Madre ausente") }
    return by_gender(L.gender, "Pésimo padre", "Pésima madre")
}

function kid_ctx(p: map) {
    return {"person": p, "hij": hij(p)}
}

// Cada mes: colegiaturas que pagas y alguna petición de tus hijos.
function kids_month() {
    for p in kids_alive() {
        kid_init(p)
        if p.tuition != "" && p.study_m > 0 {
            let fee = 2500
            if p.tuition == "half" { fee = 1250 }
            if p.tuition == "self" { fee = 0 }
            L.money -= fee
            p.study_m -= 1
            if p.study_m == 0 {
                p.degree = "título universitario"
                log_add("¡Tu " + hij(p) + " " + p.first + " se graduó de la universidad!", "g")
                add_hito(p, "Se graduó de la universidad")
                if p.tuition != "self" { p.bond = clamp100(p.bond + 10) }
                L.happy += 8
                p.tuition = ""
            }
        }
    }
    return null
}

function maybe_kid_event() {
    if G.modal != null || L.jail > 0 || !chance(9) { return false }
    let kids = kids_alive()
    if len(kids) == 0 { return false }
    let p = kid_init(pick(kids))
    let pool = []
    let weights = []
    for ev in KID_EVENTS {
        if p.age < ev.kid[0] || p.age > ev.kid[1] { continue }
        if ev.repeat != true && list_contains(kid_reqs(p), ev.id) { continue }
        if ev.req == "grandkids" && !has_grandkids(p) { continue }
        if ev.id == "k_uni" && (p.tuition != "" || p.degree != "") { continue }
        list_push(pool, ev)
        list_push(weights, ev.w)
    }
    if len(pool) == 0 { return false }
    let ev = pool[weighted_choose(G.rng, weights)]
    list_push(kid_reqs(p), ev.id)
    open_event(ev, kid_ctx(p))
    G.modal.title = fmt(ev.title, kid_ctx(p))
    return true
}

function kid_event(id: string) {
    for e in KID_EVENTS {
        if e.id == id { return e }
    }
    return KID_EVENTS[0]
}

function kid_reqs(p: map) {
    if p.reqs == null { p.reqs = [] }
    return p.reqs
}

function has_grandkids(p: map) {
    for q in L.people {
        if q.alive && q.rel == "nieto" && q.parent == p.id { return true }
    }
    return false
}

// Cada año: crecen, estudian, se van de casa, se casan y te dan nietos.
function kids_year() {
    let old_score = L.parent_score
    for p in kids_alive() {
        kid_init(p)
        // Cómo los tratas pesa en lo que sienten por ti.
        p.bond = clamp100(p.bond + (L.parent_score - 50) / 12)
        if L.jail > 0 { p.bond = clamp100(p.bond - 8) }
        if L.alcohol + L.drugs >= 50 { p.bond = clamp100(p.bond - 5) }
        if p.age >= 6 && p.age < 18 {
            let target = 30 + p.smarts / 2
            if p.style == "flojo" { target -= 10 }
            p.grades = clamp(p.grades + (target - p.grades) / 4 + rint(-4, 4), 0, 100)
        }
        if p.age == 18 {
            log_add("Tu " + hij(p) + " " + p.first + " cumplió 18 años.", "n")
            add_hito(p, "Cumplió 18 años")
        }
        if p.home && p.age >= 19 && chance(18) {
            p.home = false
            log_add(p.first + " se fue de la casa. El nido se siente vacío.", "n")
        }
        if p.age >= 22 && p.job == "" && chance(40) {
            let r = pick(CAREER_ROWS)
            if !str_contains(r[8], "h") && !str_contains(r[8], "x") {
                p.job = by_gender(p.gender, r[1], r[2])
                log_add("Tu " + hij(p) + " " + p.first + " consiguió trabajo como " + str_lower(p.job) + ".", "n")
            }
        }
        if p.age >= 24 && !p.wed && chance(8) {
            p.wed = true
            log_add("¡" + p.first + " se casó!", "g")
            add_hito(p, "Se casó")
        }
        if p.age >= 24 && p.age <= 42 && chance(9) {
            let g = pick(["m", "f"])
            let baby = make_person(g, "nieto", 0)
            baby.last = p.last
            baby.look.skin = p.look.skin
            baby.parent = p.id
            baby.bond = 70
            add_person(baby)
            L.happy += 8
            log_add("¡Eres " + by_gender(L.gender, "abuelo", "abuela") + "! " + p.first + " tuvo " + by_gender(g, "un niño", "una niña") + ": " + baby.first + ".", "g")
            if !hito_once("first_grandchild", "Familia", "Te convertiste en " + by_gender(L.gender, "abuelo", "abuela")) { hito_me("Familia", "Nació tu nieto " + baby.first) }
        }
        // En tu vejez, los hijos que te quieren te cuidan.
        if L.age >= 70 && p.age >= 25 && p.bond >= 60 && chance(40) {
            L.health += 3
            L.happy += 3
            if chance(30) { log_add(p.first + " te visita seguido y te cuida. Valió la pena.", "g") }
        }
    }
    L.parent_score = clamp100(L.parent_score + (50 - L.parent_score) / 10)
    if old_score >= 0 { return null }
    return null
}

function kid_items_for(p: map) {
    kid_init(p)
    let out = []
    let s = p.style
    if p.age >= 6 && p.age < 18 {
        list_push(out, {"action": "pact:homework", "t": "Ayudarle con la tarea", "s": "Calificaciones " + str(p.grades)})
        list_push(out, {"action": "pact:ground", "t": "Castigarl" + oa(p.gender), "s": "Disciplina (le duele)"})
    }
    if p.age >= 12 {
        list_push(out, {"action": "pact:allowance", "t": "Darle dinero ($2,000)", "s": "Cercanía"})
    }
    if p.age >= 17 && p.age <= 26 && p.tuition == "" && p.degree == "" {
        list_push(out, {"action": "pact:kiduni", "t": "Pagarle la universidad", "s": "$2,500 al mes, 4 años"})
    }
    if p.age >= 18 && p.home {
        list_push(out, {"action": "pact:kickout", "t": "Echarl" + oa(p.gender) + " de la casa", "s": "Que se independice"})
    }
    if L.heir_id == p.id {
        list_push(out, {"action": "pact:unheir", "t": "Quitarl" + oa(p.gender) + " del testamento", "s": "Heredero actual"})
    } else {
        list_push(out, {"action": "pact:heir", "t": "Nombrarl" + oa(p.gender) + " tu heredero", "s": "Lo hereda todo y podrás seguir como " + by_gender(p.gender, "él", "ella")})
    }
    return out
}

function do_kid_act(action: string, p: map) {
    kid_init(p)
    let name = p.first
    let key = "k" + action + str(p.id)
    let limited = action == "homework" || action == "ground" || action == "allowance"
    if limited && L.used[key] != null { return info(name, "Ya hiciste eso este mes con " + name + ".") }
    if limited { L.used[key] = 1 }
    if action == "homework" {
        p.grades = clamp(p.grades + rint(3, 8) + rank("know"), 0, 100)
        bond_gain(p, 4)
        L.parent_score = clamp100(L.parent_score + 2)
        return finish(name, "Pasaron la tarde estudiando juntos. Sus calificaciones suben a " + str(p.grades) + ".", "g")
    }
    if action == "ground" {
        p.grades = clamp(p.grades + rint(1, 4), 0, 100)
        let hurt = 8
        if p.style == "rebelde" { hurt = 15 }
        bond_gain(p, -hurt)
        return finish(name, "Sin celular ni salidas por un mes. " + name + " te odia un poquito, pero estudia más.", "n")
    }
    if action == "allowance" {
        if L.money < 2000 { return info(name, "No te alcanza.") }
        L.money -= 2000
        bond_gain(p, 6)
        return finish(name, "Le diste $2,000 a " + name + ". Te dio el abrazo más rápido de la historia.", "g")
    }
    if action == "kiduni" {
        G.modal = null
        list_push(kid_reqs(p), "k_uni")
        let ev = kid_event("k_uni")
        open_event(ev, kid_ctx(p))
        G.modal.title = fmt(ev.title, kid_ctx(p))
        return null
    }
    if action == "kickout" {
        p.home = false
        bond_gain(p, -30)
        L.parent_score = clamp100(L.parent_score - 8)
        return finish(name, "Le pusiste las maletas en la puerta a " + name + ". «Ya es hora de que vueles.» No lo tomó bien.", "b")
    }
    if action == "heir" {
        L.heir_id = p.id
        add_hito(p, "L" + oa(p.gender) + " nombraste tu " + by_gender(p.gender, "heredero", "heredera"))
        toast("TESTAMENTO", name + " es tu heredero" + by_gender(p.gender, "", "a") + " universal.")
        return finish("Testamento", "Firmaste tu testamento: " + name + " lo heredará todo. Su parte dependerá de cómo te trate.", "n")
    }
    if action == "unheir" {
        L.heir_id = 0
        return finish("Testamento", "Quitaste a " + name + " del testamento. Si mueres sin heredero, la ruleta decidirá.", "n")
    }
    return null
}

function kid_special(name: string, ctx: map) {
    let p = ctx["person"]
    if name == "kid_tuition_full" || name == "kid_tuition_half" || name == "kid_tuition_self" {
        if p == null { return "" }
        kid_init(p)
        p.tuition = str_replace(name, "kid_tuition_", "")
        p.study_m = 48
        return ""
    }
    if name == "kid_wed" {
        if p != null { p.wed = true }
        return ""
    }
    // Para eventos de legado: la persona del evento no es el hijo.
    if name == "kid_shame" || name == "kid_bond_up" {
        let k = find_person(L.legacy_kid)
        if k == null { return "" }
        if name == "kid_shame" {
            k.bond = clamp100(k.bond - 20)
            return " La relación con " + k.first + " se enfrió."
        }
        k.bond = clamp100(k.bond + 12)
        return ""
    }
    if name == "comeback" { return comeback() }
    return ""
}

// ---------------------------------------------------------------- carreras pasadas

const ADULT_PAST = ["porn", "stripper", "escort", "cam"]

function remember_job(id: string) {
    if !list_contains(L.past_jobs, id) { list_push(L.past_jobs, id) }
}

function past_adult() {
    for id in L.past_jobs {
        if list_contains(ADULT_PAST, id) || job_def(id).adult { return id }
    }
    return ""
}

function past_adult_label() {
    let id = past_adult()
    if id == "" { return "" }
    if id == "porn" { return "el cine para adultos" }
    if id == "stripper" { return "los clubes de striptease" }
    if id == "escort" { return "el mundo de las escorts" }
    if id == "cam" { return "las transmisiones +18" }
    return "la industria para adultos"
}

function comeback() {
    let id = past_adult()
    if id == "" || job_def(id) == null { id = "porn" }
    if L.job != null { L.last_job = L.job.title }
    L.job = new_job(id)
    L.job.level = 2
    L.job.xp = XP_TABLE[2]
    L.job.spec = by_gender(L.gender, "DILF +18", "MILF +18")
    L.job.bonus = 150
    L.fame = clamp100(L.fame + 12)
    flag("comeback")
    list_push(G.toasts, {"head": "¡REGRESO!", "title": str_upper(L.job.spec), "sub": L.job.title + " · rango 3", "t0": G.t})
    return " Vuelves como " + str_lower(L.job.title) + " especialidad " + L.job.spec + ". Los fans de lo maduro te esperaban."
}

// Etiquetas req de los eventos de legado (las consulta meets en events.vel).
function legacy_meets(tag: string) {
    if tag == "pastadult" { return past_adult() != "" }
    if tag == "pastporn" { return list_contains(L.past_jobs, "porn") || list_contains(L.past_jobs, "cam") }
    if tag == "pastadult18" { return past_adult() != "" }
    if tag == "notadultnow" { return !job_is_adult(L.job) }
    if tag == "normaljob" { return L.job != null && !job_is_adult(L.job) }
    if tag == "kidadult" { return pick_kid(20, 60) != null }
    if tag == "kidschool" { return pick_kid(6, 17) != null }
    if tag == "kidteen" { return pick_kid(15, 25) != null }
    if tag == "parentstar" { return L.parent_star != "" }
    if tag == "oldparent" { return L.age >= 25 && old_parent() != null }
    return false
}

function pick_kid(lo: int, hi: int) {
    for p in kids_alive() {
        if p.age >= lo && p.age <= hi { return p }
    }
    return null
}

function old_parent() {
    for p in L.people {
        if p.alive && (p.rel == "padre" || p.rel == "madre") && p.age >= 72 && p.cared != true { return p }
    }
    return null
}

// Contexto (persona y marcadores) de los eventos de legado.
function legacy_ctx(ev: map) {
    let ctx = {"pasado": past_adult_label()}
    let lo = 15
    let hi = 70
    if str_contains(ev.req, "kidadult") { lo = 20 }
    if str_contains(ev.req, "kidschool") {
        lo = 6
        hi = 17
    }
    if str_contains(ev.req, "kidteen") {
        lo = 15
        hi = 25
    }
    let k = pick_kid(lo, hi)
    if k != null {
        L.legacy_kid = k.id
        ctx["k"] = k.first
        ctx["hij"] = hij(k)
        ctx["ka"] = oa(k.gender)
    }
    ctx["padre"] = by_gender(L.parent_star_g, "padre", "madre")
    ctx["pa2"] = oa(L.parent_star_g)
    let spec = ev["person"]
    if spec == "kidfriend" && k != null {
        ctx["person"] = stranger_aged(max(18, k.age - 2), max(18, k.age + 3))
    } else if spec == "oldparent" {
        let p = old_parent()
        ctx["person"] = p
        if p != null {
            p.cared = true
            ctx["padre"] = str_lower(rel_label(p))
        }
    } else if spec == "near" {
        ctx["person"] = stranger()
    } else if spec != null && type_of(spec) == "list" {
        ctx["person"] = stranger_aged(spec[0], spec[1])
    }
    return ctx
}

// ---------------------------------------------------------------- vejez

function old_age_year() {
    if L.age == 65 && L.job != null && G.modal == null {
        open_choice("JUBILACIÓN", "Cumpliste 65. Puedes jubilarte y cobrar una pensión del 40% de tu sueldo (" + money_str(pay_of(L.job) * 40 / 100) + " al año), o seguir trabajando.",
            ["Jubilarme", "Seguir trabajando"], ["", ""], "retire", {})
    }
    if L.age >= 75 && L.health < 40 && L.care == "" {
        let k = null
        for p in kids_alive() {
            if p.age >= 25 && p.bond >= 60 && (k == null || p.bond > k.bond) { k = p }
        }
        if k != null {
            L.care = "kid"
            log_add(k.first + " te llevó a vivir a su casa para cuidarte. No estás sol" + oa(L.gender) + ".", "g")
            L.happy += 10
        } else if L.money >= 150000 {
            L.care = "lujo"
            L.money -= 100000
            log_add("Te mudaste a una residencia de lujo con alberca y bingo los jueves.", "n")
        } else {
            L.care = "asilo"
            L.happy -= 15
            log_add("Nadie pudo cuidarte. Terminaste en un asilo público. Tus hijos casi no te visitan.", "b")
        }
    }
    if L.care == "kid" { L.health += 2 }
    if L.care == "asilo" { L.happy -= 3 }
    return null
}

function resolve_retire(index: int) {
    G.modal = null
    if index == 1 { return finish("Jubilación", "Sigues al pie del cañón. El trabajo te mantiene joven.", "n") }
    L.pension = pay_of(L.job) * 40 / 100
    L.last_job = L.job.title
    L.job = null
    L.job2 = null
    L.happy += 10
    flag("retired")
    hito_me("Trabajo", "Te jubilaste")
    return finish("Jubilación", "¡Te jubilaste! Cobrarás " + money_str(L.pension) + " al año. Ahora sí: viajes, nietos y siestas.", "g")
}

// ---------------------------------------------------------------- muerte, funeral y herencia

function estate_value() {
    let total = net_worth()
    // El seguro de vida va directo a los herederos.
    if L.lx != null { total += L.lx.life_cov }
    return max(0, total)
}

function merit(p: map) {
    return clamp(p.bond, 0, 100)
}

// Al morir: funeral y quién hereda.
function on_death() {
    vida_on_death()
    let mourners = []
    for p in L.people {
        if p.alive && p.bond >= 50 && p.age >= 4 { list_push(mourners, p.first) }
    }
    let crowd = len(mourners) + L.fame * 3
    L.funeral = {"n": crowd, "names": list_slice(mourners, 0, min(4, len(mourners)))}
    let heirs = []
    for p in kids_alive() { list_push(heirs, p.id) }
    G.legacy = {"heirs": heirs, "estate": estate_value(), "heir": 0, "share": 0}
    G.roul = null
    if len(heirs) == 0 { return null }
    let named = find_person(L.heir_id)
    if named != null && named.alive && named.rel == "hijo" {
        legacy_set_heir(named)
    } else if len(heirs) == 1 {
        legacy_set_heir(find_person(heirs[0]))
    }
    return null
}

function legacy_set_heir(p: map) {
    G.legacy.heir = p.id
    // Si te trató bien recibe casi todo; si no, la mayor parte se pierde en impuestos y pleitos.
    G.legacy.share = G.legacy.estate * (30 + merit(p) * 70 / 100) / 100
}

function funeral_text() {
    let f = L.funeral
    if f == null { return "" }
    if f.n == 0 { return "Nadie fue a tu funeral." }
    let who = ""
    if len(f.names) > 0 { who = " Lloraron " + str_join(f.names, ", ") + "." }
    if f.n >= 100 { return "Una multitud de " + str(f.n) + " personas despidió a una leyenda." + who }
    return str(f.n) + " " + plural(f.n, "persona fue", "personas fueron") + " a tu funeral." + who
}

// Ruleta: los hijos con más méritos ocupan más espacio en la rueda.
function start_roulette() {
    if G.legacy == null || len(G.legacy.heirs) < 2 || G.roul != null { return null }
    let weights = []
    let names = []
    for id in G.legacy.heirs {
        let p = find_person(id)
        list_push(weights, max(5, merit(p)))
        list_push(names, p.first)
    }
    let idx = weighted_choose(G.rng, weights)
    let total = 0
    for w in weights { total += w }
    let start = 0
    let i = 0
    while i < idx {
        start += weights[i]
        i += 1
    }
    let center = (start * 2 + weights[idx]) * 180.0 / total
    G.roul = {"ids": G.legacy.heirs, "w": weights, "names": names, "total": total, "idx": idx, "t0": G.t, "final": 360.0 * 6.0 - center, "done": false}
    return null
}

function roulette_angle() {
    let r = G.roul
    let p = clamp((G.t - r.t0) / 4.0, 0.0, 1.0)
    let u = 1.0 - p
    return r.final * (1.0 - u * u * u * u)
}

function roulette_tick() {
    let r = G.roul
    if r == null || r.done { return false }
    if G.t - r.t0 >= 4.1 {
        r.done = true
        legacy_set_heir(find_person(r.ids[r.idx]))
        return true
    }
    return true
}

const ROUL_FILLS = ["#e3141b", "#f7f7f2", "#0d0d0d", "#ffd21f"]
const ROUL_INKS = ["#f7f7f2", "#0d0d0d", "#f7f7f2", "#0d0d0d"]

function roulette_doc(angle: float) {
    let r = G.roul
    let body = "<g transform='rotate(" + str(angle) + " 200 200)'>"
    let a0 = 0.0
    let i = 0
    let n = len(r.w)
    while i < n {
        let a1 = a0 + r.w[i] * 360.0 / r.total
        let x0 = 200.0 + 180.0 * sin(a0 * 0.0174533)
        let y0 = 200.0 - 180.0 * cos(a0 * 0.0174533)
        let x1 = 200.0 + 180.0 * sin(a1 * 0.0174533)
        let y1 = 200.0 - 180.0 * cos(a1 * 0.0174533)
        let large = 0
        if a1 - a0 > 180.0 { large = 1 }
        let fill = ROUL_FILLS[i % 4]
        if n % 4 == 1 && i == n - 1 && i > 0 { fill = ROUL_FILLS[1] }
        body = body + "<path d='M200 200 L" + str(x0) + " " + str(y0) + " A180 180 0 " + str(large) + " 1 " + str(x1) + " " + str(y1) + " Z' fill='" + fill + "' stroke='#0d0d0d' stroke-width='4'/>"
        let mid = (a0 + a1) / 2.0
        let tx = 200.0 + 112.0 * sin(mid * 0.0174533)
        let ty = 200.0 - 112.0 * cos(mid * 0.0174533)
        body = body + "<text x='" + str(tx) + "' y='" + str(ty + 8.0) + "' font-family='Impact' font-size='26' text-anchor='middle' fill='" + ROUL_INKS[i % 4] + "' transform='rotate(" + str(mid) + " " + str(tx) + " " + str(ty) + ")'>" + str_upper(r.names[i]) + "</text>"
        a0 = a1
        i += 1
    }
    body = body + "</g><circle cx='200' cy='200' r='186' fill='none' stroke='#0d0d0d' stroke-width='10'/><circle cx='200' cy='200' r='22' fill='#0d0d0d' stroke='#f7f7f2' stroke-width='4'/>"
    body = body + "<polygon points='176,0 224,0 200,44' fill='#ffd21f' stroke='#0d0d0d' stroke-width='5'/>"
    return svg_doc(400, 400, body)
}

// Seguir jugando como tu heredero.
function continue_as_heir() {
    let lg = G.legacy
    if lg == null || lg.heir == 0 { return null }
    let kid = find_person(lg.heir)
    if kid == null { return null }
    kid_init(kid)
    let old = L
    let money = lg.share
    let gender = kid.gender
    let likes = by_gender(gender, "f", "m")
    if chance(10) { likes = "ambos" } else if chance(8) { likes = gender }
    let trait = KID_TRAIT[kid.style]
    if trait == null { trait = TRAITS[rint(0, len(TRAITS) - 1)].id }
    let family = "pobre"
    if lg.estate >= 50000 { family = "media" }
    if lg.estate >= 500000 { family = "rica" }
    G.cre = {"chars": [], "gender": gender, "likes": likes, "look": kid.look, "trait": trait, "tags": random_kinks(rint(1, 3)), "page": 0, "first": kid.first, "last": old.last1 + " " + pick(SURNAMES)}
    let gen = old.gen + 1
    let lineage = list_slice(old.lineage, 0, len(old.lineage))
    list_push(lineage, old.first)
    new_life_core(kid.age)
    L.gen = gen
    L.lineage = lineage
    L.religion = religion_of(kid)
    L.faith = faith_of(kid)
    L.looks = clamp100(kid.looks)
    L.smarts = clamp100(kid.smarts)
    L.grades = kid.grades
    L.money = money
    L.family = family
    vida_heir()
    // Lo que heredas de tus padres: algo de lo que aprendieron.
    for k in SOCIAL_KEYS { gain(k, old.social[k] / 5) }
    if merit(kid) < 40 {
        L.happy = 35
        L.karma = 40
    }
    if L.age >= 12 { L.edu = 1 }
    if L.age >= 18 { L.edu = 2 }
    if L.age >= 6 && L.age < 12 { L.school = "primaria" }
    if L.age >= 12 && L.age < 18 { L.school = "secundaria" }
    if kid.degree != "" { L.edu = 3 }
    if past_adult_old(old) != "" {
        L.parent_star = past_adult_old(old)
        L.parent_star_g = old.gender
    }
    // Tu familia: el padre o madre que murió, tu otro padre (su pareja) y tus hermanos.
    let me = make_person(old.gender, by_gender(old.gender, "padre", "madre"), old.age)
    me.first = old.first
    me.last = old.last1
    me.look = old.look
    me.alive = false
    me.bond = kid.bond
    add_person(me)
    let mate = null
    for p in old.people {
        if p.alive && p.id == old.partner_id && p.gender != old.gender { mate = p }
    }
    if mate != null {
        let other = make_person(mate.gender, by_gender(mate.gender, "padre", "madre"), mate.age)
        other.first = mate.first
        other.last = mate.last
        other.look = mate.look
        other.bond = rint(50, 85)
        add_person(other)
    }
    for p in old.people {
        if !p.alive { continue }
        if p.rel == "hijo" && p.id != kid.id {
            let sib = make_person(p.gender, "hermano", p.age)
            sib.first = p.first
            sib.last = p.last
            sib.look = p.look
            sib.bond = clamp100((p.bond + kid.bond) / 2)
            add_person(sib)
        }
        if p.rel == "nieto" && p.parent == kid.id {
            let child = make_person(p.gender, "hijo", p.age)
            child.first = p.first
            child.last = p.last
            child.look = p.look
            child.bond = 85
            add_person(child)
            L.kids += 1
        }
    }
    setup_family_styles()
    corona_inherit(old)
    log_add("Generación " + str(gen) + ": continúas como " + kid.first + ", " + hij(kid) + " de " + old.first + ".", "x")
    hito_me("Familia", "Heredaste el legado de " + old.first)
    let how = "heredaste " + money_str(money) + "."
    if money == 0 { how = "no quedó nada que heredar." }
    log_add("Tu " + str_lower(parent_word_of(old.gender)) + " murió por " + old.cause + " y " + how, "n")
    if merit(kid) < 40 { log_add("Tu relación con " + old.first + " era mala: empiezas con el corazón roto y poca herencia.", "b") }
    G.legacy = null
    G.roul = null
    G.screen_t0 = G.t
    G.floats = []
    let got = "Heredaste " + money_str(money) + "."
    if money == 0 { got = "No quedó nada que heredar." }
    return info("NUEVA GENERACIÓN", "Ahora eres " + kid.first + " (" + str(kid.age) + " años). " + got + " Tu historia familiar continúa.")
}

function parent_word_of(g: string) {
    return by_gender(g, "Padre", "Madre")
}

function past_adult_old(old: map) {
    for id in old.past_jobs {
        if list_contains(ADULT_PAST, id) { return id }
    }
    return ""
}

function legacy_action(action: string) {
    if action == "legacy:spin" { return start_roulette() }
    if action == "legacy:go" { return continue_as_heir() }
    return null
}

// Panel de herencia en la pantalla de muerte.
function draw_legacy() {
    let lg = G.legacy
    panel(872, 120, 380, 430, 18)
    tag(900, 134, 190, "HERENCIA", HEX_RED, C_WHITE)
    text(900, 186, "Patrimonio: " + money_str(lg.estate), 16, C_YELLOW, "impact")
    if lg.heir != 0 {
        let p = find_person(lg.heir)
        svg(900, 200, 150, 180, portrait_doc(p.look, p.gender, p.age, person_mood(p)))
        textw(1060, 236, str_upper(p.first), 24, C_WHITE, "impact", 180)
        text(1060, 260, str(p.age) + " años · cercanía " + str(p.bond) + "%", 13, C_GRAY, "bold")
        text(1060, 300, "HEREDA", 12, C_GRAY, "bold")
        text(1060, 326, money_str(lg.share), 22, C_YELLOW, "impact")
        let note = "Te quería: recibe casi todo."
        if merit(p) < 40 { note = "Se llevaban mal: recibe poco." } else if merit(p) < 70 { note = "Recibe una buena parte." }
        let ty = 404
        for line in wrap_px(note, 320, 15) {
            text(900, ty, line, 15, C_WHITE, "bold")
            ty += 22
        }
        menu_word(888, 470, 350, 60, "SEGUIR COMO " + str_upper(p.first), "legacy:go", 22)
        return null
    }
    if G.roul == null {
        let ty = 220
        for line in wrap_px("No dejaste testamento. La ruleta decidirá quién hereda y con quién continúas. Cuanto mejor te trató cada hijo, más espacio tiene en la rueda.", 330, 15) {
            text(900, ty, line, 15, C_WHITE, "bold")
            ty += 22
        }
        ty += 10
        for id in lg.heirs {
            let p = find_person(id)
            if ty < 440 {
                textw(900, ty, p.first, 16, C_WHITE, "impact", 160)
                text(1070, ty, "Méritos " + str(merit(p)), 14, C_YELLOW, "bold")
            }
            ty += 24
        }
        menu_word(888, 470, 350, 60, "¡GIRAR LA RULETA!", "legacy:spin", 24)
        return null
    }
    return null
}

// La ruleta ocupa el centro de la pantalla mientras gira.
function draw_roulette_overlay() {
    let r = G.roul
    if r == null { return null }
    let lg = G.legacy
    if r.done && G.t - r.t0 > 5.6 { return null }
    arect(0, 0, W, H, rgba(0, 0, 0, 190))
    push({"op": "alpha_rect", "x": 0, "y": 0, "w": W, "h": H, "color": 0, "action": "noop"})
    svg(30, 0, 900, 140, tilt_title_doc("RULETA DE LA HERENCIA", 900, 140, 60, HEX_WHITE, HEX_INK))
    svg(440, 150, 400, 400, roulette_doc(roulette_angle()))
    if r.done {
        otext(640, 620, "¡" + str_upper(r.names[r.idx]) + " HEREDA!", 48, C_YELLOW, "impact", true)
    }
    return null
}
