state {
    JOBC: map = {}
}

// ---------------------------------------------------------------- definiciones

function job_def(id: string) {
    let cached = JOBC[id]
    if cached != null { return cached }
    for r in CAREER_ROWS {
        if r[0] == id {
            let flags = r[8]
            let d = {
                "id": r[0], "m": r[1], "f": r[2], "field": r[3], "edu": r[4], "smarts": r[5], "looks": r[6],
                "base": r[7], "adult": str_contains(flags, "a"), "looksy": str_contains(flags, "L"),
                "illegal": str_contains(flags, "x"), "hidden": str_contains(flags, "h"), "specs": [],
                "min_age": 18
            }
            if r[9] != "" { d.specs = str_split(r[9], "|") }
            if (d.field == "Servicio" || d.field == "Oficio") && !d.adult { d.min_age = 16 }
            JOBC[id] = d
            return d
        }
    }
    return null
}

function job_title(id: string) {
    let d = job_def(id)
    return by_gender(L.gender, d.m, d.f)
}

function rank_names(id: string) {
    let o = RANK_OVERRIDE[id]
    if o != null { return o }
    return FIELD_RANKS[job_def(id).field]
}

// Una carrera es +18 si lo es por naturaleza o por su especialización.
function job_is_adult(job: any) {
    if job == null { return false }
    if job_def(job.id).adult { return true }
    return str_ends_with(job.spec, "+18")
}

function new_job(id: string) {
    return {"id": id, "career": id, "title": job_title(id), "level": 0, "xp": 0, "perf": 60, "years": 0, "bonus": 100, "spec": "", "salary": 0, "var": 0, "amateur": false}
}

// Compatibilidad con el código anterior: la carrera principal.
function career_def(id: string) {
    return job_def(id)
}

function career_job() {
    if L.job == null { return null }
    return job_def(L.job.id)
}

function career_rank_name() {
    if L.job == null { return "" }
    return rank_names(L.job.id)[L.job.level]
}

function job_display(job: any) {
    if job == null { return "" }
    let out = rank_names(job.id)[job.level] + " · " + job.title
    if job.spec != "" { out = out + " (" + job.spec + ")" }
    if job.amateur == true { out = out + " · amateur" }
    return out
}

function pay_of(job: map) {
    let d = job_def(job.id)
    let pay = d.base * PAY_MULT[job.level] / 100
    if d.looksy { pay = pay * (50 + L.looks) / 100 }
    // Sin título se cobra como amateur.
    if job.amateur == true { pay = pay * 60 / 100 }
    return pay * job.bonus / 100
}

function career_pay() {
    return pay_of(L.job)
}

// ---------------------------------------------------------------- búsqueda y contratación

function job_reqs_text(d: map) {
    let parts = []
    if d.edu == 1 { list_push(parts, "Primaria") }
    if d.edu == 2 { list_push(parts, "Secundaria") }
    if d.edu == 3 { list_push(parts, "Universidad") }
    if d.smarts > 0 { list_push(parts, "Intel. " + str(d.smarts)) }
    if d.looks > 0 { list_push(parts, "Atractivo " + str(d.looks)) }
    if len(parts) == 0 { return "Sin requisitos" }
    return str_join(parts, " · ")
}

function job_lock(d: map) {
    if L.age < d.min_age { return "Edad " + str(d.min_age) }
    if L.job != null && L.job.id == d.id { return "Ya es tu carrera" }
    if L.job2 != null && L.job2.id == d.id { return "Ya es tu carrera" }
    if !has_credential(d.id) && is_regulated(d.id) { return "Título" }
    // Las carreras con título propio no piden escolaridad: se entra con título o audición.
    if REQUIRES[d.id] == null && L.edu < d.edu { return EDU_NAMES[d.edu] }
    if L.smarts < d.smarts { return "Intel. " + str(d.smarts) }
    if L.looks < d.looks { return "Atractivo " + str(d.looks) }
    return ""
}

function job_items_for(field: string) {
    let items = []
    for r in CAREER_ROWS {
        if r[3] != field { continue }
        let d = job_def(r[0])
        if d.hidden { continue }
        let specs = "Especializaciones: " + str_join(d.specs, ", ") + "."
        if len(d.specs) == 0 { specs = "" }
        let tag = ""
        if d.adult { tag = " Carrera +18." }
        if d.illegal { tag = " Ilegal: riesgo de cárcel." }
        let cred = ""
        let sub = money_str(d.base) + "/año"
        if REQUIRES[d.id] != null {
            if has_credential(d.id) {
                cred = " Tienes el título necesario."
            } else if is_regulated(d.id) {
                cred = " Profesión regulada: necesitas estudiar " + credential_text(d.id) + "."
                sub = "Requiere título"
            } else {
                cred = " Sin título (" + credential_text(d.id) + ") solo entras como amateur: audición con minijuego, 60% del sueldo y menos experiencia."
                sub = "Título o audición"
            }
        }
        list_push(items, {
            "action": "apply:" + d.id,
            "t": by_gender(L.gender, d.m, d.f),
            "s": sub,
            "desc": "Sueldo: " + money_str(d.base) + "/año. Requisitos: " + job_reqs_text(d) + "." + cred + tag + " Rangos: " + str_join(rank_names(d.id), " › ") + ". " + specs,
            "lock": job_lock(d)
        })
    }
    return items
}

function casting_items() {
    return job_items_for("+18")
}

// Solicitud: si ya tienes carrera, preguntamos dónde ponerla.
function apply_job(id: string) {
    let d = job_def(id)
    G.modal = null
    if d == null { return null }
    if L.jail > 0 { return info("Solicitud", "Desde la cárcel no se puede.") }
    let lock = job_lock(d)
    let name = str_lower(by_gender(L.gender, d.m, d.f))
    if !has_credential(id) {
        if is_regulated(id) {
            return info("Solicitud", "Para trabajar como " + name + " necesitas un título: " + credential_text(id) + ". Inscríbete en Ocupación › Estudios.")
        }
        if lock != "" { return info("Solicitud", "No cumples los requisitos (" + lock + ").") }
        let game = AUDITION_GAME[d.field]
        open_choice("AUDICIÓN", "No tienes título de " + credential_text(id) + ". Puedes entrar como amateur si pasas una audición (" + MG_INFO[game].title + ", necesitas 60 puntos). Como amateur ganas el 60% y avanzas más lento hasta que estudies o te certifiques.",
            ["Hacer la audición", "Mejor estudiar primero"], ["", ""], "audition", {"job": id})
        return null
    }
    let ok = lock == ""
    // La experiencia en chambas ayuda a que te contraten.
    let odds = 70 + rank("charm") * 3 + min(15, L.workxp / 2)
    if d.adult || d.illegal { odds = 85 }
    if !((ok && chance(odds)) || (!ok && L.age >= d.min_age && chance(6))) {
        L.happy -= 3
        let why = "Eligieron a alguien más."
        if !ok { why = "No cumples los requisitos (" + lock + ")." }
        return finish("Solicitud", "No te aceptaron como " + name + ". " + why, "b")
    }
    return hire_flow(id, false)
}

function resolve_audition(index: int, ctx: map) {
    G.modal = null
    if index == 1 { return finish("Audición", "Decidiste prepararte mejor antes de intentarlo.", "n") }
    let d = job_def(ctx.job)
    return mg_start(AUDITION_GAME[d.field], "Audición: " + job_title(ctx.job), "audition", ctx)
}

// Te contrataron: si ya tienes carrera, preguntamos dónde ponerla.
function hire_flow(id: string, amateur: bool) {
    let d = job_def(id)
    if amateur { flag("amateur") }
    if L.job == null {
        return take_job(id, "main", amateur)
    }
    let current = L.job.title
    let labels = ["Como carrera principal (dejas " + current + ")", "Como segunda carrera (media jornada)", "Mejor no"]
    if L.job2 != null {
        labels = ["Reemplazar la principal (" + current + ")", "Reemplazar la segunda (" + L.job2.title + ")", "Mejor no"]
    }
    let how = ""
    if amateur { how = " como amateur" }
    open_choice("¡TE ACEPTARON!", "Te ofrecen el puesto de " + str_lower(by_gender(L.gender, d.m, d.f)) + how + ". ¿Dónde lo pones?", labels, ["", "", ""], "takejob", {"job": id, "amateur": amateur})
    return null
}

function resolve_takejob(index: int, ctx: map) {
    G.modal = null
    if index == 2 { return finish("Solicitud", "Rechazaste la oferta.", "n") }
    if index == 0 { return take_job(ctx.job, "main", ctx.amateur == true) }
    return take_job(ctx.job, "second", ctx.amateur == true)
}

function take_job(id: string, slot: string, amateur: bool) {
    let d = job_def(id)
    let job = new_job(id)
    job.amateur = amateur
    if has_trait("ambicion") { job.bonus = 110 }
    if slot == "main" {
        if L.job != null { L.last_job = L.job.title }
        L.job = job
    } else {
        L.job2 = job
    }
    if d.adult { L.fame = clamp100(L.fame + 5) }
    list_push(G.toasts, {"head": "¡NUEVA CARRERA!", "title": str_upper(rank_names(id)[0]), "sub": job.title, "t0": G.t})
    let where = ""
    if slot == "second" { where = " como segunda carrera" }
    if amateur { where = where + " (amateur)" }
    return finish("Nueva carrera", "¡Ahora eres " + str_lower(job.title) + where + "! Sueldo: " + money_str(pay_of(job)) + " al año.", "g")
}

// Atajo para eventos que te dan una carrera directamente.
function start_career(id: string) {
    let d = job_def(id)
    if d == null { return null }
    if L.looks < d.looks {
        L.happy -= 4
        return finish("Casting", "No pasaste el casting: buscan a alguien con más atractivo (" + str(d.looks) + "%).", "b")
    }
    return apply_job(id)
}

// ---------------------------------------------------------------- progreso

function job_xp(job: map, amount: int, label: string) {
    let names = rank_names(job.id)
    let gained = amount
    if job.amateur == true && amount > 0 { gained = amount * 60 / 100 }
    job.xp = max(0, job.xp + gained)
    while job.level < 4 && job.xp >= XP_TABLE[job.level + 1] {
        job.level += 1
        L.happy += 6
        if job_is_adult(job) { L.fame = clamp100(L.fame + 8) } else { L.fame = clamp100(L.fame + 2) }
        list_push(G.toasts, {"head": "¡ASCENSO!", "title": str_upper(names[job.level]), "sub": job.title + label + " · rango " + str(job.level + 1) + " de 5", "t0": G.t})
        log_add("Subiste de rango" + label + ": ahora eres " + names[job.level] + " (" + job.title + ").", "x")
    }
    return null
}

function career_xp(amount: int) {
    if L.job == null { return null }
    return job_xp(L.job, amount, "")
}

// Pago y experiencia de la segunda carrera (media jornada).
function second_job_year() {
    if L.job2 == null || L.jail > 0 { return null }
    L.money += pay_of(L.job2) * 25 / 100
    job_xp(L.job2, 10 + rank("skill") * 3, " (2.ª carrera)")
    return null
}

function fusion_for(a: string, b: string) {
    for f in FUSIONS {
        if (f[0] == a && f[1] == b) || (f[0] == b && f[1] == a) { return f[2] }
    }
    return ""
}

// ---------------------------------------------------------------- menú de ocupación

function career_items() {
    let items = []
    let d = job_def(L.job.id)
    let actions = CAREER_ACTIONS[L.job.id]
    if actions == null { actions = FIELD_ACTIONS[d.field] }
    for a in actions {
        let lock = ""
        if a.need != null && rank(a.need) < a.rank { lock = SOCIAL_NAMES[a.need] + " " + str(a.rank) }
        list_push(items, {"action": "cact:" + a.id, "t": a.t, "s": a.s, "desc": a.desc, "lock": lock})
    }
    if job_is_adult(L.job) && CAREER_ACTIONS[L.job.id] == null {
        list_push(items, {"action": "cact:spec18", "t": "Encargo +18", "s": "Fama, mucho dinero", "desc": "Tu especialidad picante: los clientes pagan muy bien por lo que haces.", "lock": ""})
    }
    if L.job.amateur == true {
        let game = AUDITION_GAME[d.field]
        list_push(items, {"action": "act:practice", "t": "Practicar (" + MG_INFO[game].title + ")", "s": "Experiencia según tu puntaje", "desc": "Sin título aprendes a la mala: practica con el minijuego de tu oficio. Mejor puntaje, más experiencia.", "lock": ""})
        let lock = ""
        if L.job.level < 2 { lock = "Rango 3" }
        list_push(items, {"action": "act:certify", "t": "Examen de certificación", "s": "Dejar de ser amateur", "desc": "Un examen difícil (necesitas 75 puntos). Si lo pasas, cobras el sueldo completo sin necesidad de título.", "lock": lock})
    }
    list_push(items, {"action": "act:work_hard", "t": "Trabajar más duro", "s": "Desempeño " + str(L.job.perf) + "%", "desc": "Horas extra y reconocimiento (quizá). Suma experiencia.", "lock": ""})
    list_push(items, {"action": "act:raise", "t": "Pedir un aumento", "s": "Sueldo " + money_str(pay_of(L.job)) + "/año", "desc": "Necesitas buen desempeño y algo de valor.", "lock": ""})
    if L.job.spec == "" && len(d.specs) > 0 {
        let lock = ""
        if L.job.level < 2 { lock = "Rango 3" }
        list_push(items, {"action": "act:specialize", "t": "Especializarte", "s": "+25% de sueldo", "desc": "Elige tu especialidad: " + str_join(d.specs, ", ") + ".", "lock": lock})
    }
    if L.job2 != null {
        let fused = fusion_for(L.job.id, L.job2.id)
        if fused != "" {
            let lock = ""
            if L.job.level < 2 || L.job2.level < 2 { lock = "Ambas en rango 3" }
            list_push(items, {"action": "act:fuse", "t": "FUSIONAR → " + job_title(fused), "s": "Carrera nueva", "desc": "Combina " + L.job.title + " y " + L.job2.title + " en una sola carrera: " + job_title(fused) + ".", "lock": lock})
        }
        list_push(items, {"action": "act:shift2", "t": "Turno en tu 2.ª carrera", "s": job_display(L.job2), "desc": "Dedica tiempo a tu segunda carrera: experiencia y algo de dinero extra.", "lock": ""})
        list_push(items, {"action": "act:swap", "t": "Hacer principal: " + L.job2.title, "s": job_display(L.job2), "desc": "Intercambia tu carrera principal y la secundaria.", "lock": ""})
        list_push(items, {"action": "act:quit2", "t": "Dejar la segunda carrera", "s": L.job2.title, "desc": "Menos trabajo, menos dinero.", "lock": ""})
    }
    let names = rank_names(L.job.id)
    let next = "Rango máximo alcanzado."
    if L.job.level < 4 { next = "Siguiente rango: " + names[L.job.level + 1] + " (" + str(L.job.xp) + "/" + str(XP_TABLE[L.job.level + 1]) + " exp)." }
    list_push(items, {"action": "act:jobsearch", "t": "Buscar otra carrera", "s": "Catálogo completo", "desc": "Más de 120 carreras. Puedes tener dos a la vez y fusionarlas.", "lock": ""})
    list_push(items, {"action": "act:quit", "t": "Renunciar", "s": names[L.job.level], "desc": next, "lock": ""})
    return items
}

function do_career_act(id: string) {
    G.modal = null
    if L.job == null { return null }
    let d = job_def(L.job.id)
    let key = "c_" + id
    let used = L.used[key]
    if used == null { used = 0 }
    if used >= 1 { return info("Trabajo", "Ya hiciste eso este mes. Descansa un poco.") }
    if id == "spec18" {
        L.used[key] = used + 1
        let o = {"log": "Hiciste un encargo de «" + L.job.spec + "» para un cliente exigente. Pagó {monto}.", "money": [3000, 12000], "xp": 30, "fame": 6, "happy": 4}
        if L.job.spec == "" { o.log = "Un encargo picante muy bien pagado: {monto}." }
        let msg = apply(o, {})
        return finish(L.job.title, msg, "x")
    }
    let actions = CAREER_ACTIONS[L.job.id]
    if actions == null { actions = FIELD_ACTIONS[d.field] }
    for a in actions {
        if a.id != id { continue }
        if a.need != null && rank(a.need) < a.rank {
            return info(a.t, "Necesitas " + SOCIAL_NAMES[a.need] + " rango " + str(a.rank) + ".")
        }
        L.used[key] = used + 1
        let o = pick_outcome(a.o)
        let ctx = {}
        if map_has(o, "log") && str_contains(o.log, "{x}") { ctx["person"] = stranger() }
        let msg = apply(o, ctx)
        if d.illegal && chance(6) { msg = msg + go_to_jail(2) }
        return finish(a.t, msg, outcome_kind(o))
    }
    return null
}

function open_specialize() {
    let d = job_def(L.job.id)
    let locks = []
    for s in d.specs { list_push(locks, "") }
    let labels = list_slice(d.specs, 0, len(d.specs))
    list_push(labels, "Todavía no")
    list_push(locks, "")
    open_choice("ESPECIALIZACIÓN", "¿En qué quieres especializarte como " + str_lower(L.job.title) + "? Las que dicen +18 vuelven tu carrera picante: más fama y dinero.", labels, locks, "spec", {})
    return null
}

function resolve_spec(index: int) {
    G.modal = null
    let d = job_def(L.job.id)
    if index >= len(d.specs) { return finish("Especialización", "Lo pensarás otro año.", "n") }
    L.job.spec = d.specs[index]
    L.job.bonus = L.job.bonus + 25
    flag("spec")
    if str_ends_with(L.job.spec, "+18") {
        flag("spec18")
        L.fame = clamp100(L.fame + 10)
    }
    list_push(G.toasts, {"head": "¡ESPECIALIZACIÓN!", "title": str_upper(L.job.spec), "sub": L.job.title, "t0": G.t})
    return finish("Especialización", "Ahora te especializas en " + L.job.spec + ". Tu sueldo sube un 25%.", "x")
}

function fuse_jobs() {
    G.modal = null
    if L.job == null || L.job2 == null { return null }
    let fused = fusion_for(L.job.id, L.job2.id)
    if fused == "" || L.job.level < 2 || L.job2.level < 2 { return info("Fusión", "Necesitas ambas carreras en rango 3.") }
    let old = L.job.title + " + " + L.job2.title
    let job = new_job(fused)
    job.level = 2
    job.xp = XP_TABLE[2]
    job.bonus = 120
    L.last_job = L.job.title
    L.job = job
    L.job2 = null
    L.fame = clamp100(L.fame + 15)
    L.happy += 10
    flag("fusion")
    list_push(G.toasts, {"head": "¡FUSIÓN!", "title": str_upper(job.title), "sub": old, "t0": G.t})
    return finish("Fusión de carreras", "Combinaste " + old + " en una carrera nueva: " + job.title + ". Empiezas en rango 3 y ganas " + money_str(pay_of(job)) + " al año.", "x")
}

// ---------------------------------------------------------------- amateurs

function start_practice() {
    G.modal = null
    if L.job == null { return null }
    let used = L.used["practice"]
    if used == null { used = 0 }
    if used >= 2 { return info("Práctica", "Ya practicaste suficiente este mes.") }
    L.used["practice"] = used + 1
    let d = job_def(L.job.id)
    return mg_start(AUDITION_GAME[d.field], "Práctica: " + L.job.title, "practice", {})
}

function practice_result(score: any) {
    if L.job == null { return null }
    job_xp(L.job, score / 3, "")
    gain("skill", 1 + score / 40)
    L.job.perf = clamp100(L.job.perf + score / 20)
    return finish("Práctica", "Practicaste con " + str(score) + " puntos. Ganas experiencia como " + str_lower(L.job.title) + ".", "g")
}

function start_certify() {
    G.modal = null
    if L.job == null { return null }
    if L.job.level < 2 { return info("Certificación", "Necesitas llegar al rango 3 para presentar el examen.") }
    let used = L.used["certify"]
    if used != null { return info("Certificación", "Solo puedes presentar el examen una vez al mes.") }
    L.used["certify"] = 1
    let d = job_def(L.job.id)
    return mg_start(AUDITION_GAME[d.field], "Certificación: " + L.job.title, "certify", {})
}

function certify_result(score: any) {
    if L.job == null { return null }
    if score >= 75 {
        L.job.amateur = false
        flag("pro")
        list_push(G.toasts, {"head": "¡CERTIFICACIÓN!", "title": str_upper(L.job.title), "sub": "Ya no eres amateur: sueldo completo.", "t0": G.t})
        return finish("Certificación", "¡Aprobaste con " + str(score) + "! Ahora eres profesional. Sueldo completo: " + money_str(pay_of(L.job)) + " al año.", "g")
    }
    L.happy -= 5
    return finish("Certificación", "Sacaste " + str(score) + ". Necesitabas 75. Vuelve a intentarlo el próximo mes.", "b")
}
