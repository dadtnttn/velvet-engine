// @edition 3
// Interfaz estilo Persona: pantallas, menús, ventanas, notificaciones y animaciones.
// Lienzo de 1280x720; los colores del host son ARGB en decimal (ver rgb/rgba).

function rgb(r: int, g: int, b: int) {
    return 4278190080 + r * 65536 + g * 256 + b
}

function rgba(r: int, g: int, b: int, a: int) {
    return a * 16777216 + r * 65536 + g * 256 + b
}

const W = 1280
const H = 720

const C_DIM = rgba(0, 0, 0, 175)

const EDU_NAMES = ["Ninguna", "Primaria", "Secundaria", "Universidad"]
const PAGE_SIZE = 9

state {
    // Colores activos (rgba empaquetado); los fija el tema (tema.vel).
    C_RED: int = 4293071899,
    C_INK: int = 4279045389,
    C_WHITE: int = 4294440946,
    C_GRAY: int = 4286743170,
    C_GRAY_D: int = 4281348144,
    C_YELLOW: int = 4294955551,
    C_PINK: int = 4294933192,
    C_BAD: int = 4294926946,
    C: list = [],
    block: bool = false,
    // Tablas de avance por fuente que entrega el host (app_fonts).
    FONTS: map = {}
}

// ---------------------------------------------------------------- primitivas

function push(cmd: map) {
    list_push(C, cmd)
}

function rect(x: any, y: any, w: any, h: any, color: int) {
    push({"op": "rect", "x": x, "y": y, "w": w, "h": h, "color": color})
}

function arect(x: any, y: any, w: any, h: any, color: int) {
    push({"op": "alpha_rect", "x": x, "y": y, "w": w, "h": h, "color": color})
}

function text(x: any, y: any, s: string, size: int, color: int, font: string) {
    push({"op": "text", "x": x, "y": y, "text": tr(s), "size": size, "color": color, "font": font})
}

function ctext(x: any, y: any, s: string, size: int, color: int, font: string) {
    push({"op": "text", "x": x, "y": y, "text": tr(s), "size": size, "color": color, "font": font, "align": "center"})
}

// Texto ya traducido (líneas partidas de una frase traducida): no pasa por tr.
function text_raw(x: any, y: any, s: string, size: int, color: int, font: string) {
    push({"op": "text", "x": x, "y": y, "text": s, "size": size, "color": color, "font": font})
}

// Variantes con ancho máximo: el host primero achica la letra para que quepa
// (otros idiomas son más largos) y solo si aún no cabe, recorta con «…».
function textw(x: any, y: any, s: string, size: int, color: int, font: string, w: any) {
    push({"op": "text", "x": x, "y": y, "text": tr(s), "size": size, "color": color, "font": font, "max_width": w, "overflow": "shrink"})
}

function ctextw(x: any, y: any, s: string, size: int, color: int, font: string, w: any) {
    push({"op": "text", "x": x, "y": y, "text": tr(s), "size": size, "color": color, "font": font, "align": "center", "max_width": w, "overflow": "shrink"})
}

function otextw(x: any, y: any, s: string, size: int, color: int, font: string, center: bool, w: any) {
    let d = max(2, size / 14)
    for off in [[-d, 0], [d, 0], [0, -d], [0, d], [-d, -d], [d, d], [-d, d], [d, -d]] {
        if center { ctextw(x + off[0], y + off[1], s, size, C_INK, font, w) } else { textw(x + off[0], y + off[1], s, size, C_INK, font, w) }
    }
    if center { ctextw(x, y, s, size, color, font, w) } else { textw(x, y, s, size, color, font, w) }
}

// Texto con contorno negro grueso (estilo cómic).
function otext(x: any, y: any, s: string, size: int, color: int, font: string, center: bool) {
    let d = max(2, size / 14)
    for off in [[-d, 0], [d, 0], [0, -d], [0, d], [-d, -d], [d, d], [-d, d], [d, -d]] {
        if center { ctext(x + off[0], y + off[1], s, size, C_INK, font) } else { text(x + off[0], y + off[1], s, size, C_INK, font) }
    }
    if center { ctext(x, y, s, size, color, font) } else { text(x, y, s, size, color, font) }
}

function svg(x: any, y: any, w: int, h: int, doc: string) {
    push({"op": "svg", "x": x, "y": y, "w": w, "h": h, "text": doc})
}

function fade_push(ratio: float) {
    push({"op": "opacity_push", "ratio": ratio})
}

function fade_pop() {
    push({"op": "opacity_pop"})
}

function move_push(dx: any, dy: any) {
    push({"op": "translate_push", "x": dx, "y": dy})
}

function move_pop() {
    push({"op": "transform_pop"})
}

// Zona clicable. Registra el área para el hover propio del juego.
function hot(x: any, y: any, w: any, h: any, action: string) {
    if block { return null }
    push({"op": "alpha_rect", "x": x, "y": y, "w": w, "h": h, "color": 0, "action": action})
    list_push(G.hot, {"x": x, "y": y, "w": w, "h": h, "a": action})
    return null
}

function hovered(action: string) {
    return !block && G.hover == action
}

// Panel inclinado negro con borde blanco y sombra roja.
function panel(x: int, y: int, w: int, h: int, skew: int) {
    svg(x, y, w + 6, h + 6, slant_doc(w, h, skew, HEX_INK, HEX_WHITE, 3, HEX_RED, 6))
}

function tag(x: int, y: int, w: int, lbl: string, fill: string, color: int) {
    svg(x, y, w, 26, slant_doc(w, 26, 8, fill, "", 0, "", 0))
    ctext(x + w / 2, y + 19, lbl, 13, color, "bold")
}

// Ancho real en píxeles de un texto con la fuente indicada (si el host no
// entregó métricas, se estima por número de letras).
// "Encanto 4": el nombre del rasgo se traduce aparte (la frase entera no existe
// en los catálogos), y el número se queda igual.
function need_text(stat: string, rank: int) {
    return tr(SOCIAL_NAMES[stat]) + " " + str(rank)
}

function measure(s: string, size: int, font: string) {
    let m = FONTS[font]
    let t = tr(s)
    if m != null { return int(str_measure(t, m, size) + 0.99) }
    return len(t) * size * 54 / 100
}

// Parte un texto en líneas que caben en `width` píxeles con esa fuente.
function wrap_f(s: string, width: int, size: int, font: string) {
    let m = FONTS[font]
    let t = tr(s)
    if m != null { return str_wrap(t, m, size, width) }
    return wrap(t, width * 100 / (size * 54))
}

function wrap_px(s: string, width: int, size: int) {
    return wrap_f(s, width, size, "bold")
}

// ---------------------------------------------------------------- animación

function prog(t0: float, dur: float) {
    return clamp((G.t - t0) / dur, 0.0, 1.0)
}

function ease(t: float) {
    let u = 1.0 - t
    return 1.0 - u * u * u
}

function stat_color(v: int) {
    if v >= 60 { return C_WHITE }
    if v >= 30 { return C_YELLOW }
    return C_RED
}

function kind_color(k: string) {
    if k == "g" { return C_YELLOW }
    if k == "b" { return C_BAD }
    if k == "x" { return C_PINK }
    return C_WHITE
}

// ---------------------------------------------------------------- frame

function build() {
    C = []
    G.hot = []
    // Con los ajustes abiertos, lo de abajo se dibuja pero no responde.
    let cfg = G.cfg_on == true
    block = cfg
    svg(0, 0, W, H, bg_doc())
    if G.mode == "title" {
        draw_title()
    } else if G.mode == "create" {
        draw_create()
    } else if G.mode == "dead" {
        draw_dead()
    } else {
        block = cfg || G.modal != null
        draw_game()
        block = cfg
        if G.modal != null { draw_modal(G.modal) }
        draw_cutin()
        draw_skip()
    }
    block = false
    if cfg { draw_settings() }
    draw_toasts()
    return C
}

// ---------------------------------------------------------------- portada

function draw_title() {
    let e = ease(prog(G.screen_t0, 0.5))
    svg(-80 + (1.0 - e) * -200, 250, 460, 460, burst_doc(460, 460, 20, HEX_WHITE, HEX_INK, 5, 4))
    portrait(40 + (1.0 - e) * -200, 300, 330, 396, G.title_look, G.title_gender, 24, "grin", 3, false)

    // El logo en el idioma elegido; las letras se achican si el título es largo.
    let title = "VIDA SIN FILTRO"
    let g = I18N_GAME[CFG.lang]
    if g != null && g.title != null && g.title != "" { title = g.title }
    if list_contains(["he", "hi", "th"], CFG.lang) {
        // Escrituras con letras que se unen o se leen de derecha a izquierda:
        // el título va entero, con el motor de texto (forma y dirección).
        otextw(W / 2, 120 - (1.0 - e) * 120, title, 76, C_WHITE, "impact", true, 1100)
    } else {
        let letters = str_chars(title)
        let units = 0
        for l in letters {
            if l == " " { units += 36 } else { units += 82 }
        }
        let lsize = min(84, 110000 / max(1, units))
        let logo = ransom_doc(letters, lsize, 3)
        svg(W / 2 - logo.w / 2, 40 - (1.0 - e) * 120 + (84 - lsize) / 2, logo.w, logo.h, logo.doc)
    }
    otext(W / 2, 186, "UN SIMULADOR DE VIDA PARA ADULTOS", 22, C_WHITE, "impact", true)

    let items = [["NUEVA VIDA", "new"], ["VIDA AL AZAR", "quick"], ["AJUSTES", "settings"], ["SALIR", "quit"]]
    let top = 226
    let step = 72
    let bh = 60
    let size = 32
    if has_continue() {
        items = [["CONTINUAR", "continue"], ["NUEVA VIDA", "new"], ["VIDA AL AZAR", "quick"], ["AJUSTES", "settings"], ["SALIR", "quit"]]
        top = 214
        step = 60
        bh = 52
        size = 28
    }
    let i = 0
    while i < len(items) {
        let it = items[i]
        let x = 640 + i * 26 + (1.0 - ease(prog(G.screen_t0 + 0.1 * i, 0.4))) * 500
        let y = top + i * step
        menu_word(x, y, 440, bh, it[0], it[1], size)
        if it[1] == "continue" {
            // Quién te espera, alineado a la derecha del botón.
            let room = 440 - 70 - measure("CONTINUAR", size, "impact")
            push({"op": "text", "x": x + 424, "y": y + bh / 2 + 6, "text": tr(str_upper(SV.info)), "size": 14, "color": C_YELLOW, "font": "bold", "align": "right", "max_width": room})
        }
        i += 1
    }

    svg(640, 520, 566, 116, slant_doc(560, 110, 20, HEX_WHITE, HEX_INK, 3, HEX_RED, 6))
    svg(670, 540, 70, 70, burst_doc(70, 70, 12, HEX_RED, HEX_INK, 3, 2))
    ctext(705, 583, "+18", 22, C_WHITE, "impact")
    let wy = 556
    for line in wrap_f("Contiene sexo (sin escenas explícitas), drogas, alcohol, crimen y muy malas decisiones. Solo para mayores de edad.", 420, 16, "bold") {
        if wy <= 604 { text_raw(756, wy, line, 16, C_INK, "bold") }
        wy += 24
    }

    if G.lives > 0 {
        otext(1040, 690, "VIDAS VIVIDAS: " + str(G.lives), 18, C_YELLOW, "impact", false)
    }
    text(20, 708, "Velvet Engine · Velvet Script 3", 13, C_GRAY, "ui")
}

// Palabra de menú inclinada: negra con borde blanco; roja al pasar el ratón.
function menu_word(x: any, y: any, w: int, h: int, lbl: string, action: string, size: int) {
    let on = hovered(action)
    let doc = slant_doc(w, h, 22, HEX_INK, HEX_WHITE, 3, HEX_RED, 6)
    let dx = 0
    if on {
        doc = slant_doc(w, h, 22, HEX_RED, HEX_WHITE, 3, HEX_INK, 8)
        dx = 14
    }
    svg(x + dx, y, w + 8, h + 8, doc)
    otext(x + dx + 40, y + h / 2 + size * 36 / 100, lbl, size, C_WHITE, "impact", false)
    hot(x, y, w, h, action)
}

// ---------------------------------------------------------------- creador

function draw_create() {
    let c = G.cre
    svg(-60, 120, 520, 520, burst_doc(520, 520, 22, HEX_WHITE, HEX_INK, 5, 7))
    portrait(40, 150, 360, 432, c.look, c.gender, 22, "grin", 1, true)
    svg(10, -8, 620, 130, tilt_title_doc("CREA TU VIDA", 620, 130, 76, HEX_WHITE, HEX_INK))

    panel(462, 96, 790, 590, 24)
    let pages = ["IDENTIDAD", "ESTILO", "CARÁCTER", "GUSTOS", "ORIGEN", "RUTA Y FE"]
    cre_defaults(c)
    let i = 0
    while i < 6 {
        let action = "cre:page:" + str(i)
        let fill = HEX_INK
        let color = C_WHITE
        if i == c.page {
            fill = HEX_WHITE
            color = C_INK
        } else if hovered(action) {
            fill = HEX_RED
        }
        svg(484 + i * 126, 112, 124, 44, slant_doc(118, 40, 12, fill, HEX_WHITE, 2, HEX_RED, 4))
        ctext(484 + i * 126 + 59, 140, pages[i], 14, color, "impact")
        hot(484 + i * 126, 112, 118, 40, action)
        i += 1
    }
    let x0 = 510
    let y = 200
    if c.page == 0 {
        create_label(x0, y, "NOMBRE")
        rect(x0 + 170, y - 26, 330, 38, C_WHITE)
        let shown = str_join(c.chars, "")
        if shown == "" { shown = "(al azar)" }
        let cursor = ""
        if floor(G.t * 2.0) % 2 == 0 { cursor = "|" }
        text(x0 + 182, y + 2, shown + cursor, 20, C_INK, "bold")
        small_button(x0 + 516, y - 26, 120, 38, "AZAR", "cre:name")
        text(x0 + 170, y + 30, "Escribe con el teclado · Retroceso para borrar", 12, C_GRAY, "ui")
        y += 70
        create_label(x0, y, "SEXO")
        toggle(x0 + 170, y - 26, 150, "HOMBRE", "cre:gender:m", c.gender == "m")
        toggle(x0 + 330, y - 26, 150, "MUJER", "cre:gender:f", c.gender == "f")
        y += 60
        create_label(x0, y, "LE ATRAEN")
        toggle(x0 + 170, y - 26, 150, "MUJERES", "cre:likes:f", c.likes == "f")
        toggle(x0 + 330, y - 26, 150, "HOMBRES", "cre:likes:m", c.likes == "m")
        toggle(x0 + 490, y - 26, 150, "AMBOS", "cre:likes:ambos", c.likes == "ambos")
        y += 60
        create_label(x0, y, "PIEL")
        swatches(x0 + 170, y - 8, SKINS, c.look.skin, "cre:skin:")
        y += 60
        create_label(x0, y, "CARA")
        stepper(x0 + 170, y - 26, FACES[c.look.face], "cre:face")
        y += 60
        create_label(x0, y, "CUERPO")
        stepper(x0 + 170, y - 26, BODIES[c.look.body], "cre:body")
    } else if c.page == 1 {
        create_label(x0, y, "PEINADO")
        stepper(x0 + 170, y - 26, HAIR_STYLES[c.look.hair], "cre:hair")
        y += 58
        create_label(x0, y, "PELO")
        swatches(x0 + 170, y - 8, HAIR_COLORS, c.look.hcolor, "cre:hcolor:")
        y += 58
        create_label(x0, y, "OJOS")
        swatches(x0 + 170, y - 8, EYE_COLORS, c.look.eyes, "cre:eyes:")
        y += 58
        create_label(x0, y, "ROPA")
        swatches(x0 + 170, y - 8, OUTFITS, c.look.outfit, "cre:outfit:")
        y += 58
        create_label(x0, y, "ACCESORIO")
        stepper(x0 + 170, y - 26, ACCESSORIES[c.look.acc], "cre:acc")
        y += 58
        create_label(x0, y, "MARCAS")
        stepper(x0 + 170, y - 26, MARKS[c.look.mark], "cre:mark")
        y += 58
        create_label(x0, y, "LABIOS")
        stepper(x0 + 170, y - 26, LIPS[c.look.lips], "cre:lips")
    } else if c.page == 2 {
        create_label(x0, y, "PERSONALIDAD")
        let t = trait_def(c.trait)
        stepper(x0 + 170, y - 26, str_upper(by_gender(c.gender, t.m, t.f)), "cre:trait")
        textw(x0 + 170, y + 30, t.desc, 14, C_YELLOW, "bold", 540)
        y += 90
        create_label(x0, y, "TALENTO")
        let tl = talent_def(c.talent)
        stepper(x0 + 170, y - 26, str_upper(gfmt(tl.n, c.gender)), "cre:talent")
        let ty2 = y + 30
        for line in wrap_px(gfmt(tl.d, c.gender) + " " + SOCIAL_NAMES[tl.soc] + " +" + str(tl.pts) + " · " + stat_name(tl.stat) + " +" + str(tl.sv) + ".", 540, 14) {
            text(x0 + 170, ty2, line, 14, C_YELLOW, "bold")
            ty2 += 19
        }
        y = ty2 + 52
        create_label(x0, y, "DEFECTO")
        let fl = flaw_def(c.flaw)
        stepper(x0 + 170, y - 26, str_upper(gfmt(fl.n, c.gender)), "cre:flaw")
        let fd = gfmt(fl.d, c.gender)
        if fl.id != "ninguno" { fd = fd + " Superarlo: " + fl.goal }
        let fy = y + 30
        for line in wrap_px(fd, 540, 14) {
            text(x0 + 170, fy, line, 14, C_YELLOW, "bold")
            fy += 19
        }
        y = fy + 30
        for line in wrap_px("Un defecto es un reto: si lo superas en tu vida, ganas felicidad, Valor y un hito.", 700, 13) {
            text(x0, y, line, 13, C_GRAY, "bold")
            y += 18
        }
    } else if c.page == 3 {
        create_label(x0, y, "AFICIONES")
        text(x0 + 170, y - 4, "Elige hasta 3 (si no, se completan al azar).", 14, C_GRAY, "bold")
        let k = 0
        while k < len(INTERESTS) {
            let id = INTERESTS[k]
            toggle_s(x0 + (k % 4) * 172, y + 14 + (k / 4) * 40, 160, INT_SHORT[id], "cre:int:" + id, list_contains(c.ints, id))
            k += 1
        }
        y += 162
        create_label(x0, y, "GUSTOS +18")
        text(x0 + 170, y - 4, "Elige hasta " + str(MAX_KINKS) + ". Se revelan al cumplir 18.", 14, C_GRAY, "bold")
        k = 0
        while k < len(KINKS) {
            let kk = KINKS[k]
            toggle_s(x0 + (k % 3) * 230, y + 14 + (k / 3) * 40, 214, str_upper(by_gender(c.gender, kk.m, kk.f)), "cre:kink:" + kk.id, list_contains(c.tags, kk.id))
            k += 1
        }
    } else if c.page == 4 {
        cre_ctry_defaults(c)
        create_label(x0, y, "REGIÓN")
        stepper(x0 + 170, y - 26, cre_region_label(c), "cre:region")
        y += 46
        create_label(x0, y, "PAÍS")
        stepper(x0 + 170, y - 26, cre_ctry_label(c), "cre:ctry")
        y += 46
        create_label(x0, y, "CIUDAD")
        stepper(x0 + 170, y - 26, cre_city_name(c), "cre:city")
        y += 46
        create_label(x0, y, "FAMILIA")
        pair_toggles(x0 + 170, y - 26, FAMILY_OPTS, c.fam, "cre:fam:", c.gender)
        y += 46
        create_label(x0, y, "HERMANOS")
        pair_toggles(x0 + 170, y - 26, SIB_OPTS, c.sibs, "cre:sibs:", c.gender)
        y += 46
        create_label(x0, y, "NACIMIENTO")
        stepper(x0 + 170, y - 26, cre_month_name(c), "cre:bm")
        y += 46
        create_label(x0, y, "ESTATURA")
        pair_toggles(x0 + 170, y - 26, HEIGHTS, c.height, "cre:height:", c.gender)
        y += 46
        create_label(x0, y, "DESTINO")
        pair_toggles(x0 + 170, y - 26, DESTINY_OPTS, c.destiny, "cre:destiny:", c.gender)
        let sd = "Tu signo suma 4 a un rasgo social."
        if c.bm >= 0 { sd = SIGNS[c.bm].n + ": " + gfmt(SIGNS[c.bm].d, c.gender) + " +4 " + SOCIAL_NAMES[SIGNS[c.bm].soc] + "." }
        let sy = y + 34
        for line in wrap_px(cre_ctry_summary(c) + " " + sd + " Destino: cuántos eventos te pasan.", 500, 13) {
            if sy < y + 110 { text(x0, sy, line, 13, C_YELLOW, "bold") }
            sy += 18
        }
    } else if c.page == 5 {
        create_label(x0, y, "RUTA")
        let r = route_def(c.route)
        stepper(x0 + 170, y - 26, r.short, "cre:route")
        let ty = y + 34
        text(x0 + 170, ty, str_upper(r.n), 16, C_YELLOW, "impact")
        ty += 24
        for line in wrap_px(r.d, 560, 15) {
            text(x0 + 170, ty, line, 15, C_WHITE, "bold")
            ty += 21
        }
        y = ty + 50
        create_label(x0, y, "RELIGIÓN")
        let rel = religion_def(c.religion)
        let rlabel = str_upper(rel.n)
        let rdesc = "Tu familia: " + RELIGION_DESC[rel.id]
        if c.religion == "" {
            rlabel = "SEGÚN TU PAÍS"
            rdesc = "Tu familia tendrá la religión de tu país (al azar, según cuánta gente la practica)."
            if cre_ctry_defaults(c).ctry != "" { rdesc = rdesc + " En " + cname(c.ctry) + ": " + rel_summary(c.ctry) + "." }
        }
        stepper(x0 + 170, y - 26, rlabel, "cre:rel")
        ty = y + 34
        for line in wrap_px(rdesc, 560, 15) {
            text(x0 + 170, ty, line, 15, C_WHITE, "bold")
            ty += 21
        }
    }

    small_button(1100, 24, 150, 44, "VOLVER", "back")
    small_button(930, 24, 160, 44, "TODO AL AZAR", "cre:random")
    star_button(1036, 572, "¡A VIVIR!", "cre:go", "ENTER")
}

// Botón de opción compacto (texto que se ajusta al ancho).
function toggle_s(x: int, y: int, w: int, lbl: string, action: string, on: bool) {
    let fill = HEX_INK
    let color = C_WHITE
    if on {
        fill = HEX_WHITE
        color = C_INK
    }
    if hovered(action) && !on { fill = HEX_RED }
    svg(x, y, w + 4, 38, slant_doc(w, 34, 9, fill, HEX_WHITE, 2, HEX_RED, 3))
    ctextw(x + w / 2, y + 23, lbl, 13, color, "bold", w - 14)
    hot(x, y, w, 34, action)
}

function pair_toggles(x: int, y: int, opts: list, cur: string, prefix: string, gender: string) {
    let w = 124
    if len(opts) <= 3 { w = 150 }
    let i = 0
    while i < len(opts) {
        toggle_s(x + i * (w + 8), y, w, str_upper(gfmt(opts[i][1], gender)), prefix + opts[i][0], opts[i][0] == cur)
        i += 1
    }
}

function create_label(x: int, y: int, lbl: string) {
    otext(x, y, lbl, 19, C_WHITE, "impact", false)
}

function toggle(x: int, y: int, w: int, lbl: string, action: string, on: bool) {
    let fill = HEX_INK
    let color = C_WHITE
    if on {
        fill = HEX_WHITE
        color = C_INK
    }
    if hovered(action) && !on { fill = HEX_RED }
    svg(x, y, w + 4, 42, slant_doc(w, 38, 10, fill, HEX_WHITE, 2, HEX_RED, 4))
    ctextw(x + w / 2, y + 26, lbl, 15, color, "bold", w - 22)
    hot(x, y, w, 38, action)
}

function small_button(x: int, y: int, w: int, h: int, lbl: string, action: string) {
    let fill = HEX_INK
    if hovered(action) { fill = HEX_RED }
    svg(x, y, w + 4, h + 4, slant_doc(w, h, 10, fill, HEX_WHITE, 2, HEX_RED, 4))
    // Si la etiqueta no cabe (otro idioma, texto largo), se achica en vez de salirse.
    let sz = 15
    while sz > 10 && measure(lbl, sz, "bold") > w - 28 { sz -= 1 }
    ctext(x + w / 2, y + h / 2 + sz / 2 - 1, lbl, sz, C_WHITE, "bold")
    hot(x, y, w, h, action)
}

function swatches(x: int, y: int, colors: list, selected: int, prefix: string) {
    let i = 0
    while i < len(colors) {
        let cx = x + 18 + i * 44
        let action = prefix + str(i)
        let ring = 0
        if i == selected { ring = 5 } else if hovered(action) { ring = 3 }
        let body = "<circle cx='22' cy='22' r='" + str(14 + ring) + "' fill='" + HEX_WHITE + "' stroke='" + HEX_INK + "' stroke-width='2'/>"
        if i == selected { body = body + "<circle cx='22' cy='22' r='17' fill='" + HEX_RED + "'/>" }
        body = body + "<circle cx='22' cy='22' r='13' fill='" + colors[i] + "' stroke='" + HEX_INK + "' stroke-width='2'/>"
        svg(cx - 22, y - 22, 44, 44, svg_doc(44, 44, body))
        hot(cx - 18, y - 18, 36, 36, action)
        i += 1
    }
}

function stepper(x: int, y: int, lbl: string, action: string) {
    let left = HEX_WHITE
    let right = HEX_WHITE
    if hovered(action + ":-") { left = HEX_RED }
    if hovered(action + ":+") { right = HEX_RED }
    svg(x, y, 38, 38, arrow_doc("left", left))
    hot(x, y, 38, 38, action + ":-")
    svg(x + 46, y, 268, 42, slant_doc(264, 38, 10, HEX_WHITE, HEX_INK, 2, HEX_RED, 4))
    ctextw(x + 46 + 132, y + 26, lbl, 16, C_INK, "bold", 236)
    svg(x + 322, y, 38, 38, arrow_doc("right", right))
    hot(x + 322, y, 38, 38, action + ":+")
}

// Botón de estallido grande (avanzar año, empezar vida).
function star_button(x: int, y: int, lbl: string, action: string, hint: string) {
    let on = hovered(action)
    let fill = HEX_RED
    if on { fill = HEX_YELLOW }
    svg(x, y, 240, 160, burst_doc(240, 160, 16, fill, HEX_INK, 5, 11))
    let color = C_WHITE
    if on { color = C_INK }
    if on { ctext(x + 120, y + 92, lbl, 34, color, "impact") } else { otext(x + 120, y + 92, lbl, 34, color, "impact", true) }
    ctext(x + 120, y + 116, hint, 12, color, "bold")
    hot(x + 40, y + 30, 160, 100, action)
}

// ---------------------------------------------------------------- juego

function draw_game() {
    draw_card()
    draw_feed(404, 16, 472, 594)
    draw_stats(884, 16, 380, 196)
    draw_social(884, 222, 380, 214)
    draw_status(884, 446, 380, 146)
    draw_bottom()
}

function draw_card() {
    svg(18, 52, 360, 360, burst_doc(360, 360, 18, HEX_WHITE, HEX_INK, 4, L.age % 7))
    portrait(58, 66, 280, 336, player_look(), L.gender, L.age, mood_for(L.happy), 0, true)
    svg(16, 16, 378, 60, slant_doc(372, 54, 18, HEX_INK, HEX_WHITE, 3, HEX_RED, 6))
    textw(44, 52, str_upper(L.first + " " + L.last), 22, C_WHITE, "impact", 310)
    tag(30, 84, 150, str_upper(month_name()), HEX_YELLOW, C_INK)
    if L.route != null && L.route != "normal" {
        let rf = HEX_RED
        if hovered("tab:route") { rf = HEX_WHITE }
        let rc = C_WHITE
        if hovered("tab:route") { rc = C_INK }
        svg(186, 84, 186, 26, slant_doc(180, 26, 8, rf, HEX_WHITE, 2, "", 0))
        ctextw(186 + 90, 102, "RUTA: " + route_def(L.route).short + " ›", 13, rc, "bold", 170)
        hot(186, 84, 180, 26, "tab:route")
    }
    draw_effect_chips(26, 118)
    draw_phone_button()
    svg(282, 282, 116, 116, burst_doc(116, 116, 14, HEX_RED, HEX_INK, 4, 5))
    otext(340, 342, str(L.age), 40, C_WHITE, "impact", true)
    ctextw(340, 362, stage_of(L.age).s, 11, C_WHITE, "bold", 96)

    panel(16, 398, 372, 212, 18)
    tag(40, 410, 190, str_upper(trait_name(L.trait, L.gender)), HEX_RED, C_WHITE)
    text(238, 429, mood_word(), 14, C_YELLOW, "bold")
    let occ_label = "OCUPACIÓN"
    if L.job2 != null { occ_label = "OCUPACIÓN · 2.ª: " + str_upper(L.job2.title) }
    textw(44, 458, occ_label, 11, C_GRAY, "bold", 330)
    textw(44, 479, occupation_text(), 16, C_WHITE, "bold", 320)
    let fcol = C_YELLOW
    if hovered("ph:app:bank") { fcol = C_WHITE }
    text(44, 504, "DINERO · BANCO ›", 11, fcol, "bold")
    hot(40, 490, 170, 46, "ph:app:bank")
    let mc = C_YELLOW
    if L.money < 0 { mc = C_BAD }
    text(44, 530, money_str(L.money), 22, mc, "impact")
    draw_floats_for("money", 150, 508)
    if L.fame > 0 {
        text(220, 504, "FAMA", 11, C_GRAY, "bold")
        rect(220, 516, 130, 12, C_GRAY_D)
        rect(220, 516, 130 * L.fame / 100, 12, C_YELLOW)
        text(220 + 136, 528, str(L.fame), 13, C_YELLOW, "impact")
    } else {
        let pcol = C_GRAY
        if hovered("pa:map") { pcol = C_YELLOW }
        text(220, 504, "PAÍS · MAPA ›", 11, pcol, "bold")
        textw(220, 526, L.city + ", " + here().n, 14, C_WHITE, "bold", 150)
        hot(216, 490, 160, 44, "pa:map")
    }
    if L.age >= 18 && len(L.tags) > 0 {
        text(44, 556, "GUSTOS", 11, C_GRAY, "bold")
        let tx = 40
        let ty = 566
        for t in L.tags {
            let name = kink_name(t, L.gender)
            let w = min(170, 28 + measure(name, 12, "bold"))
            if tx + w > 380 {
                tx = 34
                ty += 24
            }
            if ty < 600 {
                svg(tx, ty, w, 22, slant_doc(w, 22, 7, "#3a0d10", HEX_RED, 2, "", 0))
                ctextw(tx + w / 2, ty + 16, name, 12, C_PINK, "bold", w - 14)
            }
            tx += w + 4
        }
    } else {
        text(44, 556, "FAMILIA", 11, C_GRAY, "bold")
        textw(44, 578, FAMILY_NAMES[L.family] + " · " + religion_text(), 14, C_WHITE, "bold", 320)
    }
}

// Retrato animado: respira, parpadea y reacciona a lo que pasa (solo el protagonista).
function portrait(x: any, y: any, w: int, h: int, look: map, gender: string, age: int, mood: string, seed: int, react: bool) {
    let dx = 0.0
    let dy = sin(G.t * 2.0 + seed * 1.7) * 2.5
    let m = mood
    if mood != "grin" && mood != "dead" && fract((G.t + seed * 0.73) / 3.7) < 0.045 {
        m = mood + "!b"
    }
    let emote = ""
    let ep = 1.0
    if react && G.react != null {
        let p = prog(G.react.t0, 0.9)
        if p < 1.0 {
            let k = G.react.kind
            if k == "b" {
                dx = sin(G.t * 70.0) * 9.0 * (1.0 - p)
                emote = "bad"
                m = "surprised"
                if p > 0.45 { m = "cry" }
            } else {
                dy = dy - abs(sin(p * 9.42)) * 16.0 * (1.0 - p)
                emote = "good"
                m = "grin"
                if k == "x" {
                    emote = "love"
                    m = "love"
                }
                if k == "m" { emote = "money" }
                if k == "a" {
                    emote = "angry"
                    m = "angry"
                }
            }
            ep = p
        }
    }
    svg(x + dx, y + dy, w, h, portrait_doc(look, gender, age, m))
    if emote != "" {
        fade_push(clamp(1.6 - ep * 1.6, 0.0, 1.0))
        svg(x + w - 90 + dx, y + 8 - ep * 20.0, 80, 80, emote_doc(emote))
        fade_pop()
    }
}

function mood_word() {
    let m = mood_for(L.happy)
    if m == "grin" { return "EUFÓRIC" + str_upper(oa(L.gender)) }
    if m == "happy" { return "CONTENT" + str_upper(oa(L.gender)) }
    if m == "neutral" { return "TRANQUIL" + str_upper(oa(L.gender)) }
    if m == "sad" { return "TRISTE" }
    return "DEPRIMID" + str_upper(oa(L.gender))
}

function occupation_text() {
    if L.jail > 0 { return "En prisión" }
    if L.job != null { return job_display(L.job) }
    if L.study != null {
        let d = degree_def(L.study.deg)
        if L.gig != null { return d.n + " + " + L.gig.title }
        return "Estudiante de " + d.n
    }
    if L.gig != null { return L.gig.title + " (medio tiempo)" }
    if L.school == "primaria" { return "Primaria" }
    if L.school == "secundaria" { return "Secundaria" }
    if L.age < 6 { return by_gender(L.gender, "Bebé consentido", "Bebé consentida") }
    return "Desemplead" + oa(L.gender)
}

// Bitácora partida en líneas para un ancho y fuente: las frases se traducen y
// se parten al dibujar; la caché (por idioma, ancho y vida) solo procesa lo nuevo.
function log_lines(width: int, size: int, font: string) {
    if G.logc == null { G.logc = {} }
    let key = str(width) + ":" + str(size) + ":" + font
    let c = G.logc[key]
    let lang = i18n_lang()
    let n = len(L.log)
    let first = ""
    if n > 0 { first = L.log[0].t }
    if c == null || c.lang != lang || c.n > n || c.first != first {
        c = {"lang": lang, "n": 0, "lines": [], "start": [], "last": "", "first": first}
        G.logc[key] = c
    }
    // El último encabezado de año puede cambiar («Edad 14–17»): se rehace.
    if c.n > 0 && L.log[c.n - 1].t != c.last {
        let s = c.start[c.n - 1]
        c.lines = list_slice(c.lines, 0, s)
        c.start = list_slice(c.start, 0, c.n - 1)
        c.n -= 1
    }
    while c.n < n {
        let e = L.log[c.n]
        list_push(c.start, len(c.lines))
        if e.k == "h" {
            list_push(c.lines, {"t": e.t, "k": "h"})
        } else {
            for line in wrap_f(e.t, width, size, font) {
                list_push(c.lines, {"t": line, "k": e.k})
            }
        }
        c.last = e.t
        c.n += 1
    }
    return c.lines
}

function draw_feed(x: int, y: int, w: int, h: int) {
    panel(x, y, w, h, 20)
    let hfill = HEX_RED
    if hovered("tab:hitos") { hfill = HEX_YELLOW }
    svg(x + 24, y + 10, 152, 34, slant_doc(146, 30, 9, hfill, HEX_WHITE, 2, HEX_INK, 4))
    let hcol = C_WHITE
    if hovered("tab:hitos") { hcol = C_INK }
    ctext(x + 24 + 73, y + 31, "HITOS " + str(hito_count()), 14, hcol, "impact")
    hot(x + 24, y + 10, 146, 30, "tab:hitos")
    let mission_label = "MISIONES " + str(len(L.done)) + "/" + str(len(MISSIONS))
    let mfill = HEX_WHITE
    let mcolor = C_INK
    if hovered("tab:missions") {
        mfill = HEX_YELLOW
    }
    svg(x + w - 176, y + 10, 156, 34, slant_doc(150, 30, 9, mfill, HEX_INK, 2, HEX_RED, 4))
    ctext(x + w - 176 + 75, y + 31, mission_label, 14, mcolor, "impact")
    hot(x + w - 176, y + 10, 150, 30, "tab:missions")
    let efill = HEX_WHITE
    if hovered("tab:effects") { efill = HEX_YELLOW }
    svg(x + 182, y + 10, 114, 34, slant_doc(108, 30, 9, efill, HEX_INK, 2, HEX_RED, 4))
    ctext(x + 182 + 54, y + 31, "EFECTOS " + str(len(effects())), 14, C_INK, "impact")
    hot(x + 182, y + 10, 108, 30, "tab:effects")
    let line_h = 23
    let top = y + 54
    let visible = (h - 70) / line_h
    let lines = log_lines(w - 80, 15, "ui")
    let total = len(lines)
    let max_scroll = max(0, total - visible)
    G.scroll = clamp(G.scroll, 0, max_scroll)
    let start = max(0, total - visible - G.scroll)
    let end = min(total, start + visible)
    push({"op": "clip_push", "x": x + 4, "y": top - 4, "w": w - 8, "h": h - 64})
    let cy = top
    let i = start
    while i < end {
        let entry = lines[i]
        let lx = x + 34 - (cy - y) * 20 / h
        if entry.k == "h" {
            let head = str_upper(entry.t)
            let tw = clamp(measure(head, 13, "bold") + 28, 120, w - 70)
            svg(lx, cy + 1, tw, 20, slant_doc(tw, 20, 7, HEX_RED, "", 0, "", 0))
            ctextw(lx + tw / 2, cy + 16, head, 13, C_WHITE, "bold", tw - 20)
        } else {
            text_raw(lx + 6, cy + 17, entry.t, 15, kind_color(entry.k), "ui")
        }
        cy += line_h
        i += 1
    }
    push({"op": "clip_pop"})
    if max_scroll > 0 {
        let track = h - 80
        let thumb = max(30, track * visible / total)
        let ty = top + (track - thumb) * (max_scroll - G.scroll) / max_scroll
        rect(x + w - 30, top, 3, track, C_GRAY_D)
        rect(x + w - 31, ty, 5, thumb, C_WHITE)
    }
    if G.scroll > 0 {
        small_button(x + w / 2 - 100, y + h - 52, 200, 34, "LO MÁS RECIENTE", "scroll:end")
    }
}

function draw_stats(x: int, y: int, w: int, h: int) {
    panel(x, y, w, h, 16)
    tag(x + 26, y + 12, 150, "ESTADÍSTICAS", HEX_RED, C_WHITE)
    let keys = ["happy", "health", "smarts", "looks"]
    let names = ["FELICIDAD", "SALUD", "INTELIGENCIA", "ATRACTIVO"]
    let i = 0
    while i < 4 {
        let v = L[keys[i]]
        if keys[i] == "looks" { v = looks_eff() }
        let ry = y + 66 + i * 34
        let rx = x + 30 - i * 4
        text(rx, ry, names[i], 14, C_WHITE, "impact")
        rect(rx + 120, ry - 13, 190, 14, C_GRAY_D)
        rect(rx + 120, ry - 13, 190 * v / 100, 14, stat_color(v))
        rect(rx + 120, ry + 1, 190, 2, C_INK)
        text(rx + 318, ry, str(v), 15, stat_color(v), "impact")
        if keys[i] == "looks" && v != L.looks {
            let diff = v - L.looks
            let lbl = str(diff)
            let col = C_BAD
            if diff > 0 {
                lbl = "+" + lbl
                col = rgb(90, 220, 120)
            }
            text(rx + 120, ry + 14, "base " + str(L.looks) + " · efectos " + lbl, 10, col, "bold")
        }
        draw_floats_for(keys[i], rx + 262, ry - 15)
        hot(rx, ry - 20, 340, 30, "st:" + keys[i])
        i += 1
    }
    text(x + 196, y + 30, "Toca una barra", 11, C_GRAY, "bold")
}

function draw_social(x: int, y: int, w: int, h: int) {
    panel(x, y, w, h, 16)
    tag(x + 26, y + 12, 170, "RASGOS SOCIALES", HEX_RED, C_WHITE)
    let i = 0
    while i < len(SOCIAL_KEYS) {
        let k = SOCIAL_KEYS[i]
        let r = rank(k)
        let ry = y + 64 + i * 32
        let rx = x + 30 - i * 3
        text(rx, ry, str_upper(SOCIAL_NAMES[k]), 14, C_WHITE, "impact")
        text(rx + 128, ry, rank_title(k, r), 13, C_GRAY, "bold")
        let p = 0
        while p < 5 {
            let col = C_GRAY_D
            if p < r { col = C_RED }
            rect(rx + 240 + p * 20, ry - 13, 14, 14, col)
            if p < r { rect(rx + 243 + p * 20, ry - 10, 4, 4, C_WHITE) }
            p += 1
        }
        draw_floats_for(k, rx + 200, ry - 14)
        hot(rx, ry - 20, 340, 30, "st:" + k)
        i += 1
    }
}

function draw_status(x: int, y: int, w: int, h: int) {
    panel(x, y, w, h, 16)
    tag(x + 26, y + 12, 130, "SITUACIÓN", HEX_RED, C_WHITE)
    let rows = [
        ["Relación", relationship_text()],
        ["Educación", education_text()],
        ["Parejas sexuales", str(L.partners) + " · Hijos " + str(L.kids)],
        ["Salud", health_text()],
        ["Vicios / ley", vice_text()]
    ]
    let ry = y + 56
    let i = 0
    for row in rows {
        let rx = x + 30 - i * 3
        text(rx, ry, row[0], 13, C_GRAY, "bold")
        textw(rx + 136, ry, row[1], 14, C_WHITE, "bold", w - 190)
        ry += 19
        i += 1
    }
}

function relationship_text() {
    let p = partner()
    if p == null {
        if L.age < 16 { return "—" }
        return by_gender(L.gender, "Soltero", "Soltera")
    }
    if L.married { return by_gender(L.gender, "Casado", "Casada") + " con " + p.first }
    return rel_label(p) + ": " + p.first
}

function education_text() {
    if L.study != null { return degree_def(L.study.deg).n + " · prom. " + str(L.study.gpa) }
    if L.school != "" && L.age < 18 { return "Escuela · calif. " + str(L.grades) }
    let out = EDU_NAMES[L.edu]
    if len(L.degrees) > 0 { out = degrees_text() }
    if L.debt > 0 { out = out + " · deuda " + money_str(L.debt) }
    return out
}



function vice_text() {
    let parts = []
    if L.alcohol > 0 { list_push(parts, "Alcohol " + str(L.alcohol) + "%") }
    if L.drugs > 0 { list_push(parts, "Drogas " + str(L.drugs) + "%") }
    if L.jail > 0 { list_push(parts, "En prisión") } else if L.record > 0 { list_push(parts, str(L.record) + " " + plural(L.record, "delito", "delitos")) }
    if len(parts) == 0 { return "Ninguno" }
    return str_join(parts, " · ")
}

function draw_bottom() {
    let tabs = [["OCUPACIÓN", "tab:job"], ["VÍNCULOS", "tab:rel"], ["ACTIVIDADES", "tab:act"], ["NOCHE +18", "tab:night"]]
    let i = 0
    while i < len(tabs) {
        let t = tabs[i]
        let x = 16 + i * 222
        let y = 634
        let on = hovered(t[1])
        let doc = slant_doc(210, 64, 20, HEX_INK, HEX_WHITE, 3, HEX_RED, 6)
        if on {
            doc = slant_doc(210, 64, 20, HEX_RED, HEX_WHITE, 3, HEX_INK, 8)
            y -= 6
        }
        svg(x, y, 218, 72, doc)
        otext(x + 105, y + 43, t[0], 24, C_WHITE, "impact", true)
        hot(x, 634, 210, 64, t[1])
        i += 1
    }
    // Avance rápido hasta el cumpleaños (se detiene si algo requiere decisión).
    let fy = 640
    let fill = HEX_WHITE
    let color = C_INK
    if hovered(if_str(L.age < 6, "age", "year")) {
        fill = HEX_YELLOW
        fy -= 4
    }
    // De bebé, la estrella ya avanza un año; este botón da el paso corto (un mes).
    let small_lbl = "+1 AÑO"
    let small_act = "year"
    let small_key = "TECLA Y"
    if L.age < 6 {
        small_lbl = "+1 MES"
        small_act = "age"
        small_key = "UN MES"
    }
    svg(912, fy, 128, 58, slant_doc(122, 52, 14, fill, HEX_INK, 3, HEX_RED, 5))
    ctextw(972, fy + 26, small_lbl, 20, color, "impact", 104)
    ctextw(972, fy + 44, small_key, 11, color, "bold", 104)
    hot(912, 640, 122, 52, small_act)
    let sy = 600
    let sfill = HEX_INK
    if hovered("skip:5") {
        sfill = HEX_RED
        sy -= 3
    }
    svg(918, sy, 116, 34, slant_doc(110, 30, 10, sfill, HEX_WHITE, 2, HEX_RED, 4))
    ctextw(972, sy + 21, "+5 AÑOS · U", 14, C_WHITE, "impact", 94)
    hot(918, 600, 110, 30, "skip:5")
    if L.age < 6 {
        star_button(1034, 586, "+1 AÑO", "year", "ESPACIO")
    } else {
        star_button(1034, 586, "+1 MES", "age", "ESPACIO")
    }
}

// Avance de varios años en curso: barra de progreso y botón para parar.
function draw_skip() {
    let s = G.skip
    if s == null { return null }
    arect(0, 0, W, H, rgba(0, 0, 0, 120))
    let w = 520
    let h = 170
    let x = (W - w) / 2
    let y = 250
    svg(x, y, w + 10, h + 10, slant_doc(w, h, 22, HEX_INK, HEX_WHITE, 4, HEX_RED, 10))
    otextw(x + w / 2, y + 52, "AVANZANDO EL TIEMPO", 30, C_YELLOW, "impact", true, w - 60)
    let ratio = 0.0
    if s.total > 0 { ratio = float(s.done) / float(s.total) }
    push({"op": "bar", "x": x + 50, "y": y + 74, "w": w - 100, "h": 22, "ratio": ratio, "fill": C_RED, "background": C_GRAY_D, "stroke": C_WHITE, "thickness": 2})
    ctext(x + w / 2, y + 116, str(L.age) + " " + plural(L.age, "año", "años") + " · " + str(s.done) + " de " + str(s.total), 16, C_WHITE, "bold")
    small_button(x + w / 2 - 80, y + 128, 160, 30, "PARAR (ESC)", "skip:cancel")
}

// Números que flotan junto a una estadística después de cambiar.
function draw_floats_for(key: string, x: int, y: int) {
    for f in G.floats {
        if f.k != key || G.t < f.t0 { continue }
        let p = prog(f.t0, 1.6)
        if p >= 1.0 { continue }
        let lbl = str(f.v)
        let color = C_YELLOW
        if f.v > 0 { lbl = "+" + lbl }
        if f.v < 0 { color = C_BAD }
        if key == "money" {
            lbl = money_str(f.v)
            if f.v > 0 { lbl = "+" + lbl }
        }
        fade_push(1.0 - p * p)
        otext(x, y - p * 26, lbl, 18, color, "impact", false)
        fade_pop()
    }
}

// ---------------------------------------------------------------- ventanas

function draw_modal(m: map) {
    arect(0, 0, W, H, C_DIM)
    push({"op": "alpha_rect", "x": 0, "y": 0, "w": W, "h": H, "color": 0, "action": "noop"})
    if G.t < G.modal_t0 { return null }
    if m.kind == "info" { return draw_dialog(m, ["CONTINUAR"], [""], [""], "ok") }
    if m.kind == "choice" {
        let tags = m.tags
        if tags == null { tags = [] }
        return draw_dialog(m, m.choices, m.locks, tags, "choice:")
    }
    if m.kind == "menu" { return draw_menu(m) }
    if m.kind == "person" { return draw_person(m) }
    if m.kind == "minigame" { return draw_minigame() }
    if m.kind == "chat" { return draw_chat() }
    if m.kind == "phone" { return draw_phone() }
    if m.kind == "world" { return draw_world(m) }
    return null
}

// Diálogo estilo Persona: retrato a un lado, panel inclinado y opciones.
function draw_dialog(m: map, choices: list, locks: list, tags: list, prefix: string) {
    let e = ease(prog(G.modal_t0, 0.25))
    let p = m.person
    let w = 740
    let fs = 18
    let lh = 27
    let oh = 56
    let lines = wrap_f(m.text, w - 96, fs, "ui")
    let n = len(choices)
    let chart_h = 0
    if m.chart != null && len(m.chart.vals) > 0 { chart_h = 150 }
    let h = 96 + len(lines) * lh + n * oh + 20 + chart_h
    // Texto largo (o traducido) y muchas opciones: todo se compacta para que
    // la ventana nunca se salga de la pantalla.
    if h > H - 50 {
        fs = 16
        lh = 23
        oh = 50
        lines = wrap_f(m.text, w - 96, fs, "ui")
        let room = (H - 50 - 96 - n * oh - 20 - chart_h) / lh
        if len(lines) > room && room > 0 {
            lines = list_slice(lines, 0, room)
            lines[room - 1] = lines[room - 1] + "…"
        }
        h = 96 + len(lines) * lh + n * oh + 20 + chart_h
    }
    let x = (W - w) / 2
    if p != null { x = 470 }
    let y = (H - h) / 2 + 20
    if p != null {
        let px = 20 - (1.0 - e) * 300
        svg(px - 30, 250, 420, 420, burst_doc(420, 420, 18, HEX_WHITE, HEX_INK, 5, p.id % 9))
        // Mientras «habla» (el primer segundo y medio), la boca se mueve.
        let pm = person_mood(p)
        if G.t - G.modal_t0 < 1.5 && fract(G.t * 5.0) < 0.5 { pm = "talk" }
        portrait(px + 20, 270, 330, 396, p.look, p.gender, p.age, pm, p.id, false)
        svg(px + 30, 640, 300, 50, slant_doc(294, 44, 14, HEX_INK, HEX_WHITE, 3, HEX_RED, 6))
        textw(px + 56, 672, str_upper(p.first), 24, C_WHITE, "impact", 240)
    }
    fade_push(e)
    move_push((1.0 - e) * 140, 0)
    svg(x, y, w + 10, h + 10, slant_doc(w, h, 26, HEX_INK, HEX_WHITE, 4, HEX_RED, 10))
    let title = str_upper(m.title)
    let tw = min(600, 56 + measure(title, 28, "impact"))
    svg(x - 12, y - 26, tw + 6, 58, slant_doc(tw, 52, 16, HEX_RED, HEX_WHITE, 3, HEX_INK, 6))
    otextw(x + 18, y + 12, title, 28, C_WHITE, "impact", false, tw - 44)
    let ty = y + 64
    for line in lines {
        text_raw(x + 48, ty, line, fs, C_WHITE, "ui")
        ty += lh
    }
    if chart_h > 0 {
        draw_chart(x + 48, ty + 6, w - 110, 110, m.chart)
        ty += chart_h
    }
    let by = ty + 8
    let i = 0
    while i < n {
        let action = prefix
        if prefix == "choice:" { action = prefix + str(i) }
        let locked = len(locks) > i && locks[i] != ""
        let tag_text = ""
        if len(tags) > i { tag_text = tags[i] }
        dialog_option(x + 40 - i * 6, by, w - 90, choices[i], i, action, locked, locks, tag_text)
        by += oh
        i += 1
    }
    move_pop()
    fade_pop()
    return null
}

function dialog_option(x: int, y: int, w: int, lbl: string, i: int, action: string, locked: bool, locks: list, tag_text: string) {
    let on = hovered(action) && !locked
    let fill = "#262626"
    let color = C_WHITE
    if on { fill = HEX_RED }
    if locked {
        fill = "#1a1a1a"
        color = C_GRAY
    }
    let dx = 0
    if on { dx = 12 }
    svg(x + dx, y, w + 6, 50, slant_doc(w, 46, 14, fill, HEX_WHITE, 2, HEX_INK, 4))
    svg(x + dx + 18, y + 9, 30, 30, slant_doc(30, 30, 6, HEX_WHITE, "", 0, "", 0))
    ctext(x + dx + 33, y + 31, str(i + 1), 18, C_INK, "impact")
    textw(x + dx + 60, y + 30, lbl, 17, color, "bold", w - 230)
    if locked {
        svg(x + dx + w - 190, y + 8, 30, 30, lock_doc())
        textw(x + dx + w - 156, y + 30, str_upper(locks[i]), 14, C_RED, "impact", 146)
    } else if tag_text != "" {
        textw(x + dx + w - 150, y + 30, "[" + str_upper(tag_text) + "]", 14, C_YELLOW, "impact", 140)
    }
    if !locked { hot(x, y, w, 46, action) }
}

function person_mood(p: map) {
    if p.rel == "ex" { return "angry" }
    if p.bond >= 75 { return "grin" }
    if p.bond >= 45 { return "happy" }
    if p.bond >= 25 { return "neutral" }
    return "sad"
}

// Pantalla de lista: título ladeado, pestañas, opciones y panel de descripción.
function draw_list(title: string, cats: list, cat: int, items: list, back: string, kind: string) {
    let e = ease(prog(G.menu_t0, 0.3))
    svg(-160 - (1.0 - e) * 400, 0, 820, 720, slant_doc(760, 720, 220, HEX_RED, "", 0, HEX_INK, 60))
    svg(24, 2 - (1.0 - e) * 80, 640, 136, tilt_title_doc(title, 640, 136, 78, HEX_WHITE, HEX_INK))
    small_button(1110, 26, 140, 42, "VOLVER", back)
    text(1118, 86, "ESC", 12, C_WHITE, "bold")

    let list_y = 150
    if len(cats) > 0 {
        // Hasta 6 pestañas por fila; con muchas categorías se usan varias filas compactas.
        let per_row = 6
        let tw = 100
        let th = 30
        if len(cats) <= 4 {
            per_row = 4
            tw = 128
            th = 38
        }
        let i = 0
        while i < len(cats) {
            let action = "cat:" + str(i)
            let fill = HEX_INK
            let color = C_WHITE
            if i == cat {
                fill = HEX_WHITE
                color = C_INK
            } else if hovered(action) {
                fill = HEX_RED
            }
            let tx = 46 + (i % per_row) * (tw + 6) - (i / per_row) * 8
            let ty = 138 + (i / per_row) * (th + 6)
            svg(tx, ty, tw + 4, th + 4, slant_doc(tw, th, 8, fill, HEX_WHITE, 2, HEX_INK, 4))
            let size = 16
            if th < 38 { size = 13 }
            ctextw(tx + tw / 2, ty + th / 2 + size * 4 / 10, str_upper(cats[i]), size, color, "impact", tw - 10)
            hot(tx, ty, tw, th, action)
            i += 1
        }
        let rows = (len(cats) + per_row - 1) / per_row
        list_y = 140 + rows * (th + 6) + 12
    }

    let page_size = (650 - list_y) / 52
    if page_size > PAGE_SIZE { page_size = PAGE_SIZE }
    if page_size < 4 { page_size = 4 }
    let pages = max(1, (len(items) + page_size - 1) / page_size)
    G.menu_page = clamp(G.menu_page, 0, pages - 1)
    let first = G.menu_page * page_size
    let last = min(len(items), first + page_size)
    let focus = null
    let i = first
    while i < last {
        let it = items[i]
        let k = i - first
        let ie = ease(prog(G.menu_t0 + k * 0.03, 0.25))
        let ix = 56 - k * 4 - (1.0 - ie) * 260
        let iy = list_y + k * 52
        let locked = it.lock != ""
        let on = hovered(it.action)
        if on { focus = it }
        let fill = HEX_INK
        let color = C_WHITE
        let dx = 0
        if on {
            fill = HEX_WHITE
            color = C_INK
            dx = 16
        }
        if locked && !on {
            fill = "#1c1c1c"
            color = C_GRAY
        }
        if it.done == true && !on {
            fill = "#3a2a00"
            color = C_YELLOW
        }
        svg(ix + dx, iy, 526, 52, slant_doc(520, 46, 16, fill, HEX_WHITE, 2, HEX_RED, 6))
        textw(ix + dx + 30, iy + 30, it.t, 19, color, "impact", 298)
        let sub_color = C_GRAY
        if on { sub_color = C_RED }
        if locked {
            svg(ix + dx + 372, iy + 8, 28, 28, lock_doc())
            textw(ix + dx + 404, iy + 29, str_upper(it.lock), 13, C_RED, "impact", 100)
        } else {
            // El subtítulo usa el espacio que deja el título (hasta 230 px).
            let title_end = ix + dx + 30 + min(298, measure(it.t, 19, "impact")) + 18
            let sub_w = min(230, max(160, measure(it.s, 12, "bold")))
            let sub_x = max(title_end, ix + dx + 504 - sub_w)
            textw(sub_x, iy + 29, it.s, 12, sub_color, "bold", ix + dx + 504 - sub_x)
        }
        hot(ix, iy, 520, 46, it.action)
        i += 1
    }
    if pages > 1 {
        let py = list_y + page_size * 52 + 4
        if G.menu_page > 0 { small_button(60, py, 140, 36, "ANTERIOR", "page:-") }
        if G.menu_page < pages - 1 { small_button(360, py, 140, 36, "SIGUIENTE", "page:+") }
        ctext(280, py + 24, str(G.menu_page + 1) + " / " + str(pages), 16, C_WHITE, "impact")
    }
    if focus == null && len(items) > 0 { focus = items[first] }
    if focus != null { draw_detail(focus, kind) }
    return null
}

function draw_detail(it: any, kind: string) {
    let x = 660
    let y = 150
    let w = 580
    let h = 520
    svg(x, y, w + 12, h + 12, slant_doc(w, h, 26, HEX_WHITE, HEX_INK, 4, HEX_INK, 12))
    if it.pid != null {
        let p = find_person(it.pid)
        if p != null {
            svg(x + 300, y + 120, 280, 280, burst_doc(280, 280, 16, HEX_RED, HEX_INK, 4, p.id % 7))
            portrait(x + 320, y + 130, 230, 276, p.look, p.gender, p.age, person_mood(p), p.id, false)
            if p.age >= 18 && L.age >= 18 && p.tags != null && !is_family(p) {
                let gl = "Gustos: " + kinks_text(p.tags, p.gender)
                let shared = shared_kinks(p)
                if len(shared) > 0 { gl = gl + " · ¡comparten " + str(len(shared)) + "!" }
                textw(x + 46, y + 410, gl, 13, C_RED, "bold", 270)
            }
            textw(x + 46, y + 60, str_upper(p.first), 34, C_INK, "impact", 260)
            textw(x + 46, y + 92, rel_label(p) + " · " + str(p.age) + " años" + person_flag_text(p), 17, C_RED, "bold", 270)
            text(x + 46, y + 140, "ARCANO", 12, C_GRAY, "bold")
            text(x + 46, y + 166, str_upper(arcana(p)), 22, C_INK, "impact")
            text(x + 46, y + 206, "RANGO DE CONFIDENTE", 12, C_GRAY, "bold")
            let r = conf_rank(p)
            let i = 0
            while i < 10 {
                let col = rgb(210, 210, 205)
                if i < r { col = C_RED }
                rect(x + 46 + i * 24, y + 218, 18, 18, col)
                i += 1
            }
            text(x + 46, y + 270, "CERCANÍA " + str(p.bond) + "%", 16, C_INK, "impact")
            rect(x + 46, y + 280, 230, 12, rgb(210, 210, 205))
            rect(x + 46, y + 280, 230 * p.bond / 100, 12, C_RED)
            textw(x + 46, y + 318, bond_state(p) + " · Compatibilidad " + str(compat(p)) + "%", 15, C_INK, "bold", 270)
            let extra = style_name(npc_style(p), p) + " · " + temper_name(p) + " · " + str_lower(mood_name(p))
            if p.age >= 18 { extra = "Atractivo " + str(p.looks) + "% · " + extra }
            textw(x + 46, y + 338, extra, 13, C_GRAY, "bold", 270)
            let fl = interests_text(p)
            if p.bff == true { fl = "Mejor amig" + oa(p.gender) + " · " + fl }
            textw(x + 46, y + 356, fl, 13, C_GRAY, "bold", 270)
            let ll = lovelang_text(p)
            if p.age >= 18 && L.age >= 18 && (rel_group(p) == "partner" || rel_group(p) == "fling") && p.gender != L.gender {
                ll = ll + " · Fertilidad " + fert_word(their_fertility(p))
            }
            textw(x + 46, y + 374, ll, 13, C_GRAY, "bold", 270)
            let lz = lazos_detail(p)
            if lz != "" { textw(x + 46, y + 392, lz, 13, C_RED, "bold", 270) }
            if kind == "person" {
                textw(x + 46, y + 440, str_upper(it.t), 22, C_RED, "impact", 500)
                textw(x + 46, y + 462, it.s, 14, C_INK, "bold", 500)
                if it.desc != null && it.desc != it.s {
                    let dy = y + 484
                    for line in wrap_px(it.desc, 500, 14) {
                        if dy < y + 520 { text_raw(x + 46, dy, line, 14, C_INK, "ui") }
                        dy += 18
                    }
                }
            } else {
                text(x + 46, y + 470, "Clic para interactuar", 14, C_RED, "bold")
            }
            return null
        }
    }
    textw(x + 46, y + 66, str_upper(it.t), 34, C_INK, "impact", 420)
    textw(x + 46, y + 100, it.s, 17, C_RED, "bold", 500)
    let ty = y + 150
    // La descripción no invade el aviso de requisito ni sale de la tarjeta.
    let bottom = y + h - 24
    if it.lock != "" { bottom = y + h - 132 }
    if it.desc != null {
        for line in wrap_px(it.desc, 470, 18) {
            if ty <= bottom { text_raw(x + 46, ty, line, 18, C_INK, "ui") }
            ty += 28
        }
    }
    if it.lock != "" {
        svg(x + 40, y + h - 120, 380, 58, slant_doc(372, 50, 14, HEX_INK, HEX_RED, 3, HEX_RED, 6))
        svg(x + 58, y + h - 110, 30, 30, lock_doc())
        textw(x + 96, y + h - 87, "REQUIERE: " + str_upper(it.lock), 18, C_WHITE, "impact", 316)
    }
    if kind == "jobs" && it.ok != null {
        let msg = "CUMPLES LOS REQUISITOS"
        let col = C_RED
        if !it.ok {
            msg = "NO CUMPLES · PRUEBA SUERTE"
            col = C_GRAY
        }
        text(x + 46, y + h - 60, msg, 20, col, "impact")
    }
    return null
}

function draw_menu(m: map) {
    let blocked = menu_block(m.tab)
    if blocked != "" {
        draw_list(menu_title(m.tab), [], 0, [], "close", "menu")
        svg(660, 260, 580, 140, slant_doc(570, 130, 20, HEX_WHITE, HEX_INK, 4, HEX_INK, 10))
        let ty = 320
        for line in wrap_px(blocked, 480, 20) {
            text(706, ty, line, 20, C_INK, "impact")
            ty += 28
        }
        return null
    }
    let cats = menu_cats(m.tab)
    let cat = ""
    if len(cats) > 0 { cat = cats[clamp(G.menu_cat, 0, len(cats) - 1)] }
    let items = menu_items(m.tab, cat)
    let back = "close"
    if m.tab == "jobs" { back = "tab:job" }
    draw_list(menu_title(m.tab), cats, G.menu_cat, items, back, "menu")
    if len(items) == 0 {
        text(70, 260, "Nada que hacer aquí por ahora.", 20, C_WHITE, "impact")
    }
    return null
}

function draw_person(m: map) {
    let p = find_person(m.pid)
    if p == null { return null }
    let cats = person_cats(p)
    let cat = cats[clamp(G.menu_cat, 0, len(cats) - 1)]
    let items = person_items(p, cat)
    draw_list(str_upper(p.first), cats, G.menu_cat, items, "tab:rel", "person")
    if len(items) == 0 { text(70, 300, "Nada que hacer aquí por ahora.", 20, C_WHITE, "impact") }
    return null
}

// ---------------------------------------------------------------- efectos

// Corte de pantalla al cumplir años.
function draw_cutin() {
    let t = G.t - G.cut_t0
    if t < 0.0 || t > 1.05 { return null }
    let x = 0.0
    if t < 0.22 { x = (1.0 - ease(t / 0.22)) * -1400.0 }
    if t > 0.8 { x = ease((t - 0.8) / 0.25) * 1500.0 }
    svg(x - 120, 230, 1520, 230, slant_doc(1500, 220, 120, HEX_RED, HEX_WHITE, 6, HEX_INK, 14))
    svg(x + 160, 250, 1100, 40, slant_doc(1100, 34, 30, HEX_INK, "", 0, "", 0))
    otext(x + 260, 282, life_stage(), 26, C_WHITE, "impact", false)
    otext(x + 640, 420, str(L.age), 150, C_WHITE, "impact", true)
    otext(x + 340, 400, "EDAD", 48, C_YELLOW, "impact", true)
    otext(x + 940, 400, plural(L.age, "AÑO", "AÑOS"), 48, C_YELLOW, "impact", true)
    return null
}

function life_stage() {
    if L.age < 6 { return "INFANCIA" }
    if L.age < 13 { return "NIÑEZ" }
    if L.age < 18 { return "ADOLESCENCIA" }
    if L.age < 30 { return "JUVENTUD" }
    if L.age < 60 { return "ADULTEZ" }
    return "VEJEZ"
}

// Notificaciones al estilo Persona: una cola, como mucho dos a la vez. Cada una vive
// 2.6 s desde que aparece (las que esperan no envejecen) y entra con un destello.
function draw_toasts() {
    let alive = []
    let slot = 0
    let n = 0
    let total = len(G.toasts)
    for t in G.toasts {
        n += 1
        // Si se amontonan muchas, se descartan las más viejas.
        if total - n >= 8 { continue }
        if slot >= 2 {
            list_push(alive, t)
            continue
        }
        if t.shown == null { t.shown = G.t }
        let age = G.t - t.shown
        if age > 2.6 { continue }
        list_push(alive, t)
        let e = ease(clamp(age / 0.22, 0.0, 1.0))
        let fade = 1.0
        if age > 2.25 { fade = 1.0 - (age - 2.25) / 0.35 }
        let w = 470
        let x = 405.0 + (1.0 - e) * 140.0
        let y = 8.0 + slot * 64.0
        fade_push(clamp(fade, 0.0, 1.0) * e)
        svg(x, y, w + 8, 60, slant_doc(w, 54, 18, HEX_INK, HEX_WHITE, 3, HEX_RED, 6))
        svg(x + 6, y - 2, 58, 58, burst_doc(58, 58, 10, HEX_YELLOW, HEX_INK, 3, 4))
        svg(x + 20, y + 12, 30, 30, arrow_doc("up", HEX_RED))
        let head = t.head
        if head == null {
            head = "AVISO"
            if str_contains(t.title, "RANGO") { head = "¡RANGO ARRIBA!" }
            if str_contains(t.title, "NO SE PUDO") { head = "ERROR" }
        }
        otext(x + 74, y + 19, head, 13, C_YELLOW, "impact", false)
        textw(x + 74, y + 38, t.title, 17, C_WHITE, "impact", w - 100)
        textw(x + 74, y + 51, t.sub, 11, C_GRAY, "bold", w - 100)
        if age < 0.14 { arect(x + 10, y, w - 20, 54, rgba(255, 255, 255, int((0.14 - age) / 0.14 * 110.0))) }
        fade_pop()
        slot += 1
    }
    G.toasts = alive
    return null
}

// ---------------------------------------------------------------- muerte

function draw_dead() {
    arect(0, 0, W, H, rgba(0, 0, 0, 170))
    let e = ease(prog(G.screen_t0, 0.6))
    svg(-40, 140, 460, 460, burst_doc(460, 460, 20, HEX_WHITE, HEX_INK, 5, 1))
    svg(40 - (1.0 - e) * 200, 170, 300, 360, portrait_doc(player_look(), L.gender, L.age, "dead"))
    if L.job != null && L.job.career != null {
        otext(60, 590, str_upper(career_rank_name()), 26, C_YELLOW, "impact", false)
        text(60, 614, L.job.title, 15, C_WHITE, "bold")
    }
    svg(10, -4 - (1.0 - e) * 100, 860, 130, tilt_title_doc("DESCANSE EN PAZ", 860, 130, 72, HEX_WHITE, HEX_INK))

    svg(400, 120, 452, 560, slant_doc(440, 548, 22, HEX_WHITE, HEX_INK, 4, HEX_RED, 12))
    textw(440, 170, str_upper(L.first + " " + L.last), 28, C_INK, "impact", 370)
    let ty = 196
    for line in wrap_px("Murió a los " + str(L.age) + " años por " + L.cause + ".", 360, 16) {
        text_raw(436, ty, line, 16, C_RED, "bold")
        ty += 22
    }
    for line in wrap_px("«" + epitaph() + "»", 360, 15) {
        text_raw(436, ty + 8, line, 15, C_GRAY, "bold")
        ty += 20
    }
    ty -= 20
    if L.lastwords != null && L.lastwords != "" {
        for line in wrap_px("Últimas palabras: «" + L.lastwords + "»", 360, 13) {
            ty += 18
            text_raw(436, ty + 8, line, 13, C_RED, "bold")
        }
    }
    ty += 14
    for line in wrap_px(funeral_text(), 360, 14) {
        ty += 20
        text_raw(436, ty + 8, line, 14, C_INK, "bold")
    }
    let job = L.last_job
    if L.job != null { job = L.job.title }
    if job == "" { job = "Ninguno" }
    let rows = [
        ["Personalidad", trait_name(L.trait, L.gender)],
        ["Dinero", money_str(L.money)],
        ["Último trabajo", job],
        ["Educación", EDU_NAMES[L.edu]]
    ]
    if L.age >= 18 { list_push(rows, ["Parejas sexuales", str(L.partners)]) }
    for r in [["Matrimonios", str(L.marriages) + " · Divorcios " + str(L.divorces)],
              ["Hijos", str(L.kids) + " · " + parenting_label()],
              ["Generación", str(L.gen) + " · " + str(hito_count()) + " hitos"],
              ["Propósitos", goals_text()],
              ["Misiones", str(len(L.done)) + " / " + str(len(MISSIONS))],
              ["Karma", karma_text()]] {
        list_push(rows, r)
    }
    // Las filas se aprietan si el texto de arriba creció (funeral largo,
    // otros idiomas); si ni así caben, se omiten las menos importantes.
    let ry = ty + 46
    let rh = 27
    let room = 662 - ry
    if room < len(rows) * rh { rh = max(19, room / len(rows)) }
    while len(rows) > 6 && len(rows) * rh > room { list_pop(rows) }
    for row in rows {
        text(436, ry, row[0], 14, C_GRAY, "bold")
        textw(586, ry, row[1], 15, C_INK, "impact", 220)
        ry += rh
    }

    if G.legacy != null && len(G.legacy.heirs) > 0 {
        draw_legacy()
        draw_dead_buttons()
        draw_roulette_overlay()
        return null
    }
    draw_grade_stamp()
    // Tu vida en momentos: tus favoritos o, si no marcaste ninguno, los hitos clave.
    let e2 = ease(prog(G.screen_t0 + 0.2, 0.45))
    move_push((1.0 - e2) * 200, 0)
    panel(872, 120, 380, 430, 18)
    let favs = fav_hitos()
    let title = "TU VIDA EN MOMENTOS"
    if len(favs) > 0 { title = "TUS MOMENTOS FAVORITOS" }
    tag(900, 134, 260, title, HEX_RED, C_WHITE)
    push({"op": "clip_push", "x": 880, "y": 160, "w": 364, "h": 386})
    let ly = 178
    let list = life_highlights()
    if len(favs) > 0 { list = list_slice(favs, max(0, len(favs) - 11), len(favs)) }
    if len(list) == 0 { textw(900, ly + 10, "Una vida sin momentos memorables... todavía.", 14, C_GRAY, "bold", 330) }
    for h in list {
        svg(896, ly - 15, 62, 22, slant_doc(58, 20, 6, HEX_RED, "", 0, "", 0))
        ctext(926, ly, str(h.a), 13, C_WHITE, "impact")
        textw(966, ly, h.t, 13, C_WHITE, "bold", 270)
        ly += 30
    }
    push({"op": "clip_pop"})
    text(900, 520, "SE TE RECORDARÁ POR", 11, C_GRAY, "bold")
    textw(900, 540, remembered_for(), 15, C_YELLOW, "impact", 330)
    move_pop()
    draw_dead_buttons()
}

// Calificación de la vida (S a D), al estilo de los resultados de un combate.
function life_grade() {
    let s = min(30, L.age * 30 / 85)
    s += min(20, hito_count() / 2)
    s += (L.karma - 50) / 5
    s += L.happy / 10
    s += min(10, L.kids * 3 + if_num(L.marriages > 0, 3, 0))
    if L.money >= 1000000 { s += 10 } else if L.money >= 100000 { s += 6 } else if L.money > 0 { s += 3 } else { s -= 5 }
    s += L.fame / 10
    if s >= 80 { return ["S", "UNA VIDA LEGENDARIA"] }
    if s >= 65 { return ["A", "UNA VIDA PLENA"] }
    if s >= 50 { return ["B", "UNA BUENA VIDA"] }
    if s >= 35 { return ["C", "UNA VIDA COMPLICADA"] }
    return ["D", "UN DESASTRE ENTRAÑABLE"]
}

function if_num(c: bool, a: int, b: int) {
    if c { return a }
    return b
}

function draw_grade_stamp() {
    let t = G.t - G.screen_t0 - 0.55
    if t < 0.0 { return null }
    let g = life_grade()
    let e = ease(clamp(t / 0.22, 0.0, 1.0))
    let size = 150.0 + (1.0 - e) * 170.0
    let cx = 300.0
    let cy = 520.0
    fade_push(e)
    svg(cx - size / 2.0, cy - size / 2.0, int(size), int(size), burst_doc(int(size), int(size), 16, HEX_RED, HEX_INK, 5, 2))
    otext(cx - size * 0.16, cy + size * 0.2, g[0], int(size * 0.55), C_WHITE, "impact", true)
    fade_pop()
    if t > 0.25 {
        let w = 320
        svg(56, cy + 74, w + 8, 40, slant_doc(w, 34, 12, HEX_INK, HEX_WHITE, 3, HEX_RED, 5))
        ctextw(56 + w / 2, cy + 98, g[1], 16, C_YELLOW, "impact", w - 30)
    }
    return null
}

// Los hitos que cuentan tu historia: sin los de salud menores, repartidos a lo largo de la vida.
function life_highlights() {
    let out = []
    if L.hitos == null { return out }
    let pool = []
    for h in L.hitos {
        if h.c == "Salud" && !str_contains(h.t, "Venciste") { continue }
        list_push(pool, h)
    }
    let n = len(pool)
    if n <= 11 { return pool }
    let i = 0
    while i < 11 {
        list_push(out, pool[i * (n - 1) / 10])
        i += 1
    }
    return out
}

function remembered_for() {
    if L.bw_count != null && L.bw_count > 0 { return "Algo que nadie sabe... y que te llevaste a la tumba." }
    if L.fame >= 60 { return "Tu fama: medio mundo sabía tu nombre." }
    if L.money >= 1000000 { return "Tu fortuna y lo que hiciste con ella." }
    if L.kids >= 3 { return "La gran familia que dejaste." }
    if L.karma >= 80 { return "Tu bondad. Hiciste el mundo un poco mejor." }
    if L.karma < 20 { return "Tus crímenes. Nadie te extrañará." }
    if L.marriages >= 3 { return "Tus bodas. Todas." }
    return "Tu forma de vivir: sin filtro."
}

function draw_dead_buttons() {
    menu_word(880, 566, 250, 54, "OTRA VIDA", "again", 26)
    small_button(1150, 572, 110, 42, "MENÚ", "restart")
    small_button(1150, 628, 110, 42, "SALIR", "quit")
}

function epitaph() {
    if vida_epitaph() != "" { return vida_epitaph() }
    if L.karma >= 75 { return "Un alma buena en un mundo complicado." }
    if L.karma >= 50 { return "Vivió, amó y se equivocó como cualquiera." }
    if L.karma >= 25 { return "Nunca dijo que fuera un santo." }
    return "El infierno ya tiene su lugar reservado."
}

function karma_text() {
    if L.karma >= 75 { return "Santo" }
    if L.karma >= 50 { return "Decente" }
    if L.karma >= 25 { return "Cuestionable" }
    return "Villano"
}
