// @edition 3
// Interfaz estilo Persona: pantallas, menús, ventanas, notificaciones y animaciones.
// Lienzo de 1280x720; los colores del host son ARGB en decimal (ver rgb/rgba).

function rgb(r: int, g: int, b: int) {
    return 4278190080 + r * 65536 + g * 256 + b
}

function rgba(r: int, g: int, b: int, a: int) {
    return a * 16777216 + r * 65536 + g * 256 + b
}

const W = 1280
const H = 720

const C_RED = rgb(227, 20, 27)
const C_INK = rgb(13, 13, 13)
const C_WHITE = rgb(247, 247, 242)
const C_GRAY = rgb(130, 130, 130)
const C_GRAY_D = rgb(48, 48, 48)
const C_YELLOW = rgb(255, 210, 31)
const C_PINK = rgb(255, 122, 200)
const C_BAD = rgb(255, 98, 98)
const C_DIM = rgba(0, 0, 0, 175)

const EDU_NAMES = ["Ninguna", "Primaria", "Secundaria", "Universidad"]
const PAGE_SIZE = 9

state {
    C: list = [],
    block: bool = false
}

// ---------------------------------------------------------------- primitivas

function push(cmd: map) {
    list_push(C, cmd)
}

function rect(x: any, y: any, w: any, h: any, color: int) {
    push({"op": "rect", "x": x, "y": y, "w": w, "h": h, "color": color})
}

function arect(x: any, y: any, w: any, h: any, color: int) {
    push({"op": "alpha_rect", "x": x, "y": y, "w": w, "h": h, "color": color})
}

function text(x: any, y: any, s: string, size: int, color: int, font: string) {
    push({"op": "text", "x": x, "y": y, "text": s, "size": size, "color": color, "font": font})
}

function ctext(x: any, y: any, s: string, size: int, color: int, font: string) {
    push({"op": "text", "x": x, "y": y, "text": s, "size": size, "color": color, "font": font, "align": "center"})
}

// Texto con contorno negro grueso (estilo cómic).
function otext(x: any, y: any, s: string, size: int, color: int, font: string, center: bool) {
    let d = max(2, size / 14)
    for off in [[-d, 0], [d, 0], [0, -d], [0, d], [-d, -d], [d, d], [-d, d], [d, -d]] {
        if center { ctext(x + off[0], y + off[1], s, size, C_INK, font) } else { text(x + off[0], y + off[1], s, size, C_INK, font) }
    }
    if center { ctext(x, y, s, size, color, font) } else { text(x, y, s, size, color, font) }
}

function svg(x: any, y: any, w: int, h: int, doc: string) {
    push({"op": "svg", "x": x, "y": y, "w": w, "h": h, "text": doc})
}

function fade_push(ratio: float) {
    push({"op": "opacity_push", "ratio": ratio})
}

function fade_pop() {
    push({"op": "opacity_pop"})
}

function move_push(dx: any, dy: any) {
    push({"op": "translate_push", "x": dx, "y": dy})
}

function move_pop() {
    push({"op": "transform_pop"})
}

// Zona clicable. Registra el área para el hover propio del juego.
function hot(x: any, y: any, w: any, h: any, action: string) {
    if block { return null }
    push({"op": "alpha_rect", "x": x, "y": y, "w": w, "h": h, "color": 0, "action": action})
    list_push(G.hot, {"x": x, "y": y, "w": w, "h": h, "a": action})
    return null
}

function hovered(action: string) {
    return !block && G.hover == action
}

// Panel inclinado negro con borde blanco y sombra roja.
function panel(x: int, y: int, w: int, h: int, skew: int) {
    svg(x, y, w + 6, h + 6, slant_doc(w, h, skew, HEX_INK, HEX_WHITE, 3, HEX_RED, 6))
}

function tag(x: int, y: int, w: int, lbl: string, fill: string, color: int) {
    svg(x, y, w, 26, slant_doc(w, 26, 8, fill, "", 0, "", 0))
    ctext(x + w / 2, y + 19, lbl, 13, color, "bold")
}

function chars_for(width: int, size: int) {
    return width * 100 / (size * 54)
}

function clip_text(s: string, width: int, size: int) {
    let limit = chars_for(width, size)
    if len(s) <= limit { return s }
    let out = ""
    for w in str_split(s, " ") {
        let next = w
        if out != "" { next = out + " " + w }
        if len(next) + 1 > limit { return out + "…" }
        out = next
    }
    return out
}

// ---------------------------------------------------------------- animación

function prog(t0: float, dur: float) {
    return clamp((G.t - t0) / dur, 0.0, 1.0)
}

function ease(t: float) {
    let u = 1.0 - t
    return 1.0 - u * u * u
}

function stat_color(v: int) {
    if v >= 60 { return C_WHITE }
    if v >= 30 { return C_YELLOW }
    return C_RED
}

function kind_color(k: string) {
    if k == "g" { return C_YELLOW }
    if k == "b" { return C_BAD }
    if k == "x" { return C_PINK }
    return C_WHITE
}

// ---------------------------------------------------------------- frame

function build() {
    C = []
    G.hot = []
    block = false
    svg(0, 0, W, H, bg_doc())
    if G.mode == "title" {
        draw_title()
    } else if G.mode == "create" {
        draw_create()
    } else if G.mode == "dead" {
        draw_dead()
    } else {
        block = G.modal != null
        draw_game()
        block = false
        if G.modal != null { draw_modal(G.modal) }
        draw_cutin()
    }
    draw_toasts()
    return C
}

// ---------------------------------------------------------------- portada

function draw_title() {
    let e = ease(prog(G.screen_t0, 0.5))
    svg(-80 + (1.0 - e) * -200, 250, 460, 460, burst_doc(460, 460, 20, HEX_WHITE, HEX_INK, 5, 4))
    portrait(40 + (1.0 - e) * -200, 300, 330, 396, G.title_look, G.title_gender, 24, "grin", 3, false)

    let logo = ransom_doc(["V", "I", "D", "A", " ", "S", "I", "N", " ", "F", "I", "L", "T", "R", "O"], 84, 3)
    svg(W / 2 - logo.w / 2, 40 - (1.0 - e) * 120, logo.w, logo.h, logo.doc)
    otext(W / 2, 186, "UN SIMULADOR DE VIDA PARA ADULTOS", 22, C_WHITE, "impact", true)

    let items = [["NUEVA VIDA", "new"], ["VIDA AL AZAR", "quick"], ["SALIR", "quit"]]
    let i = 0
    while i < len(items) {
        let it = items[i]
        let x = 640 + i * 26 + (1.0 - ease(prog(G.screen_t0 + 0.1 * i, 0.4))) * 500
        let y = 250 + i * 84
        menu_word(x, y, 440, 68, it[0], it[1], 36)
        i += 1
    }

    svg(640, 520, 566, 116, slant_doc(560, 110, 20, HEX_WHITE, HEX_INK, 3, HEX_RED, 6))
    svg(670, 540, 70, 70, burst_doc(70, 70, 12, HEX_RED, HEX_INK, 3, 2))
    ctext(705, 583, "+18", 22, C_WHITE, "impact")
    text(756, 556, "Contiene sexo (sin escenas explícitas),", 16, C_INK, "bold")
    text(756, 580, "drogas, alcohol, crimen y muy malas", 16, C_INK, "bold")
    text(756, 604, "decisiones. Solo para mayores de edad.", 16, C_INK, "bold")

    if G.lives > 0 {
        otext(1040, 690, "VIDAS VIVIDAS: " + str(G.lives), 18, C_YELLOW, "impact", false)
    }
    text(20, 708, "Velvet Engine · Velvet Script 3", 13, C_GRAY, "ui")
}

// Palabra de menú inclinada: negra con borde blanco; roja al pasar el ratón.
function menu_word(x: any, y: any, w: int, h: int, lbl: string, action: string, size: int) {
    let on = hovered(action)
    let doc = slant_doc(w, h, 22, HEX_INK, HEX_WHITE, 3, HEX_RED, 6)
    let dx = 0
    if on {
        doc = slant_doc(w, h, 22, HEX_RED, HEX_WHITE, 3, HEX_INK, 8)
        dx = 14
    }
    svg(x + dx, y, w + 8, h + 8, doc)
    otext(x + dx + 40, y + h / 2 + size * 36 / 100, lbl, size, C_WHITE, "impact", false)
    hot(x, y, w, h, action)
}

// ---------------------------------------------------------------- creador

function draw_create() {
    let c = G.cre
    svg(-60, 120, 520, 520, burst_doc(520, 520, 22, HEX_WHITE, HEX_INK, 5, 7))
    portrait(40, 150, 360, 432, c.look, c.gender, 22, "grin", 1, true)
    svg(10, -8, 620, 130, tilt_title_doc("CREA TU VIDA", 620, 130, 76, HEX_WHITE, HEX_INK))

    panel(462, 96, 790, 590, 24)
    let pages = ["IDENTIDAD", "ESTILO", "PERSONALIDAD", "RUTA Y FE"]
    let i = 0
    while i < 4 {
        let action = "cre:page:" + str(i)
        let fill = HEX_INK
        let color = C_WHITE
        if i == c.page {
            fill = HEX_WHITE
            color = C_INK
        } else if hovered(action) {
            fill = HEX_RED
        }
        svg(496 + i * 186, 112, 184, 44, slant_doc(178, 40, 12, fill, HEX_WHITE, 2, HEX_RED, 4))
        ctext(496 + i * 186 + 89, 140, str(i + 1) + " · " + pages[i], 15, color, "impact")
        hot(496 + i * 186, 112, 178, 40, action)
        i += 1
    }
    let x0 = 510
    let y = 200
    if c.page == 0 {
        create_label(x0, y, "NOMBRE")
        rect(x0 + 170, y - 26, 330, 38, C_WHITE)
        let shown = str_join(c.chars, "")
        if shown == "" { shown = "(al azar)" }
        let cursor = ""
        if floor(G.t * 2.0) % 2 == 0 { cursor = "|" }
        text(x0 + 182, y + 2, shown + cursor, 20, C_INK, "bold")
        small_button(x0 + 516, y - 26, 120, 38, "AZAR", "cre:name")
        text(x0 + 170, y + 30, "Escribe con el teclado · Retroceso para borrar", 12, C_GRAY, "ui")
        y += 70
        create_label(x0, y, "SEXO")
        toggle(x0 + 170, y - 26, 150, "HOMBRE", "cre:gender:m", c.gender == "m")
        toggle(x0 + 330, y - 26, 150, "MUJER", "cre:gender:f", c.gender == "f")
        y += 60
        create_label(x0, y, "LE ATRAEN")
        toggle(x0 + 170, y - 26, 150, "MUJERES", "cre:likes:f", c.likes == "f")
        toggle(x0 + 330, y - 26, 150, "HOMBRES", "cre:likes:m", c.likes == "m")
        toggle(x0 + 490, y - 26, 150, "AMBOS", "cre:likes:ambos", c.likes == "ambos")
        y += 60
        create_label(x0, y, "PIEL")
        swatches(x0 + 170, y - 8, SKINS, c.look.skin, "cre:skin:")
        y += 60
        create_label(x0, y, "CARA")
        stepper(x0 + 170, y - 26, FACES[c.look.face], "cre:face")
        y += 60
        create_label(x0, y, "CUERPO")
        stepper(x0 + 170, y - 26, BODIES[c.look.body], "cre:body")
    } else if c.page == 1 {
        create_label(x0, y, "PEINADO")
        stepper(x0 + 170, y - 26, HAIR_STYLES[c.look.hair], "cre:hair")
        y += 58
        create_label(x0, y, "PELO")
        swatches(x0 + 170, y - 8, HAIR_COLORS, c.look.hcolor, "cre:hcolor:")
        y += 58
        create_label(x0, y, "OJOS")
        swatches(x0 + 170, y - 8, EYE_COLORS, c.look.eyes, "cre:eyes:")
        y += 58
        create_label(x0, y, "ROPA")
        swatches(x0 + 170, y - 8, OUTFITS, c.look.outfit, "cre:outfit:")
        y += 58
        create_label(x0, y, "ACCESORIO")
        stepper(x0 + 170, y - 26, ACCESSORIES[c.look.acc], "cre:acc")
        y += 58
        create_label(x0, y, "MARCAS")
        stepper(x0 + 170, y - 26, MARKS[c.look.mark], "cre:mark")
        y += 58
        create_label(x0, y, "LABIOS")
        stepper(x0 + 170, y - 26, LIPS[c.look.lips], "cre:lips")
    } else if c.page == 3 {
        create_label(x0, y, "RUTA")
        let r = route_def(c.route)
        stepper(x0 + 170, y - 26, r.short, "cre:route")
        let ty = y + 34
        text(x0 + 170, ty, str_upper(r.n), 16, C_YELLOW, "impact")
        ty += 24
        for line in wrap(r.d, chars_for(560, 15)) {
            text(x0 + 170, ty, line, 15, C_WHITE, "bold")
            ty += 21
        }
        y = ty + 50
        create_label(x0, y, "RELIGIÓN")
        let rel = religion_def(c.religion)
        stepper(x0 + 170, y - 26, str_upper(rel.n), "cre:rel")
        ty = y + 34
        for line in wrap("Tu familia: " + RELIGION_DESC[rel.id], chars_for(560, 15)) {
            text(x0 + 170, ty, line, 15, C_WHITE, "bold")
            ty += 21
        }
    } else {
        create_label(x0, y, "PERSONALIDAD")
        let t = trait_def(c.trait)
        stepper(x0 + 170, y - 26, str_upper(by_gender(c.gender, t.m, t.f)), "cre:trait")
        text(x0 + 170, y + 30, clip_text(t.desc, 540, 14), 14, C_YELLOW, "bold")
        y += 72
        create_label(x0, y, "GUSTOS +18")
        text(x0 + 170, y - 4, "Elige hasta " + str(MAX_KINKS) + ". Se revelan al cumplir 18.", 14, C_GRAY, "bold")
        let k = 0
        while k < len(KINKS) {
            let kk = KINKS[k]
            let col = k % 3
            let row = k / 3
            toggle(x0 + col * 230, y + 18 + row * 48, 214, str_upper(by_gender(c.gender, kk.m, kk.f)), "cre:kink:" + kk.id, list_contains(c.tags, kk.id))
            k += 1
        }
    }

    small_button(1100, 24, 150, 44, "VOLVER", "back")
    small_button(930, 24, 160, 44, "TODO AL AZAR", "cre:random")
    star_button(1036, 572, "¡A VIVIR!", "cre:go", "ENTER")
}

function create_label(x: int, y: int, lbl: string) {
    otext(x, y, lbl, 19, C_WHITE, "impact", false)
}

function toggle(x: int, y: int, w: int, lbl: string, action: string, on: bool) {
    let fill = HEX_INK
    let color = C_WHITE
    if on {
        fill = HEX_WHITE
        color = C_INK
    }
    if hovered(action) && !on { fill = HEX_RED }
    svg(x, y, w + 4, 42, slant_doc(w, 38, 10, fill, HEX_WHITE, 2, HEX_RED, 4))
    ctext(x + w / 2, y + 26, lbl, 15, color, "bold")
    hot(x, y, w, 38, action)
}

function small_button(x: int, y: int, w: int, h: int, lbl: string, action: string) {
    let fill = HEX_INK
    if hovered(action) { fill = HEX_RED }
    svg(x, y, w + 4, h + 4, slant_doc(w, h, 10, fill, HEX_WHITE, 2, HEX_RED, 4))
    ctext(x + w / 2, y + h / 2 + 6, lbl, 15, C_WHITE, "bold")
    hot(x, y, w, h, action)
}

function swatches(x: int, y: int, colors: list, selected: int, prefix: string) {
    let i = 0
    while i < len(colors) {
        let cx = x + 18 + i * 44
        let action = prefix + str(i)
        let ring = 0
        if i == selected { ring = 5 } else if hovered(action) { ring = 3 }
        let body = "<circle cx='22' cy='22' r='" + str(14 + ring) + "' fill='" + HEX_WHITE + "' stroke='" + HEX_INK + "' stroke-width='2'/>"
        if i == selected { body = body + "<circle cx='22' cy='22' r='17' fill='" + HEX_RED + "'/>" }
        body = body + "<circle cx='22' cy='22' r='13' fill='" + colors[i] + "' stroke='" + HEX_INK + "' stroke-width='2'/>"
        svg(cx - 22, y - 22, 44, 44, svg_doc(44, 44, body))
        hot(cx - 18, y - 18, 36, 36, action)
        i += 1
    }
}

function stepper(x: int, y: int, lbl: string, action: string) {
    let left = HEX_WHITE
    let right = HEX_WHITE
    if hovered(action + ":-") { left = HEX_RED }
    if hovered(action + ":+") { right = HEX_RED }
    svg(x, y, 38, 38, arrow_doc("left", left))
    hot(x, y, 38, 38, action + ":-")
    svg(x + 46, y, 268, 42, slant_doc(264, 38, 10, HEX_WHITE, HEX_INK, 2, HEX_RED, 4))
    ctext(x + 46 + 132, y + 26, lbl, 16, C_INK, "bold")
    svg(x + 322, y, 38, 38, arrow_doc("right", right))
    hot(x + 322, y, 38, 38, action + ":+")
}

// Botón de estallido grande (avanzar año, empezar vida).
function star_button(x: int, y: int, lbl: string, action: string, hint: string) {
    let on = hovered(action)
    let fill = HEX_RED
    if on { fill = HEX_YELLOW }
    svg(x, y, 240, 160, burst_doc(240, 160, 16, fill, HEX_INK, 5, 11))
    let color = C_WHITE
    if on { color = C_INK }
    if on { ctext(x + 120, y + 92, lbl, 34, color, "impact") } else { otext(x + 120, y + 92, lbl, 34, color, "impact", true) }
    ctext(x + 120, y + 116, hint, 12, color, "bold")
    hot(x + 40, y + 30, 160, 100, action)
}

// ---------------------------------------------------------------- juego

function draw_game() {
    draw_card()
    draw_feed(404, 16, 472, 594)
    draw_stats(884, 16, 380, 196)
    draw_social(884, 222, 380, 214)
    draw_status(884, 446, 380, 146)
    draw_bottom()
}

function draw_card() {
    svg(18, 52, 360, 360, burst_doc(360, 360, 18, HEX_WHITE, HEX_INK, 4, L.age % 7))
    portrait(58, 66, 280, 336, L.look, L.gender, L.age, mood_for(L.happy), 0, true)
    svg(16, 16, 378, 60, slant_doc(372, 54, 18, HEX_INK, HEX_WHITE, 3, HEX_RED, 6))
    text(44, 52, clip_text(str_upper(L.first + " " + L.last), 310, 22), 22, C_WHITE, "impact")
    tag(30, 84, 150, str_upper(month_name()), HEX_YELLOW, C_INK)
    if L.route != null && L.route != "normal" {
        let rf = HEX_RED
        if hovered("tab:route") { rf = HEX_WHITE }
        let rc = C_WHITE
        if hovered("tab:route") { rc = C_INK }
        svg(186, 84, 186, 26, slant_doc(180, 26, 8, rf, HEX_WHITE, 2, "", 0))
        ctext(186 + 90, 102, clip_text("RUTA: " + route_def(L.route).short + " ›", 170, 13), 13, rc, "bold")
        hot(186, 84, 180, 26, "tab:route")
    }
    draw_effect_chips(26, 118)
    draw_phone_button()
    svg(282, 282, 116, 116, burst_doc(116, 116, 14, HEX_RED, HEX_INK, 4, 5))
    otext(340, 342, str(L.age), 40, C_WHITE, "impact", true)
    ctext(340, 362, plural(L.age, "AÑO", "AÑOS"), 12, C_WHITE, "bold")

    panel(16, 398, 372, 212, 18)
    tag(40, 410, 190, str_upper(trait_name(L.trait, L.gender)), HEX_RED, C_WHITE)
    text(238, 429, mood_word(), 14, C_YELLOW, "bold")
    let occ_label = "OCUPACIÓN"
    if L.job2 != null { occ_label = "OCUPACIÓN · 2.ª: " + str_upper(L.job2.title) }
    text(44, 458, clip_text(occ_label, 330, 11), 11, C_GRAY, "bold")
    text(44, 479, clip_text(occupation_text(), 320, 16), 16, C_WHITE, "bold")
    let fcol = C_YELLOW
    if hovered("ph:app:bank") { fcol = C_WHITE }
    text(44, 504, "DINERO · BANCO ›", 11, fcol, "bold")
    hot(40, 490, 170, 46, "ph:app:bank")
    let mc = C_YELLOW
    if L.money < 0 { mc = C_BAD }
    text(44, 530, money_str(L.money), 22, mc, "impact")
    draw_floats_for("money", 150, 508)
    if L.fame > 0 {
        text(220, 504, "FAMA", 11, C_GRAY, "bold")
        rect(220, 516, 130, 12, C_GRAY_D)
        rect(220, 516, 130 * L.fame / 100, 12, C_YELLOW)
        text(220 + 136, 528, str(L.fame), 13, C_YELLOW, "impact")
    } else {
        text(220, 504, "CIUDAD", 11, C_GRAY, "bold")
        text(220, 526, clip_text(L.city, 150, 14), 14, C_WHITE, "bold")
    }
    if L.age >= 18 && len(L.tags) > 0 {
        text(44, 556, "GUSTOS", 11, C_GRAY, "bold")
        let tx = 40
        let ty = 566
        for t in L.tags {
            let name = kink_name(t, L.gender)
            let w = min(170, 24 + len(name) * 8)
            if tx + w > 380 {
                tx = 34
                ty += 24
            }
            if ty < 600 {
                svg(tx, ty, w, 22, slant_doc(w, 22, 7, "#3a0d10", HEX_RED, 2, "", 0))
                ctext(tx + w / 2, ty + 16, clip_text(name, w - 14, 12), 12, C_PINK, "bold")
            }
            tx += w + 4
        }
    } else {
        text(44, 556, "FAMILIA", 11, C_GRAY, "bold")
        text(44, 578, clip_text(FAMILY_NAMES[L.family] + " · " + religion_text(), 320, 14), 14, C_WHITE, "bold")
    }
}

// Retrato animado: respira, parpadea y reacciona a lo que pasa (solo el protagonista).
function portrait(x: any, y: any, w: int, h: int, look: map, gender: string, age: int, mood: string, seed: int, react: bool) {
    let dx = 0.0
    let dy = sin(G.t * 2.0 + seed * 1.7) * 2.5
    let m = mood
    if mood != "grin" && mood != "dead" && fract((G.t + seed * 0.73) / 3.7) < 0.045 {
        m = mood + "!b"
    }
    let emote = ""
    let ep = 1.0
    if react && G.react != null {
        let p = prog(G.react.t0, 0.9)
        if p < 1.0 {
            let k = G.react.kind
            if k == "b" {
                dx = sin(G.t * 70.0) * 9.0 * (1.0 - p)
                emote = "bad"
            } else {
                dy = dy - abs(sin(p * 9.42)) * 16.0 * (1.0 - p)
                emote = "good"
                if k == "x" { emote = "love" }
                if k == "m" { emote = "money" }
                if k == "a" { emote = "angry" }
            }
            ep = p
        }
    }
    svg(x + dx, y + dy, w, h, portrait_doc(look, gender, age, m))
    if emote != "" {
        fade_push(clamp(1.6 - ep * 1.6, 0.0, 1.0))
        svg(x + w - 90 + dx, y + 8 - ep * 20.0, 80, 80, emote_doc(emote))
        fade_pop()
    }
}

function mood_word() {
    let m = mood_for(L.happy)
    if m == "grin" { return "EUFÓRIC" + str_upper(oa(L.gender)) }
    if m == "happy" { return "CONTENT" + str_upper(oa(L.gender)) }
    if m == "neutral" { return "TRANQUIL" + str_upper(oa(L.gender)) }
    if m == "sad" { return "TRISTE" }
    return "DEPRIMID" + str_upper(oa(L.gender))
}

function occupation_text() {
    if L.jail > 0 { return "En prisión" }
    if L.job != null { return job_display(L.job) }
    if L.study != null {
        let d = degree_def(L.study.deg)
        if L.gig != null { return d.n + " + " + L.gig.title }
        return "Estudiante de " + d.n
    }
    if L.gig != null { return L.gig.title + " (medio tiempo)" }
    if L.school == "primaria" { return "Primaria" }
    if L.school == "secundaria" { return "Secundaria" }
    if L.age < 6 { return by_gender(L.gender, "Bebé consentido", "Bebé consentida") }
    return "Desemplead" + oa(L.gender)
}

function draw_feed(x: int, y: int, w: int, h: int) {
    panel(x, y, w, h, 20)
    let hfill = HEX_RED
    if hovered("tab:hitos") { hfill = HEX_YELLOW }
    svg(x + 24, y + 10, 152, 34, slant_doc(146, 30, 9, hfill, HEX_WHITE, 2, HEX_INK, 4))
    let hcol = C_WHITE
    if hovered("tab:hitos") { hcol = C_INK }
    ctext(x + 24 + 73, y + 31, "HITOS " + str(hito_count()), 14, hcol, "impact")
    hot(x + 24, y + 10, 146, 30, "tab:hitos")
    let mission_label = "MISIONES " + str(len(L.done)) + "/" + str(len(MISSIONS))
    let mfill = HEX_WHITE
    let mcolor = C_INK
    if hovered("tab:missions") {
        mfill = HEX_YELLOW
    }
    svg(x + w - 176, y + 10, 156, 34, slant_doc(150, 30, 9, mfill, HEX_INK, 2, HEX_RED, 4))
    ctext(x + w - 176 + 75, y + 31, mission_label, 14, mcolor, "impact")
    hot(x + w - 176, y + 10, 150, 30, "tab:missions")
    let efill = HEX_WHITE
    if hovered("tab:effects") { efill = HEX_YELLOW }
    svg(x + 182, y + 10, 114, 34, slant_doc(108, 30, 9, efill, HEX_INK, 2, HEX_RED, 4))
    ctext(x + 182 + 54, y + 31, "EFECTOS " + str(len(effects())), 14, C_INK, "impact")
    hot(x + 182, y + 10, 108, 30, "tab:effects")
    let line_h = 23
    let top = y + 54
    let visible = (h - 70) / line_h
    let total = len(L.log)
    let max_scroll = max(0, total - visible)
    G.scroll = clamp(G.scroll, 0, max_scroll)
    let start = max(0, total - visible - G.scroll)
    let end = min(total, start + visible)
    push({"op": "clip_push", "x": x + 4, "y": top - 4, "w": w - 8, "h": h - 64})
    let cy = top
    let i = start
    while i < end {
        let entry = L.log[i]
        let lx = x + 34 - (cy - y) * 20 / h
        if entry.k == "h" {
            svg(lx, cy + 1, 120, 20, slant_doc(120, 20, 7, HEX_RED, "", 0, "", 0))
            ctext(lx + 60, cy + 16, str_upper(entry.t), 13, C_WHITE, "bold")
        } else {
            text(lx + 6, cy + 17, entry.t, 15, kind_color(entry.k), "ui")
        }
        cy += line_h
        i += 1
    }
    push({"op": "clip_pop"})
    if max_scroll > 0 {
        let track = h - 80
        let thumb = max(30, track * visible / total)
        let ty = top + (track - thumb) * (max_scroll - G.scroll) / max_scroll
        rect(x + w - 30, top, 3, track, C_GRAY_D)
        rect(x + w - 31, ty, 5, thumb, C_WHITE)
    }
    if G.scroll > 0 {
        small_button(x + w / 2 - 100, y + h - 52, 200, 34, "LO MÁS RECIENTE", "scroll:end")
    }
}

function draw_stats(x: int, y: int, w: int, h: int) {
    panel(x, y, w, h, 16)
    tag(x + 26, y + 12, 150, "ESTADÍSTICAS", HEX_RED, C_WHITE)
    let keys = ["happy", "health", "smarts", "looks"]
    let names = ["FELICIDAD", "SALUD", "INTELIGENCIA", "ATRACTIVO"]
    let i = 0
    while i < 4 {
        let v = L[keys[i]]
        if keys[i] == "looks" { v = looks_eff() }
        let ry = y + 66 + i * 34
        let rx = x + 30 - i * 4
        text(rx, ry, names[i], 14, C_WHITE, "impact")
        rect(rx + 120, ry - 13, 190, 14, C_GRAY_D)
        rect(rx + 120, ry - 13, 190 * v / 100, 14, stat_color(v))
        rect(rx + 120, ry + 1, 190, 2, C_INK)
        text(rx + 318, ry, str(v), 15, stat_color(v), "impact")
        if keys[i] == "looks" && v != L.looks {
            let diff = v - L.looks
            let lbl = str(diff)
            let col = C_BAD
            if diff > 0 {
                lbl = "+" + lbl
                col = rgb(90, 220, 120)
            }
            text(rx + 120, ry + 14, "base " + str(L.looks) + " · efectos " + lbl, 10, col, "bold")
        }
        draw_floats_for(keys[i], rx + 262, ry - 15)
        i += 1
    }
}

function draw_social(x: int, y: int, w: int, h: int) {
    panel(x, y, w, h, 16)
    tag(x + 26, y + 12, 170, "RASGOS SOCIALES", HEX_RED, C_WHITE)
    let i = 0
    while i < len(SOCIAL_KEYS) {
        let k = SOCIAL_KEYS[i]
        let r = rank(k)
        let ry = y + 64 + i * 32
        let rx = x + 30 - i * 3
        text(rx, ry, str_upper(SOCIAL_NAMES[k]), 14, C_WHITE, "impact")
        text(rx + 128, ry, rank_title(k, r), 13, C_GRAY, "bold")
        let p = 0
        while p < 5 {
            let col = C_GRAY_D
            if p < r { col = C_RED }
            rect(rx + 240 + p * 20, ry - 13, 14, 14, col)
            if p < r { rect(rx + 243 + p * 20, ry - 10, 4, 4, C_WHITE) }
            p += 1
        }
        draw_floats_for(k, rx + 200, ry - 14)
        i += 1
    }
}

function draw_status(x: int, y: int, w: int, h: int) {
    panel(x, y, w, h, 16)
    tag(x + 26, y + 12, 130, "SITUACIÓN", HEX_RED, C_WHITE)
    let rows = [
        ["Relación", relationship_text()],
        ["Educación", education_text()],
        ["Parejas sexuales", str(L.partners) + " · Hijos " + str(L.kids)],
        ["Salud", health_text()],
        ["Vicios / ley", vice_text()]
    ]
    let ry = y + 56
    let i = 0
    for row in rows {
        let rx = x + 30 - i * 3
        text(rx, ry, row[0], 13, C_GRAY, "bold")
        text(rx + 136, ry, clip_text(row[1], w - 190, 14), 14, C_WHITE, "bold")
        ry += 19
        i += 1
    }
}

function relationship_text() {
    let p = partner()
    if p == null {
        if L.age < 16 { return "—" }
        return by_gender(L.gender, "Soltero", "Soltera")
    }
    if L.married { return by_gender(L.gender, "Casado", "Casada") + " con " + p.first }
    return rel_label(p) + ": " + p.first
}

function education_text() {
    if L.study != null { return degree_def(L.study.deg).n + " · prom. " + str(L.study.gpa) }
    if L.school != "" && L.age < 18 { return "Escuela · calif. " + str(L.grades) }
    let out = EDU_NAMES[L.edu]
    if len(L.degrees) > 0 { out = degrees_text() }
    if L.debt > 0 { out = out + " · deuda " + money_str(L.debt) }
    return out
}



function vice_text() {
    let parts = []
    if L.alcohol > 0 { list_push(parts, "Alcohol " + str(L.alcohol) + "%") }
    if L.drugs > 0 { list_push(parts, "Drogas " + str(L.drugs) + "%") }
    if L.jail > 0 { list_push(parts, "En prisión") } else if L.record > 0 { list_push(parts, str(L.record) + " " + plural(L.record, "delito", "delitos")) }
    if len(parts) == 0 { return "Ninguno" }
    return str_join(parts, " · ")
}

function draw_bottom() {
    let tabs = [["OCUPACIÓN", "tab:job"], ["VÍNCULOS", "tab:rel"], ["ACTIVIDADES", "tab:act"], ["NOCHE +18", "tab:night"]]
    let i = 0
    while i < len(tabs) {
        let t = tabs[i]
        let x = 16 + i * 222
        let y = 634
        let on = hovered(t[1])
        let doc = slant_doc(210, 64, 20, HEX_INK, HEX_WHITE, 3, HEX_RED, 6)
        if on {
            doc = slant_doc(210, 64, 20, HEX_RED, HEX_WHITE, 3, HEX_INK, 8)
            y -= 6
        }
        svg(x, y, 218, 72, doc)
        otext(x + 105, y + 43, t[0], 24, C_WHITE, "impact", true)
        hot(x, 634, 210, 64, t[1])
        i += 1
    }
    // Avance rápido hasta el cumpleaños (se detiene si algo requiere decisión).
    let fy = 640
    let fill = HEX_WHITE
    let color = C_INK
    if hovered("year") {
        fill = HEX_YELLOW
        fy -= 4
    }
    svg(912, fy, 128, 58, slant_doc(122, 52, 14, fill, HEX_INK, 3, HEX_RED, 5))
    ctext(972, fy + 26, "+1 AÑO", 20, color, "impact")
    ctext(972, fy + 44, "TECLA Y", 11, color, "bold")
    hot(912, 640, 122, 52, "year")
    star_button(1034, 586, "+1 MES", "age", "ESPACIO")
}

// Números que flotan junto a una estadística después de cambiar.
function draw_floats_for(key: string, x: int, y: int) {
    for f in G.floats {
        if f.k != key || G.t < f.t0 { continue }
        let p = prog(f.t0, 1.6)
        if p >= 1.0 { continue }
        let lbl = str(f.v)
        let color = C_YELLOW
        if f.v > 0 { lbl = "+" + lbl }
        if f.v < 0 { color = C_BAD }
        if key == "money" {
            lbl = money_str(f.v)
            if f.v > 0 { lbl = "+" + lbl }
        }
        fade_push(1.0 - p * p)
        otext(x, y - p * 26, lbl, 18, color, "impact", false)
        fade_pop()
    }
}

// ---------------------------------------------------------------- ventanas

function draw_modal(m: map) {
    arect(0, 0, W, H, C_DIM)
    push({"op": "alpha_rect", "x": 0, "y": 0, "w": W, "h": H, "color": 0, "action": "noop"})
    if G.t < G.modal_t0 { return null }
    if m.kind == "info" { return draw_dialog(m, ["CONTINUAR"], [""], [""], "ok") }
    if m.kind == "choice" {
        let tags = m.tags
        if tags == null { tags = [] }
        return draw_dialog(m, m.choices, m.locks, tags, "choice:")
    }
    if m.kind == "menu" { return draw_menu(m) }
    if m.kind == "person" { return draw_person(m) }
    if m.kind == "minigame" { return draw_minigame() }
    if m.kind == "chat" { return draw_chat() }
    if m.kind == "phone" { return draw_phone() }
    return null
}

// Diálogo estilo Persona: retrato a un lado, panel inclinado y opciones.
function draw_dialog(m: map, choices: list, locks: list, tags: list, prefix: string) {
    let e = ease(prog(G.modal_t0, 0.25))
    let p = m.person
    let w = 740
    let lines = wrap(m.text, chars_for(w - 120, 18))
    let n = len(choices)
    let h = 96 + len(lines) * 27 + n * 56 + 20
    let x = (W - w) / 2
    if p != null { x = 470 }
    let y = (H - h) / 2 + 20
    if p != null {
        let px = 20 - (1.0 - e) * 300
        svg(px - 30, 250, 420, 420, burst_doc(420, 420, 18, HEX_WHITE, HEX_INK, 5, p.id % 9))
        portrait(px + 20, 270, 330, 396, p.look, p.gender, p.age, person_mood(p), p.id, false)
        svg(px + 30, 640, 300, 50, slant_doc(294, 44, 14, HEX_INK, HEX_WHITE, 3, HEX_RED, 6))
        text(px + 56, 672, clip_text(str_upper(p.first), 240, 24), 24, C_WHITE, "impact")
    }
    fade_push(e)
    move_push((1.0 - e) * 140, 0)
    svg(x, y, w + 10, h + 10, slant_doc(w, h, 26, HEX_INK, HEX_WHITE, 4, HEX_RED, 10))
    let title = str_upper(m.title)
    let tw = min(600, 70 + len(title) * 19)
    svg(x - 12, y - 26, tw + 6, 58, slant_doc(tw, 52, 16, HEX_RED, HEX_WHITE, 3, HEX_INK, 6))
    otext(x + 18, y + 12, title, 28, C_WHITE, "impact", false)
    let ty = y + 64
    for line in lines {
        text(x + 48, ty, line, 18, C_WHITE, "ui")
        ty += 27
    }
    let by = ty + 8
    let i = 0
    while i < n {
        let action = prefix
        if prefix == "choice:" { action = prefix + str(i) }
        let locked = len(locks) > i && locks[i] != ""
        let tag_text = ""
        if len(tags) > i { tag_text = tags[i] }
        dialog_option(x + 40 - i * 6, by, w - 90, choices[i], i, action, locked, locks, tag_text)
        by += 56
        i += 1
    }
    move_pop()
    fade_pop()
    return null
}

function dialog_option(x: int, y: int, w: int, lbl: string, i: int, action: string, locked: bool, locks: list, tag_text: string) {
    let on = hovered(action) && !locked
    let fill = "#262626"
    let color = C_WHITE
    if on { fill = HEX_RED }
    if locked {
        fill = "#1a1a1a"
        color = C_GRAY
    }
    let dx = 0
    if on { dx = 12 }
    svg(x + dx, y, w + 6, 50, slant_doc(w, 46, 14, fill, HEX_WHITE, 2, HEX_INK, 4))
    svg(x + dx + 18, y + 9, 30, 30, slant_doc(30, 30, 6, HEX_WHITE, "", 0, "", 0))
    ctext(x + dx + 33, y + 31, str(i + 1), 18, C_INK, "impact")
    text(x + dx + 60, y + 30, clip_text(lbl, w - 230, 17), 17, color, "bold")
    if locked {
        svg(x + dx + w - 190, y + 8, 30, 30, lock_doc())
        text(x + dx + w - 156, y + 30, str_upper(locks[i]), 14, C_RED, "impact")
    } else if tag_text != "" {
        text(x + dx + w - 150, y + 30, "[" + str_upper(tag_text) + "]", 14, C_YELLOW, "impact")
    }
    if !locked { hot(x, y, w, 46, action) }
}

function person_mood(p: map) {
    if p.rel == "ex" { return "angry" }
    if p.bond >= 75 { return "grin" }
    if p.bond >= 45 { return "happy" }
    if p.bond >= 25 { return "neutral" }
    return "sad"
}

// Pantalla de lista: título ladeado, pestañas, opciones y panel de descripción.
function draw_list(title: string, cats: list, cat: int, items: list, back: string, kind: string) {
    let e = ease(prog(G.menu_t0, 0.3))
    svg(-160 - (1.0 - e) * 400, 0, 820, 720, slant_doc(760, 720, 220, HEX_RED, "", 0, HEX_INK, 60))
    svg(24, 2 - (1.0 - e) * 80, 640, 136, tilt_title_doc(title, 640, 136, 78, HEX_WHITE, HEX_INK))
    small_button(1110, 26, 140, 42, "VOLVER", back)
    text(1118, 86, "ESC", 12, C_WHITE, "bold")

    let list_y = 150
    if len(cats) > 0 {
        // Hasta 6 pestañas por fila; con muchas categorías se usan varias filas compactas.
        let per_row = 6
        let tw = 100
        let th = 30
        if len(cats) <= 4 {
            per_row = 4
            tw = 128
            th = 38
        }
        let i = 0
        while i < len(cats) {
            let action = "cat:" + str(i)
            let fill = HEX_INK
            let color = C_WHITE
            if i == cat {
                fill = HEX_WHITE
                color = C_INK
            } else if hovered(action) {
                fill = HEX_RED
            }
            let tx = 46 + (i % per_row) * (tw + 6) - (i / per_row) * 8
            let ty = 138 + (i / per_row) * (th + 6)
            svg(tx, ty, tw + 4, th + 4, slant_doc(tw, th, 8, fill, HEX_WHITE, 2, HEX_INK, 4))
            let size = 16
            if th < 38 { size = 13 }
            ctext(tx + tw / 2, ty + th / 2 + size * 4 / 10, clip_text(str_upper(cats[i]), tw - 10, size), size, color, "impact")
            hot(tx, ty, tw, th, action)
            i += 1
        }
        let rows = (len(cats) + per_row - 1) / per_row
        list_y = 140 + rows * (th + 6) + 12
    }

    let page_size = (650 - list_y) / 52
    if page_size > PAGE_SIZE { page_size = PAGE_SIZE }
    if page_size < 4 { page_size = 4 }
    let pages = max(1, (len(items) + page_size - 1) / page_size)
    G.menu_page = clamp(G.menu_page, 0, pages - 1)
    let first = G.menu_page * page_size
    let last = min(len(items), first + page_size)
    let focus = null
    let i = first
    while i < last {
        let it = items[i]
        let k = i - first
        let ie = ease(prog(G.menu_t0 + k * 0.03, 0.25))
        let ix = 56 - k * 4 - (1.0 - ie) * 260
        let iy = list_y + k * 52
        let locked = it.lock != ""
        let on = hovered(it.action)
        if on { focus = it }
        let fill = HEX_INK
        let color = C_WHITE
        let dx = 0
        if on {
            fill = HEX_WHITE
            color = C_INK
            dx = 16
        }
        if locked && !on {
            fill = "#1c1c1c"
            color = C_GRAY
        }
        if it.done == true && !on {
            fill = "#3a2a00"
            color = C_YELLOW
        }
        svg(ix + dx, iy, 526, 52, slant_doc(520, 46, 16, fill, HEX_WHITE, 2, HEX_RED, 6))
        text(ix + dx + 30, iy + 30, clip_text(it.t, 310, 19), 19, color, "impact")
        let sub_color = C_GRAY
        if on { sub_color = C_RED }
        if locked {
            svg(ix + dx + 372, iy + 8, 28, 28, lock_doc())
            text(ix + dx + 404, iy + 29, clip_text(str_upper(it.lock), 100, 13), 13, C_RED, "impact")
        } else {
            text(ix + dx + 344, iy + 29, clip_text(it.s, 160, 12), 12, sub_color, "bold")
        }
        hot(ix, iy, 520, 46, it.action)
        i += 1
    }
    if pages > 1 {
        let py = list_y + page_size * 52 + 4
        if G.menu_page > 0 { small_button(60, py, 140, 36, "ANTERIOR", "page:-") }
        if G.menu_page < pages - 1 { small_button(360, py, 140, 36, "SIGUIENTE", "page:+") }
        ctext(280, py + 24, str(G.menu_page + 1) + " / " + str(pages), 16, C_WHITE, "impact")
    }
    if focus == null && len(items) > 0 { focus = items[first] }
    if focus != null { draw_detail(focus, kind) }
    return null
}

function draw_detail(it: any, kind: string) {
    let x = 660
    let y = 150
    let w = 580
    let h = 520
    svg(x, y, w + 12, h + 12, slant_doc(w, h, 26, HEX_WHITE, HEX_INK, 4, HEX_INK, 12))
    if it.pid != null {
        let p = find_person(it.pid)
        if p != null {
            svg(x + 300, y + 120, 280, 280, burst_doc(280, 280, 16, HEX_RED, HEX_INK, 4, p.id % 7))
            portrait(x + 320, y + 130, 230, 276, p.look, p.gender, p.age, person_mood(p), p.id, false)
            if p.age >= 18 && L.age >= 18 && p.tags != null && !is_family(p) {
                let gl = "Gustos: " + kinks_text(p.tags, p.gender)
                let shared = shared_kinks(p)
                if len(shared) > 0 { gl = gl + " · ¡comparten " + str(len(shared)) + "!" }
                text(x + 46, y + 410, clip_text(gl, 270, 13), 13, C_RED, "bold")
            }
            text(x + 46, y + 60, clip_text(str_upper(p.first), 260, 34), 34, C_INK, "impact")
            text(x + 46, y + 92, rel_label(p) + " · " + str(p.age) + " años", 17, C_RED, "bold")
            text(x + 46, y + 140, "ARCANO", 12, C_GRAY, "bold")
            text(x + 46, y + 166, str_upper(arcana(p)), 22, C_INK, "impact")
            text(x + 46, y + 206, "RANGO DE CONFIDENTE", 12, C_GRAY, "bold")
            let r = conf_rank(p)
            let i = 0
            while i < 10 {
                let col = rgb(210, 210, 205)
                if i < r { col = C_RED }
                rect(x + 46 + i * 24, y + 218, 18, 18, col)
                i += 1
            }
            text(x + 46, y + 270, "CERCANÍA " + str(p.bond) + "%", 16, C_INK, "impact")
            rect(x + 46, y + 280, 230, 12, rgb(210, 210, 205))
            rect(x + 46, y + 280, 230 * p.bond / 100, 12, C_RED)
            text(x + 46, y + 318, clip_text(bond_state(p) + " · Compatibilidad " + str(compat(p)) + "%", 270, 15), 15, C_INK, "bold")
            let extra = STYLE_NAMES[npc_style(p)] + " · " + temper_name(p) + " · " + str_lower(mood_name(p))
            if p.age >= 18 { extra = "Atractivo " + str(p.looks) + "% · " + extra }
            text(x + 46, y + 338, clip_text(extra, 270, 13), 13, C_GRAY, "bold")
            let fl = interests_text(p)
            if p.bff == true { fl = "Mejor amig" + oa(p.gender) + " · " + fl }
            text(x + 46, y + 356, clip_text(fl, 270, 13), 13, C_GRAY, "bold")
            let ll = lovelang_text(p)
            if p.age >= 18 && L.age >= 18 && (rel_group(p) == "partner" || rel_group(p) == "fling") && p.gender != L.gender {
                ll = ll + " · Fertilidad " + fert_word(their_fertility(p))
            }
            text(x + 46, y + 374, clip_text(ll, 270, 13), 13, C_GRAY, "bold")
            if kind == "person" {
                text(x + 46, y + 440, clip_text(str_upper(it.t), 500, 22), 22, C_RED, "impact")
                text(x + 46, y + 462, clip_text(it.s, 500, 14), 14, C_INK, "bold")
                if it.desc != null && it.desc != it.s {
                    let dy = y + 484
                    for line in wrap(it.desc, chars_for(500, 14)) {
                        if dy < y + 520 { text(x + 46, dy, line, 14, C_INK, "ui") }
                        dy += 18
                    }
                }
            } else {
                text(x + 46, y + 470, "Clic para interactuar", 14, C_RED, "bold")
            }
            return null
        }
    }
    text(x + 46, y + 66, clip_text(str_upper(it.t), 420, 34), 34, C_INK, "impact")
    text(x + 46, y + 100, it.s, 17, C_RED, "bold")
    let ty = y + 150
    if it.desc != null {
        for line in wrap(it.desc, chars_for(470, 18)) {
            text(x + 46, ty, line, 18, C_INK, "ui")
            ty += 28
        }
    }
    if it.lock != "" {
        svg(x + 40, y + h - 120, 380, 58, slant_doc(372, 50, 14, HEX_INK, HEX_RED, 3, HEX_RED, 6))
        svg(x + 58, y + h - 110, 30, 30, lock_doc())
        text(x + 96, y + h - 87, "REQUIERE: " + str_upper(it.lock), 18, C_WHITE, "impact")
    }
    if kind == "jobs" && it.ok != null {
        let msg = "CUMPLES LOS REQUISITOS"
        let col = C_RED
        if !it.ok {
            msg = "NO CUMPLES · PRUEBA SUERTE"
            col = C_GRAY
        }
        text(x + 46, y + h - 60, msg, 20, col, "impact")
    }
    return null
}

function draw_menu(m: map) {
    let blocked = menu_block(m.tab)
    if blocked != "" {
        draw_list(menu_title(m.tab), [], 0, [], "close", "menu")
        svg(660, 260, 580, 140, slant_doc(570, 130, 20, HEX_WHITE, HEX_INK, 4, HEX_INK, 10))
        let ty = 320
        for line in wrap(blocked, chars_for(480, 20)) {
            text(706, ty, line, 20, C_INK, "impact")
            ty += 28
        }
        return null
    }
    let cats = menu_cats(m.tab)
    let cat = ""
    if len(cats) > 0 { cat = cats[clamp(G.menu_cat, 0, len(cats) - 1)] }
    let items = menu_items(m.tab, cat)
    let back = "close"
    if m.tab == "jobs" { back = "tab:job" }
    draw_list(menu_title(m.tab), cats, G.menu_cat, items, back, "menu")
    if len(items) == 0 {
        text(70, 260, "Nada que hacer aquí por ahora.", 20, C_WHITE, "impact")
    }
    return null
}

function draw_person(m: map) {
    let p = find_person(m.pid)
    if p == null { return null }
    let cats = person_cats(p)
    let cat = cats[clamp(G.menu_cat, 0, len(cats) - 1)]
    let items = person_items(p, cat)
    draw_list(str_upper(p.first), cats, G.menu_cat, items, "tab:rel", "person")
    if len(items) == 0 { text(70, 300, "Nada que hacer aquí por ahora.", 20, C_WHITE, "impact") }
    return null
}

// ---------------------------------------------------------------- efectos

// Corte de pantalla al cumplir años.
function draw_cutin() {
    let t = G.t - G.cut_t0
    if t < 0.0 || t > 1.05 { return null }
    let x = 0.0
    if t < 0.22 { x = (1.0 - ease(t / 0.22)) * -1400.0 }
    if t > 0.8 { x = ease((t - 0.8) / 0.25) * 1500.0 }
    svg(x - 120, 230, 1520, 230, slant_doc(1500, 220, 120, HEX_RED, HEX_WHITE, 6, HEX_INK, 14))
    svg(x + 160, 250, 1100, 40, slant_doc(1100, 34, 30, HEX_INK, "", 0, "", 0))
    otext(x + 260, 282, life_stage(), 26, C_WHITE, "impact", false)
    otext(x + 640, 420, str(L.age), 150, C_WHITE, "impact", true)
    otext(x + 340, 400, "EDAD", 48, C_YELLOW, "impact", true)
    otext(x + 940, 400, plural(L.age, "AÑO", "AÑOS"), 48, C_YELLOW, "impact", true)
    return null
}

function life_stage() {
    if L.age < 6 { return "INFANCIA" }
    if L.age < 13 { return "NIÑEZ" }
    if L.age < 18 { return "ADOLESCENCIA" }
    if L.age < 30 { return "JUVENTUD" }
    if L.age < 60 { return "ADULTEZ" }
    return "VEJEZ"
}

// Notificaciones de rango (rasgos sociales y confidentes).
function draw_toasts() {
    let alive = []
    let slot = 0
    for t in G.toasts {
        let age = G.t - t.t0
        if age > 2.8 { continue }
        list_push(alive, t)
        let e = ease(clamp(age / 0.25, 0.0, 1.0))
        let fade = 1.0
        if age > 2.4 { fade = 1.0 - (age - 2.4) / 0.4 }
        let y = -90.0 + e * (100.0 + slot * 92.0)
        fade_push(clamp(fade, 0.0, 1.0))
        svg(380, y, 536, 86, slant_doc(526, 76, 24, HEX_INK, HEX_YELLOW, 4, HEX_RED, 8))
        svg(392, y - 4, 90, 90, burst_doc(90, 90, 12, HEX_YELLOW, HEX_INK, 3, 4))
        svg(418, y + 22, 38, 38, arrow_doc("up", HEX_RED))
        let head = t.head
        if head == null { head = "¡RANGO ARRIBA!" }
        otext(496, y + 32, head, 18, C_YELLOW, "impact", false)
        text(496, y + 54, clip_text(t.title, 380, 20), 20, C_WHITE, "impact")
        text(496, y + 71, clip_text(t.sub, 380, 12), 12, C_GRAY, "bold")
        fade_pop()
        slot += 1
    }
    G.toasts = alive
    return null
}

// ---------------------------------------------------------------- muerte

function draw_dead() {
    arect(0, 0, W, H, rgba(0, 0, 0, 170))
    let e = ease(prog(G.screen_t0, 0.6))
    svg(-40, 140, 460, 460, burst_doc(460, 460, 20, HEX_WHITE, HEX_INK, 5, 1))
    svg(40 - (1.0 - e) * 200, 170, 300, 360, portrait_doc(L.look, L.gender, L.age, "dead"))
    if L.job != null && L.job.career != null {
        otext(60, 590, str_upper(career_rank_name()), 26, C_YELLOW, "impact", false)
        text(60, 614, L.job.title, 15, C_WHITE, "bold")
    }
    svg(10, -4 - (1.0 - e) * 100, 860, 130, tilt_title_doc("DESCANSE EN PAZ", 860, 130, 72, HEX_WHITE, HEX_INK))

    svg(400, 120, 452, 560, slant_doc(440, 548, 22, HEX_WHITE, HEX_INK, 4, HEX_RED, 12))
    text(440, 170, clip_text(str_upper(L.first + " " + L.last), 370, 28), 28, C_INK, "impact")
    let ty = 196
    for line in wrap("Murió a los " + str(L.age) + " años por " + L.cause + ".", chars_for(360, 16)) {
        text(436, ty, line, 16, C_RED, "bold")
        ty += 22
    }
    text(436, ty + 8, "«" + epitaph() + "»", 15, C_GRAY, "bold")
    ty += 14
    for line in wrap(funeral_text(), chars_for(360, 14)) {
        ty += 20
        text(436, ty + 8, line, 14, C_INK, "bold")
    }
    let job = L.last_job
    if L.job != null { job = L.job.title }
    if job == "" { job = "Ninguno" }
    let rows = [
        ["Personalidad", trait_name(L.trait, L.gender)],
        ["Dinero", money_str(L.money)],
        ["Último trabajo", job],
        ["Educación", EDU_NAMES[L.edu]],
        ["Parejas sexuales", str(L.partners)],
        ["Matrimonios", str(L.marriages) + " · Divorcios " + str(L.divorces)],
        ["Hijos", str(L.kids) + " · " + parenting_label()],
        ["Generación", str(L.gen) + " · " + str(hito_count()) + " hitos"],

        ["Misiones", str(len(L.done)) + " / " + str(len(MISSIONS))],
        ["Karma", karma_text()]
    ]
    let ry = ty + 46
    for row in rows {
        text(436, ry, row[0], 14, C_GRAY, "bold")
        text(586, ry, clip_text(row[1], 220, 15), 15, C_INK, "impact")
        ry += 27
    }

    if G.legacy != null && len(G.legacy.heirs) > 0 {
        draw_legacy()
        draw_dead_buttons()
        draw_roulette_overlay()
        return null
    }
    panel(872, 120, 380, 430, 18)
    tag(900, 134, 190, "ÚLTIMOS RECUERDOS", HEX_RED, C_WHITE)
    let total = len(L.log)
    let visible = 15
    let i = max(0, total - visible)
    let ly = 190
    push({"op": "clip_push", "x": 880, "y": 160, "w": 364, "h": 386})
    while i < total {
        let entry = L.log[i]
        let color = kind_color(entry.k)
        if entry.k == "h" { color = C_RED }
        text(900, ly, clip_text(entry.t, 330, 13), 13, color, "bold")
        ly += 24
        i += 1
    }
    push({"op": "clip_pop"})
    draw_dead_buttons()
}

function draw_dead_buttons() {
    menu_word(880, 566, 250, 54, "OTRA VIDA", "again", 26)
    small_button(1150, 572, 110, 42, "MENÚ", "restart")
    small_button(1150, 628, 110, 42, "SALIR", "quit")
}

function epitaph() {
    if L.karma >= 75 { return "Un alma buena en un mundo complicado." }
    if L.karma >= 50 { return "Vivió, amó y se equivocó como cualquiera." }
    if L.karma >= 25 { return "Nunca dijo que fuera un santo." }
    return "El infierno ya tiene su lugar reservado."
}

function karma_text() {
    if L.karma >= 75 { return "Santo" }
    if L.karma >= 50 { return "Decente" }
    if L.karma >= 25 { return "Cuestionable" }
    return "Villano"
}
