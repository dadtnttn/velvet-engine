// @edition 3
// Prisión: la vida adentro, mes a mes.
// - Rutina: trabajar (sueldo de prisión), gimnasio, biblioteca, estudiar la
//   secundaria, talleres de arte y portarte bien.
// - Patio: pelear, unirte a una pandilla (protección), contrabando de cigarros,
//   proteger a los nuevos y tu compañero o compañera de celda.
// - Visitas y cartas de tu familia y tu pareja (visita conyugal entre adultos).
// - Legal: apelación con abogado, audiencia de libertad condicional o delatar.
// - Fuga: conseguir una herramienta, cavar un túnel, sobornar a un guardia y
//   escapar (o saltar la barda a la desesperada).
// - Eventos: motín, revisión de celdas, pleitos, cartas, enfermedades, el nuevo.
// Conducta y respeto deciden cómo te va: con buena conducta sales antes; con
// respeto (o pandilla) nadie se mete contigo. Acciones con el prefijo "pr:".

const PRISON_CATS = ["Rutina", "Patio", "Visitas", "Legal", "Fuga"]

const PRISON_EVENTS = [
    {
        "id": "pr_riot", "title": "Motín",
        "text": "Estalla un motín en tu pabellón: colchones quemados, gritos y guardias armados en la entrada.",
        "choices": [
            {"t": "Unirte al motín", "o": [{"w": 60, "log": "Peleaste junto a los demás. Ahora te respetan, pero los guardias te tienen en la mira.", "guts": 3, "health": -5, "special": "pr_riot_join"}, {"w": 40, "log": "Te identificaron como uno de los cabecillas: dos años más.", "health": -5, "special": "pr_more2"}]},
            {"t": "Encerrarte en tu celda", "o": [{"w": 100, "log": "Esperaste a que pasara la tormenta. Nadie te notó.", "happy": -2}]},
            {"t": "Ayudar a los guardias", "o": [{"w": 100, "log": "Los guardias lo anotaron en tu expediente. Los reclusos, también.", "special": "pr_snitchy"}]}
        ]
    },
    {
        "id": "pr_search", "title": "Revisión sorpresa",
        "text": "A las 5 a. m. entran los guardias: revisión de celdas. Si tienes algo escondido, es ahora o nunca.",
        "choices": [
            {"t": "Esconder todo en el colchón", "need": "skill", "rank": 2, "o": [{"w": 100, "log": "No encontraron nada. Eres un mago.", "happy": 2}]},
            {"t": "Quedarte quiet{a} y rezar", "o": [{"w": 60, "log": "Revisaron rápido y se fueron.", "happy": 1}, {"w": 40, "log": "Encontraron tu mercancía. Castigo y mala nota en tu expediente.", "special": "pr_busted"}]}
        ]
    },
    {
        "id": "pr_fight", "title": "Te buscan pleito",
        "text": "Un recluso enorme te empuja en la fila de la comida. Todos voltean a ver qué haces.",
        "choices": [
            {"t": "Responder el golpe", "o": [{"w": 50, "log": "Lo tumbaste. Nadie volverá a empujarte.", "guts": 4, "health": -5, "special": "pr_resp_up"}, {"w": 50, "log": "Te ganó. Enfermería y orgullo herido.", "health": -15, "special": "pr_resp_down"}]},
            {"t": "Ignorarlo y seguir en la fila", "o": [{"w": 100, "log": "Seguiste en la fila. Algunos lo vieron como debilidad.", "special": "pr_resp_down"}]},
            {"t": "Llamar a tu pandilla", "o": [{"w": 100, "log": "", "special": "pr_call_gang"}]}
        ]
    },
    {
        "id": "pr_letter", "title": "Carta de casa",
        "text": "Te llega una carta de tu familia. Está llena de noticias y de «te extrañamos».",
        "choices": [
            {"t": "Responder con todo tu cariño", "o": [{"w": 100, "log": "Escribiste cinco hojas. Lloraste en la tercera.", "happy": 6, "special": "pr_family"}]},
            {"t": "Guardarla sin responder", "o": [{"w": 100, "log": "Te dio vergüenza responder. La leíste veinte veces.", "happy": -3}]}
        ]
    },
    {
        "id": "pr_offer", "title": "Una oferta de protección",
        "text": "El líder de una pandilla del pabellón se sienta a tu lado: «Aquí sol{a} no duras. Con nosotros, nadie te toca. Pero a veces te pediremos favores.»",
        "choices": [
            {"t": "Aceptar", "o": [{"w": 100, "log": "Ahora tienes protección... y deudas.", "special": "pr_join"}]},
            {"t": "Rechazar con respeto", "o": [{"w": 70, "log": "Asintió y se fue. Respetó tu decisión.", "special": "pr_resp_up"}, {"w": 30, "log": "No le gustó tu respuesta. Esa noche te dieron una lección.", "health": -12}]}
        ]
    },
    {
