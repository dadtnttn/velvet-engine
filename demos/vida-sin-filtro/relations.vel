// ---------------------------------------------------------------- grupos y menús

function rel_group(p: map) {
    let r = p.rel
    if r == "pareja" || r == "esposo" { return "partner" }
    if r == "amante" || r == "ligue" { return "fling" }
    if r == "padre" || r == "madre" { return "parent" }
    if r == "hermano" { return "sibling" }
    if r == "hijo" { return "child" }
    if r == "nieto" { return "grandchild" }
    if r == "abuelo" { return "grandparent" }
    if r == "tio" { return "uncle" }
    if r == "primo" { return "cousin" }
    if r == "ex" { return "ex" }
    if r == "suegro" { return "inlaw" }
    if r == "sobrino" { return "nephew" }
    if r == "colega" { return "coworker" }
    if r == "rival" { return "rival" }
    if r == "exsuegro" || r == "recluso" || r == "excolega" { return "acq" }
    return "friend"
}

function person_cats(p: map) {
    let cats = REL_CATS[rel_group(p)]
    if cats == null { cats = ["Hablar"] }
    // Sin intimidad, citas ni futuro si alguno es menor de edad.
    if L.age < 18 || p.age < 18 {
        let out = []
        for c in cats {
            if c != "Intimidad" && c != "Citas" && c != "Futuro" && c != "Reencuentro" { list_push(out, c) }
        }
        return sweet_cats(p, out)
    }
    return sweet_cats(p, cats)
}

function rel_act(id: string) {
    for a in REL_ACTS {
        if a.id == id { return a }
    }
    return lazos_act(id)
}

// Motivo por el que una acción no se ve ("" si se puede mostrar).
function rel_hidden(a: map, p: map) {
    if !list_contains(a.grp, rel_group(p)) { return true }
    if a.adult == true && (L.age < 18 || p.age < 18) { return true }
    if a.me != null && L.age < a.me { return true }
    if a.them != null && p.age < a.them { return true }
    if a.max != null && L.age > a.max { return true }
    if a.maxthem != null && p.age > a.maxthem { return true }
    if a.id == "threesome" && L.age < 18 { return true }
    if a.id == "pet" && p.pet == true { return true }
    if a.id == "breakfast" && minor_pair(p) { return true }
    if a.cond != null && !lazos_cond(a.cond, p) { return true }
    return false
}

function rel_lock(a: map, p: map) {
    if L.jail > 0 { return "En prisión" }
    if a.id == "trip" && in_barracks() { return "En el ejército" }
    if a.id == "trip" && borders_closed() { return "Fronteras cerradas" }
    if a.cost != null && L.money < local_price(a.cost) { return money_str(local_price(a.cost)) }
    if L.used["r" + a.id + str(p.id)] != null { return "Este mes ya" }
    return ""
}

// Opciones de la pantalla de una persona para la categoría elegida.
function person_items(p: map, cat: string) {
    ensure_want(p)
    let items = []
    let ctx = {"person": p}
    let g = rel_group(p)
    for a in REL_ACTS {
        if rel_hidden(a, p) { continue }
        if a.cat != cat && !(a.cat == "*" && rel_star_cat(g) == cat) { continue }
        list_push(items, act_item(a, p, ctx))
    }
    for a in LAZOS_ACTS {
        if rel_hidden(a, p) { continue }
        if a.cat != cat && !(a.cat == "*" && rel_star_cat(g) == cat) { continue }
        list_push(items, act_item(a, p, ctx))
    }
    for it in legacy_person_items(p, cat) { list_push(items, it) }
    for it in sweet_items(p, cat) { list_push(items, it) }
    return items
}

function act_item(a: map, p: map, ctx: map) {
    let t = lazos_title(a, p)
    if t == "" { t = fmt(a.t, ctx) }
    let s = lazos_sub(a, p)
    if s == "" { s = a.s }
    if a.cost != null { s = local_text(s, a.cost) }
    let desc = fmt(a.desc, ctx)
    if p.want == a.id && p.want_tm == L.tm {
        s = "★ LO QUE QUIERE · " + s
        desc = desc + " (Es justo lo que " + p.first + " quiere este mes: cuenta doble.)"
    }
    return {"action": "ract:" + a.id, "t": t, "s": s, "desc": desc, "lock": rel_lock(a, p), "pid": p.id}
}

// Las acciones compartidas ("*") caen en la categoría de convivencia de cada grupo.
function rel_star_cat(g: string) {
    if g == "partner" { return "Juntos" }
    if g == "fling" { return "Citas" }
    if g == "friend" { return "Juntos" }
    if g == "child" { return "Convivir" }
    if g == "ex" { return "Reencuentro" }
    if g == "coworker" { return "Trabajo" }
    if g == "rival" { return "Rivalidad" }
    return "Convivir"
}

// Acciones de antes (diálogos, pareja, hijos) repartidas en categorías.
function legacy_person_items(p: map, cat: string) {
    let out = []
    let g = rel_group(p)
    let r = p.rel
    let adult = L.age >= 18 && p.age >= 18 && L.jail == 0
    if cat == "Hablar" {
        if L.age < 3 {
            // Un bebé no conversa: balbucea.
            list_push(out, pitem(p, "pact:babble", "Balbucear", "Cercanía", "«Gugu, tata.» Funciona mejor de lo que crees."))
        } else if p.age < 3 {
            list_push(out, pitem(p, "pact:faces", "Hacerle caritas", "Cercanía", "Muecas, ruiditos y la cara más ridícula que tengas."))
            list_push(out, pitem(p, "pact:sing", "Cantarle", "Cercanía", "Una canción de cuna, aunque desafines."))
        } else {
            if can_chat(p) {
                list_push(out, pitem(p, "ract:chat", "Platicar", "Ánimo: " + mood_name(p), "Una conversación libre. Lo que conviene decir depende de su ánimo (" + str_lower(mood_name(p)) + ") y de su forma de ser (" + str_lower(temper_name(p)) + ")."))
            }
            if tree_for(p) != "" {
                list_push(out, pitem(p, "pact:dlg", "Conversación profunda", "Diálogo · " + style_name(npc_style(p), p), "Una conversación con decisiones. Lo que diga depende de su forma de ser."))
            } else {
                list_push(out, pitem(p, "pact:talk", "Conversar", "Un poco más de cercanía", "Platicar de lo que sea."))
            }
            if adult && (g == "partner" || g == "fling" || g == "friend") {
                list_push(out, pitem(p, "pact:wealth", "Hablar de dinero", fortune_hint(p), "¿Cuánto gana? ¿Cuánto tiene? Preguntarlo sin parecer interesad" + oa(L.gender) + " es un arte."))
            }
            if (r == "padre" || r == "madre") && L.age >= 6 { list_push(out, pitem(p, "pact:money", "Pedir dinero", money_ask_hint(p), "Depende de su cariño, de tu edad y de cómo esté la economía familiar.")) }
            if L.age < 6 {
                list_push(out, pitem(p, "pact:tantrum", "Hacer berrinche", "Gritar hasta que te hagan caso", "Tirarte al piso es una forma de comunicación."))
            } else if p.age >= 6 {
                list_push(out, pitem(p, "pact:argue", "Discutir", "Desahogarte", "A veces hay que sacarlo todo."))
                list_push(out, pitem(p, "pact:insult", "Insultar", "Quemar el puente", "Hay palabras que no se olvidan."))
            }
        }
    }
    if (cat == "Convivir" || cat == "Juntos" || cat == "Salir") && g != "fling" {
        list_push(out, pitem(p, "pact:time", "Pasar tiempo juntos", "Más cercanía", "Sin plan, solo estar."))
    }
    if cat == "Salir" && g == "friend" && p.bff != true && p.bond >= 70 && L.age >= 6 {
        list_push(out, pitem(p, "ract:bff", "Nombrarl" + oa(p.gender) + " tu mejor amig" + oa(p.gender), "Solo puede haber uno", "Un título serio: mejores amigos para siempre. Si ya tienes uno, lo reemplaza."))
    }
    if g == "child" {
        let kc = "Crianza"
        for it in kid_items_for(p) {
            let c = kc
            if it.action == "pact:heir" || it.action == "pact:unheir" { c = "Legado" }
            if it.action == "pact:allowance" { c = "Convivir" }
            if c == cat { list_push(out, pitem(p, it.action, it.t, it.s, it.s)) }
        }
    }
    if cat == "Futuro" && adult && g == "partner" {
        if r == "pareja" {
            list_push(out, pitem(p, "pact:propose", "Proponer matrimonio", "Elige el tipo de boda", "Anillo, rodilla en el piso y el corazón en la mano. Si dice que sí, eliges la boda."))
            list_push(out, pitem(p, "pact:breakup", "Terminar", "Fin de la relación", "Hay amores que no son para siempre."))
        } else {
            list_push(out, pitem(p, "ract:vows", "Renovar los votos", "$6,000", "Volver a decir «sí» frente a quienes los quieren."))
            list_push(out, pitem(p, "pact:breakup", "Divorciarte", "Pierdes la mitad", "Abogados, mediación y la mitad de todo."))
        }
        list_push(out, pitem(p, "ract:adopt", "Adoptar un hijo", "$50,000", "Darle un hogar a un niño que lo necesita."))
        list_push(out, pitem(p, "ract:ivf", "Tratamiento de fertilidad", "$80,000", "Fertilización in vitro (o gestación subrogada si son del mismo sexo)."))
    }
    if cat == "Intimidad" && adult && g == "fling" && L.married && can_polygamy() {
        list_push(out, pitem(p, "ract:cospouse", "Casarte también con " + p.first, "Matrimonio múltiple", "Tu religión o las leyes de tu reino lo permiten. A tu cónyuge actual quizá no le guste."))
    }
    if cat == "Intimidad" && adult && g == "fling" {
        if L.partner_id == 0 && r != "ex" { list_push(out, pitem(p, "pact:official", "Hacerlo oficial", "Formalizar", "Ponerle nombre a lo que tienen.")) }
        list_push(out, pitem(p, "pact:end", "Cortar la aventura", "Se acabó", "Lo que pasó, pasó."))
    }
    if cat == "Reencuentro" && adult && r == "ex" {
        list_push(out, pitem(p, "pact:again", "Intentar volver", "Segundas partes...", "Depende de cuánto te quiera todavía."))
        list_push(out, pitem(p, "pact:hookup", "Recaer en la cama", "Solo una vez más", "Ambos saben que es mala idea."))
    }
    return out
}

function pitem(p: map, action: string, t: string, s: string, desc: string) {
    let lock = ""
    if str_starts_with(action, "pact:") && pact_used(str_replace(action, "pact:", ""), p) { lock = "Este mes ya" }
    return {"action": action, "t": t, "s": s, "desc": desc, "lock": lock, "pid": p.id}
}

// Lo básico con cada persona se puede una vez al mes (si no, el cariño, la
// Amabilidad y el dinero de tus papás serían infinitos).
const PACT_MONTHLY = ["time", "talk", "money", "argue", "insult", "tantrum", "faces", "sing", "babble", "wealth"]

function pact_key(action: string, p: map) {
    if action == "dlg" { return "dlg" + str(p.id) }
    return "p" + action + str(p.id)
}

function pact_used(action: string, p: map) {
    if action != "dlg" && !list_contains(PACT_MONTHLY, action) { return false }
    return L.used[pact_key(action, p)] != null
}

// Lista de vínculos por categoría.
// Una pieza propia (no pegada a otra) para que se traduzca sola en la lista.
const BDAY_TAG = "¡Cumpleaños!"

function rel_list(cat: string) {
    let items = []
    if cat == "Conocer" { return meet_items() }
    for p in L.people {
        if !p.alive { continue }
        let g = rel_group(p)
        let ok = false
        if cat == "Familia" { ok = g == "parent" || g == "sibling" || g == "child" || g == "grandchild" || g == "grandparent" || g == "uncle" || g == "cousin" || g == "inlaw" || g == "nephew" }
        if cat == "Pareja" { ok = g == "partner" || p.rel == "amante" }
        if cat == "Amigos" { ok = g == "friend" }
        if cat == "Trabajo" { ok = g == "coworker" || g == "rival" }
        if cat == "Otros" { ok = p.rel == "ex" || p.rel == "ligue" || g == "rival" || g == "acq" }
        if !ok { continue }
        let tagline = ""
        if p.childhood == true { tagline = " · desde la infancia" }
        if p.bday_due == L.tm && p.bday_done != L.tm { tagline = tagline + " · " + BDAY_TAG }
        ensure_want(p)
        if p.want != null && p.want != "" { tagline = tagline + " · ★" }
        list_push(items, {
            "action": "person:" + str(p.id),
            "t": full_name(p),
            "s": rel_label(p) + " · " + str(p.age) + " años" + tagline,
            "desc": arcana(p) + " · Rango " + str(conf_rank(p)),
            "lock": "",
            "pid": p.id
        })
    }
    return items
}

function meet_items() {
    let items = []
    if L.age >= 18 && L.jail == 0 {
        list_push(items, {"action": "ph:app:flama", "t": "Buscar el amor", "s": "Flama, en tu móvil", "desc": "Alguien allá afuera está deslizando a la derecha. Abre Flama (casual) o Alma Gemela (serio) en tu celular.", "lock": ""})
    }
    let lock = ""
    if L.age < 4 { lock = "Edad 4" }
    if L.used["makefriend"] != null { lock = "Este mes ya" }
    let where = "en la escuela"
    if L.age >= 18 { where = "en un club, el gimnasio o una clase" }
    list_push(items, {"action": "ract:makefriend", "t": "Hacer un amigo nuevo", "s": "Encanto", "desc": "Acercarte a alguien " + where + ". Con más Encanto, más fácil.", "lock": lock})
    return items
}

// ---------------------------------------------------------------- fertilidad

function fert_by_age(gender: string, age: int, base: int) {
    if age < 16 { return 0 }
    if gender == "f" {
        if age <= 30 { return base }
        if age <= 35 { return base * 85 / 100 }
        if age <= 40 { return base * 55 / 100 }
        if age <= 44 { return base * 20 / 100 }
        return 0
    }
    if age < 40 { return base }
    if age < 55 { return base * 80 / 100 }
    if age < 75 { return base * 50 / 100 }
    return base * 20 / 100
}

function my_fertility() {
    if L.sterile == true { return 0 }
    let f = fert_by_age(L.gender, L.age, L.fert)
    if has_habit("fumar") { f = f * 85 / 100 }
    if has_ill("obesidad") { f = f * 85 / 100 }
    if has_ill("clamidia") || has_ill("gonorrea") { f = f * 60 / 100 }
    if L.drugs >= 40 { f = f * 80 / 100 }
    return f
}

function their_fertility(p: map) {
    if p.fert == null { p.fert = rint(40, 95) }
    return fert_by_age(p.gender, p.age, p.fert)
}

function fert_word(f: int) {
    if f >= 70 { return "alta" }
    if f >= 40 { return "media" }
    if f > 0 { return "baja" }
    return "nula"
}

// ---------------------------------------------------------------- acciones

function rel_do(id: string, p: map) {
    G.modal = null
    if id == "makefriend" { return make_friend() }
    if id == "bff" { return make_bff(p) }
    if id == "cospouse" { return take_cospouse(p) }
    if sweet_act(id) != null { return sweet_do(id, p) }
    if id == "chat" {
        if L.used["rchat" + str(p.id)] != null { return info(p.first, "Ya platicaron este mes. Dale un respiro.") }
        L.used["rchat" + str(p.id)] = 1
        return start_chat(p, false)
    }
    if id == "vows" { return renew_vows(p) }
    if id == "adopt" { return adopt(p) }
    if id == "ivf" { return ivf(p) }
    let a = rel_act(id)
    if a == null { return null }
    let ctx = {"person": p}
    if rel_hidden(a, p) { return null }
    let lock = rel_lock(a, p)
    if lock != "" { return info(fmt(a.t, ctx), "No se puede ahora: " + lock + ".") }
    L.used["r" + a.id + str(p.id)] = 1
    if a.code != null { return rel_code(a, p) }
    if a.cost != null && a.mg == null && a.o != null {
        // El costo va en los resultados solo si lo dicen; si no, se cobra aquí.
        if !rel_outcomes_charge(a) { L.money -= local_price(a.cost) }
    }
    if a.mg != null {
        if a.cost != null { L.money -= local_price(a.cost) }
        return mg_start(a.mg, fmt(a.t, ctx) + " con " + p.first, "rel", {"pid": p.id, "act": a.id})
    }
    let o = pick_outcome(a.o)
    let msg = apply(o, ctx)
    if o.sexact == true { msg = msg + sex_with(p) }
    if a.hito != null { add_hito(p, fmt(a.hito, ctx)) }
    if a.spark != null { lazos_spark(p, a.spark) } else if a.cat == "Intimidad" { lazos_spark(p, 6) }
    msg = msg + bond_bonus(p, a.id)
    return finish(p.first, msg, outcome_kind(o))
}

function rel_outcomes_charge(a: map) {
    for o in a.o {
        if o.money != null { return true }
    }
    return false
}

// Resultado de un minijuego en pareja, con amigos o con la familia.
function rel_mg_result(score: any, ctx: map) {
    let p = find_person(ctx.pid)
    let a = rel_act(ctx.act)
    if p == null || a == null { return null }
    let lo = a.bond[0]
    let hi = a.bond[1]
    let fctx = {"person": p}
    let gain_b = lo + (hi - lo) * score / 100
    if score < 30 { gain_b = 0 - lo / 2 }
    bond_gain(p, gain_b)
    let o = {}
    if a.happy != null { o["happy"] = a.happy * score / 100 + 1 }
    if a.health != null { o["health"] = a.health }
    if a.know != null { o["know"] = a.know }
    apply(o, fctx)
    let text = fmt(a.ok, fctx)
    let kind = "g"
    if score < 50 {
        text = fmt(a.bad, fctx)
        kind = "n"
    }
    if a.cat == "Intimidad" && score >= 50 { sex_with(p) }
    if score >= 50 {
        if a.kgr != null && p.grades != null { p.grades = clamp(p.grades + a.kgr, 0, 100) }
        if a.flagz != null { flag(a.flagz) }
        if a.spark != null { lazos_spark(p, a.spark) } else if a.cat == "Intimidad" { lazos_spark(p, 6) }
    }
    if a.hito != null { add_hito(p, fmt(a.hito, fctx)) }
    text = text + bond_bonus(p, a.id)
    return finish(p.first, text + " (" + str(score) + " puntos)", kind)
}

function rel_code(a: map, p: map) {
    let id = a.id
    if id == "gift" { return open_gift(p) }
    if id == "sex" { return open_sex(p) }
    if id == "spicy" { return open_spicy(p) }
    if id == "threesome" { return open_trio(p) }
    if id == "trip" { return trip(p) }
    if id == "pet" {
        L.money -= local_price(a.cost)
        p.pet = true
        bond_gain(p, 10)
        L.happy += 8
        let name = pick(["Firulais", "Michi", "Canela", "Rocky", "Luna", "Chispa", "Toby", "Nala"])
        add_pet(pick(["perro", "gato"]), name)
        log_add("Adoptaron a " + name + ". La casa ya tiene dueño (y no son ustedes).", "g")
        return finish(p.first, "Adoptaron a " + name + " juntos. " + p.first + " no deja de tomarle fotos.", "g")
    }
    if id == "block" {
        // Fuera de tu vida, pero no muert{xa}: blocked lo distingue de un difunto.
        p.rel = "bloqueado"
        p.blocked = true
        p.alive = false
        L.happy += 3
        gain("guts", 2)
        return finish("Cerrar el ciclo", "Bloqueaste a " + p.first + " de todas partes. Se siente como respirar.", "n")
    }
    return lazos_code(a, p)
}

// ---------------------------------------------------------------- regalos

function open_gift(p: map) {
    let ctx = {"person": p}
    let labels = [local_text("Flores o dulces ($300)", 300), local_text("Perfume o un buen libro ($1,500)", 1500), local_text("Una joya o algo de lujo ($8,000)", 8000), "Algo hecho con tus manos (gratis)", "Mejor no"]
    let locks = ["", "", "", "", ""]
    if L.money < local_price(300) { locks[0] = money_str(local_price(300)) }
    if L.money < local_price(1500) { locks[1] = money_str(local_price(1500)) }
    if L.money < local_price(8000) { locks[2] = money_str(local_price(8000)) }
    open_choice("REGALO PARA " + str_upper(who(p)), fmt("¿Qué le regalas a {x}? A cada quien le gusta algo distinto.", ctx), labels, locks, "gift", ctx)
    G.modal.tags = ["", "", "", "Destreza", ""]
    return null
}

function resolve_gift(index: int, ctx: map) {
    G.modal = null
    let p = ctx.person
    if index == 4 { return finish(p.first, "Guardaste la cartera.", "n") }
    let st = npc_style(p)
    let gain_b = 0
    let msg = ""
    if index == 0 {
        L.money -= local_price(300)
        gain_b = 5
        msg = "Le encantaron las flores."
        if st == "dulce" || st == "amoroso" { gain_b = 9 }
    }
    if index == 1 {
        L.money -= local_price(1500)
        gain_b = 9
        msg = "Un regalo muy atinado. Lo usa todos los días."
    }
    if index == 2 {
        L.money -= local_price(8000)
        gain_b = 14
        msg = "Se quedó sin palabras. Brilla tanto como su sonrisa."
        if st == "libre" {
            gain_b = 6
            msg = "«Es carísimo... prefiero que vivamos algo juntos.» Aun así lo aceptó."
        }
        if st == "intenso" || st == "celoso" { gain_b = 18 }
    }
    if index == 3 {
        gain_b = 4 + rank("skill") * 3
        msg = "Le hiciste algo con tus manos. Vale más que cualquier cosa de tienda."
        gain("skill", 1)
        if p.rel == "padre" || p.rel == "madre" || p.rel == "nieto" || p.rel == "hijo" { gain_b += 4 }
    }
    bond_gain(p, gain_b)
    L.happy += 2
    add_hito(p, "Su primer regalo")
    msg = msg + bond_bonus(p, "gift")
    return finish(p.first, msg, "g")
}

// ---------------------------------------------------------------- intimidad

function open_sex(p: map) {
    let ctx = {"person": p}
    let same = p.gender == L.gender
    let mine = my_fertility()
    let theirs = their_fertility(p)
    let extra = ""
    if !same { extra = " Fertilidad: tú " + fert_word(mine) + ", " + p.first + " " + fert_word(theirs) + "." }
    let shared = shared_kinks(p)
    if len(shared) > 0 { extra = extra + " Comparten gustos: " + kink_name(shared[0], L.gender) + "." }
    let locks = ["", "", "", "", ""]
    if same {
        locks[1] = "No hace falta"
        locks[3] = "Mismo sexo"
    }
    if L.pregnant || L.partner_preg { locks[3] = "Ya hay bebé en camino" }
    open_choice("INTIMIDAD CON " + str_upper(p.first), fmt("La noche se pone interesante con {x}." + extra + " ¿Cómo?", ctx),
        ["Con condón", "Con anticonceptivo (sin condón)", "Sin protección", "Buscar un bebé", "Mejor no"], locks, "sex", ctx)
    G.modal.tags = ["Seguro", "Sin condón", "Riesgo", "+Fértil", ""]
    return null
}

function resolve_sex(index: int, ctx: map) {
    G.modal = null
    let p = ctx.person
    if index == 4 { return finish(p.first, "Prefirieron solo abrazarse y dormir. También cuenta.", "n") }
    let base = 30
    G.sex_mode = "raw"
    if index == 0 {
        base = 3
        G.sex_mode = "prot"
    }
    if index == 1 { base = 1 }
    if index == 3 { base = 45 }
    let preg = base * my_fertility() * their_fertility(p) / 10000
    let happy = 6 + fx_sum("sexhappy")
    let lines = ["Una noche para recordar.", "Terminaron enredados entre las sábanas, riéndose.", "No durmieron mucho. Nadie se queja.", "Fue tierno, intenso y perfecto."]
    let msg = pick(lines)
    let shared = shared_kinks(p)
    if len(shared) > 0 {
        happy += 4
        msg = msg + " Su gusto en común (" + kink_name(shared[0], L.gender) + ") hizo todo mejor."
    }
    if has_kink("romantico") && rel_group(p) == "partner" { happy += 2 }
    bond_gain(p, rint(3, 8))
    lazos_spark(p, 6)
    L.happy += max(0, happy)
    msg = msg + sex_with(p)
    add_hito(p, "Su primera noche juntos")
    G.sex_mode = ""
    if index == 3 && p.gender != L.gender && preg > 0 {
        return mg_start("race", "La gran carrera", "conceive", {"pid": p.id, "preg": preg, "msg": msg})
    }
    if p.gender != L.gender { msg = msg + maybe_pregnancy(p, preg) }
    return finish(p.first, msg, "x")
}

// Resultado de la carrera: ganarla multiplica la probabilidad de embarazo.
function conceive_result(score: any, ctx: map) {
    let p = find_person(ctx.pid)
    if p == null { return null }
    let chance_p = ctx.preg * (40 + score * 12 / 10) / 100
    let msg = ctx.msg
    let race = "Tu campeón llegó en buen lugar."
    if score >= 100 { race = "¡Tu campeón llegó primero al óvulo!" }
    if score < 40 { race = "Tu campeón se quedó en el camino." }
    let preg = maybe_pregnancy(p, chance_p)
    msg = msg + " " + race + preg
    if preg == "" && !L.pregnant && !L.partner_preg { msg = msg + " Este mes no hubo suerte; sigan intentando." }
    return finish(p.first, msg, "x")
}

function open_spicy(p: map) {
    let ctx = {"person": p}
    let opts = []
    for t in shared_kinks(p) {
        if len(opts) < 2 { list_push(opts, t) }
    }
    for t in L.tags {
        if len(opts) < 3 && !list_contains(opts, t) { list_push(opts, t) }
    }
    if p.tags != null {
        for t in p.tags {
            if len(opts) < 4 && !list_contains(opts, t) { list_push(opts, t) }
        }
    }
    if len(opts) == 0 { list_push(opts, "rol") }
    let labels = []
    let tags = []
    for t in opts {
        list_push(labels, "Proponer: " + kink_name(t, L.gender))
        let tg = ""
        if p.tags != null && list_contains(p.tags, t) { tg = "Le gusta" }
        list_push(tags, tg)
    }
    list_push(labels, "Mejor no")
    list_push(tags, "")
    let locks = []
    for l in labels { list_push(locks, "") }
    open_choice("NOCHE DE FANTASÍAS", fmt("¿Qué le propones a {x}? Las que dicen [LE GUSTA] son apuesta segura.", ctx), labels, locks, "spicy", {"person": p, "opts": opts})
    G.modal.tags = tags
    return null
}

function resolve_spicy(index: int, ctx: map) {
    G.modal = null
    let p = ctx.person
    if index >= len(ctx.opts) { return finish(p.first, "Mejor otro día.", "n") }
    let t = ctx.opts[index]
    let theirs = p.tags != null && list_contains(p.tags, t)
    G.sex_mode = ""
    let faith_no = disapproval(p, "adult")
    if theirs || chance(35 + rank("charm") * 6 - faith_no / 2) {
        bond_gain(p, 10)
        L.happy += 10 + fx_sum("sexhappy")
        flag("kink")
        let msg = "Propusiste «" + kink_name(t, L.gender) + "» y " + p.first + " se animó sin pensarlo. Noche legendaria." + sex_with(p)
        if !theirs && (p.tags == null || len(p.tags) < 4) {
            if p.tags == null { p.tags = [] }
            list_push(p.tags, t)
            msg = msg + " Descubrió que también le gusta."
        }
        return finish(p.first, msg, "x")
    }
    bond_gain(p, -6)
    if faith_no >= 30 { return finish(p.first, p.first + " se puso seri" + oa(p.gender) + ". «Mi fe no me lo permite.» Cambiaron de plan y vieron una película.", "n") }
    return finish(p.first, p.first + " se puso incómod" + oa(p.gender) + ". «No es lo mío.» Cambiaron de plan y vieron una película.", "n")
}

// ---------------------------------------------------------------- viajes y futuro

// Un viaje de una semana para dos: un país de verdad (de los que reciben
// turistas), al alcance del paquete y que cuenta en tu pasaporte.
function trip(p: map) {
    let price = local_price(12000)
    L.money -= price
    let here_c = here_id()
    let opts = []
    for c in COUNTRIES {
        if c.id != here_c && c.tour >= 40 && trip_cost(c.id) * 2 <= price { list_push(opts, c.id) }
    }
    if len(opts) == 0 {
        for c in COUNTRIES {
            if c.id != here_c && c.tour >= 40 { list_push(opts, c.id) }
        }
    }
    let dest = pick(opts)
    let x = ctry(dest)
    mark_visited(dest)
    bond_gain(p, 15)
    L.happy += 12
    gain("know", 2)
    tfx_add("vacaciones", 2)
    if dest == "jp" { flag("tokyo") }
    add_hito(p, "Viajaron juntos a " + x.n)
    let msg = "Una semana en " + x.n + " con " + p.first + "."
    if x.honey != "" { msg = msg + " Conocieron " + x.honey + "." }
    let g = rel_group(p)
    if g == "partner" && L.age >= 18 {
        lazos_spark(p, 10)
        msg = msg + " Paseos de día, hotel de noche. Volvieron más enamorados que nunca." + sex_with(p)
    } else {
        msg = msg + " Fotos, comida rara y anécdotas para toda la vida."
    }
    return finish("Viaje", msg, "g")
}

function renew_vows(p: map) {
    if L.money < local_price(6000) { return info("Votos", "No te alcanza. Cuesta " + money_str(local_price(6000)) + ".") }
    if L.used["rvows"] != null { return info("Votos", "Ya lo hicieron este mes.") }
    L.used["rvows"] = 1
    L.money -= local_price(6000)
    bond_gain(p, 18)
    add_hito(p, "Renovaron sus votos")
    L.happy += 10
    return finish("Renovación de votos", "Frente a familia y amigos, volvieron a prometerse todo. " + p.first + " lloró desde el «hola».", "g")
}

function adopt(p: map) {
    if L.money < local_price(50000) { return info("Adopción", "El proceso cuesta " + money_str(local_price(50000)) + ".") }
    if L.age < 25 { return info("Adopción", "Necesitas tener al menos 25 años.") }
    L.money -= local_price(50000)
    let child = make_person(pick(["m", "f"]), "hijo", rint(0, 7))
    child.last = L.last1
    child.bond = 75
    add_person(child)
    L.kids += 1
    L.happy += 15
    bond_gain(p, 10)
    flag("adopt")
    add_hito(p, "Adoptaron a " + child.first)
    return finish("Adopción", "Después de meses de trámites, " + child.first + " (" + str(child.age) + " años) llegó a su casa. Ya son familia.", "g")
}

function ivf(p: map) {
    let cost = local_price(80000)
    let same = p.gender == L.gender
    if same && L.gender == "m" { cost = local_price(150000) }
    if L.money < cost { return info("Fertilidad", "El tratamiento cuesta " + money_str(cost) + ".") }
    if L.pregnant || L.partner_preg { return info("Fertilidad", "Ya viene un bebé en camino.") }
    L.money -= cost
    let f = my_fertility()
    if L.gender == "m" { f = their_fertility(p) }
    if same && L.gender == "f" { f = max(my_fertility(), their_fertility(p)) }
    if same && L.gender == "m" { f = 80 }
    if !chance(15 + f / 2) {
        L.happy -= 8
        return finish("Fertilidad", "El tratamiento no funcionó esta vez. Duele, pero pueden intentarlo de nuevo.", "b")
    }
    if L.gender == "f" && (!same || my_fertility() >= their_fertility(p)) {
        L.pregnant = true
        L.preg_with = p.first
        add_hito(p, "El tratamiento de fertilidad funcionó")
        return finish("Fertilidad", "¡Funcionó! Estás embarazada.", "g")
    }
    L.partner_preg = true
    if same && L.gender == "m" { return finish("Fertilidad", "¡La gestante subrogada está embarazada! En nueve meses serán padres.", "g") }
    return finish("Fertilidad", "¡Funcionó! " + p.first + " está embarazada.", "g")
}

// Boda: después del «sí», eliges cómo celebrarla.
// Única puerta a una boda: respeta la ley del país (matrimonio igualitario),
// luego el acuerdo prenupcial y el estilo de boda.
function begin_wedding(p: map) {
    if pais_marriage_block(p) { return open_symbolic_wedding(p) }
    return open_wedding(p)
}

function open_wedding(p: map) {
    return open_prenup(p)
}

function open_wedding_style(p: map) {
    let ctx = {"person": p}
    let costs = [0, 2000, 5000, 20000, 40000]
    let locks = []
    for c in costs {
        if c > 0 && L.money < local_price(c) { list_push(locks, money_str(local_price(c))) } else { list_push(locks, "") }
    }
    open_choice("¡DIJO QUE SÍ!", fmt("{x} aceptó casarse contigo. ¿Qué boda quieren?", ctx),
        ["Solo ustedes dos al atardecer (gratis)", local_text("Registro civil y tacos ($2,000)", 2000), local_text("Escaparse a Las Vegas ($5,000)", 5000), local_text("Boda en la playa ($20,000)", 20000), local_text("La boda del año ($40,000)", 40000)], locks, "wedding", ctx)
    G.modal.tags = ["Íntima", "Sencilla", "Espontánea", "Romántica", "Fama"]
    return null
}

function resolve_wedding(index: int, ctx: map) {
    G.modal = null
    let p = ctx.person
    let costs = [0, 2000, 5000, 20000, 40000]
    let texts = [
        "Se casaron solos, con dos testigos desconocidos y el sol cayendo. No necesitaron nada más.",
        "Firmaron en el registro civil y celebraron con tacos y cerveza. Sencillo y perfecto.",
        "Un Elvis los casó a las 3 a. m. en Las Vegas. Nadie de la familia lo sabía.",
        "Descalzos en la arena, con el atardecer de fondo. Todos lloraron.",
        "Trescientos invitados, mariachi, fuegos artificiales. Salió en las revistas."
    ]
    L.money -= local_price(costs[index])
    marry_cost(0)
    let bonus = [8, 6, 8, 14, 16]
    bond_gain(p, bonus[index])
    L.happy += 10 + index * 2
    if index == 4 { L.fame = clamp100(L.fame + 5) }
    toast("LOS AMANTES · BODA", "Te casaste con " + p.first + ".")
    let styles = ["Boda íntima al atardecer", "Boda civil con tacos", "Boda en Las Vegas", "Boda en la playa", "La boda del año"]
    add_hito(p, styles[index])
    return finish("Boda", texts[index] + " Ahora " + p.first + " es tu " + str_lower(rel_label(p)) + ".", "g")
}

// ---------------------------------------------------------------- amigos

function make_friend() {
    if L.age < 4 { return null }
    if L.used["makefriend"] != null { return info("Amistades", "Ya conociste a alguien este mes.") }
    L.used["makefriend"] = 1
    if !chance(40 + rank("charm") * 10) {
        return finish("Amistades", "Intentaste hacer plática, pero no hubo química. Otra vez será.", "n")
    }
    let age = max(4, L.age + rint(-2, 2))
    if L.age >= 18 { age = max(18, L.age + rint(-6, 6)) }
    let p = make_person(pick(["m", "f"]), "amigo", age)
    p.bond = rint(45, 70)
    add_person(p)
    let where = "en la escuela"
    if L.age >= 18 { where = pick(["en el gimnasio", "en una clase de cocina", "en un bar", "en el trabajo", "en un club de lectura"]) }
    p.hitos = [{"a": L.age, "t": "Se conocieron " + where}]
    hito_once("first_friend_made", "Amistad", "Hiciste un amigo por tu cuenta: " + p.first)
    return finish("Amistades", "Conociste a " + p.first + " " + where + ". Hicieron clic de inmediato.", "g")
}

// Amigos que aparecen solos: el kínder, la primaria y la secundaria.
function childhood_friends() {
    let a = L.age
    if a == 3 || (a == 6 && chance(60)) || (a == 12 && chance(50)) {
        let g = pick(["m", "f"])
        if chance(55) && L.likes != "ambos" { g = L.likes }
        let p = make_person(g, "amigo", max(1, a + rint(-1, 1)))
        p.bond = rint(65, 85)
        p.childhood = true
        add_person(p)
        let where = "en el kínder"
        if a == 6 { where = "en la primaria" }
        if a == 12 { where = "en la secundaria" }
        log_add("Conociste a " + p.first + " " + where + ". Desde ese día son inseparables.", "g")
        p.hitos = [{"a": a, "t": "Se conocieron " + where}]
        hito_quiet("Amistad", "Conociste a " + p.first + " " + where)
    }
    return null
}

function childhood_crush() {
    for p in L.people {
        if p.alive && p.rel == "amigo" && p.childhood == true && p.age >= 18 && p.bond >= 55 && (L.likes == "ambos" || L.likes == p.gender) {
            return p
        }
    }
    return null
}

function find_rel_where(rel: string, min_age: int) {
    for p in L.people {
        if p.alive && p.rel == rel && p.age >= min_age { return p }
    }
    return null
}

// Un amigo adulto que todavía no se ha casado (cada boda pasa una sola vez).
function unwed_friend() {
    let opts = []
    for p in L.people {
        if p.alive && p.rel == "amigo" && p.age >= 20 && p.wed != true { list_push(opts, p) }
    }
    if len(opts) == 0 { return null }
    return opts[rint(0, len(opts) - 1)]
}

function rel_meets(tag: string) {
    if tag == "hasgrandparent" { return first_rel("abuelo") != null }
    if tag == "oldgrandparent" { return find_rel_where("abuelo", 70) != null }
    if tag == "adultcousin" { return L.age >= 18 && find_rel_where("primo", 18) != null }
    if tag == "hasuncle" { return first_rel("tio") != null }
    if sweet_meets(tag) { return true }
    if lazos_meets(tag) { return true }
    if tag == "childhoodcrush" { return L.partner_id == 0 && L.age >= 18 && childhood_crush() != null }
    if tag == "hasfriend" { return first_rel("amigo") != null }
    if tag == "unwedfriend" { return unwed_friend() != null }
    if tag == "partnerjob" {
        let q = partner()
        return q != null && q.age < 65 && partner_income(q) > 0
    }
    if tag == "hassibling" { return first_rel("hermano") != null }
    return false
}

function rel_ctx(ev: map) {
    let spec = ev["person"]
    if spec == "childhood" { return {"person": childhood_crush()} }
    if spec == "partner" { return {"person": partner()} }
    if spec == "friend" { return {"person": first_rel("amigo")} }
    if spec == "unwedfriend" { return {"person": unwed_friend()} }
    if spec == "sibling" { return {"person": first_rel("hermano")} }
    let p = rel_event_person(spec)
    if p == null { return {} }
    let res = {"person": p, "rel": str_lower(rel_label(p))}
    if spec == "kid14to17" {
        // Su pareja: casi siempre del otro sexo, a veces del mismo.
        let g = by_gender(p.gender, "f", "m")
        if chance(10) { g = p.gender }
        res["nov"] = by_gender(g, "novio", "novia")
        res["alnov"] = by_gender(g, "al pobre muchacho", "a la pobre muchacha")
    }
    return res
}

function rel_event_person(spec: any) {
    if spec == "grandparent" { return first_rel("abuelo") }
    if spec == "oldgrandparent" { return find_rel_where("abuelo", 70) }
    if spec == "adultcousin" { return find_rel_where("primo", 18) }
    if spec == "uncle" { return first_rel("tio") }
    return lazos_person(spec)
}

// ---------------------------------------------------------------- tríos y más

function open_trio(p: map) {
    let ctx = {"person": p}
    let odds = trio_odds(p)
    open_choice("TRÍOS Y ALGO MÁS", fmt("¿Qué le propones a {x}? Que acepte depende de su carácter, de sus gustos y de cuánto confíe en ti. Probabilidad: " + str(odds) + "%.", ctx),
        ["Invitar a otra mujer", "Invitar a otro hombre", "Intercambio de parejas (swingers)", "Fiesta privada para adultos", "Mejor no"],
        ["", "", "", "", ""], "trio", ctx)
    G.modal.tags = [str(odds) + "%", str(odds) + "%", str(odds - 10) + "%", str(odds - 20) + "%", ""]
    return null
}

function trio_odds(p: map) {
    let odds = 20 + rank("charm") * 5
    if p.tags != null && list_contains(p.tags, "trios") { odds += 35 }
    if has_kink("trios") { odds += 10 }
    let st = npc_style(p)
    if st == "libre" { odds += 20 }
    if st == "celoso" { odds -= 25 }
    if st == "dulce" { odds -= 5 }
    if p.open == true { odds += 20 }
    if p.bond >= 70 { odds += 10 }
    // Su fe también opina.
    odds -= disapproval(p, "adult") / 2
    return clamp(odds, 5, 95)
}

function resolve_trio(index: int, ctx: map) {
    G.modal = null
    let p = ctx.person
    if index == 4 { return finish(p.first, "Lo pensaste mejor. Esta noche, solo ustedes dos.", "n") }
    let odds = trio_odds(p)
    if index == 2 { odds -= 10 }
    if index == 3 { odds -= 20 }
    if !chance(odds) {
        let hurt = 12
        if npc_style(p) == "celoso" { hurt = 25 }
        bond_gain(p, -hurt)
        p.mood = "enojado"
        return finish(p.first, p.first + " se quedó helad" + oa(p.gender) + ". «¿No te basto?» Hoy duermes en el sillón.", "b")
    }
    let msg = ""
    let extra = 1
    if index == 0 || index == 1 {
        let g = "f"
        if index == 1 { g = "m" }
        let third = make_person(g, "ligue", rint(max(18, L.age - 8), L.age + 8))
        let who = by_gender(g, "un invitado", "una invitada")
        msg = p.first + " aceptó. Conocieron a " + third.first + ", " + who + " encantador" + by_gender(g, "", "a") + ", y la noche fue inolvidable para los tres."
        msg = msg + sex_with(third) + sex_with(p)
        third.known = false
    }
    if index == 2 {
        let a = make_person(by_gender(L.gender, "f", "m"), "ligue", rint(max(18, L.age - 6), L.age + 10))
        msg = "Conocieron a otra pareja en un club. Intercambiaron parejas por una noche y volvieron a casa riéndose de todo."
        msg = msg + sex_with(a) + sex_with(p)
        flag("trio")
    }
    if index == 3 {
        extra = 3
        msg = "Una fiesta privada con antifaces, reglas claras y mucha gente dispuesta. Lo que pasa ahí, se queda ahí."
        msg = msg + sex_with(p)
        for i in [0, 1, 2] {
            if chance(20 * (100 + fx_sum("its")) / 100) {
                let s = catch_its_random()
                if s != "" { msg = msg + s }
            }
        }
    }
    L.partners += extra
    L.happy += 12 + fx_sum("sexhappy")
    flag("trio")
    // Celos después de la emoción.
    let st = npc_style(p)
    if (st == "celoso" || st == "intenso") && chance(45) {
        bond_gain(p, -15)
        msg = msg + " Pero al día siguiente " + p.first + " no paraba de preguntar si te gustó más que con " + by_gender(p.gender, "él", "ella") + "."
    } else {
        bond_gain(p, 6)
        msg = msg + " Despertaron abrazados y con más confianza que nunca."
    }
    return finish(p.first, msg, "x")
}
