// ---------------------------------------------------------------- reglas

function both_adults(p: any) {
    if p == null { return L.age >= 18 }
    return L.age >= 18 && p.age >= 18
}

function minor_pair(p: map) {
    return rel_group(p) == "partner" && (L.age < 18 || p.age < 18)
}

function attracted_to(p: map) {
    return L.likes == "ambos" || L.likes == p.gender
}

// Un amigo de tu edad que te gusta (los dos entre 12 y 17).
function teen_crush_ok(p: map) {
    let diff = L.age - p.age
    if diff < 0 { diff = 0 - diff }
    return p.rel == "amigo" && L.age >= 12 && L.age < 18 && p.age >= 12 && p.age < 18 && diff <= 2 && L.partner_id == 0 && attracted_to(p)
}

function kid_friend_ok(p: map) {
    return p.rel == "amigo" && L.age >= 6 && L.age <= 11 && p.age <= 13
}

function sweet_groups(p: map) {
    let out = []
    if minor_pair(p) { list_push(out, "teenpair") }
    if teen_crush_ok(p) { list_push(out, "teencrush") }
    if kid_friend_ok(p) { list_push(out, "kidfriend") }
    return out
}

// Categorías extra en la pantalla de la persona.
function sweet_cats(p: map, cats: list) {
    let out = []
    if minor_pair(p) { list_push(out, "Noviazgo") }
    if teen_crush_ok(p) { list_push(out, "Romance") }
    for c in cats { list_push(out, c) }
    if rel_group(p) == "partner" || (p.hitos != null && len(p.hitos) > 0) { list_push(out, "Historia") }
    return out
}

function sweet_act(id: string) {
    for a in SWEET_ACTS {
        if a.id == id { return a }
    }
    return null
}

function sweet_items(p: map, cat: string) {
    let items = []
    if cat == "Historia" { return hito_items(p) }
    let groups = sweet_groups(p)
    let ctx = {"person": p}
    for a in SWEET_ACTS {
        if a.cat != cat || !list_contains(groups, a.grp) { continue }
        if a.me != null && L.age < a.me { continue }
        if a.them != null && p.age < a.them { continue }
        let lock = ""
        if L.used["s" + a.id + str(p.id)] != null { lock = "Este mes ya" }
        if a.cost != null && L.money < a.cost { lock = money_str(a.cost) }
        list_push(items, {"action": "ract:" + a.id, "t": fmt(a.t, ctx), "s": a.s, "desc": fmt(a.desc, ctx), "lock": lock, "pid": p.id})
    }
    return items
}

function sweet_do(id: string, p: map) {
    let a = sweet_act(id)
    if a == null || !list_contains(sweet_groups(p), a.grp) { return null }
    let ctx = {"person": p}
    let key = "s" + a.id + str(p.id)
    if L.used[key] != null { return info(p.first, "Ya lo hicieron este mes.") }
    if a.cost != null && L.money < a.cost { return info(p.first, "No te alcanza.") }
    L.used[key] = 1
    if a.code == "ask" { return ask_out(p) }
    if a.code == "breakup" {
        let name = p.first
        breakup()
        L.happy -= 8
        return finish(name, "Terminaste con " + name + ". El primer corazón roto duele como ningún otro.", "b")
    }
    if a.cost != null { L.money -= a.cost }
    if a.mg != null {
        return mg_start(a.mg, fmt(a.t, ctx) + " con " + p.first, "sweet", {"pid": p.id, "act": a.id})
    }
    let o = pick_outcome(a.o)
    if o.crush != null { p.crush = clamp100(crush_of(p) + o.crush) }
    let msg = apply(o, ctx)
    if a.hito != null { add_hito(p, fmt(a.hito, ctx)) }
    if a.id == "t_pinky" { p.pinky = true }
    msg = msg + bond_bonus(p, a.id)
    return finish(p.first, msg, outcome_kind(o))
}

function sweet_mg_result(score: any, ctx: map) {
    let p = find_person(ctx.pid)
    let a = sweet_act(ctx.act)
    if p == null || a == null { return null }
    let fctx = {"person": p}
    let gb = a.bond[0] + (a.bond[1] - a.bond[0]) * score / 100
    bond_gain(p, gb)
    L.happy += 2 + score / 25
    if a.id == "t_study" {
        L.grades = clamp(L.grades + score / 25, 0, 100)
        if p.grades != null { p.grades = clamp(p.grades + score / 25, 0, 100) }
    }
    let text = fmt(a.ok, fctx)
    if score < 50 { text = fmt(a.bad, fctx) }
    if a.hito != null { add_hito(p, fmt(a.hito, fctx)) }
    text = text + bond_bonus(p, a.id)
    return finish(p.first, text + " (" + str(score) + " puntos)", "g")
}

function crush_of(p: map) {
    if p.crush == null {
        p.crush = 10
        if p.childhood == true { p.crush = 25 }
    }
    return p.crush
}

// Pedirle que sea tu novio o novia: depende de cuánto le gustas.
function ask_out(p: map) {
    let odds = crush_of(p) + p.bond / 3 + rank("charm") * 5 + (looks_eff() - 50) / 4 - 15
    if p.childhood == true { odds += 10 }
    odds = clamp(odds, 5, 95)
    if chance(odds) {
        make_partner(p)
        p.teen_start = L.age
        add_hito(p, "Se hicieron novios")
        L.happy += 15
        flag("first_love")
        return finish(p.first, "Con la voz temblando se lo pediste... y " + p.first + " dijo que sí, roj" + oa(p.gender) + " como tomate. Tu primer amor.", "g")
    }
    p.crush = clamp100(crush_of(p) - 10)
    bond_gain(p, -4)
    L.happy -= 8
    return finish(p.first, p.first + " se quedó callad" + oa(p.gender) + " y luego dijo: «Te quiero, pero como amig" + oa(L.gender) + "». Auch. Quizá con el tiempo...", "b")
}

// ---------------------------------------------------------------- hitos

function add_hito(p: map, text: string) {
    if p == null { return null }
    if p.hitos == null { p.hitos = [] }
    for h in p.hitos {
        if h.t == text { return null }
    }
    list_push(p.hitos, {"a": L.age, "t": text})
    list_push(G.toasts, {"head": "¡HITO!", "title": str_upper(text), "sub": "Con " + p.first + " · a los " + str(L.age) + " años", "t0": G.t})
    hito_push(hito_cat_for(p), text + " (" + p.first + ")")
    return null
}

function hito_items(p: map) {
    let items = []
    if p.hitos == null || len(p.hitos) == 0 {
        list_push(items, {"action": "hito:0", "t": "Su historia apenas empieza", "s": "", "desc": "Cada momento importante que vivan juntos quedará aquí.", "lock": "", "pid": p.id})
        return items
    }
    let i = 0
    while i < len(p.hitos) {
        let h = p.hitos[i]
        list_push(items, {"action": "hito:" + str(i), "t": h.t, "s": "A los " + str(h.a) + " años", "desc": "Tenías " + str(h.a) + " años. " + h.t + ".", "lock": "", "pid": p.id, "done": true})
        i += 1
    }
    return items
}

// Hitos que llegan solos con el tiempo (una vez al año).
function sweet_year() {
    let p = partner()
    if p == null || !p.alive { return null }
    if p.since == null { p.since = L.age }
    let years = L.age - p.since
    if L.age == 18 && p.teen_start != null { add_hito(p, "Cumpliste 18 a su lado") }
    if years == 1 { add_hito(p, "Su primer aniversario") }
    if years == 5 { add_hito(p, "Cinco años juntos") }
    if years == 10 { add_hito(p, "Diez años juntos") }
    if years == 25 {
        add_hito(p, "Bodas de plata: 25 años juntos")
        L.happy += 10
    }
    if years == 50 {
        add_hito(p, "Bodas de oro: 50 años juntos")
        L.happy += 15
        flag("golden")
    }
    return null
}

function sweet_special(name: string, ctx: map) {
    let p = ctx["person"]
    if str_starts_with(name, "hito:") {
        if p != null { add_hito(p, str_replace(name, "hito:", "")) }
        return ""
    }
    if name == "sweet_end" || name == "sweet_moved" {
        if p != null {
            breakup()
            p.rel = "amigo"
            if name == "sweet_moved" { p.moved = true }
        }
        return ""
    }
    return ""
}

function sweet_meets(tag: string) {
    let p = partner()
    if tag == "teencouple" { return p != null && L.age < 18 && p.age < 18 }
    if tag == "teencoupleold" { return p != null && p.teen_start != null && p.age <= 19 }
    return false
}
