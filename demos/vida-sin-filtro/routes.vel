function porno_action(id: string) {
    let d = L.rd
    if id == "pstart" {
        if L.job != null { L.last_job = L.job.title }
        L.job = new_job("porn")
        remember_job("porn")
        hito_me("Trabajo", "Debut en el cine para adultos")
        return finish("Casting", "Pasaste el casting. Contrato firmado y pruebas médicas en regla.", "x")
    }
    if id == "pstudio" {
        if d.studio || L.money < 2000000 { return null }
        L.money -= 2000000
        d.studio = true
        hito_me("Trabajo", "Fundaste tu estudio de cine para adultos")
        return finish("Tu estudio", "Fundaste tu estudio. Ahora tú decides cómo se trabaja.", "g")
    }
    if !route_use(id) { return info("Estrella +18", "Ya lo hiciste este mes.") }
    if id == "pscene" { return mg_start("arrows", "Rodaje", "route", {"kind": "scene"}) }
    if id == "ptest" {
        d.tested = L.tm
        let msg = its_test()
        L.money += 500
        return finish("Pruebas", msg, "n")
    }
    if id == "pcon" {
        let pay = 5000 + L.fame * 300
        L.money += pay
        L.fame = clamp100(L.fame + 3)
        return finish("Convención", "Firmaste autógrafos seis horas seguidas. Ganaste " + money_str(pay) + ".", "g")
    }
    if id == "pfilm" {
        if L.money < 200000 { return null }
        L.money -= 200000
        d.studio_films += 1
        let ret = 200000 * (L.fame + rint(0, 60)) / 50
        L.money += ret
        let kind = "g"
        if ret < 200000 { kind = "b" }
        return finish("Producción", "Tu película recaudó " + money_str(ret) + ".", kind)
    }
