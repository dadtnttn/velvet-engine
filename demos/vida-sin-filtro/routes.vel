const NICHES = ["Videojuegos", "Comedia", "Belleza", "Fitness", "Música", "Cocina"]
const NICHE_INT = {"Videojuegos": "videojuegos", "Comedia": "cine", "Belleza": "arte", "Fitness": "deporte", "Música": "musica", "Cocina": "cocina"}

// ---------------------------------------------------------------- base

function route_def(id: string) {
    for r in ROUTES {
        if r.id == id { return r }
    }
    return ROUTES[0]
}

function route_is_adult() {
    return L.route == "escort" || L.route == "porno" || L.route == "fans" || (L.route == "profeta" && L.religion == "velo")
}

function route_setup() {
    L.rstage = 0
    L.rdone = false
    let id = L.route
    if id == "rey" {
        L.family = "rica"
        L.rd = {"inf": 0, "allies": 0, "king": false, "realm": null, "reign_m": 0, "stable_m": 0, "poly": false}
        log_add("Naciste en una familia noble, descendiente de la antigua corona. Algunos dicen que el trono te pertenece.", "x")
    } else if id == "presidente" {
        L.rd = {"party": "", "pop": 5, "office": "", "pres": false, "term_m": 0, "terms": 0, "good_m": 0, "stable_m": 0, "realm": null, "done": false}
    } else if id == "creador" {
        L.rd = {"subs": 0, "niche": "", "videos": 0, "brand": false}
    } else if id == "filantropo" {
        L.family = "rica"
        L.rd = {"mine": 0, "workers": 50, "tech": false, "space": false, "eng": 0, "rnd": 0, "rocket": false, "station": false, "mars": 0, "mars_done": false, "donated": 0}
        log_add("Tu familia es dueña de «La Verde», una mina de esmeraldas. Un día será tuya.", "x")
    } else if id == "escort" {
        L.rd = {"clients": 0, "rate": 1000, "security": false, "agency": false}
    } else if id == "porno" {
        L.rd = {"films": 0, "studio": false, "studio_films": 0, "tested": -1}
    } else if id == "fans" {
        L.rd = {"open": false, "subs": 0, "price": 10, "agency": false, "security": false}
    } else if id == "profeta" {
        L.rd = {"order": false, "fol": 0, "fervor": 50, "brain": 20, "heat": 0, "treasury": 0, "temple": 0, "doctrine": [],
                "path": "", "reform": 0, "doom": 0, "done": [], "cands": [], "escaped": 0, "infidelities": 0, "final": false}
        log_add("Desde niñ" + oa(L.gender) + " sientes que naciste para algo más grande. A los 18 lo sabrás.", "x")
    } else {
        L.rd = {}
    }
    return null
}

function route_stages() {
    let s = ROUTE_STAGES[L.route]
    if s == null { return [] }
    return s
}

function route_check(req: string) {
    let d = L.rd
    if req == "age16" { return L.age >= 16 }
    if req == "inf40" { return d.inf >= 40 }
    if req == "allies3" { return d.allies >= 3 }
    if req == "king" { return d.king == true }
    if req == "stable24" { return d.stable_m >= 24 }
    if req == "heir" { return d.king == true && len(kids_alive()) > 0 }
    if req == "reign120" { return d.king == true && d.reign_m >= 120 && d.realm.aprob >= 60 }
    if req == "party" { return d.party != "" }
    if str_starts_with(req, "office:") {
        let o = str_replace(req, "office:", "")
        return d.office == o || (o == "diputado" && (d.office == "gobernador" || d.pres)) || (o == "gobernador" && d.pres)
    }
    if req == "pres" { return d.pres == true || d.terms >= 1 }
    if req == "good24" { return d.good_m >= 24 }
    if req == "terms2" { return d.terms >= 2 }
    if req == "presdone" { return d.done == true }
    if req == "videos1" { return d.videos >= 1 }
    if req == "subs1k" { return d.subs >= 1000 }
    if req == "subs100k" { return d.subs >= 100000 }
    if req == "subs1m" { return d.subs >= 1000000 }
    if req == "subs10m" { return d.subs >= 10000000 }
    if req == "brand" { return d.brand == true }
    if req == "mine" { return d.mine >= 1 }
    if req == "mine3" { return d.mine >= 3 }
    if req == "tech" { return d.tech == true }
    if req == "space" { return d.space == true }
    if req == "rocket" { return d.rocket == true }
    if req == "station" { return d.station == true }
    if req == "mars" { return d.mars_done == true }
    if str_starts_with(req, "job:") { return job_is(str_replace(req, "job:", "")) }
    if req == "clients10" { return d.clients >= 10 }
    if req == "rank3" { return L.job != null && L.job.level >= 2 }
    if req == "rank2" { return L.job != null && L.job.level >= 1 }
    if req == "rate5k" { return d.rate >= 5000 }
    if req == "agency" { return d.agency == true }
    if req == "money5m" { return L.money >= 5000000 }
    if req == "award" { return has_flag("award") }
    if req == "fame60" { return L.fame >= 60 }
    if req == "studio" { return d.studio == true }
    if req == "pornlegend" { return L.job != null && L.job.level >= 4 && d.studio_films >= 5 }
    if req == "fans_open" { return d.open == true }
    if req == "fsubs100" { return d.subs >= 100 }
    if req == "fsubs1k" { return d.subs >= 1000 }
    if req == "fsubs10k" { return d.subs >= 10000 }
    if req == "fsubs100k" { return d.subs >= 100000 }
    if req == "fans_agency" { return d.agency == true }
    if req == "v_order" { return d.order == true }
    if req == "v_fol100" { return d.fol >= 100 }
    if req == "v_circle" { return has_flag("circle12") }
    if req == "v_temple" { return d.temple >= 1 }
    if req == "v_fol10k" { return d.fol >= 10000 }
    if req == "v_path" { return d.path != "" }
    if req == "v_final" { return d.final == true }
    return false
}

// Cada mes: lo propio de la ruta y revisar si se cumplió la etapa actual.
function route_month() {
    if L.route == null || L.route == "normal" { return null }
    if L.route == "rey" || L.route == "presidente" { realm_month() }
    if L.route == "filantropo" { space_month() }
    if L.route == "creador" { creator_month() }
    if L.route == "fans" { fans_month() }
    if L.route == "escort" { escort_month() }
    corona_month()
    politica_month()
    contenido_month()
    marte_month()
    velo_month()
    rutas18_month()
    let st = route_stages()
    if L.rstage < len(st) && route_check(st[L.rstage].req) {
        let s = st[L.rstage]
        L.rstage += 1
        L.happy += 6
        hito_me("Vida", "Ruta: " + s.t)
        if L.rstage >= len(st) {
            L.rdone = true
            flag("route_done")
            list_push(G.toasts, {"head": "¡RUTA COMPLETADA!", "title": str_upper(route_def(L.route).n), "sub": "Eres una leyenda.", "t0": G.t})
            L.fame = clamp100(L.fame + 20)
        }
    }
    return null
}

function route_block() {
    if L.route == null || L.route == "normal" { return "Elegiste una vida sin guion. Para seguir una ruta, elígela al crear tu siguiente personaje." }
    if route_def(L.route).adult && L.age < 18 { return "Tu ruta empieza a los 18 años. Por ahora, vive tu infancia y tu adolescencia." }
    return ""
}

function route_cats() {
    let id = L.route
    let d = L.rd
    if id == "rey" {
        if d.king { return ["Objetivos", "Gobierno", "Leyes", "Corte", "Consejo", "Diplomacia", "Herederos"] }
        if d.regency == true { return ["Objetivos"] }
        return ["Objetivos", "Corte"]
    }
    if id == "presidente" {
        if d.pres { return ["Objetivos", "Gobierno", "Leyes", "Gabinete", "Prensa"] }
        if d.ex == true { return ["Objetivos", "Campaña", "Equipo", "Expresidente"] }
        return ["Objetivos", "Campaña", "Equipo"]
    }
    if id == "creador" { return ["Objetivos", "Contenido", "Formatos", "Negocio", "Equipo", "Canal"] }
    if id == "fans" { return ["Objetivos", "Contenido", "Negocio", "Fans"] }
    if id == "filantropo" { return ["Objetivos", "Mina", "Empresas", "TerraTech", "Espacio", "Marte", "Filantropía"] }
    if id == "escort" { return ["Objetivos", "Clientes", "Negocio", "Agenda", "Agencia"] }
    if id == "porno" { return ["Objetivos", "Rodajes", "Negocio", "Carrera"] }
    if id == "profeta" { return velo_cats() }
    return ["Objetivos"]
}

function route_items(cat: string) {
    if cat == "Objetivos" { return objective_items() }
    let id = L.route
    if id == "profeta" { return velo_items(cat) }
    if id == "rey" && (cat == "Consejo" || cat == "Diplomacia" || cat == "Herederos") { return corona_items(cat) }
    if id == "presidente" && (cat == "Equipo" || cat == "Gabinete" || cat == "Prensa" || cat == "Expresidente") { return politica_items(cat) }
    if id == "creador" && (cat == "Formatos" || cat == "Equipo" || cat == "Canal") { return contenido_items(cat) }
    if id == "filantropo" && (cat == "TerraTech" || cat == "Marte") { return marte_items(cat) }
    if id == "escort" && (cat == "Agenda" || cat == "Agencia") { return escort_extra_items(cat) }
    if id == "porno" && cat == "Carrera" { return porno_extra_items(cat) }
    if id == "fans" && cat == "Fans" { return fans_extra_items(cat) }
    if id == "rey" || id == "presidente" { return realm_items(cat) }
    if id == "filantropo" {
        let base = space_items(cat)
        if cat == "Mina" || cat == "Filantropía" {
            for it in marte_items(cat) { list_push(base, it) }
        }
        return base
    }
    if id == "creador" && cat == "Negocio" {
        let base = creator_items(cat)
        for it in contenido_items(cat) { list_push(base, it) }
        return base
    }
    if id == "creador" { return creator_items(cat) }
    if id == "fans" { return fans_items(cat) }
    if id == "escort" { return escort_items(cat) }
    if id == "porno" { return porno_items(cat) }
    return []
}

function objective_items() {
    let items = []
    let st = route_stages()
    let i = 0
    while i < len(st) {
        let s = st[i]
        let sub = "Pendiente"
        let lock = ""
        if i < L.rstage { sub = "CUMPLIDO" }
        if i == L.rstage { sub = "EN CURSO" }
        if i > L.rstage { lock = "Etapa " + str(i + 1) }
        list_push(items, {"action": "ra:obj", "t": str(i + 1) + ". " + s.t, "s": sub, "desc": s.d + " " + route_status(), "lock": lock, "done": i < L.rstage})
        i += 1
    }
    return items
}

// Una línea con el estado de la ruta.
function route_status() {
    let d = L.rd
    let id = L.route
    if id == "rey" {
        if d.king { return "Reinas desde hace " + str(d.reign_m) + " meses." }
        if d.regency == true { return "Regencia: te coronan a los 18." }
        return "Influencia " + str(d.inf) + " · aliados " + str(d.allies) + "."
    }
    if id == "presidente" {
        let o = d.office
        if d.pres { o = "presidente" }
        if o == "" { o = "ninguno" }
        return "Popularidad " + str(d.pop) + "% · cargo: " + o + "."
    }
    if id == "creador" { return "Seguidores: " + big_num(d.subs) + "." }
    if id == "fans" { return "Suscriptores: " + big_num(d.subs) + " · precio $" + str(d.price) + "." }
    if id == "escort" { return "Clientes: " + str(d.clients) + " · tarifa " + money_str(d.rate) + "." }
    if id == "porno" { return "Películas: " + str(d.films) + "." }
    if id == "filantropo" { return "Mina nivel " + str(d.mine) + " · investigación " + str(d.rnd) + "%." }
    if id == "profeta" { return velo_status() }
    return ""
}

function big_num(n: int) {
    if n >= 1000000 { return str(n / 1000000) + "." + str(n % 1000000 / 100000) + " M" }
    if n >= 1000 { return str(n / 1000) + "." + str(n % 1000 / 100) + " mil" }
    return str(n)
}

// Acción genérica de ruta con límite mensual.
function ritem(id: string, t: string, s: string, desc: string, lock: string) {
    let l = lock
    if l == "" && L.used["ra_" + id] != null { l = "Este mes ya" }
    return {"action": "ra:" + id, "t": t, "s": s, "desc": desc, "lock": l}
}

function route_use(id: string) {
    if L.used["ra_" + id] != null { return false }
    L.used["ra_" + id] = 1
    return true
}

function route_action(id: string) {
    G.modal = null
    if id == "obj" { return null }
    if list_contains(FANS_IDS, id) { return fans_action(id) }
    let r = L.route
    if r == "rey" || r == "presidente" { return realm_action(id) }
    if r == "filantropo" { return space_action(id) }
    if r == "creador" { return creator_action_r(id) }
    if r == "fans" { return fans_action(id) }
    if r == "escort" { return escort_action(id) }
    if r == "porno" { return porno_action(id) }
    return null
}

function route_mg_result(score: any, ctx: map) {
    let k = ctx.kind
    if k == "video" || k == "live" { return creator_result(k, score) }
    if k == "flive" { return fans_live_result(score) }
    if k == "scene" { return porno_scene_result(score) }
    if k == "debate" { return debate_result(score) }
    if k == "launch" { return launch_result(score, ctx) }
    return null
}

// ---------------------------------------------------------------- creador de contenido

function creator_items(cat: string) {
    let d = L.rd
    let items = []
    let young = ""
    if L.age < 13 { young = "Edad 13" }
    if cat == "Contenido" {
        list_push(items, ritem("video", "Grabar un video", "Minijuego · seguidores", "Edita rápido y bien: tu puntaje decide cuántas vistas tiene. Si es de tu nicho y te gusta, rinde más.", young))
        list_push(items, ritem("live", "Transmitir en vivo", "Minijuego · donaciones", "Interactúa con tu chat al ritmo. Más seguidores, más donaciones.", young))
        let nl = young
        list_push(items, {"action": "ra:niche", "t": "Elegir tu nicho", "s": "Actual: " + creator_niche(), "desc": "Un nicho que te apasiona hace que tus videos rindan más.", "lock": nl})
        let cl = young
        if d.subs < 1000 && cl == "" { cl = "1,000 seguidores" }
        list_push(items, ritem("collab", "Colaborar con otro creador", "Seguidores", "Juntar comunidades siempre suma.", cl))
        list_push(items, ritem("drama", "Hacer polémica", "Arriesgado", "Un video de chisme y clickbait. Puede explotar... o cancelarte.", young))
        list_push(items, ritem("rest", "Descanso digital", "Salud mental", "Un mes sin redes. Tus seguidores bajan un poco, tú respiras.", ""))
        return items
    }
    let sl = ""
    if d.subs < 10000 { sl = "10 mil seguidores" }
    list_push(items, ritem("sponsor", "Aceptar un patrocinio", "Dinero", "Una marca te paga por mencionarla. Pagan según tus seguidores.", sl))
    let ml = ""
    if d.subs < 50000 { ml = "50 mil seguidores" }
    list_push(items, ritem("merch", "Vender mercancía", "Dinero", "Gorras, playeras y tazas con tu cara.", ml))
    let bl = ""
    if d.subs < 1000000 { bl = "1 millón" }
    if d.brand { bl = "Ya la tienes" }
    if bl == "" && L.money < 500000 { bl = "$500,000" }
    list_push(items, {"action": "ra:brand", "t": "Lanzar tu propia marca", "s": "$500,000", "desc": "Tu propia empresa de productos. Ingresos cada mes.", "lock": bl})
    return items
}

function creator_niche() {
    if L.rd.niche == "" { return "ninguno" }
    return L.rd.niche
}

function creator_action_r(id: string) {
    let d = L.rd
    if id == "niche" {
        let labels = list_slice(NICHES, 0, len(NICHES))
        let locks = []
        for x in labels { list_push(locks, "") }
        open_choice("TU NICHO", "¿De qué será tu canal?", labels, locks, "niche", {})
        return null
    }
    if !route_use(id) { return info("Contenido", "Ya lo hiciste este mes.") }
    if id == "video" { return mg_start("typing", "Editar tu video", "route", {"kind": "video"}) }
    if id == "live" { return mg_start("arrows", "Transmisión en vivo", "route", {"kind": "live"}) }
    if id == "collab" {
        let gainv = d.subs / 10 + rint(200, 2000)
        d.subs += gainv
        let f = make_person(pick(["m", "f"]), "amigo", max(13, L.age + rint(-4, 6)))
        f.bond = rint(45, 70)
        add_person(f)
        return finish("Colaboración", "Hiciste un video con " + f.first + ", otr" + oa(f.gender) + " creador" + by_gender(f.gender, "", "a") + ". +" + big_num(gainv) + " seguidores y una nueva amistad.", "g")
    }
    if id == "drama" {
        if chance(55) {
            let g = d.subs * 3 / 10 + 500
            d.subs += g
            L.fame = clamp100(L.fame + 3)
            return finish("Polémica", "El chisme explotó: +" + big_num(g) + " seguidores. Los comentarios arden.", "g")
        }
        let lost = d.subs / 4
        d.subs -= lost
        L.happy -= 10
        hito_once("cancelled", "Vida", "Te cancelaron en redes")
        return finish("Polémica", "Te cancelaron. Perdiste " + big_num(lost) + " seguidores y ahora todos opinan de ti.", "b")
    }
    if id == "rest" {
        d.subs -= d.subs / 50
        L.happy += 8
        L.health += 2
        return finish("Descanso", "Un mes sin redes. Dormiste, leíste y volviste con ideas nuevas.", "g")
    }
    if id == "sponsor" {
        let pay = d.subs / 40 + 1000
        L.money += pay
        return finish("Patrocinio", "Una marca te pagó " + money_str(pay) + " por mencionarla en tu video.", "g")
    }
    if id == "merch" {
        let pay = d.subs / 25
        L.money += pay
        return finish("Mercancía", "Vendiste tu mercancía: " + money_str(pay) + ".", "g")
    }
    if id == "brand" {
        if d.brand || L.money < 500000 { return null }
        L.money -= 500000
        d.brand = true
        hito_me("Trabajo", "Lanzaste tu propia marca")
        return finish("Tu marca", "Lanzaste tu marca. Se agotó en un día.", "g")
    }
    return null
}

function resolve_niche(index: int) {
    G.modal = null
    let n = NICHES[index]
    L.rd.niche = n
    return finish("Tu canal", "Ahora tu canal es de " + str_lower(n) + ".", "n")
}

function creator_result(kind: string, score: any) {
    let d = L.rd
    let mult = 1
    let ni = NICHE_INT[d.niche]
    if ni != null && list_contains(my_interests(), ni) { mult = 2 }
    if kind == "video" {
        d.last_upload_tm = L.tm
        d.videos += 1
        let gainv = (score + 20) * (5 + d.subs / 2000) * mult
        if score >= 80 && chance(8) {
            gainv = gainv * 10
            hito_once("viral", "Vida", "Tu primer video viral")
            d.subs += gainv
            L.fame = clamp100(L.fame + 8)
            return finish("¡Viral!", "¡Tu video se hizo viral! +" + big_num(gainv) + " seguidores.", "g")
        }
        d.subs += gainv
        if d.videos == 1 { hito_me("Trabajo", "Subiste tu primer video") }
        return finish("Video", "Tu video tuvo " + big_num(gainv * 7) + " vistas. +" + big_num(gainv) + " seguidores. (" + str(score) + " puntos)", "g")
    }
    let tips = d.subs / 300 * score / 50 + score * 3
    L.money += tips
    d.subs += score * (2 + d.subs / 5000)
    return finish("En vivo", "Tu transmisión estuvo " + mg_rating(score) + ". Donaciones: " + money_str(tips) + ".", "g")
}

function creator_month() {
    let d = L.rd
    if d.subs <= 0 { return null }
    L.money += d.subs * 2 / 100
    if d.brand { L.money += 30000 + d.subs / 100 }
    // L.used se reinicia antes de esto cada mes: la fecha del último video vive en d.
    let last = map_get(d, "last_upload_tm", -99)
    if last >= L.tm - 1 { d.subs += d.subs / 100 } else if last < L.tm - 2 { d.subs -= d.subs / 60 }
    if d.subs >= 1000000 { L.fame = clamp100(max(L.fame, 50)) }
    return null
}

// ---------------------------------------------------------------- VelvetFans (+18)

function fans_items(cat: string) {
    let d = vf()
    let items = []
    if !d.open {
        list_push(items, {"action": "ra:fopen", "t": "Abrir tu cuenta en VelvetFans", "s": "Empezar", "desc": "Fotos y videos exclusivos para quienes pagan tu suscripción. Tú pones las reglas.", "lock": ""})
        return items
    }
    if cat == "Contenido" {
        list_push(items, ritem("fphotos", "Publicar una sesión de fotos", "Suscriptores", "Lencería, luz suave y tu mejor ángulo.", ""))
        list_push(items, ritem("fvideo", "Video exclusivo", "Más suscriptores", "Contenido que solo tus fans pagados pueden ver.", ""))
        list_push(items, ritem("flive", "Transmisión en vivo", "Minijuego · propinas", "Lee el chat al ritmo y consiente a tus fans.", ""))
        list_push(items, ritem("fdm", "Mensajes personalizados", "Dinero", "Contenido a pedido para tus fans más fieles.", ""))
        list_push(items, ritem("fcollab", "Colaboración con otro creador", "Fama", "Un video juntos para las dos comunidades.", ""))
        return items
    }
    list_push(items, {"action": "ra:fprice", "t": "Cambiar tu precio", "s": "Ahora $" + str(d.price) + "/mes", "desc": "Más caro: menos fans pero más dinero por fan. Más barato: creces rápido.", "lock": ""})
    let pl = ""
    if L.money < 500 { pl = "$500" }
    list_push(items, ritem("fpromo", "Promoción en redes", "$500 · suscriptores", "Anuncios y adelantos en tus redes públicas.", pl))
    if d.security {
        list_push(items, {"action": "ra:fsecurity", "t": "Cancelar la seguridad digital", "s": "ACTIVA · $2,000/mes", "desc": "Ahorras el pago, pero vuelves a quedar expuest" + oa(L.gender) + " a filtraciones y acosadores.", "lock": ""})
    } else {
        list_push(items, {"action": "ra:fsecurity", "t": "Contratar seguridad digital", "s": "$2,000/mes", "desc": "Protege tu identidad y evita filtraciones y acosadores.", "lock": ""})
    }
    let al = ""
    if d.subs < 100000 { al = "100 mil suscriptores" }
    if d.agency { al = "Ya la tienes" }
    if al == "" && L.money < 1000000 { al = "$1,000,000" }
    list_push(items, {"action": "ra:fagency", "t": "Fundar tu agencia de creadores", "s": "$1,000,000", "desc": "Manejas a otros creadores y te llevas un porcentaje.", "lock": al})
    return items
}

function fans_action(id: string) {
    let d = vf()
    if id == "fopen" {
        d.open = true
        if L.job == null { L.job = new_job("cam") }
        remember_job("cam")
        hito_me("Trabajo", "Abriste tu cuenta en VelvetFans")
        return finish("VelvetFans", "Tu cuenta está abierta. Primera foto subida con el corazón a mil.", "x")
    }
    if id == "fprice" {
        open_choice("TU PRECIO", "¿Cuánto cobras al mes? Ahora: $" + str(d.price) + ".", ["$5 (crecer rápido)", "$10", "$20", "$50 (exclusivo)", "Dejarlo igual"], ["", "", "", "", ""], "fprice", {})
        return null
    }
    if id == "fsecurity" {
        if d.security {
            d.security = false
            return finish("Seguridad", "Cancelaste la seguridad digital. Ojalá no te arrepientas.", "n")
        }
        d.security = true
        return finish("Seguridad", "Contrataste seguridad digital. Duermes más tranquil" + oa(L.gender) + ".", "g")
    }
    if id == "fagency" {
        if d.agency || L.money < 1000000 { return null }
        L.money -= 1000000
        d.agency = true
        hito_me("Trabajo", "Fundaste tu agencia de creadores")
        return finish("Tu agencia", "Ahora representas a otros creadores. El dinero entra solo.", "g")
    }
    if !route_use(id) { return info("VelvetFans", "Ya lo hiciste este mes.") }
    let looks_bonus = looks_eff() / 20 + fx_sum("flirt") / 5
    if id == "fphotos" {
        let g = rint(10, 40) + d.subs * (3 + looks_bonus) / 100
        d.subs += g
        career_xp(8)
        return finish("Sesión de fotos", "Tus fotos encantaron: +" + big_num(g) + " suscriptores.", "x")
    }
    if id == "fvideo" {
        let g = rint(30, 90) + d.subs * (5 + looks_bonus) / 100
        d.subs += g
        L.fame = clamp100(L.fame + 1)
        career_xp(12)
        return finish("Video exclusivo", "Tu video exclusivo fue el más visto de la semana: +" + big_num(g) + " suscriptores.", "x")
    }
    if id == "flive" { return mg_start("arrows", "En vivo en VelvetFans", "route", {"kind": "flive"}) }
    if id == "fdm" {
        let pay = d.subs * d.price / 15 + 200
        L.money += pay
        return finish("Mensajes", "Tus fans más fieles pagaron por contenido a pedido: " + money_str(pay) + ".", "x")
    }
    if id == "fcollab" {
        d.subs += d.subs / 8 + 100
        L.fame = clamp100(L.fame + 3)
        return finish("Colaboración", "Tu video con otro creador fue tendencia en la plataforma.", "x")
    }
    if id == "fpromo" {
        L.money -= 500
        d.subs += rint(20, 80) + d.subs / 30
        return finish("Promoción", "Tus adelantos en redes atrajeron nuevos fans.", "g")
    }
    return null
}

function resolve_fprice(index: int) {
    G.modal = null
    let prices = [5, 10, 20, 50]
    if index < 4 {
        let d = vf()
        d.price = prices[index]
    }
    return finish("Tu precio", "Tu suscripción ahora cuesta $" + str(vf().price) + " al mes.", "n")
}

function fans_live_result(score: any) {
    let d = vf()
    let tips = score * (5 + d.subs / 200)
    L.money += tips
    d.subs += score / 2 + d.subs / 100
    return finish("En vivo", "Tu transmisión estuvo " + mg_rating(score) + ". Propinas: " + money_str(tips) + ".", "x")
}

function fans_month() {
    let d = vf()
    if !d.open { return null }
    let income = d.subs * d.price * 80 / 100
    L.money += income
    if d.security { L.money -= 2000 }
    if d.agency { L.money += 50000 + d.subs / 2 }
    let churn = 2 + d.price / 10
    d.subs -= d.subs * churn / 100
    if d.price <= 10 { d.subs += rint(0, 10) + d.subs / 50 }
    if !d.security && d.subs >= 500 && rint(1, 2500) <= 100 * fans_leak_mult() / 100 {
        L.happy -= 12
        hito_once("leak", "Vida", "Filtraron tu contenido")
        log_add("Alguien filtró tu contenido exclusivo en un foro. Te sientes expuest" + oa(L.gender) + ".", "b")
    }
    if !d.security && d.subs >= 2000 && chance(2) {
        L.happy -= 8
        log_add("Un fan obsesionado descubrió dónde vives. Da miedo salir.", "b")
    }
    return null
}

// ---------------------------------------------------------------- escort (+18)

function escort_items(cat: string) {
    let d = L.rd
    let items = []
    if !job_is("escort") {
        list_push(items, {"action": "ra:estart", "t": "Empezar como escort", "s": "Debut", "desc": "Tus reglas, tu seguridad y tu tarifa. Siempre entre adultos que consienten.", "lock": ""})
        return items
    }
    if cat == "Clientes" {
        list_push(items, ritem("eclient", "Atender a un cliente", money_str(d.rate), "Una cita discreta en un buen hotel. Usa protección: siempre hay riesgo.", ""))
        let vl = ""
        if L.job.level < 1 { vl = "Rango 2" }
        list_push(items, ritem("evip", "Cliente VIP", "Mucho dinero", "Un empresario te invita a su yate un fin de semana.", vl))
        list_push(items, ritem("eup", "Subir tu tarifa", "Encanto", "Si tu encanto lo sostiene, ganas más por cita. Si no, pierdes clientes.", ""))
        list_push(items, ritem("edown", "Bajar tu tarifa", "Más clientes", "Más trabajo, menos dinero por cita.", ""))
        return items
    }
    let sl = ""
    if d.security { sl = "Ya tienes" }
    list_push(items, {"action": "ra:esecurity", "t": "Contratar seguridad", "s": "$3,000/mes", "desc": "Un chofer y alguien que sabe dónde estás. Evita los peores sustos.", "lock": sl})
    let al = ""
    if L.job.level < 1 { al = "Rango 2" }
    if d.agency { al = "Ya la tienes" }
    if al == "" && L.money < 500000 { al = "$500,000" }
    list_push(items, {"action": "ra:eagency", "t": "Abrir tu agencia", "s": "$500,000", "desc": "Representas a otras escorts con reglas justas y seguridad. Ganancias cada mes.", "lock": al})
    return items
}

function escort_action(id: string) {
    let d = L.rd
    if id == "estart" {
        if L.job != null { L.last_job = L.job.title }
        L.job = new_job("escort")
        remember_job("escort")
        hito_me("Trabajo", "Debut como escort")
        return finish("Debut", "Tu primera cita como escort. Nervios, un buen vestido y reglas claras.", "x")
    }
    if id == "esecurity" {
        d.security = true
        return finish("Seguridad", "Contrataste seguridad. Ahora alguien siempre sabe dónde estás.", "g")
    }
    if id == "eagency" {
        if d.agency || L.money < 500000 { return null }
        L.money -= 500000
        d.agency = true
        hito_me("Trabajo", "Abriste tu propia agencia")
        return finish("Tu agencia", "Abriste tu agencia: reglas justas, seguridad y discreción.", "g")
    }
    if !route_use(id) { return info("Escort", "Ya lo hiciste este mes.") }
    if id == "eclient" {
        let pay = d.rate * rint(8, 12) / 10
        d.clients += 1
        career_xp(10)
        let msg = "Cita con un cliente discreto. Cobraste " + money_str(pay) + "."
        L.money += pay
        L.partners += 1
        if chance(6 * (100 + fx_sum("its")) / 100 * escort_its_mult() / 100) { msg = msg + catch_its_random() }
        if !d.security && rint(1, 2000) <= 100 * escort_risk_mult() / 100 {
            L.money -= pay
            L.health -= 10
            L.happy -= 15
            msg = "El cliente se puso violento y se llevó tu dinero. Saliste corriendo del hotel."
            hito_once("escort_scare", "Vida", "Un cliente peligroso")
            return finish("Escort", msg, "b")
        }
        msg = msg + escort_after_client()
        return finish("Escort", msg, "x")
    }
    if id == "evip" {
        let pay = d.rate * 5
        L.money += pay
        d.clients += 1
        L.happy += 6
        career_xp(25)
        return finish("Cliente VIP", "Un fin de semana en yate con un cliente generoso: " + money_str(pay) + ".", "x")
    }
    if id == "eup" {
        if chance(35 + rank("charm") * 8 + looks_eff() / 5) {
            d.rate = d.rate * 13 / 10
            return finish("Tarifa", "Tus clientes aceptaron la nueva tarifa: " + money_str(d.rate) + ".", "g")
        }
        d.clients = max(0, d.clients - 2)
        return finish("Tarifa", "Algunos clientes se fueron con alguien más barato.", "b")
    }
    if id == "edown" {
        d.rate = max(500, d.rate * 8 / 10)
        d.clients += 2
        return finish("Tarifa", "Bajaste tu tarifa a " + money_str(d.rate) + ". Llegaron clientes nuevos.", "n")
    }
    return null
}

function escort_month() {
    let d = L.rd
    if d.security { L.money -= 3000 }
    if d.agency { L.money += rint(20, 60) * 1000 }
    return null
}

