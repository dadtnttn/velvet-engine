}

function porno_scene_result(score: any) {
    let d = L.rd
    d.films += 1
    let pay = 3000 + score * 80 + L.fame * 100
    let x = x8()
    if x.contract != null {
        pay = pay * studio_def(x.contract).pay / 100
        L.fame = clamp100(L.fame + studio_def(x.contract).fame / 2)
    }
    if len(x.costars) > 0 && x.costars[len(x.costars) - 1].chem >= 70 { pay = pay * 12 / 10 }
    L.money += pay
    L.fame = clamp100(L.fame + score / 25)
    career_xp(score / 2)
    let msg = "Escena terminada (" + str(score) + " puntos). Cobraste " + money_str(pay) + "."
    if d.tested != L.tm && chance(5 * (100 + fx_sum("its")) / 100) { msg = msg + catch_its_random() }
    L.partners += 1
    if score >= 90 && chance(25) && !has_flag("award") {
        flag("award")
        msg = msg + " ¡Tu escena ganó el Premio Terciopelo Rojo!"
        hito_me("Trabajo", "Ganaste el Premio Terciopelo Rojo")
    }
    return finish("Rodaje", msg, "x")
}

// Eventos de las rutas (desde advance_month).
function maybe_route_event() {
    if L.route == null || L.route == "normal" { return false }
    if maybe_velo_event() { return true }
    if corona_event() { return true }
    if politica_event() { return true }
    if contenido_event() { return true }
    if marte_event() { return true }
    if rutas18_event() { return true }
    return false
}
