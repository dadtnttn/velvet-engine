eza", "cost": 15, "min": 0}, {"t": "Regatear en el Jan el-Jalili", "d": "El vendedor te llama 'amigo', te ofrece té y empieza pidiendo el triple.", "k": "cultura", "cost": 20, "min": 0}, {"t": "Bucear en Dahab", "d": "Corales y peces de colores a dos pasos de la orilla del mar Rojo.", "k": "deporte", "cost": 50, "min": 0}, {"t": "Picnic de Sham el-Nessim", "d": "Huevos pintados y fesikh, un pescado fermentado con un olor inolvidable.", "k": "comida", "cost": 10, "min": 0}, {"t": "Subir al monte Sinaí al amanecer", "d": "Caminata nocturna con linternas para ver salir el sol en la cumbre.", "k": "naturaleza", "cost": 20, "min": 0}], "fest": [{"m": 3, "n": "Sham el-Nessim", "d": "Fiesta de primavera con picnic, huevos pintados y fesikh."}], "honey": "Las pirámides de Guiza, un crucero por el Nilo y Luxor", "tour": 85, "sport": "Fútbol", "fifa": 65, "nb": ["ly", "sd", "il", "ps"]},
