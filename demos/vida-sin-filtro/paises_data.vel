va chicles.|La vuvuzela sigue en el armario esperando otro Mundial.", "cus": [{"t": "Hacer un braai de domingo", "d": "Boerewors, chuletas y pap a la brasa, con un tío que no deja a nadie tocar las pinzas.", "k": "comida", "cost": 20, "min": 0}, {"t": "Tomar algo en un shebeen de Soweto", "d": "Bares de barrio con amapiano a todo volumen, cerveza en litro y baile improvisado.", "k": "fiesta", "cost": 10, "min": 18}, {"t": "Apostar en el Durban July", "d": "La carrera de caballos más famosa de África, donde la gente va más por los modelitos que por los caballos.", "k": "apuesta", "cost": 50, "min": 18}, {"t": "Safari en el Kruger", "d": "Buscar a los Cinco Grandes conduciendo tu propio coche por el parque.", "k": "naturaleza", "cost": 150, "min": 0}, {"t": "Subir a la Montaña de la Mesa", "d": "Teleférico o caminata hasta la cima plana con vistas a Ciudad del Cabo y dos océanos.", "k": "naturaleza", "cost": 25, "min": 0}, {"t": "Catar vinos en Stellenbosch", "d": "Bodegas holandesas del siglo XVII entre montañas y viñedos.", "k": "picante", "cost": 40, "min": 18}], "fest": [{"m": 0, "n": "Kaapse Klopse", "d": "El 2 de enero los coros y bandas de Ciudad del Cabo desfilan con trajes brillantes y sombrillas."}, {"m": 8, "n": "Día de la Herencia (Braai Day)", "d": "El 24 de septiembre el país celebra su diversidad... encendiendo la parrilla."}, {"m": 2, "n": "Festival de Jazz de Ciudad del Cabo", "d": "El mayor festival de jazz de África, con artistas de todo el continente."}], "honey": "Ciudad del Cabo, la ruta del vino y el Parque Kruger", "tour": 80, "sport": "rugby", "fifa": 45, "nb": ["na", "bw", "zw", "mz", "sz", "ls"]},
