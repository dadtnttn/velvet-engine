mansaf con las manos", "d": "Formas bolitas de arroz con yogur de cabra caliente, como manda la tradición.", "k": "comida", "cost": 10, "min": 0}, {"t": "Bucear en el mar Rojo de Áqaba", "d": "Arrecifes de coral y hasta un tanque hundido a pocos metros de la orilla.", "k": "deporte", "cost": 60, "min": 0}, {"t": "Petra de noche", "d": "El Tesoro iluminado por mil velas mientras suena la flauta beduina.", "k": "cultura", "cost": 30, "min": 0}], "fest": [{"m": 6, "n": "Festival de Jerash", "d": "Música y danza en las ruinas romanas de Jerash."}], "honey": "Petra, Wadi Rum y el mar Muerto", "tour": 72, "sport": "Fútbol", "fifa": 58, "nb": ["sy", "iq", "sa", "il", "ps"]},
