    {"id": "tz", "n": "Tanzania", "dm": "tanzano", "df": "tanzana", "reg": "africa_este", "lang": "suajili e inglés", "pop": 70000, "lat": -6.3, "lon": 34.8, "cap": "Dodoma", "cities": ["Dodoma", "Dar es Salaam", "Mwanza", "Arusha", "Zanzíbar", "Mbeya"], "gdp": 4, "life": 67, "hap": 38, "safe": 60, "edu": 30, "unemp": 3, "gov": "republica", "lead_m": "Presidente", "lead_f": "Presidenta", "crown_m": "Sultán", "crown_f": "Sultana", "crown_reform": true, "ss": 1, "nm": "Juma,John,Joseph,Hassan,Ali,Emmanuel,Baraka,Daudi,Rashidi,Salum,Hamisi,Musa,Petro,Yusufu,Godfrey,Frank,Abdallah,Saidi,Elia,Amani", "nf": "Mwanaidi,Rehema,Neema,Mary,Grace,Zawadi,Asha,Fatuma,Mariamu,Halima,Amina,Upendo,Furaha,Esther,Anna,Joyce,Zuhura,Mwajuma,Saida,Scholastica", "sn": "Juma,Hassan,Mohamed,Ali,Said,Hamisi,Mwakyusa,Massawe,Mollel,Shirima,Mushi,Kimaro,Mrema,Swai,Lyimo,Mwakalinga,Mbwambo,Salum,Rashid,Magesa", "odd_m": "Godbless,Godlisten,Goodluck,Gift,Innocent,Lucky", "odd_f": "Happiness,Lightness,Glory,Witness,Loveness,Faraja", "odd_pct": 10, "rel": {"evangelica": 33, "catolica": 30, "islam": 34, "tradicional": 2, "ninguna": 1}, "skin": [0, 1, 2, 12, 45, 40], "blond": 0, "light_eyes": 0, "lgbt": 0, "sexwork": 0, "alcohol": 2, "weed": 0, "draft": 0, "draft_m": 0, "army": 20, "jobs": ["Servicio", "Oficio", "Negocios"], "food": ["Chipsi mayai", "Pilau", "Mishkaki"], "cl": "'Pole pole' (despacio, despacio) es filosofía de vida, sobre todo en la cola del banco.|El Kilimanjaro es tanzano, aunque Kenia lo ponga en todas sus postales.|Saludar a un mayor sin decir 'Shikamoo' es un pecado social imperdonable.|El chipsi mayai es tortilla con patatas fritas dentro: la versión tanzana de la tortilla española.|El Bongo Flava suena en cada daladala, en cada boda y en cada peluquería.|En Zanzíbar la hora suajili empieza a contar a las seis de la mañana: llegarás seis horas tarde.|Los nombres como Godbless, Godlisten o Happiness son totalmente normales en el colegio.", "cus": [{"t": "Subir el Kilimanjaro", "d": "Seis días de caminata hasta el techo de África, con porteadores que cantan mientras tú jadeas.", "k": "naturaleza", "cost": 2000, "min": 16}, {"t": "Pelear con tallos de plátano en Mwaka Kogwa", "d": "En Makunduchi, Zanzíbar, los hombres se golpean con tallos de banano para limpiar rencores del año.", "k": "fiesta", "cost": 0, "min": 0}, {"t": "Cenar en los jardines de Forodhani", "d": "El mercado nocturno de Stone Town: pizza de Zanzíbar, brochetas y zumo de caña de azúcar.", "k": "comida", "cost": 10, "min": 0}, {"t": "Safari en el Serengeti", "d": "Llanuras infinitas con la gran migración, leones y globos al amanecer.", "k": "naturaleza", "cost": 400, "min": 0}, {"t": "Navegar en un dhow al atardecer", "d": "Un velero tradicional, una puesta de sol rosa y alguien especial al lado.", "k": "picante", "cost": 40, "min": 18}, {"t": "Hacer un tour de especias", "d": "Probar clavo, canela, vainilla y nuez moscada directamente de la planta en Zanzíbar.", "k": "cultura", "cost": 20, "min": 0}], "fest": [{"m": 1, "n": "Sauti za Busara", "d": "Festival de música africana en el fuerte de Stone Town, Zanzíbar."}, {"m": 6, "n": "Mwaka Kogwa", "d": "Año nuevo shirazi en Zanzíbar con peleas rituales con tallos de plátano y una choza que se quema."}, {"m": 6, "n": "ZIFF", "d": "Festival Internacional de Cine de Zanzíbar, con proyecciones al aire libre junto al mar."}], "honey": "Zanzíbar, el Serengeti y el Kilimanjaro", "tour": 70, "sport": "fútbol", "fifa": 25, "nb": ["ke", "ug", "rw", "bi", "cd", "zm", "mw", "mz"]},
