eza", "d": "En Brezna se compite por quién aguanta más días tumbado sin levantarse, en honor al cliché nacional.", "k": "fiesta", "cost": 0, "min": 0}, {"t": "Peregrinar al monasterio de Ostrog", "d": "Un monasterio incrustado en un acantilado vertical al que llegan peregrinos de todas las religiones.", "k": "ritual", "cost": 0, "min": 0}, {"t": "Probar pršut en Njeguši", "d": "El pueblo natal de la dinastía real cura sus jamones con el viento de la montaña.", "k": "comida", "cost": 15, "min": 0}, {"t": "Recorrer la bahía de Kotor en barco", "d": "Navegar entre montañas que caen al mar hasta la isla de Nuestra Señora de las Rocas.", "k": "naturaleza", "cost": 30, "min": 0}, {"t": "Salir de fiesta en Budva", "d": "La 'Miami del Adriático' tiene discotecas en la playa abiertas toda la noche en verano.", "k": "picante", "cost": 50, "min": 18}], "fest": [{"m": 1, "n": "Fiesta de la Mimosa", "d": "Herceg Novi celebra el fin del invierno con flores amarillas y desfiles."}, {"m": 1, "n": "Carnaval de Kotor", "d": "Máscaras y desfiles por las calles medievales."}], "honey": "La bahía de Kotor, Sveti Stefan y el parque Durmitor", "tour": 70, "sport": "waterpolo", "fifa": 35, "nb": ["hr", "ba", "rs", "xk", "al"]},
