ó tiene opinión sobre cómo golpear la ficha en la mesa.", "cus": [{"t": "Ir a un street dance de dancehall", "d": "Baila en plena calle frente a una pared de altavoces hasta que salga el sol.", "k": "picante", "cost": 10, "min": 18}, {"t": "Comer pollo jerk en Boston Bay", "d": "Prueba el jerk original, ahumado sobre madera de pimienta en la cuna de la receta.", "k": "comida", "cost": 12, "min": 0}, {"t": "Subir las cascadas de Dunn's River", "d": "Escala la cascada de la mano de desconocidos formando una cadena humana.", "k": "naturaleza", "cost": 25, "min": 0}, {"t": "Ver amanecer en Blue Mountain", "d": "Sube de madrugada al pico más alto y desayuna el café más famoso de la isla.", "k": "naturaleza", "cost": 60, "min": 0}, {"t": "Visitar la casa de Bob Marley", "d": "Recorre en Kingston el museo donde vivió y grabó la leyenda del reggae.", "k": "cultura", "cost": 25, "min": 0}, {"t": "Golpear fichas de dominó en la plaza", "d": "Únete a una partida ruidosa donde cada ficha cae como un martillazo.", "k": "cultura", "cost": 0, "min": 0}], "fest": [{"m": 1, "n": "Bob Marley Month", "d": "Febrero se llena de conciertos de reggae por el cumpleaños de Bob Marley."}, {"m": 3, "n": "Carnaval de Jamaica", "d": "Kingston se llena de bandas disfrazadas y soca después de Semana Santa."}, {"m": 6, "n": "Reggae Sumfest", "d": "Montego Bay organiza el mayor festival de reggae y dancehall del Caribe."}], "honey": "Negril y las cascadas de Ocho Ríos", "tour": 78, "sport": "Atletismo", "fifa": 45, "nb": ["cu", "ht"]},
