    {"id": "ph", "n": "Filipinas", "dm": "filipino", "df": "filipina", "reg": "sudeste_asiatico", "lang": "filipino e inglés", "pop": 115000, "lat": 12.9, "lon": 121.8, "cap": "Manila", "cities": ["Manila", "Ciudad Quezón", "Dávao", "Cebú", "Zamboanga", "Antipolo"], "gdp": 11, "life": 70, "hap": 61, "safe": 60, "edu": 55, "unemp": 4, "gov": "republica", "lead_m": "Presidente", "lead_f": "Presidenta", "crown_m": "Rajá", "crown_f": "Rani", "crown_reform": true, "ss": 1, "nm": "Juan,Jose,John Paul,Mark,Michael,Christian,Jerome,Joshua,Angelo,Carlo,Rodel,Rogelio,Romeo,Jomar,Nathaniel,Ezekiel,Gabriel,Jacob,Liam,Nathan", "nf": "Maria,Mary Grace,Jennifer,Kristine,Angelica,Joy,Rose,Michelle,Mary Joy,Jasmine,Princess,Althea,Sofia,Samantha,Andrea,Nicole,Erlinda,Corazon,Analyn,Aaliyah", "sn": "Santos,Reyes,Cruz,Garcia,Ramos,Dela Cruz,Mendoza,Bautista,De Guzman,Fernandez,Flores,Gonzales,Villanueva,Lopez,De Leon,Castillo,Aquino,Rivera,Domingo,Perez", "odd_m": "Bongbong,Dingdong,Jun-Jun,Jejomar,Bembol,Jhon Mark,Jayvee,Kokoy", "odd_f": "Luzviminda,Lovely,Cherry Pie,Honey Grace,Babylyn,Precious,Jhing,Marivic", "odd_pct": 15, "rel": {"catolica": 79, "evangelica": 11, "islam": 6, "ninguna": 2, "tradicional": 1, "espiritual": 1}, "skin": [3, 20, 40, 30, 7, 0], "blond": 0, "light_eyes": 0, "lgbt": 1, "sexwork": 0, "alcohol": 2, "weed": 0, "draft": 0, "draft_m": 0, "army": 25, "jobs": ["Servicio", "Salud", "Oficina", "Espectáculo"], "food": ["Adobo", "Lechón", "Halo-halo"], "cl": "La Navidad empieza oficialmente en septiembre, el primer día de los 'ber months'.|Toda reunión familiar termina con el tito cantando 'My Way' en el videoke.|Se señala con los labios, no con el dedo.|Los apodos como Bongbong, Dingdong o Jun-Jun son perfectamente normales, incluso para presidentes.|Si no has comido arroz, no has comido.|Los jeepneys son arte en movimiento y llevan más cromo que una feria.|Se juega al baloncesto en cualquier calle, aunque solo haya un aro colgado de un poste.|Una caja balikbayan llegada del extranjero es una fiesta para toda la familia.", "cus": [{"t": "Cantar en el videoke familiar", "d": "Alquilas una máquina de videoke para la fiesta y compites por la mejor puntuación hasta medianoche.", "k": "fiesta", "cost": 10, "min": 0}, {"t": "Apostar en el sabong", "d": "En una gallera abarrotada, los apostadores gritan cifras con señas de manos antes de cada pelea de gallos.", "k": "apuesta", "cost": 20, "min": 18}, {"t": "Comer en una boodle fight", "d": "Arroz, lechón y mariscos se sirven sobre hojas de plátano y todos comen con las manos a la vez.", "k": "comida", "cost": 10, "min": 0}, {"t": "Bailar en el Sinulog de Cebú", "d": "Te unes al desfile con tambores y trajes de colores en honor al Santo Niño.", "k": "fiesta", "cost": 0, "min": 0}, {"t": "Recorrer las islas de El Nido en barca", "d": "Saltas de laguna en laguna entre acantilados de piedra caliza en Palawan.", "k": "naturaleza", "cost": 40, "min": 0}, {"t": "Ir a las Simbang Gabi", "d": "Asistes a nueve misas al amanecer antes de Navidad, con bibingka y puto bumbong a la salida.", "k": "ritual", "cost": 0, "min": 0}], "fest": [{"m": 0, "n": "Sinulog", "d": "Cebú baila en honor al Santo Niño con tambores, trajes y fiesta callejera."}, {"m": 1, "n": "Panagbenga", "d": "El festival de las flores de Baguio llena las calles de carrozas floridas."}, {"m": 11, "n": "Simbang Gabi", "d": "Nueve misas al amanecer y comida callejera antes de la Nochebuena."}], "honey": "Las lagunas de El Nido en Palawan y las playas de Boracay", "tour": 72, "sport": "Baloncesto", "fifa": 18, "nb": ["tw", "my", "id", "pw"]},
