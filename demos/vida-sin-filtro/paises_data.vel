0}, {"t": "Cantar en el coro de la iglesia del domingo", "d": "Te sumas a los coros de voces potentísimas en una misa que dura horas.", "k": "ritual", "cost": 0, "min": 0}, {"t": "Comer en un umu dominical", "d": "Desentierras cochinillo, lu pulu y ñame cocinados entre piedras calientes.", "k": "comida", "cost": 30, "min": 0}, {"t": "Beber kava en un kalapu", "d": "Pasas la noche en un club de kava cantando y charlando con los hombres del pueblo.", "k": "ritual", "cost": 5, "min": 18}, {"t": "Ver los géiseres marinos de Mapu'a 'a Vaea", "d": "Contemplas cientos de chorros de agua que salen disparados entre las rocas de coral.", "k": "naturaleza", "cost": 0, "min": 0}], "fest": [{"m": 6, "n": "Festival Heilala", "d": "Coincide con el cumpleaños del rey: desfiles, música y concurso de belleza."}], "honey": "Las islas de Vava'u y sus ballenas jorobadas", "tour": 45, "sport": "Rugby", "fifa": 2, "nb": ["ws", "fj"]},
