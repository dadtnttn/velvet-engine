iesta", "cost": 0, "min": 0}, {"t": "Encender el Funken", "d": "El primer domingo de Cuaresma se quema una torre de madera con una bruja de paja en lo alto para despedir el invierno.", "k": "ritual", "cost": 0, "min": 0}, {"t": "Ponerte el sello del país en el pasaporte", "d": "En la oficina de turismo de Vaduz te sellan el pasaporte como recuerdo, aunque no haga falta.", "k": "cultura", "cost": 5, "min": 0}, {"t": "Hacer senderismo por la ruta del Liechtenstein Weg", "d": "Un sendero que recorre los once municipios del país con vistas al Rin.", "k": "naturaleza", "cost": 0, "min": 0}, {"t": "Catar vino en las bodegas del Príncipe", "d": "La bodega real ofrece catas de pinot noir cultivado a los pies del castillo.", "k": "comida", "cost": 35, "min": 18}], "fest": [{"m": 7, "n": "Día Nacional", "d": "Fiesta en el castillo, discursos, fuegos artificiales sobre Vaduz y cerveza gratis."}, {"m": 2, "n": "Funkensonntag", "d": "Hogueras gigantes en cada pueblo para quemar el invierno."}], "honey": "El castillo de Vaduz y los Alpes de Malbun", "tour": 45, "sport": "esquí", "fifa": 3, "nb": ["ch", "at"]},
