    {"id": "pk", "n": "Pakistán", "dm": "paquistaní", "df": "paquistaní", "reg": "asia_sur", "lang": "urdu e inglés", "pop": 250000, "lat": 30.4, "lon": 69.3, "cap": "Islamabad", "cities": ["Islamabad", "Karachi", "Lahore", "Faisalabad", "Rawalpindi", "Peshawar"], "gdp": 7, "life": 67, "hap": 46, "safe": 30, "edu": 30, "unemp": 7, "gov": "republica", "lead_m": "Primer ministro", "lead_f": "Primera ministra", "crown_m": "Nawab", "crown_f": "Begum", "crown_reform": true, "ss": 1, "nm": "Muhammad,Ahmed,Ali,Hassan,Hussain,Usman,Bilal,Umar,Hamza,Abdullah,Imran,Asad,Faisal,Zain,Saad,Shahid,Tariq,Waqas,Ayaan,Rayyan", "nf": "Fatima,Ayesha,Maryam,Zainab,Khadija,Sana,Hira,Iqra,Mahnoor,Areeba,Anaya,Hania,Saba,Nadia,Rabia,Amna,Sidra,Bushra,Zoya,Alishba", "sn": "Khan,Ahmed,Ali,Hussain,Malik,Butt,Qureshi,Chaudhry,Shah,Sheikh,Raja,Awan,Mirza,Siddiqui,Abbasi,Baig,Javed,Iqbal,Rana,Bhatti", "odd_m": "", "odd_f": "", "odd_pct": 0, "rel": {"islam": 96, "hinduismo": 2, "evangelica": 1, "catolica": 1}, "skin": [2, 15, 35, 32, 14, 2], "blond": 1, "light_eyes": 5, "lgbt": 0, "sexwork": 0, "alcohol": 1, "weed": 1, "draft": 0, "draft_m": 0, "army": 70, "jobs": ["Tecnología", "Oficio", "Salud", "Negocios"], "food": ["Biryani", "Nihari", "Chai doodh patti"], "cl": "El críquet no es un deporte: es una religión que se juega en cualquier callejón.|Ninguna boda dura menos de tres días: mehndi, baraat y walima.|La tía del barrio ya tiene un rishta, un pretendiente, preparado para ti.|El chai con leche se toma a cualquier hora y con cualquier temperatura.|Los camiones van pintados como obras de arte, con espejitos, cadenas y poemas.|Lahore y Karachi discuten eternamente quién tiene la mejor comida.|Ninguna conversación está completa sin un 'inshallah'.", "cus": [{"t": "Volar cometas en Basant", "d": "Los tejados de Lahore se llenan de cometas amarillas, música y gritos de '¡bo kata!' cuando cortas la de otro.", "k": "fiesta", "cost": 5, "min": 0}, {"t": "Ver la ceremonia de la frontera de Wagah", "d": "Soldados con penachos levantan las piernas hasta la nariz en un duelo de desfile con India.", "k": "cultura", "cost": 0, "min": 0}, {"t": "Jugar críquet callejero", "d": "Un ladrillo como portería, una pelota de tenis con cinta y veinte primos jugando.", "k": "deporte", "cost": 0, "min": 0}, {"t": "Bailar en una noche de mehndi", "d": "Henna en las manos de la novia, tambores dhol y coreografías ensayadas por las primas.", "k": "fiesta", "cost": 30, "min": 0}, {"t": "Cenar en la Food Street de Lahore", "d": "Karahi, tikka y lassi frente a la mezquita Badshahi iluminada.", "k": "comida", "cost": 10, "min": 0}, {"t": "Ver polo en Shandur", "d": "Partidos de polo salvaje en el campo más alto del mundo.", "k": "deporte", "cost": 20, "min": 0}], "fest": [{"m": 1, "n": "Basant", "d": "Lahore se llena de cometas para recibir la primavera."}, {"m": 6, "n": "Festival de Polo de Shandur", "d": "Polo de montaña a más de 3.700 metros de altura."}], "honey": "El valle de Hunza, Lahore y la carretera del Karakórum", "tour": 30, "sport": "Críquet", "fifa": 12, "nb": ["ir", "af", "cn", "in"]},
    {"id": "in", "n": "India", "dm": "indio", "df": "india", "reg": "asia_sur", "lang": "hindi e inglés", "pop": 1460000, "lat": 22.0, "lon": 79.0, "cap": "Nueva Delhi", "cities": ["Nueva Delhi", "Bombay", "Bangalore", "Calcuta", "Chennai", "Hyderabad"], "gdp": 11, "life": 72, "hap": 44, "safe": 55, "edu": 50, "unemp": 6, "gov": "republica", "lead_m": "Primer ministro", "lead_f": "Primera ministra", "crown_m": "Maharajá", "crown_f": "Maharaní", "crown_reform": true, "ss": 1, "nm": "Ram,Mohammed,Aarav,Vihaan,Arjun,Rahul,Amit,Rajesh,Suresh,Ramesh,Sanjay,Vijay,Anil,Sunil,Deepak,Rohan,Aditya,Krishna,Vivaan,Ishaan", "nf": "Priya,Anjali,Sunita,Pooja,Neha,Kavita,Lakshmi,Sita,Anita,Rekha,Deepika,Divya,Shreya,Ananya,Aadhya,Saanvi,Diya,Kiara,Meera,Fatima", "sn": "Kumar,Singh,Sharma,Patel,Devi,Yadav,Gupta,Das,Reddy,Khan,Verma,Shah,Jain,Mishra,Iyer,Nair,Rao,Chauhan,Mehta,Banerjee", "odd_m": "Bunty,Pappu,Chintu,Bablu,Montu,Golu", "odd_f": "Pinky,Sweety,Dolly,Bubbly,Twinkle,Rinky", "odd_pct": 5, "rel": {"hinduismo": 79, "islam": 15, "catolica": 1, "evangelica": 1, "sij": 2, "budismo": 1, "tradicional": 1}, "skin": [1, 7, 25, 35, 25, 7], "blond": 1, "light_eyes": 3, "lgbt": 1, "sexwork": 1, "alcohol": 2, "weed": 1, "draft": 0, "draft_m": 0, "army": 85, "jobs": ["Tecnología", "Ciencia", "Salud", "Espectáculo"], "food": ["Biryani", "Masala chai", "Butter chicken"], "cl": "Las tías del barrio tienen un pretendiente perfecto para ti y su biodata en el móvil.|Una boda india tiene más invitados que algunos pueblos y dura una semana.|Un India contra Pakistán de críquet paraliza a mil millones de personas.|Los camiones llevan escrito 'Horn OK Please' y la gente cumple con entusiasmo.|En 'hora india', la fiesta de las ocho empieza a las diez.|Toda madre india cree que la cúrcuma con leche cura cualquier cosa.|En Bollywood cualquier problema se resuelve con un número musical.|El jugaad convierte cualquier avería en un arreglo ingenioso con cinta y alambre.", "cus": [{"t": "Lanzar polvos de colores en Holi", "d": "Acabas teñido de rosa, verde y amarillo, empapado y con un vaso de lassi en la mano.", "k": "fiesta", "cost": 5, "min": 0}, {"t": "Jugar críquet callejero", "d": "Partido improvisado en un callejón donde la ventana del vecino es la frontera.", "k": "deporte", "cost": 0, "min": 0}, {"t": "Bañarse en el Ganges en Benarés", "d": "Al amanecer, entre peregrinos, flores flotantes y cánticos del aarti.", "k": "ritual", "cost": 0, "min": 0}, {"t": "Ir a una cita arreglada por las tías", "d": "Las familias negocian mientras tú intentas charlar con tu posible pareja entre samosas.", "k": "ritual", "cost": 0, "min": 0}, {"t": "Dormir en una casa flotante en Kerala", "d": "Navegar por los backwaters entre cocoteros con curry de pescado a bordo.", "k": "naturaleza", "cost": 120, "min": 0}, {"t": "Bailar en una boda de cinco días", "d": "Sangeet, haldi, mehndi y un novio que llega montado a caballo con banda de música.", "k": "fiesta", "cost": 50, "min": 0}], "fest": [{"m": 2, "n": "Holi", "d": "Todo el país se lanza polvos de colores para celebrar la primavera."}, {"m": 8, "n": "Ganesh Chaturthi", "d": "Bombay saca a la calle estatuas gigantes del dios elefante."}, {"m": 9, "n": "Diwali", "d": "Festival de las luces con lámparas, dulces y petardos."}], "honey": "El Taj Mahal, los palacios de Rajastán y los canales de Kerala", "tour": 85, "sport": "Críquet", "fifa": 22, "nb": ["pk", "cn", "np", "bt", "bd", "mm", "lk", "mv"]},
    {"id": "bd", "n": "Bangladés", "dm": "bangladesí", "df": "bangladesí", "reg": "asia_sur", "lang": "bengalí", "pop": 175000, "lat": 23.7, "lon": 90.4, "cap": "Daca", "cities": ["Daca", "Chittagong", "Khulna", "Rajshahi", "Sylhet"], "gdp": 9, "life": 74, "hap": 38, "safe": 45, "edu": 35, "unemp": 5, "gov": "republica", "lead_m": "Primer ministro", "lead_f": "Primera ministra", "crown_m": "Nawab", "crown_f": "Begum", "crown_reform": true, "ss": 1, "nm": "Mohammad,Rahim,Karim,Hasan,Hossain,Kamal,Jamal,Rafiq,Shafiq,Anwar,Habib,Arif,Sakib,Tanvir,Tamim,Rakib,Sabbir,Shanto,Ayaan,Rafi", "nf": "Fatema,Ayesha,Nasrin,Shirin,Rahima,Salma,Taslima,Sumaiya,Nusrat,Farhana,Sharmin,Jannat,Tasnim,Lamia,Mim,Ruma,Shapla,Puja,Anika,Tahmina", "sn": "Ahmed,Hossain,Rahman,Islam,Uddin,Akter,Begum,Khatun,Chowdhury,Sarkar,Mia,Haque,Alam,Khan,Das,Roy,Mollah,Sheikh,Biswas,Talukdar", "odd_m": "", "odd_f": "", "odd_pct": 0, "rel": {"islam": 91, "hinduismo": 8, "budismo": 1}, "skin": [0, 4, 20, 40, 30, 6], "blond": 0, "light_eyes": 1, "lgbt": 0, "sexwork": 1, "alcohol": 1, "weed": 0, "draft": 0, "draft_m": 0, "army": 30, "jobs": ["Moda", "Oficio", "Servicio"], "food": ["Ilish con mostaza", "Kacchi biryani", "Pitha"], "cl": "El pescado ilish es tan sagrado que se discute qué río da el más sabroso.|Los rickshaws pintados forman el atasco más colorido del planeta.|El críquet hace que hasta las abuelas griten frente a la tele.|Todo bangladesí tiene una opinión firme sobre la mejor kacchi biryani de Daca.|La lluvia del monzón no detiene a nadie: te arremangas el pantalón y sigues.|Las tías saben de qué familia eres con solo verte la cara.|Pohela Boishakh se celebra vestido de rojo y blanco comiendo panta-ilish.", "cus": [{"t": "Celebrar Pohela Boishakh", "d": "Desfile de máscaras gigantes, ropa roja y blanca y arroz fermentado con ilish para desayunar.", "k": "fiesta", "cost": 5, "min": 0}, {"t": "Pasear en rickshaw por el viejo Daca", "d": "Callejones imposibles, campanillas y un conductor que adela