    {"id": "bb", "n": "Barbados", "dm": "barbadense", "df": "barbadense", "reg": "caribe", "lang": "inglés", "pop": 282, "lat": 13.2, "lon": -59.5, "cap": "Bridgetown", "cities": ["Bridgetown", "Speightstown", "Oistins", "Holetown"], "gdp": 20, "life": 78, "hap": 62, "safe": 70, "edu": 60, "unemp": 7, "gov": "republica", "lead_m": "Primer ministro", "lead_f": "Primera ministra", "crown_m": "Rey", "crown_f": "Reina", "crown_reform": true, "ss": 1, "nm": "David,Michael,Mark,Andrew,Christopher,Ryan,Anthony,Kevin,Jason,Shane,Dwayne,Richard,Peter,Adrian,Damien,Jabari,Joshua,Isaiah,Elijah,Nathan", "nf": "Sandra,Patricia,Michelle,Nicole,Lisa,Andrea,Karen,Sharon,Deborah,Natalie,Kimberly,Danielle,Robyn,Tia,Amanda,Jessica,Ashley,Gabrielle,Kayla,Aaliyah", "sn": "Clarke,Alleyne,Griffith,Brathwaite,Best,Harewood,King,Phillips,Gittens,Holder,Jordan,Payne,Forde,Cumberbatch,Blackman,Small,Greenidge,Inniss,Thompson,Williams", "odd_m": "Shamar,Kemar,Akeem,Ramone,Jahmal", "odd_f": "Shanice,Kerri-Ann,Shanika,Tiffany-Ann,Rhianna", "odd_pct": 7, "rel": {"evangelica": 68, "catolica": 4, "ninguna": 21, "espiritual": 6, "islam": 1}, "skin": [3, 3, 4, 10, 30, 50], "blond": 1, "light_eyes": 2, "lgbt": 1, "sexwork": 0, "alcohol": 2, "weed": 1, "draft": 0, "draft_m": 0, "army": 2, "jobs": ["Servicio", "Negocios", "Educación"], "food": ["Cou-cou con pez volador", "Macaroni pie", "Ron de Barbados"], "cl": "El críquet no es un deporte: es una religión con merienda incluida.|Siempre hay un rum shop a menos de cien pasos, y en cada uno alguien arreglando el mundo.|Mencionas a Rihanna en cada conversación con extranjeros, sin falta.|El domingo se va a la iglesia con sombrero y después a la playa con el macaroni pie.|Saludar con un 'Wuh gine on?' es obligatorio, aunque vayas con prisa.|Te ofendes si alguien insinúa que el ron no se inventó aquí.", "cus": [{"t": "Pasar la tarde en un rum shop", "d": "Juega dominó y discute de críquet con un vaso de ron en la mano.", "k": "fiesta", "cost": 15, "min": 18}, {"t": "Bailar en el Grand Kadooment", "d": "Desfila con plumas y lentejuelas en el cierre del Crop Over.", "k": "fiesta", "cost": 150, "min": 0}, {"t": "Ir al Oistins Fish Fry", "d": "Cada viernes el pueblo pesquero se llena de pescado frito, música y baile.", "k": "comida", "cost": 20, "min": 0}, {"t": "Ver críquet en el Kensington Oval", "d": "Anima a las Indias Occidentales con trompetas y caracolas en la grada.", "k": "deporte", "cost": 20, "min": 0}, {"t": "Nadar con tortugas en Carlisle Bay", "d": "Bucea entre tortugas marinas y barcos hundidos a pocos metros de la orilla.", "k": "naturaleza", "cost": 60, "min": 0}], "fest": [{"m": 7, "n": "Crop Over", "d": "La fiesta de la zafra termina en agosto con el gran desfile del Grand Kadooment."}, {"m": 10, "n": "Día de la Independencia", "d": "El 30 de noviembre todo se viste de azul y oro, y desde 2021 también se celebra la república."}], "honey": "Las playas de la Costa de Platino", "tour": 78, "sport": "Críquet", "fifa": 5, "nb": ["lc", "vc"]},
    {"id": "tt", "n": "Trinidad y Tobago", "dm": "trinitense", "df": "trinitense", "reg": "caribe", "lang": "inglés", "pop": 1510, "lat": 10.5, "lon": -61.3, "cap": "Puerto España", "cities": ["Puerto España", "San Fernando", "Chaguanas", "Arima", "Scarborough"], "gdp": 30, "life": 74, "hap": 62, "safe": 40, "edu": 55, "unemp": 5, "gov": "republica", "lead_m": "Primer ministro", "lead_f": "Primera ministra", "crown_m": "Rey", "crown_f": "Reina", "crown_reform": true, "ss": 1, "nm": "Ryan,Kevin,Anil,Ravi,Michael,Christopher,Jason,Marlon,Sean,Anthony,Rajesh,Vishnu,Ricardo,Darren,Dwayne,Brian,Joshua,Isaiah,Jaden,Aiden", "nf": "Sharon,Anita,Nicole,Lisa,Michelle,Kavita,Sunita,Natalie,Kimberly,Melissa,Shivani,Priya,Stacy-Ann,Candice,Karen,Alicia,Gabrielle,Arianna,Kayla,Aaliyah", "sn": "Mohammed,Ali,Williams,Charles,Joseph,Baptiste,Ramnarine,Maharaj,Persad,Singh,John,Thomas,Phillip,Roberts,Rampersad,Khan,George,James,Lewis,Hosein", "odd_m": "Kerwin,Kerron,Akeem,Shaquille,Kheston,Jerlon", "odd_f": "Kerisha,Shenelle,Keisha,Shernelle,Kizzy", "odd_pct": 8, "rel": {"catolica": 21, "evangelica": 38, "hinduismo": 18, "islam": 5, "espiritual": 9, "tradicional": 1, "ninguna": 8}, "skin": [2, 6, 18, 32, 22, 20], "blond": 0, "light_eyes": 2, "lgbt": 0, "sexwork": 0, "alcohol": 2, "weed": 1, "draft": 0, "draft_m": 0, "army": 4, "jobs": ["Negocios", "Oficio", "Espectáculo", "Ciencia"], "food": ["Doubles", "Roti con curry", "Pelau"], "cl": "Para ti el año se divide en dos: Carnaval y la espera hasta el siguiente Carnaval.|Un 'lime' es cualquier reunión sin plan que puede durar seis horas.|Desayunas doubles en la calle y discutes qué vendedor tiene el mejor picante.|Hay una canción de soca para cada emoción humana, y las cantas a todo pulmón.|Si preguntas en Tobago, te dirán que la isla bonita es la suya, sin discusión.|Todo se arregla con un 'doh worry', aunque el problema siga ahí.|El tráfico de Puerto España es tan legendario que se planifica la vida a su alrededor.", "cus": [{"t": "Embarrarte en el J'ouvert", "d": "Al amanecer del lunes de Carnaval la gente baila cubierta de pintura, barro y chocolate.", "k": "fiesta", "cost": 60, "min": 0}, {"t": "Desfilar con una banda de mas", "d": "Ponte un traje de plumas y lentejuelas y cruza el escenario de la Savannah.", "k": "fiesta", "cost": 800, "min": 0}, {"t": "Comer doubles de madrugada", "d": "Dos panes fritos con garbanzos al curry, 'slight pepper' por favor.", "k": "comida", "cost": 2, "min": 0}, {"t": "Lanzar polvo de colores en Phagwa", "d": "Celebra la primavera hindú cubriéndote de abir y cantando chowtal.", "k": "ritual", "cost": 5, "min": 0}, {"t": "Ver desovar tortugas laúd en Matura", "d": "De marzo a agosto las tortugas más grandes del mundo llegan a la playa.", "k": "naturaleza", "cost": 20, "min": 0}, {"t": "Bailar 'wining' en una fiesta de soca", "d": "Mueve la cintura sin descanso en una fête previa al Carnaval.", "k": "picante", "cost": 40, "min": 18}], "fest": [{"m": 1, "n": "Carnaval de Trinidad", "d": "Lunes y martes de Carnaval, con J'ouvert, steelbands y bandas de mas cubiertas de plumas."}, {"m": 10, "n": "Divali", "d": "Las comunidades hindúes iluminan casas y templos con miles de lamparitas de barro."}, {"m": 2, "n": "Phagwa", "d": "La fiesta hindú de primavera llena la isla de polvo rojo y canciones."}], "honey": "Tobago: Pigeon Point y Englishman's Bay", "tour": 60, "sport": "Críquet", "fifa": 28, "nb": ["ve", "gd"]},
    {"id": "lc", "n": "Santa Lucía", "dm": "santalucense", "df": "santalucense", "reg": "caribe", "lang": "inglés y kwéyòl", "pop": 180, "lat": 13.9, "lon": -61.0, "cap": "Castries", "cities": ["Castries", "Gros Islet", "Vieux Fort", "Soufrière"], "gdp": 24, "life": 73, "hap": 60, "safe": 55, "edu": 48, "unemp": 13, "gov": "monarquia_const", "lead_m": "Primer ministro", "lead_f": "Primera ministra", "crown_m": "Rey", "crown_f": "Reina", "crown_reform": false, "ss": 1, "nm": "Kevin,Michael,Mark,Andy,Ryan,Jason,Kenny,Peter,Christopher,Anthony,Darren,Joseph,Paul,Brian,Dominic,Jaden,Jaheim,Elijah,Josiah,Joshua", "nf": "Mary,Anne,Margaret,Theresa,Agnes,Cecilia,Natasha,Nicole,Diana,Kerry,Lisa,Michelle,Sandra,Shania,Kimberly,Jada,Aaliyah,Arianna,Kayla,Gabriella", "sn": "Joseph,Charles,Augustin,Louis,Edmund,Alexander,Felix,Emmanuel,Francis,Paul,Jn Baptiste,St. Rose,Mathurin,Hippolyte,Henry,Pierre,Lubin,Anthony,George,Prospere", "odd_m": "Shem,Kurt,Kervin,Lyndon,Jahvel", "odd_f": "Sherma,Kerlin,Shernelle,Kizzie,Shaneka", "odd_pct": 7, "rel": {"catolica": 61, "evangelica": 27, "espiritual": 5, "ninguna": 7}, "skin": [1, 2, 5, 17, 35, 40], "blond": 0, "light_eyes": 2, "lgbt": 1, "sexwork": 0, "alcohol": 2, "weed": 1, "draft": 0, "draft_m": 0, "army": 1, "jobs": ["Servicio", "Negocios", "Oficio"], "food": ["Plátano verde con bacalao", "Bouyon", "Cacao tea"], "cl": "Los 'higos verdes' del plato nacional son en realidad plátanos verdes, y nadie te lo explica.|Hablas inglés en la oficina y kwéyòl en casa, y a veces los dos en la misma frase.|El viernes por la noche media isla termina en el jump-up de Gros Islet.|Presumes de que el país tiene dos premios Nobel con menos habitantes que un barrio grande.|Los Pitons salen en todas tus fotos, incluso en las que no querías.|Cuando alguien dice 'just now', puede ser en un minuto o por la tarde.", "cus": [{"t": "Ir al Friday Night Jump-Up", "d": "Las calles de Gros Islet se llenan de pescado a la parrilla, altavoces y baile.", "k": "picante", "cost": 20, "min": 18}, {"t": "Bañarte en el volcán de Sulphur Springs", "d": "Úntate de barro volcánico en el único volcán 'drive-in' del Caribe.", "k": "naturaleza", "cost": 15, "min": 0}, {"t": "Subir al Gros Piton", "d": "Escala el pico más famoso de la isla y mira el mar desde arriba.", "k": "naturaleza", "cost": 60, "min": 0}, {"t": "Hacer tu propio chocolate en Soufrière", "d": "En una plantación de cacao tuestas y moldeas tu tableta.", "k": "comida", "cost": 50, "min": 0}, {"t": "Celebrar La Woz con las sociedades de flores", "d": "Únete a la rivalidad centenaria entre la Rosa y la Margarita con trajes y cantos.", "k": "cultura", "cost": 0, "min": 0}], "fest": [{"m": 6, "n": "Carnaval de Santa Lucía", "d": "En julio las bandas de mas y la soca toman Castries."}, {"m": 4, "n": "Saint Lucia Jazz & Arts Festival", "d": "En mayo hay música en vivo frente al mar por toda la isla."}, {"m": 7, "n": "La Woz", "d": "La sociedad de la Rosa celebra el 30 de agosto con trajes y canciones en kwéyòl."}], "honey": "Soufrière y los Pitons", "tour": 82, "sport": "Críquet", "fifa": 4, "nb": ["vc", "bb"]},
    {"id": "vc", "n": "San Vicente y las Granadinas", "dm": "sanvicentino", "df": "sanvicentina", "reg": "caribe", "lang": "inglés", "pop": 101, "lat": 13.2, "lon": -61.2, "cap": "Kingstown", "cities": ["Kingstown", "Georgetown", "Barrouallie", "Port Elizabeth"], "gdp": 20, "life": 72, "hap": 59, "safe": 58, "edu": 45, "unemp": 17, "gov": "monarquia_const", "lead_m": "Primer ministro", "lead_f": "Primera ministra", "crown_m": "Rey", "crown_f": "Reina", "crown_reform": false, "ss": 1, "nm": "Kevin,Michael,Mark,Andre,Jason,Ryan,Anthony,Dwight,Ralph,Peter,Junior,Jomo,Shawn,Kenneth,Daniel,Oral,Elijah,Jaden,Joshua,Isaiah", "nf": "Sandra,Joan,Patricia,Jennifer,Michelle,Nicole,Lisa,Natasha,Shelly,Karen,Andrea,Monique,Camille,Simone,Tamara,Kayla,Jada,Arianna,Gabrielle,Destiny", "sn": "Williams,John,Browne,Charles,Jack,Samuel,James,Richards,Gonsalves,DaSilva,Ollivierre,Ballantyne,Cupid,Hazell,Joseph,King,Baptiste,Cato,Providence,Haynes", "odd_m": "Glenroy,Kenroy,Delroy,Kemoy,Shamal", "odd_f": "Kenisha,Shonelle,Kerisha,Shermaine,Latisha", "odd_pct": 7, "rel": {"evangelica": 75, "catolica": 6, "ninguna": 10, "espiritual": 7, "hinduismo": 1, "islam": 1}, "skin": [2, 4, 8, 20, 32, 34], "blond": 1, "light_eyes": 3, "lgbt": 0, "sexwork": 0, "alcohol": 2, "weed": 1, "draft": 0, "draft_m": 0, "army": 1, "jobs": ["Servicio", "Oficio", "Negocios"], "food": ["Fruta de pan asada con jackfish", "Sopa callaloo", "Ron Sunset"], "cl": "La fruta de pan asada con pescado frito es plato nacional y la defiendes con pasión.|Las 'vans' de pasajeros llevan nombre propio, luces de colores y soca a todo volumen.|Dices que eres de 'Vincy' y alguien te pregunta enseguida por el Vincy Mas.|Las Granadinas son tu patio de recreo y conoces a alguien en cada isla.|El ron local es tan fuerte que tu tío lo usa para brindar y para curar catarros.|Cuando La Soufrière ruge, todo el mundo se vuelve experto en volcanes.", "cus": [{"t": "Navegar hasta los Tobago Cays", "d": "Recorre las Granadinas en velero y nada con tortugas en aguas turquesa.", "k": "naturaleza", "cost": 120, "min": 0}, {"t": "Salir en las Nine Mornings", "d": "Nueve madrugadas antes de Navidad la gente sale a la calle a cantar, bailar y bañarse en el mar.", "k": "ritual", "cost": 0, "min": 0}, {"t": "Bailar en el J'ouvert del Vincy Mas", "d": "Recibe el amanecer cubierto de pintura al ritmo de la soca.", "k": "fiesta", "cost": 30, "min": 0}, {"t": "Subir al volcán La Soufrière", "d": "Camina por la selva hasta el borde del cráter activo.", "k": "naturaleza", "cost": 30, "min": 0}, {"t": "Comprar un barquito artesanal en Bequia", "d": "Los artesanos de Bequia tallan maquetas de barcos con siglos de tradición marinera.", "k": "cultura", "cost": 80, "min": 0}], "fest": [{"m": 6, "n": "Vincy Mas", "d": "El carnaval vincentino de finales de junio y julio, con calipso, soca y J'ouvert."}, {"m": 11, "n": "Nine Mornings", "d": "Del 16 al 24 de diciembre la isla madruga para celebrar con música y baños de mar."}], "honey": "Los Tobago Cays y Mustique", "tour": 72, "sport": "Críquet", "fifa": 5, "nb": ["lc", "gd", "bb"]},
    {"id": "gd", "n": "Granada", "dm": "granadino", "df": "granadina", "reg": "caribe", "lang": "inglés", "pop": 117, "lat": 12.1, "lon": -61.7, "cap": "Saint George's", "cities": ["Saint George's", "Gouyave", "Grenville", "Hillsborough"], "gdp": 22, "life": 75, "hap": 60, "safe": 70, "edu": 50, "unemp": 13, "gov": "monarquia_const", "lead_m": "Primer ministro", "lead_f": "Primera ministra", "crown_m": "Rey", "crown_f": "Reina", "crown_reform": false, "ss": 1, "nm": "Kevin,Michael,Mark,Anthony,Andre,Jason,Ryan,Brian,Keith,Dexter,Shawn,Christopher,Daniel,Peter,Joseph,Patrick,Joshua,Elijah,Jaden,Isaiah", "nf": "Sandra,Patricia,Jennifer,Michelle,Nicole,Lisa,Natalie,Karen,Simone,Angela,Andrea,Gail,Monique,Kimberly,Danielle,Kayla,Jada,Aaliyah,Gabrielle,Zoe", "sn": "Charles,Joseph,Thomas,John,Mitchell,Williams,Alexander,Bishop,Francis,Phillip,James,Noel,Hosten,Baptiste,Paul,Peters,George,Belfon,Antoine,McQueen", "odd_m": "Kirani,Kemron,Shaquille,Kervin,Delroy", "odd_f": "Shaniqua,Kerisha,Tishanna,Sherry-Ann,Kizzy", "odd_pct": 6, "rel": {"catolica": 36, "evangelica": 50, "ninguna": 6, "espiritual": 7, "tradicional": 1}, "skin": [1, 2, 5, 17, 35, 40], "blond": 0, "light_eyes": 2, "lgbt": 0, "sexwork": 0, "alcohol": 2, "weed": 1, "draft": 0, "draft_m": 0, "army": 1, "jobs": ["Servicio", "Educación", "Salud"], "food": ["Oil down", "Callaloo", "Helado de nuez moscada"], "cl": "Le pones nuez moscada a todo: al ponche, al helado y casi a la conversación.|Un 'oil down' en la playa no es una comida, es un evento social de cinco horas.|En Spicemas te untan de aceite negro y luego te abrazan con todo el cariño.|Llamas a tu país 'la isla de las especias' y lo dices oliendo a canela.|Nadie tiene prisa: 'just now' puede ser dentro de tres horas.|Todo niño corre los 400 metros soñando con ser el próximo Kirani James.", "cus": [{"t": "Ser 'jab jab' en Spicemas", "d": "Úntate de aceite negro, ponte cuernos y baila con cadenas en el J'ouvert.", "k": "fiesta", "cost": 10, "min": 0}, {"t": "Bucear en el parque de esculturas submarinas", "d": "En Moliniere nadas entre estatuas cubiertas de coral.", "k": "naturaleza", "cost": 70, "min": 0}, {"t": "Cocinar un oil down", "d": "Fruta de pan, pescado salado y leche de coco en una olla gigante a la orilla del mar.", "k": "comida", "cost": 25, "min": 0}, {"t": "Ir al Fish Friday de Gouyave", "d": "El pueblo pesquero se llena cada viernes de pescado a la brasa y música.", "k": "comida", "cost": 15, "min": 0}, {"t": "Probar el ron de River Antoine", "d": "Visita la destilería más antigua del Caribe que aún funciona con rueda de agua.", "k": "comida", "cost": 10, "min": 18}], "fest": [{"m": 7, "n": "Spicemas", "d": "El carnaval de agosto, con jab jabs pintados de negro, steelbands y soca."}, {"m": 3, "n": "Carriacou Maroon & String Band Festival", "d": "En abril Carriacou celebra con música de cuerda, tambores y comida tradicional."}], "honey": "Grand Anse y la isla de Carriacou", "tour": 70, "sport": "Críquet", "fifa": 7, "nb": ["vc", "tt"]},
    {"id": "ag", "n": "Antigua y Barbuda", "dm": "antiguano", "df": "antiguana", "reg": "caribe", "lang": "inglés", "pop": 94, "lat": 17.1, "lon": -61.8, "cap": "Saint John's", "cities": ["Saint John's", "All Saints", "Liberta", "English Harbour"], "gdp": 30, "life": 78, "hap": 61, "safe": 68, "edu": 50, "unemp": 8, "gov": "monarquia_const", "lead_m": "Primer ministro", "lead_f": "Primera ministra", "crown_m": "Rey", "crown_f": "Reina", "crown_reform": false, "ss": 1, "nm": "Michael,Mark,Kevin,Andre,Anthony,Richard,Christopher,Jason,Ryan,Dwayne,Brian,Gaston,Kelvin,Peter,Daniel,Joshua,Elijah,Isaiah,Jayden,Nathan", "nf": "Sandra,Patricia,Jennifer,Michelle,Nicole,Lisa,Natalie,Karen,Sharon,Joan,Andrea,Monique,Tamara,Kimberly,Danielle,Kayla,Jada,Aaliyah,Gabrielle,Zara", "sn": "Joseph,Thomas,Henry,Francis,Samuel,Benjamin,Richards,Roberts,Christian,Simon,Edwards,Williams,Charles,Martin,Jarvis,Lewis,James,Bird,Walter,Jacobs", "odd_m": "Curtly,Shabazz,Shaquille,Kemoy,Javan", "odd_f": "Shermaine,Keisha,Latoya,Tishaun,Kenisha", "odd_pct": 6, "rel": {"evangelica": 78, "catolica": 8, "espiritual": 8, "ninguna": 6}, "skin": [1, 2, 4, 13, 35, 45], "blond": 0, "light_eyes": 1, "lgbt": 1, "sexwork": 1, "alcohol": 2, "weed": 1, "draft": 0, "draft_m": 0, "army": 1, "jobs": ["Servicio", "Negocios", "Deporte"], "food": ["Fungie con pepperpot", "Ducana con pescado salado", "Piña negra de Antigua"], "cl": "Presumes de tener 365 playas, una para cada día del año, y aun así vas siempre a la misma.|El críquet es sagrado y Viv Richards es casi un santo nacional.|Los domingos se pasan en Shirley Heights con steelband, ponche de ron y puesta de sol.|La piña negra antiguana es la más dulce del mundo, y no aceptas discusión.|En English Harbour un yate más grande que tu casa se considera mediano.|Barbuda tiene más fragatas que habitantes, y los barbudenses lo cuentan con orgullo.", "cus": [{"t": "Ir a la fiesta de Shirley Heights", "d": "Cada domingo, steelband, reggae y ponche de ron con vistas a English Harbour.", "k": "fiesta", "cost": 20, "min": 18}, {"t": "Navegar en la Antigua Sailing Week", "d": "Únete como tripulante a una de las regatas más famosas del Caribe.", "k": "deporte", "cost": 300, "min": 0}, {"t": "Probar una playa distinta cada día", "d": "Empieza el reto de las 365 playas y apunta tus favoritas.", "k": "naturaleza", "cost": 0, "min": 0}, {"t": "Nadar con rayas en Stingray City", "d": "Acaricia mantarrayas en aguas poco profundas.", "k": "naturaleza", "cost": 80, "min": 0}, {"t": "Ver las fragatas de Barbuda", "d": "Visita la mayor colonia de fragatas del Caribe en Codrington Lagoon.", "k": "naturaleza", "cost": 100, "min": 0}], "fest": [{"m": 7, "n": "Carnaval de Antigua", "d": "De finales de julio al primer martes de agosto, con J'ouvert, calipso y bandas de mas."}, {"m": 3, "n": "Antigua Sailing Week", "d": "Regatas, fiestas en el puerto y cientos de velas en English Harbour."}], "honey": "Las 365 playas y English Harbour", "tour": 78, "sport": "Críquet", "fifa": 6, "nb": ["kn"]},
    {"id": "dm", "n": "Dominica", "dm": "dominiqués", "df": "dominiquesa", "reg": "caribe", "lang": "inglés y kwéyòl", "pop": 67, "lat": 15.4, "lon": -61.4, "cap": "Roseau", "cities": ["Roseau", "Portsmouth", "Marigot", "Mahaut"], "gdp": 17, "life": 73, "hap": 60, "safe": 70, "edu": 45, "unemp": 10, "gov": "republica", "lead_m": "Primer ministro", "lead_f": "Primera ministra", "crown_m": "Jefe kalinago", "crown_f": "Jefa kalinago", "crown_reform": true, "ss": 1, "nm": "Kevin,Michael,Mark,Peter,Joseph,Anthony,Jason,Brian,Ian,Gregory,Ryan,Andre,Shawn,Daniel,Jaden,Joshua,Elijah,Paul,Francis,Clement", "nf": "Mary,Anne,Theresa,Marie,Cecilia,Agnes,Natasha,Nicole,Sandra,Michelle,Jennifer,Lisa,Karen,Josephine,Simone,Kayla,Jada,Aaliyah,Arianna,Gabriella", "sn": "Joseph,Charles,Thomas,John,Laurent,Bruney,Christian,George,Francis,Pierre,Paul,Toussaint,Peltier,Lewis,Jno Baptiste,Henderson,Shillingford,Benjamin,Felix,Daniel", "odd_m": "Roosevelt,Kervin,Shemron,Akim,Lennox", "odd_f": "Kerlyn,Sherma,Kenisha,Shermaine,Kizzy", "odd_pct": 6, "rel": {"catolica": 60, "evangelica": 28, "espiritual": 4, "ninguna": 7, "tradicional": 1}, "skin": [1, 2, 6, 21, 35, 35], "blond": 0, "light_eyes": 2, "lgbt": 1, "sexwork": 0, "alcohol": 2, "weed": 1, "draft": 0, "draft_m": 0, "army": 1, "jobs": ["Servicio", "Oficio", "Negocios"], "food": ["Sopa callaloo", "Bakes con bacalao", "Salsa picante de papaya"], "cl": "Pasas media vida aclarando: 'Es Dominica, no República Dominicana'.|Presumes de tener 365 ríos, uno para cada día, y lo dices sin pestañear.|Caminar tres horas por la selva hasta un lago hirviendo es un plan normal de domingo.|Siempre hay un vecino centenario contándote historias: aquí la gente vive mucho.|Sin lluvia no hay Dominica, y el paraguas es parte del uniforme.|En el World Creole Music Festival hasta las abuelas bailan bouyon.", "cus": [{"t": "Caminar hasta el Lago Hirviente", "d": "Atraviesa el Valle de la Desolación hasta un lago que burbujea a 90 grados.", "k": "naturaleza", "