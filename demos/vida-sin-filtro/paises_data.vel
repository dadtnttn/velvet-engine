somalí", "d": "Una tarde de té donde cada uno improvisa versos; el que mejor rima gana respeto para años.", "k": "cultura", "cost": 0, "min": 0}, {"t": "Ver el Istunka de Afgooye", "d": "Lucha ritual con palos entre barrios para celebrar el año nuevo, con mucha danza y bravuconería.", "k": "fiesta", "cost": 0, "min": 0}, {"t": "Beber leche de camella fresca", "d": "En el mercado de camellos te la sirven recién ordeñada, espumosa y algo salada.", "k": "comida", "cost": 2, "min": 0}, {"t": "Ver las pinturas de Laas Geel", "d": "Pinturas rupestres de vacas y pastores de miles de años, con colores aún vivos.", "k": "cultura", "cost": 25, "min": 0}], "fest": [{"m": 6, "n": "Día de la Independencia", "d": "El 1 de julio se celebra la unión de 1960 con banderas azules por todas partes."}, {"m": 6, "n": "Dab Shid", "d": "El año nuevo somalí tradicional se celebra saltando hogueras."}], "honey": "La playa de Lido en Mogadiscio y las pinturas rupestres de Laas Geel", "tour": 5, "sport": "fútbol", "fifa": 4, "nb": ["dj", "et", "ke"]},
