termina con 're'.", "cus": [{"t": "Pedir un meze completo", "d": "Una cena de veinte o treinta platillos pequeños que salen uno tras otro durante horas.", "k": "comida", "cost": 35, "min": 0}, {"t": "Jugar al tavli en el kafeneio", "d": "Partidas de backgammon a toda velocidad con los abuelos del café del pueblo.", "k": "cultura", "cost": 5, "min": 0}, {"t": "Mojarse en el Kataklysmos", "d": "La fiesta del diluvio en Pentecostés: concursos de poesía y guerras de agua en el paseo marítimo.", "k": "fiesta", "cost": 0, "min": 0}, {"t": "Brindar en el Festival del Vino de Limasol", "d": "Vino gratis de las bodegas locales, bailes tradicionales y música hasta tarde.", "k": "comida", "cost": 10, "min": 18}, {"t": "Salir de fiesta en Ayia Napa", "d": "Las discotecas y bares del sureste son la meca de la noche mediterránea.", "k": "picante", "cost": 60, "min": 18}, {"t": "Bañarse en la roca de Afrodita", "d": "Dicen que nadar alrededor de la roca donde nació la diosa te da juventud eterna.", "k": "naturaleza", "cost": 0, "min": 0}], "fest": [{"m": 5, "n": "Kataklysmos", "d": "Fiesta del agua en Pentecostés con música y competiciones en la costa."}, {"m": 8, "n": "Festival del Vino de Limasol", "d": "Diez días de catas gratuitas y bailes folclóricos."}], "honey": "Pafos, la roca de Afrodita y los pueblos de Troodos", "tour": 72, "sport": "fútbol", "fifa": 15, "nb": ["tr", "gr", "lb", "sy"]},
