    {"id": "mz", "n": "Mozambique", "dm": "mozambiqueño", "df": "mozambiqueña", "reg": "africa_sur", "lang": "portugués y macua", "pop": 35600, "lat": -17.3, "lon": 35.5, "cap": "Maputo", "cities": ["Maputo", "Matola", "Beira", "Nampula", "Quelimane", "Tete"], "gdp": 2, "life": 63, "hap": 52, "safe": 35, "edu": 22, "unemp": 4, "gov": "republica", "lead_m": "Presidente", "lead_f": "Presidenta", "crown_m": "Mwenemutapa", "crown_f": "Reina", "crown_reform": true, "ss": 1, "nm": "João,José,António,Manuel,Carlos,Fernando,Paulo,Armando,Alberto,Francisco,Pedro,Samuel,Celso,Edson,Hélio,Nelson,Felisberto,Américo,Lourenço,Ernesto", "nf": "Maria,Ana,Joana,Rosa,Celeste,Graça,Esperança,Felismina,Isabel,Teresa,Luísa,Alice,Marta,Cláudia,Sónia,Lurdes,Amélia,Fátima,Carla,Arlete", "sn": "Cossa,Macuácua,Sitoe,Nhantumbo,Langa,Tembe,Mabunda,Manjate,Muianga,Matsinhe,Chauque,Massingue,Mondlane,Bila,Cumbe,Machava,Mussa,Ussene,dos Santos,Fernandes", "odd_m": "", "odd_f": "", "odd_pct": 2, "rel": {"catolica": 27, "evangelica": 33, "islam": 19, "tradicional": 7, "ninguna": 14}, "skin": [0, 1, 3, 12, 44, 40], "blond": 0, "light_eyes": 0, "lgbt": 1, "sexwork": 1, "alcohol": 2, "weed": 0, "draft": 1, "draft_m": 24, "army": 12, "jobs": ["Servicio", "Oficio", "Negocios"], "food": ["Frango à zambeziana", "Matapa", "Camarones piri-piri"], "cl": "En un chapa siempre cabe uno más, y otro, y la gallina de la señora.|El piri-piri pica tanto que los portugueses lo exportaron a medio planeta.|La capulana sirve de falda, mochila, portabebés, mantel y regalo de cumpleaños.|La marrabenta suena en cada fiesta y hasta los abuelos bailan mejor que tú.|Te jurarán que sus gambas son las mejores del mundo, y probablemente tengan razón.|Hablan portugués con su propio ritmo y lo salpican de changana y macua.", "cus": [{"t": "Nadar con tiburones ballena en Tofo", "d": "Las aguas de Tofo son de las mejores del mundo para ver tiburones ballena y mantas.", "k": "naturaleza", "cost": 70, "min": 0}, {"t": "Comer gambas piri-piri en el mercado", "d": "Compras el marisco en el mercado de peixe de Maputo y te lo cocinan con piri-piri al momento.", "k": "comida", "cost": 15, "min": 0}, {"t": "Bailar marrabenta en Maputo", "d": "Una noche de música en vivo en la Mafalala o en un bar de la Baixa.", "k": "fiesta", "cost": 10, "min": 18}, {"t": "Recorrer la Isla de Mozambique", "d": "Callejear por la antigua capital colonial, Patrimonio de la Humanidad, en bici o a pie.", "k": "cultura", "cost": 20, "min": 0}, {"t": "Comprar una capulana a medida", "d": "Elegir la tela estampada en el mercado y que una costurera te haga un traje en un día.", "k": "cultura", "cost": 15, "min": 0}, {"t": "Navegar en dhow por Bazaruto", "d": "Un velero tradicional entre dunas, arrecifes y dugongos, ideal para una escapada en pareja.", "k": "picante", "cost": 80, "min": 18}], "fest": [{"m": 5, "n": "Día de la Independencia", "d": "El 25 de junio se celebra la independencia de Portugal con música y desfiles."}, {"m": 1, "n": "Festival de Marrabenta", "d": "Conciertos itinerantes de marrabenta entre Maputo y el sur del país."}], "honey": "El archipiélago de Bazaruto y la Isla de Mozambique", "tour": 45, "sport": "fútbol", "fifa": 25, "nb": ["tz", "mw", "zm", "zw", "za", "sz"]},
