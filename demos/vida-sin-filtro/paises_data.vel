    {"id": "pg", "n": "Papúa Nueva Guinea", "dm": "papuano", "df": "papuana", "reg": "oceania", "lang": "tok pisin, inglés e hiri motu", "pop": 10500, "lat": -6.3, "lon": 143.9, "cap": "Port Moresby", "cities": ["Port Moresby", "Lae", "Mount Hagen", "Madang", "Goroka"], "gdp": 4, "life": 66, "hap": 47, "safe": 35, "edu": 35, "unemp": 3, "gov": "monarquia_const", "lead_m": "Primer ministro", "lead_f": "Primera ministra", "crown_m": "Rey", "crown_f": "Reina", "crown_reform": false, "ss": 1, "nm": "John,Peter,Michael,Joseph,James,Paul,David,Thomas,Samuel,Daniel,Mark,Steven,Joshua,Benjamin,Kevin,Mathew,Simon,Jacob,Moses,Elijah", "nf": "Mary,Grace,Elizabeth,Ruth,Joyce,Margaret,Esther,Rose,Christine,Janet,Helen,Anna,Agnes,Martha,Sarah,Naomi,Dorothy,Rebecca,Lucy,Priscilla", "sn": "Kaupa,Wari,Kila,Namaliu,Somare,Kuman,Pato,Tom,John,Peter,Paul,James,Joseph,Kepa,Mondo,Yalu,Waine,Kuri,Siaguru,Marape", "odd_m": "", "odd_f": "", "odd_pct": 0, "rel": {"evangelica": 64, "catolica": 26, "tradicional": 8, "espiritual": 1, "ninguna": 1}, "skin": [0, 2, 8, 30, 45, 15], "blond": 2, "light_eyes": 0, "lgbt": 0, "sexwork": 0, "alcohol": 2, "weed": 0, "draft": 0, "draft_m": 0, "army": 5, "jobs": ["Oficio", "Servicio", "Negocios"], "food": ["Mumu (cerdo cocinado bajo tierra)", "Kaukau (batata)", "Sago"], "cl": "Hay más de 800 idiomas, así que siempre hay alguien que no entiende a su propio vecino.|En tok pisin la barba es 'gras bilong fes': pelo de la cara, lógica pura.|Mascar buai (nuez de betel) tiñe las sonrisas de rojo intenso.|El rugby league no es un deporte, es una religión con camiseta.|La 'hora PNG' significa que la reunión empieza cuando llega el último.|Los cerdos son tan valiosos que forman parte de las dotes de boda.|Tu 'wantok', alguien que habla tu idioma, siempre te debe un favor, y tú a él.", "cus": [{"t": "Ir al sing-sing del Goroka Show", "d": "Ves a cientos de tribus con pinturas, plumas de ave del paraíso y máscaras de barro bailar a la vez.", "k": "fiesta", "cost": 30, "min": 0}, {"t": "Comer un mumu", "d": "Ayudas a enterrar cerdo, batatas y verduras entre piedras calientes y hojas de plátano durante horas.", "k": "comida", "cost": 10, "min": 0}, {"t": "Recorrer el sendero de Kokoda", "d": "Caminas durante días por la selva de montaña siguiendo la ruta histórica de la Segunda Guerra Mundial.", "k": "naturaleza", "cost": 300, "min": 0}, {"t": "Ver el State of Origin en la plaza", "d": "Sigues el clásico australiano de rugby league entre multitudes que gritan cada placaje.", "k": "deporte", "cost": 10, "min": 0}, {"t": "Presenciar una ceremonia del cocodrilo en el Sepik", "d": "Asistes en una casa de los espíritus a una ceremonia de iniciación de los pueblos del río.", "k": "ritual", "cost": 50, "min": 0}], "fest": [{"m": 7, "n": "Mount Hagen Show", "d": "Las tribus de las tierras altas se reúnen con sus mejores atuendos."}, {"m": 8, "n": "Goroka Show", "d": "El mayor sing-sing del país coincide con el Día de la Independencia."}], "honey": "El río Sepik y los arrecifes de la bahía de Milne", "tour": 25, "sport": "Rugby league", "fifa": 5, "nb": ["id", "au", "sb", "fm"]},
