// ---------------------------------------------------------------- menús

function find_activity(id: string) {
    for a in ACTIVITIES {
        if a.id == id { return a }
    }
    return null
}

function menu_title(tab: string) {
    if tab == "job" { return "OCUPACIÓN" }
    if tab == "rel" { return "VÍNCULOS" }
    if tab == "act" { return "ACTIVIDADES" }
    if tab == "missions" { return "MISIONES" }
    return "NOCHE +18"
}

function menu_cats(tab: string) {
    if tab == "act" { return ["Cuerpo", "Mente", "Lujos"] }
    if tab == "night" { return ["Fiesta", "Ligue", "Carreras", "Vicios", "Crimen"] }
    return []
}

function menu_items(tab: string, cat: string) {
    if tab == "job" { return job_items() }
    if tab == "rel" { return rel_items() }
    if tab == "missions" { return mission_items() }
    if tab == "night" && cat == "Carreras" { return casting_items() }
    let items = []
    for a in ACTIVITIES {
        if a.tab == tab && a.cat == cat && L.age >= a.min {
            let lock = ""
            if a.need != null && rank(a.need) < a.rank { lock = SOCIAL_NAMES[a.need] + " " + str(a.rank) }
            list_push(items, {"action": "act:" + a.id, "t": a.t, "s": fmt(a.s, {}), "desc": fmt(a.desc, {}), "lock": lock})
        }
    }
    if tab == "act" && cat == "Lujos" && L.age >= 18 {
        for asset in ASSETS {
            let lock = ""
            if list_contains(L.assets, asset.t) {
                lock = "Ya lo tienes"
            } else if L.money < asset.cost {
                lock = money_str(asset.cost)
            }
            list_push(items, {"action": "buy:" + asset.id, "t": "Comprar: " + asset.t, "s": money_str(asset.cost), "desc": "Presume tu " + str_lower(asset.t) + ". Felicidad y Encanto.", "lock": lock})
        }
    }
    return items
}

// Mensaje cuando un menú no está disponible; "" si sí lo está.
function menu_block(tab: string) {
    if tab == "night" && L.age < 18 { return "La vida nocturna empieza a los 18. Paciencia." }
    if (tab == "night" || tab == "act") && L.jail > 0 {
        return "Estás en prisión. Te quedan " + str(L.jail) + " " + plural(L.jail, "año", "años") + "."
    }
    if tab == "job" && L.age < 6 { return "Tu único trabajo ahora es crecer." }
    if tab == "act" && L.age < 6 { return "Eres demasiado pequeñ" + oa(L.gender) + ". Juegas con bloques y babeas." }
    return ""
}

function job_items() {
    let items = []
    if L.jail > 0 {
        list_push(items, {"action": "act:behave", "t": "Portarte bien", "s": "Puede reducir tu condena", "desc": "Agacha la cabeza, cumple las reglas y espera.", "lock": ""})
        list_push(items, {"action": "act:yard", "t": "Pelear en el patio", "s": "Respeto o enfermería", "desc": "En prisión, el respeto se gana a golpes.", "lock": ""})
        list_push(items, {"action": "act:escape", "t": "Intentar escapar", "s": "Muy arriesgado", "desc": "Una cuchara, un túnel y mucha paciencia.", "lock": ""})
        return items
    }
    if L.job != null && L.job.career != null {
        items = career_items()
        list_push(items, {"action": "act:jobsearch", "t": "Buscar otro trabajo", "s": "Cambiar de rumbo", "desc": "Quizá sea hora de algo con menos luces.", "lock": ""})
        return items
    }
    if L.age < 18 && L.school != "" {
        list_push(items, {"action": "act:study", "t": "Estudiar más duro", "s": "Inteligencia, conocimiento", "desc": "Cuadernos, desvelos y la satisfacción de un 10.", "lock": ""})
        list_push(items, {"action": "act:skip", "t": "Saltarte clases", "s": "Felicidad, valor", "desc": "El centro comercial no se va a visitar solo.", "lock": ""})
    }
    if L.age >= 18 {
        if L.edu < 2 {
            list_push(items, {"action": "act:ged", "t": "Secundaria abierta", "s": "$1,500", "desc": "Nunca es tarde para terminar la escuela.", "lock": ""})
        }
        if L.edu == 2 && L.uni == 0 {
            list_push(items, {"action": "act:uni", "t": "Ir a la universidad", "s": "4 años · préstamo de $40,000", "desc": "Fiestas, deudas y, con suerte, un título.", "lock": ""})
        }
        if L.uni > 0 {
            list_push(items, {"action": "act:uni_study", "t": "Estudiar para los finales", "s": "Inteligencia, conocimiento", "desc": "Café, apuntes subrayados y crisis existenciales.", "lock": ""})
            list_push(items, {"action": "act:dropout", "t": "Dejar la universidad", "s": "Adiós título", "desc": "Muchos millonarios dejaron la escuela. Muchos más no lo son.", "lock": ""})
        }
    }
    if L.age >= 16 {
        list_push(items, {"action": "act:jobsearch", "t": "Buscar trabajo", "s": "Ver ofertas de empleo", "desc": "Revisa vacantes y prueba suerte en entrevistas.", "lock": ""})
    }
    if L.job != null {
        list_push(items, {"action": "act:work_hard", "t": "Trabajar más duro", "s": "Desempeño " + str(L.job.perf) + "%", "desc": "Horas extra, correos a medianoche y reconocimiento (quizá).", "lock": ""})
        list_push(items, {"action": "act:raise", "t": "Pedir un aumento", "s": "Sueldo " + money_str(job_pay(L.job)) + "/año", "desc": "Necesitas buen desempeño y algo de valor.", "lock": ""})
        list_push(items, {"action": "act:quit", "t": "Renunciar", "s": L.job.title, "desc": "Mandar todo al diablo se siente increíble. Por un rato.", "lock": ""})
    }
    return items
}

function rel_items() {
    let items = []
    for p in L.people {
        if !p.alive { continue }
        list_push(items, {
            "action": "person:" + str(p.id),
            "t": full_name(p),
            "s": rel_label(p) + " · " + str(p.age) + " años",
            "desc": arcana(p) + " · Rango " + str(conf_rank(p)),
            "lock": "",
            "pid": p.id
        })
    }
    if L.age >= 18 && L.jail == 0 {
        list_push(items, {"action": "act:dating", "t": "Buscar el amor", "s": "Abrir la app de citas", "desc": "Alguien allá afuera está deslizando a la derecha.", "lock": ""})
    }
    return items
}

function person_actions(p: map) {
    let out = [
        {"action": "pact:time", "t": "Pasar tiempo juntos", "s": "Más cercanía"},
        {"action": "pact:talk", "t": "Conversar", "s": "Un poco más de cercanía"},
        {"action": "pact:argue", "t": "Discutir", "s": "Desahogarte"},
        {"action": "pact:insult", "t": "Insultar", "s": "Quemar el puente"}
    ]
    let r = p.rel
    if r == "padre" || r == "madre" {
        list_push(out, {"action": "pact:money", "t": "Pedir dinero", "s": "Si te quiere lo suficiente"})
    }
    if L.age >= 18 && L.jail == 0 {
        if r == "pareja" || r == "esposo" {
            list_push(out, {"action": "pact:romance", "t": "Noche romántica", "s": "Felicidad y cercanía"})
            list_push(out, {"action": "pact:baby", "t": "Intentar tener un bebé", "s": "Agrandar la familia"})
            list_push(out, {"action": "pact:threesome", "t": "Proponer un trío", "s": "Arriesgado"})
            if r == "pareja" {
                list_push(out, {"action": "pact:propose", "t": "Proponer matrimonio", "s": "Boda de $8,000"})
                list_push(out, {"action": "pact:breakup", "t": "Terminar", "s": "Fin de la relación"})
            } else {
                list_push(out, {"action": "pact:breakup", "t": "Divorciarte", "s": "Pierdes la mitad"})
            }
        }
        if r == "ex" {
            list_push(out, {"action": "pact:again", "t": "Intentar volver", "s": "Segundas partes..."})
            list_push(out, {"action": "pact:hookup", "t": "Recaer en la cama", "s": "Solo una vez más"})
        }
        if r == "amante" || r == "ligue" {
            list_push(out, {"action": "pact:hookup", "t": "Verse a escondidas", "s": "Encuentro"})
            if L.partner_id == 0 {
                list_push(out, {"action": "pact:official", "t": "Hacerlo oficial", "s": "Formalizar"})
            }
            list_push(out, {"action": "pact:end", "t": "Cortar la aventura", "s": "Se acabó"})
        }
        if r == "amigo" || r == "hermano" {
            list_push(out, {"action": "pact:party", "t": "Salir de fiesta juntos", "s": "Felicidad y alcohol"})
        }
    }
    return out
}

// ---------------------------------------------------------------- acciones

function info(title: string, text: string) {
    G.modal = {"kind": "info", "title": title, "text": text}
    G.modal_t0 = G.t
    return null
}

function toast(title: string, sub: string) {
    list_push(G.toasts, {"title": title, "sub": sub, "t0": G.t})
}

function do_act(id: string) {
    G.modal = null
    if do_job_act(id) { return null }
    let a = find_activity(id)
    if a == null { return null }
    if L.jail > 0 { return info(a.t, "Estás en prisión.") }
    if L.age < a.min { return info(a.t, "Eres demasiado joven para eso.") }
    if a.need != null && rank(a.need) < a.rank {
        return info(a.t, "Necesitas " + SOCIAL_NAMES[a.need] + " rango " + str(a.rank) + " para esto.")
    }
    if a.cost > 0 && L.money < a.cost {
        return info(a.t, "No te alcanza. Necesitas " + money_str(a.cost) + " y tienes " + money_str(L.money) + ".")
    }
    let used = L.used[id]
    if used == null { used = 0 }
    if used >= 3 {
        return info(a.t, "Ya hiciste eso suficiente este año. Envejece un poco.")
    }
    L.used[id] = used + 1
    if a.code == true {
        code_activity(id, a)
        return null
    }
    L.money -= a.cost
    let o = pick_outcome(a.o)
    let msg = apply(o, {})
    if a.tab == "night" && has_trait("fiesta") && L.alive {
        L.happy = clamp100(L.happy + 4)
    }
    finish(a.t, msg, outcome_kind(o))
    return null
}

function buy(id: string) {
    G.modal = null
    for asset in ASSETS {
        if asset.id != id { continue }
        if list_contains(L.assets, asset.t) { return info(asset.t, "Ya tienes uno. No seas codicios" + oa(L.gender) + ".") }
        if L.money < asset.cost { return info(asset.t, "No te alcanza. Cuesta " + money_str(asset.cost) + ".") }
        L.money -= asset.cost
        list_push(L.assets, asset.t)
        L.happy = clamp100(L.happy + asset.happy)
        gain("charm", asset.charm)
        return finish("Compra", "Compraste: " + str_lower(asset.t) + ". Todo el barrio te mira con envidia.", "g")
    }
    return null
}

function code_activity(id: string, a: map) {
    if id == "doctor" { return doctor() }
    if id == "rehab" {
        if L.alcohol + L.drugs < 10 {
            L.used[id] = L.used[id] - 1
            return info(a.t, "No tienes adicciones... de momento.")
        }
        L.money -= a.cost
        special("rehab", {})
        L.happy -= 5
        return finish(a.t, "Pasaste 90 días en rehabilitación. Estás limpi" + oa(L.gender) + ".", "g")
    }
    if id == "surgery" {
        L.money -= a.cost
        if chance(75) {
            L.looks += rint(8, 18)
            return finish(a.t, "La cirugía fue un éxito. Te ves espectacular.", "g")
        }
        L.looks -= rint(10, 20)
        L.health -= 10
        return finish(a.t, "La cirugía salió mal. Pareces un gato asustado.", "b")
    }
    if id == "lottery" {
        L.money -= a.cost
        if rint(1, 2000) == 1 {
            L.money += 1000000
            L.happy = 100
            return finish(a.t, "¡GANASTE LA LOTERÍA! $1,000,000 a tu cuenta.", "g")
        }
        if rint(1, 30) == 1 {
            L.money += 500
            return finish(a.t, "Ganaste $500. Algo es algo.", "g")
        }
        return finish(a.t, "No ganaste nada. Como siempre.", "n")
    }
    if id == "dating" { return open_dating() }
    if id == "hookup" {
        let person = stranger()
        let odds = 35 + L.looks / 2 + rank("charm") * 4
        if has_trait("carisma") { odds += 15 }
        if chance(odds) {
            return open_hookup({"person": person})
        }
        return finish(a.t, "Nadie se interesó esta noche. Te fuiste a casa a ver videos.", "b")
    }
    if id == "casino" { return open_casino() }
    return null
}

function doctor() {
    let cost = 300
    if L.age < 18 { cost = 0 }
    if L.money < cost {
        return info("Doctor", "No te alcanza para la consulta.")
    }
    L.money -= cost
    L.health += 6
    if len(L.std) == 0 {
        return finish("Doctor", "El doctor dice que estás bien. Te cobró por decírtelo.", "g")
    }
    let keep = []
    let lines = []
    for s in L.std {
        if s == "herpes" {
            list_push(keep, s)
            list_push(lines, "El herpes no tiene cura, pero te dieron una pomada.")
        } else if s == "VIH" {
            list_push(keep, s)
            L.hiv_treated = true
            list_push(lines, "Empezaste tratamiento antirretroviral para el VIH.")
        } else {
            list_push(lines, "Te curaron la " + s + ".")
        }
    }
    L.std = keep
    return finish("Doctor", str_join(lines, " "), "g")
}

// ---------------------------------------------------------------- ocupación

function do_job_act(id: string) {
    if id == "study" {
        L.smarts += rint(2, 5)
        gain("know", rint(3, 6))
        L.happy -= 1
        finish("Escuela", "Estudiaste como nunca. Tus profesores están impresionados.", "g")
        return true
    }
    if id == "skip" {
        L.smarts -= rint(1, 3)
        L.happy += 4
        gain("guts", 3)
        finish("Escuela", "Te saltaste clases para ir al centro comercial.", "n")
        return true
    }
    if id == "ged" {
        if L.money < 1500 { info("Secundaria abierta", "No te alcanza. Cuesta $1,500."); return true }
        L.money -= 1500
        if L.smarts >= 25 || chance(60) {
            L.edu = 2
            gain("know", 5)
            finish("Secundaria abierta", "Terminaste la secundaria abierta. Nunca es tarde.", "g")
        } else {
            finish("Secundaria abierta", "Reprobaste el examen final. Inténtalo de nuevo.", "b")
        }
        return true
    }
    if id == "uni" {
        L.uni = 4
        L.school = "universidad"
        L.debt += 40000
        finish("Universidad", "Entraste a la universidad. Préstamo estudiantil: $40,000.", "g")
        return true
    }
    if id == "uni_study" {
        L.smarts += rint(2, 5)
        gain("know", rint(3, 7))
        L.happy -= 2
        finish("Universidad", "Noches sin dormir y litros de café. Pasaste los finales.", "g")
        return true
    }
    if id == "dropout" {
        L.uni = 0
        L.school = ""
        finish("Universidad", "Dejaste la universidad. La deuda, en cambio, no te deja a ti.", "b")
        return true
    }
    if id == "jobsearch" {
        open_jobs()
        return true
    }
    if id == "work_hard" {
        let boost = rint(6, 14)
        if has_trait("ambicion") { boost += 5 }
        L.job.perf = clamp100(L.job.perf + boost)
        gain("skill", rint(2, 5))
        L.happy -= 2
        L.health -= 1
        finish("Trabajo", "Te quedaste horas extra todo el año. Tu jefe lo notó.", "g")
        return true
    }
    if id == "raise" {
        let odds = 35 + rank("guts") * 6
        if has_trait("ambicion") { odds += 15 }
        if L.job.perf >= 60 && chance(odds) {
            L.job.salary = L.job.salary * 110 / 100
            L.job.var = L.job.var * 11 / 10
            gain("guts", 3)
            finish("Trabajo", "¡Te dieron un aumento! Ahora ganas " + money_str(job_pay(L.job)) + " al año.", "g")
        } else {
            L.job.perf -= 5
            finish("Trabajo", "Tu jefe se rió en tu cara.", "b")
        }
        return true
    }
    if id == "quit" {
        L.last_job = L.job.title
        L.job = null
        finish("Trabajo", "Renunciaste. Libertad... y cero ingresos.", "n")
        return true
    }
    if id == "behave" {
        if chance(40) {
            L.jail -= 1
            if L.jail <= 0 {
                L.jail = 0
                finish("Prisión", "Te dieron libertad anticipada por buena conducta.", "g")
            } else {
                finish("Prisión", "Te redujeron la condena un año por buena conducta.", "g")
            }
        } else {
            finish("Prisión", "Te portaste bien. Nadie lo notó.", "n")
        }
        gain("kind", 2)
        return true
    }
    if id == "yard" {
        gain("guts", 4)
        if chance(40 + rank("guts") * 8) {
            L.happy += 5
            L.health -= 5
            finish("Prisión", "Ganaste la pelea. Ahora te respetan en el patio.", "g")
        } else {
            L.health -= 20
            finish("Prisión", "Te mandaron a la enfermería con tres costillas rotas.", "b")
        }
        return true
    }
    if id == "escape" {
        if chance(8 + rank("skill") * 3) {
            L.jail = 0
            L.record += 1
            flag("escape")
            finish("Prisión", "¡Escapaste! Ahora eres prófug" + oa(L.gender) + ".", "g")
        } else {
            L.jail += 2
            L.jail_total += 2
            finish("Prisión", "Te atraparon trepando la barda. Dos años más.", "b")
        }
        return true
    }
    return false
}

function open_jobs() {
    let pool = []
    for j in JOBS {
        if L.age >= j.min_age { list_push(pool, j) }
    }
    shuffle(G.rng, pool)
    let offers = list_slice(pool, 0, min(6, len(pool)))
    G.modal = {"kind": "jobs", "title": "OFERTAS DE EMPLEO", "offers": offers}
    G.modal_t0 = G.t
}

function job_requirements(j: map) {
    let parts = []
    if j.edu == 1 { list_push(parts, "Primaria") }
    if j.edu == 2 { list_push(parts, "Secundaria") }
    if j.edu == 3 { list_push(parts, "Universidad") }
    if j.smarts > 0 { list_push(parts, "Intel. " + str(j.smarts)) }
    if j.looks > 0 { list_push(parts, "Atractivo " + str(j.looks)) }
    if len(parts) == 0 { return "Sin requisitos" }
    return str_join(parts, " · ")
}

function job_salary_text(j: map) {
    if j.var != null { return "Según tu atractivo" }
    return money_str(j.salary) + "/año"
}

function job_ok(j: map) {
    return L.edu >= j.edu && L.smarts >= j.smarts && L.looks >= j.looks
}

function hire(index: int) {
    let j = G.modal.offers[index]
    G.modal = null
    let title = by_gender(L.gender, j.m, j.f)
    let ok = job_ok(j)
    let odds = 70 + rank("charm") * 3
    if (ok && chance(odds)) || (!ok && chance(8)) {
        if L.job != null { L.last_job = L.job.title }
        let v = 0
        if j.var != null { v = j.var }
        let salary = j.salary
        if has_trait("ambicion") { salary = salary * 110 / 100 }
        L.job = {"id": j.id, "title": title, "salary": salary, "var": v, "perf": 60, "years": 0}
        L.happy += 5
        return finish("Entrevista", "¡Te contrataron como " + title + "! Ganarás " + money_str(job_pay(L.job)) + " al año.", "g")
    }
    let why = "Eligieron a alguien más."
    if !ok { why = "No cumples los requisitos: " + job_requirements(j) + "." }
    return finish("Entrevista", "No te contrataron como " + title + ". " + why, "b")
}

// ---------------------------------------------------------------- encuentros

function open_hookup(ctx: map) {
    let x = ctx.person
    let likes = ""
    if x.tags != null && len(x.tags) > 0 { likes = " Le gusta: " + kinks_text(x.tags, x.gender) + "." }
    let shared = shared_kinks(x)
    if len(shared) > 0 { likes = likes + " ¡Comparten gustos!" }
    open_choice(
        "ENCUENTRO CON " + str_upper(x.first),
        fmt("{x} ({edad} años, atractivo " + str(x.looks) + "%) está más que dispuest{xa}." + likes + " ¿Cómo quieres que sea?", ctx),
        ["Con protección", "Sin protección", "Mejor no"],
        ["", "", ""],
        "hookup",
        ctx
    )
    return null
}

function resolve_hookup(index: int, ctx: map) {
    G.modal = null
    let x = ctx.person
    if index == 2 {
        return finish("Encuentro", "Cambiaste de opinión y te fuiste a casa.", "n")
    }
    let o = {"log": pick(HOOKUP_LINES), "happy": 4 + x.looks / 12, "sex": true, "std": 3, "preg": 2, "charm": 2}
    if index == 1 {
        o.std = 18
        o.preg = 25
    }
    if has_kink("insaciable") { o.happy = o.happy + 3 }
    let shared = shared_kinks(x)
    if len(shared) > 0 {
        o.log = o.log + " Descubrieron que comparten un gusto: " + kink_name(shared[0], L.gender) + ". Noche legendaria."
        o.happy = o.happy + 6
        o.flag = "kink"
        if has_kink("trios") && shared[0] == "trios" { o.count = 1 }
    }
    let msg = apply(o, ctx)
    return finish("Encuentro con " + x.first, msg, "x")
}

function open_dating() {
    let x = stranger()
    let ctx = {"person": x}
    open_choice(
        fmt("MATCH: {x}, {edad}", ctx),
        fmt("Su bio dice: «" + pick(BIOS) + "» Atractivo: " + str(x.looks) + "%.", ctx),
        [fmt("Invitarl{xlo} a una cita", ctx), "Ir directo al grano", "Deslizar a la izquierda"],
        ["", "", ""],
        "date",
        ctx
    )
    return null
}

function resolve_date(index: int, ctx: map) {
    G.modal = null
    let x = ctx.person
    if index == 0 {
        let odds = 55 + (L.looks - x.looks) / 3 + rank("charm") * 4
        if has_trait("carisma") || has_trait("romance") { odds += 10 }
        if chance(odds) {
            L.happy += 8
            gain("charm", 3)
            let msg = "La cita con " + x.first + " fue increíble. Hubo química."
            msg = msg + special("new_partner", ctx)
            return finish("Cita", msg, "x")
        }
        L.happy -= 4
        return finish("Cita", x.first + " habló de su ex toda la noche. Desastre.", "b")
    }
    if index == 1 {
        if L.looks + rint(0, 50) + rank("charm") * 5 >= x.looks {
            return open_hookup(ctx)
        }
        L.happy -= 3
        return finish("App de citas", x.first + " te dejó en visto después de tu primer mensaje.", "b")
    }
    return finish("App de citas", "Deslizaste a la izquierda. Siguiente.", "n")
}

function open_casino() {
    let tenth = max(100, L.money / 10)
    open_choice(
        "CASINO",
        "Las luces, el ruido, la ruleta. Tienes " + money_str(L.money) + ". ¿Cuánto apuestas?",
        ["Apostar $100", "Apostar " + money_str(tenth), "Apostarlo TODO (" + money_str(L.money) + ")", "Mejor no"],
        ["", "", "", ""],
        "casino",
        {"amounts": [100, tenth, L.money]}
    )
    return null
}

function resolve_casino(index: int, ctx: map) {
    G.modal = null
    if index == 3 { return finish("Casino", "Te fuiste sin apostar. Sabia decisión.", "n") }
    let amount = ctx.amounts[index]
    if amount > L.money || amount <= 0 { return finish("Casino", "No tienes tanto dinero.", "b") }
    gain("guts", 2)
    if chance(45) {
        L.money += amount
        L.happy += 8
        return finish("Casino", "¡Ganaste " + money_str(amount) + "! La ruleta te ama.", "g")
    }
    L.money -= amount
    L.happy -= 8
    return finish("Casino", "Perdiste " + money_str(amount) + ". La casa siempre gana.", "b")
}

// ---------------------------------------------------------------- vínculos

function bond_gain(p: map, amount: int) {
    let before = conf_rank(p)
    let gained = amount
    if has_trait("romance") && amount > 0 { gained = amount * 3 / 2 }
    p.bond = clamp100(p.bond + gained)
    let after = conf_rank(p)
    if after > before {
        list_push(G.toasts, {"head": "¡CONFIDENTE!", "title": str_upper(arcana(p)) + " · RANGO " + str(after), "sub": "Tu vínculo con " + p.first + " se fortaleció.", "t0": G.t})
    }
}

function do_person_act(action: string, p: map) {
    G.modal = null
    let ctx = {"person": p}
    let name = p.first
    if action == "time" {
        bond_gain(p, rint(5, 12))
        L.happy += 3
        gain("kind", 2)
        return finish(name, "Pasaste tiempo con " + name + ". Se divirtieron.", "g")
    }
    if action == "talk" {
        bond_gain(p, rint(2, 6))
        gain("kind", 1)
        return finish(name, "Platicaste con " + name + " de la vida.", "n")
    }
    if action == "argue" {
        bond_gain(p, -rint(8, 15))
        L.happy -= 3
        gain("guts", 1)
        return finish(name, "Discutiste con " + name + " por una tontería. Ahora no se hablan.", "b")
    }
    if action == "insult" {
        bond_gain(p, -20)
        L.karma -= 3
        return finish(name, "Le dijiste a " + name + " cosas que no se olvidan.", "b")
    }
    if action == "money" {
        if p.bond >= 50 && chance(60) {
            let amount = rint(1, 20) * 100
            L.money += amount
            return finish(name, name + " te dio " + money_str(amount) + ".", "g")
        }
        bond_gain(p, -3)
        return finish(name, name + " te dijo que te pongas a trabajar.", "b")
    }
    if action == "romance" {
        if has_kink("romantico") { bond_gain(p, 5) }
        bond_gain(p, 10)
        L.happy += 8
        sex_with(p)
        return finish(name, "Cena, vino y una noche que terminó como tenía que terminar.", "x")
    }
    if action == "baby" {
        if p.gender == L.gender {
            return finish(name, "Biológicamente complicado. Tal vez podrían adoptar algún día.", "n")
        }
        let her_age = p.age
        if L.gender == "f" { her_age = L.age }
        if her_age > 45 { return finish(name, "A estas alturas ya no es posible.", "n") }
        if L.pregnant || L.partner_preg { return finish(name, "Ya viene un bebé en camino.", "n") }
        L.happy += 3
        sex_with(p)
        if chance(45) {
            if L.gender == "f" {
                L.pregnant = true
                L.preg_with = name
                return finish(name, "¡Estás embarazada! El bebé nacerá el próximo año.", "g")
            }
            L.partner_preg = true
            return finish(name, "¡" + name + " está embarazada! El bebé nacerá el próximo año.", "g")
        }
        return finish(name, "Lo intentaron mucho. Este año no hubo suerte (pero sí diversión).", "x")
    }
    if action == "threesome" {
        let odds = 35 + rank("charm") * 6
        if has_kink("trios") { odds += 20 }
        if chance(odds) {
            let msg = apply({"log": name + " aceptó. Fue una noche épica.", "happy": 12, "count": 1, "bond": 5, "std": 8, "flag": "trio"}, ctx)
            return finish(name, msg, "x")
        }
        bond_gain(p, -20)
        return finish(name, name + " se ofendió muchísimo. Hoy duermes en el sillón.", "b")
    }
    if action == "propose" {
        if chance(p.bond - 10 + rank("guts") * 3) {
            marry()
            L.happy += 15
            toast("LOS AMANTES · BODA", "Te casaste con " + name + ".")
            return finish(name, "¡Dijo que sí! Se casaron en una boda inolvidable.", "g")
        }
        bond_gain(p, -10)
        return finish(name, name + " dijo que no está list" + oa(p.gender) + ". Qué incómodo.", "b")
    }
    if action == "breakup" {
        let was_married = L.married
        breakup()
        L.happy -= 5
        if was_married { return finish(name, "Te divorciaste de " + name + ".", "b") }
        return finish(name, "Terminaste con " + name + ".", "b")
    }
    if action == "again" {
        if L.partner_id == 0 && chance(p.bond) {
            make_partner(p)
            return finish(name, "Volvieron. Esta vez será diferente (no lo será).", "x")
        }
        return finish(name, name + " te dijo que ni loc" + oa(p.gender) + ".", "b")
    }
    if action == "hookup" { return open_hookup(ctx) }
    if action == "official" {
        make_partner(p)
        return finish(name, "Ahora es oficial: " + name + " y tú son pareja.", "g")
    }
    if action == "end" {
        p.rel = "ex"
        return finish(name, "Terminaste la aventura con " + name + ".", "n")
    }
    if action == "party" {
        bond_gain(p, 5)
        L.happy += 6
        L.alcohol += 4
        gain("charm", 2)
        return finish(name, "Salieron de fiesta y acabaron cantando en un karaoke.", "g")
    }
    return null
}

// ---------------------------------------------------------------- efectos especiales

function special(name: string, ctx: map) {
    if str_starts_with(name, "event:") {
        let ev = find_event(str_replace(name, "event:", ""))
        if ev != null { open_event(ev, event_ctx(ev)) }
        return ""
    }
    if name == "hookup" {
        if ctx["person"] == null { ctx["person"] = stranger() }
        open_hookup(ctx)
        return ""
    }
    if name == "hookup_young" {
        ctx["person"] = stranger_aged(20, 26)
        open_hookup(ctx)
        return ""
    }
    if name == "new_partner" {
        let p = ctx["person"]
        if p == null { p = stranger() }
        if make_partner(p) {
            return " Ahora " + p.first + " es tu " + str_lower(rel_label(p)) + "."
        }
        return " " + p.first + " ahora es tu amante: llevas una doble vida."
    }
    if name == "vegas_marry" {
        let p = ctx["person"]
        if p != null && make_partner(p) {
            marry()
            return " Ahora " + p.first + " es tu " + str_lower(rel_label(p)) + "."
        }
        return ""
    }
    if name == "add_friend" {
        let p = ctx["person"]
        if p != null {
            if !p.known { add_person(p) }
            p.rel = "amigo"
        }
        return ""
    }
    if name == "breakup" {
        breakup()
        return ""
    }
    if name == "baby" {
        let other = "alguien"
        if ctx["person"] != null { other = ctx["person"].first }
        add_child(other)
        return ""
    }
    if name == "marry" {
        marry()
        return ""
    }
    if name == "rehab" {
        L.alcohol = 0
        L.drugs = 0
        L.health += 10
        return ""
    }
    if name == "family_hate" {
        for p in L.people {
            if p.alive && (p.rel == "padre" || p.rel == "madre" || p.rel == "hermano") {
                p.bond = clamp100(p.bond - 30)
            }
        }
        return ""
    }
    if name == "fired" {
        if L.job != null {
            L.last_job = L.job.title
            L.job = null
        }
        return ""
    }
    if name == "promo" {
        if L.job == null { return "" }
        L.job.salary = L.job.salary * 115 / 100
        L.job.perf = clamp100(L.job.perf + 10)
        return " Nuevo sueldo: " + money_str(job_pay(L.job)) + " al año."
    }
    if name == "creator" {
        let c = career_def("cam")
        if L.job != null { L.last_job = L.job.title }
        L.job = {"id": "cam", "career": "cam", "title": by_gender(L.gender, c.m, c.f), "salary": 0, "var": 0, "perf": 60, "years": 0, "level": 1, "xp": c.xp[1], "bonus": 100}
        L.fame = clamp100(L.fame + 15)
        return " Ahora eres " + str_lower(L.job.title) + "."
    }
    if name == "career_raise" {
        if L.job != null && L.job.career != null { L.job.bonus = L.job.bonus + 15 }
        return " Tus ingresos suben un 15%."
    }
    if name == "kink_scene" {
        if len(L.tags) == 0 { return "" }
        let t = pick(L.tags)
        career_xp(45)
        L.fame = clamp100(L.fame + 6)
        L.happy += 8
        L.money += 5000
        return "Grabaste una escena de tu especialidad («" + kink_name(t, L.gender) + "»). Se nota que lo disfrutas: los fans enloquecieron. +$5,000."
    }
    if name == "clinic" {
        if L.money < 500 { return "No te alcanzó para las pruebas." }
        L.money -= 500
        let out = "Pruebas completas: todo limpio."
        if len(L.std) > 0 {
            out = "Te detectaron " + str_join(L.std, ", ") + " a tiempo y empezaste tratamiento."
            let keep = []
            for s in L.std {
                if s == "herpes" || s == "VIH" { list_push(keep, s) }
                if s == "VIH" { L.hiv_treated = true }
            }
            L.std = keep
        }
        career_xp(10)
        return out
    }
    if name == "collab" {
        let p = stranger()
        p.tags = L.tags
        ctx["person"] = p
        career_xp(30)
        L.fame = clamp100(L.fame + 8)
        open_hookup(ctx)
        return ""
    }
    return ""
}

function dispatch_choice(index: int) {
    let m = G.modal
    if m == null || m.kind != "choice" { return null }
    if index < 0 || index >= len(m.choices) { return null }
    if m.locks != null && m.locks[index] != "" { return null }
    if m.handler == "event" { return resolve_event(m.ev, index, m.ctx) }
    if m.handler == "hookup" { return resolve_hookup(index, m.ctx) }
    if m.handler == "date" { return resolve_date(index, m.ctx) }
    if m.handler == "casino" { return resolve_casino(index, m.ctx) }
    return null
}
