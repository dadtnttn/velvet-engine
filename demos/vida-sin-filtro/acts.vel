// ---------------------------------------------------------------- menús

function find_activity(id: string) {
    for a in ACTIVITIES {
        if a.id == id { return a }
    }
    return find_ocio(id)
}

function menu_title(tab: string) {
    if tab == "job" && L.jail > 0 { return "PRISIÓN" }
    if tab == "job" { return "OCUPACIÓN" }
    if tab == "study" { return "ESTUDIOS" }
    if tab == "gigs" { return "CHAMBAS" }
    if tab == "rel" { return "VÍNCULOS" }
    if tab == "act" { return "ACTIVIDADES" }
    if tab == "missions" { return "MISIONES" }
    if tab == "effects" { return "EFECTOS" }
    if tab == "hitos" { return "MIS HITOS" }
    if tab == "fin" { return "FINANZAS" }
    if tab == "lux" { return "LUJOS" }
    if tab == "route" { return "MI RUTA" }
    if tab == "jobs" { return "CARRERAS" }
    return "NOCHE +18"
}

function menu_cats(tab: string) {
    if tab == "act" { return ["Cuerpo", "Mente", "Salud", "Médico", "Hábitos", "Hobbies", "Mascotas", "Viajes", "Fe", "Lujos", "Vida", "País"] }
    if tab == "job" && L.jail > 0 { return PRISON_CATS }
    if tab == "job" { return job_cats() }
    if tab == "night" { return ["Fiesta", "Ligue", "Placer", "Carreras", "Vicios", "Crimen"] }
    if tab == "rel" { return ["Familia", "Pareja", "Amigos", "Trabajo", "Otros", "Conocer"] }
    if tab == "hitos" { return HITO_CATS }
    if tab == "missions" { return MISSION_CAT_ORDER }
    if tab == "fin" { return fin_cats() }
    if tab == "lux" { return LX_CATS }
    if tab == "route" { return route_cats() }
    if tab == "jobs" { return FIELD_ORDER }
    if tab == "study" { return ["Universidad", "Técnica"] }
    if tab == "gigs" {
        let out = []
        for k in GIG_PLACE_ORDER { list_push(out, GIG_PLACES[k]) }
        return out
    }
    return []
}

function menu_items(tab: string, cat: string) {
    if tab == "job" && L.jail > 0 { return prison_items(cat) }
    if tab == "job" { return job_tab_items(cat) }
    if tab == "act" && (cat == "Hobbies" || cat == "Mascotas" || cat == "Viajes") { return ocio_items(cat) }
    if tab == "rel" { return rel_list(cat) }
    if tab == "missions" { return mission_items(cat) }
    if tab == "effects" { return effect_items() }
    if tab == "hitos" { return my_hito_items(cat) }
    if tab == "fin" { return fin_items(cat) }
    if tab == "lux" { return lx_items(cat) }
    if tab == "route" { return route_items(cat) }
    if tab == "act" && cat == "Fe" { return faith_items() }
    if tab == "act" && cat == "Vida" { return vida_items() }
    if tab == "act" && cat == "País" { return pais_items() }
    if tab == "jobs" { return job_items_for(cat) }
    if tab == "study" {
        if cat == "Técnica" { return study_items("tec") }
        return study_items("uni")
    }
    if tab == "gigs" {
        for k in GIG_PLACE_ORDER {
            if GIG_PLACES[k] == cat { return gig_items(k) }
        }
        return []
    }
    if tab == "night" && cat == "Carreras" { return casting_items() }
    if tab == "act" && cat == "Salud" { return health_items() }
    if tab == "act" && cat == "Médico" { return doctor_items() }
    if tab == "act" && cat == "Hábitos" { return habit_items() }
    let items = ocio_head_items(tab, cat)
    for a in ACTIVITIES {
        if a.tab == tab && a.cat == cat && L.age >= a.min {
            let lock = ""
            if a.need != null && rank(a.need) < a.rank { lock = need_text(a.need, a.rank) }
            let lock2 = lock
            if lock2 == "" { lock2 = body_lock(a.id) }
            if lock2 == "" && a.cost > 0 && L.money < local_price(a.cost) && !parents_pay(a.cost) { lock2 = money_str(local_price(a.cost)) }
            let desc = a.desc
            if L.age < 13 && a.desc_kid != null { desc = a.desc_kid }
            list_push(items, {"action": "act:" + a.id, "t": a.t, "s": local_text(fmt(a.s, {}), a.cost), "desc": fmt(desc, {}), "lock": lock2})
        }
    }
    for a in OCIO_ACTS {
        if a.tab == tab && a.cat == cat && L.age >= a.min {
            let lock = ocio_lock(a)
            if lock == "" && L.used[a.id] != null { lock = "Este mes ya" }
            if lock == "" && a.cost > 0 && L.money < local_price(a.cost) && !parents_pay(a.cost) { lock = money_str(local_price(a.cost)) }
            let t = a.t
            if a.id == "bigheist" { t = heist_title() }
            list_push(items, {"action": "act:" + a.id, "t": t, "s": local_text(fmt(a.s, {}), a.cost), "desc": local_text(fmt(a.desc, {}), a.cost), "lock": lock})
        }
    }
    if tab == "act" && cat == "Lujos" && L.age >= 18 {
        list_push(items, {"action": "tab:lux", "t": "Tienda de lujo", "s": "Estatus: " + lx_status_name(), "desc": "Más de 40 bienes: vehículos, propiedades, joyas, arte y tecnología. También personal doméstico y seguros.", "lock": ""})
    }
    return items
}

// Mensaje cuando un menú no está disponible; "" si sí lo está.
function menu_block(tab: string) {
    if tab == "night" && L.age < 18 { return "La vida nocturna empieza a los 18. Paciencia." }
    if (tab == "night" || tab == "act") && L.jail > 0 {
        return "Estás en prisión. Te quedan " + sentence_left() + "."
    }
    if tab == "job" && L.age < 6 { return "Tu único trabajo ahora es crecer." }
    if (tab == "gigs" || tab == "study" || tab == "jobs") && L.jail > 0 { return "Desde la cárcel no se puede." }
    if (tab == "night" || tab == "gigs" || tab == "study" || tab == "jobs") && in_barracks() {
        return "Estás en el ejército. Eso tendrá que esperar a que termine tu servicio."
    }
    if tab == "fin" && fin_block() != "" { return fin_block() }
    if tab == "route" && route_block() != "" { return route_block() }
    if tab == "gigs" && L.age < 16 { return "Las chambas empiezan a los 16. Por ahora, a estudiar." }
    if tab == "act" && L.age < 6 { return "Eres demasiado pequeñ" + oa(L.gender) + ". Juegas con bloques y babeas." }
    return ""
}

// Pestañas de Ocupación: la escuela mientras estudias la secundaria; carrera,
// trabajo, estudios y chambas después.
function job_cats() {
    if L.age < 6 { return [] }
    if in_school() {
        let cats = ["Clases", "Vida escolar", "Clubes"]
        if L.age >= 16 { list_push(cats, "Chambas") }
        return cats
    }
    if L.age < 16 { return [] }
    return ["Carrera", "Trabajo", "Estudios", "Chambas"]
}

function job_tab_items(cat: string) {
    match cat {
        "Clases" => return school_class_items()
        "Vida escolar" => return school_life_items()
        "Clubes" => return club_items()
        "Carrera" => return career_tab_items()
        "Trabajo" => return workplace_items()
        "Estudios" => return study_tab_items()
        "Chambas" => return gig_tab_items()
        _ => return job_items()
    }
}

function career_tab_items() {
    if L.job != null { return career_items() }
    let items = []
    let last = "Todavía no has tenido una carrera."
    if L.last_job != "" { last = "Tu último trabajo: " + L.last_job + "." }
    list_push(items, {"action": "act:jobsearch", "t": "Buscar carrera", "s": "Más de 120 carreras", "desc": last + " Las profesiones piden título; sin él puedes entrar como amateur pasando una audición. Con entrevista (minijuego) también negocias tu sueldo.", "lock": ""})
    return items
}

function study_tab_items() {
    let items = []
    if L.study != null {
        let d = degree_def(L.study.deg)
        let left = L.study.months
        let where = ""
        if L.study.tier != null && L.study.tier != "" { where = " · " + uni_tier(L.study.tier).n }
        list_push(items, {"action": "act:study_hard", "t": "Estudiar para " + d.n, "s": "Promedio " + str(L.study.gpa), "desc": "Te faltan " + str(left) + " " + plural(left, "mes", "meses") + where + ". Sube tu promedio (con menos de 65 pierdes la beca).", "lock": ""})
        list_push(items, {"action": "act:study_party", "t": "Fiesta universitaria", "s": "Felicidad, encanto", "desc": "Los mejores contactos se hacen en las fiestas. Tu promedio no opina lo mismo.", "lock": ""})
        for it in study_items_extra() { list_push(items, it) }
        list_push(items, {"action": "act:dropout", "t": "Dejar " + d.n, "s": "Adiós título", "desc": "Muchos millonarios dejaron la escuela. Muchos más no lo son.", "lock": ""})
    } else {
        let lock = ""
        if L.age < 18 { lock = "Edad 18" }
        list_push(items, {"action": "act:studymenu", "t": "Universidad y técnicas", "s": str(len(DEGREES)) + " carreras", "desc": "Universidades pública, privada o de élite según tu examen de admisión, y técnicas sin examen. Paga tu familia, una beca, un préstamo o tú.", "lock": lock})
        lock = ""
        if L.edu < 2 { lock = "Secundaria" } else if sc().exam_age == L.age { lock = "Este año ya" }
        list_push(items, {"action": "es:admission", "t": "Examen de admisión", "s": "Puntaje: " + str(sc().exam), "desc": "Decide a qué universidades puedes entrar: pública 55, privada 30, élite 80. Una vez al año.", "lock": lock})
    }
    for it in post_items() { list_push(items, it) }
    if L.age >= 18 && L.edu < 2 {
        list_push(items, {"action": "act:ged", "t": "Secundaria abierta", "s": "$1,500", "desc": "Nunca es tarde para terminar la escuela. Necesaria para la universidad.", "lock": ""})
    }
    return items
}

function gig_tab_items() {
    let items = []
    if L.gig != null {
        for it in gig_action_items() { list_push(items, it) }
        for it in gig_extra_items() { list_push(items, it) }
    }
    let sub = "100 trabajos sin experiencia"
    if L.gig != null { sub = "Cambiar de chamba" }
    let lock = ""
    if L.age < 16 { lock = "Edad 16" }
    list_push(items, {"action": "act:gigmenu", "t": "Chambas de medio tiempo", "s": sub, "desc": "Mesero, albañil, bartender, repartidor... Sin experiencia y compatibles con estudiar. Cada turno es un minijuego y cada mes hay una minimisión con bono.", "lock": lock})
    return items
}

function job_items() {
    let items = []
    if L.jail > 0 {
        list_push(items, {"action": "act:behave", "t": "Portarte bien", "s": "Puede reducir tu condena", "desc": "Agacha la cabeza, cumple las reglas y espera.", "lock": ""})
        list_push(items, {"action": "act:yard", "t": "Pelear en el patio", "s": "Respeto o enfermería", "desc": "En prisión, el respeto se gana a golpes.", "lock": ""})
        list_push(items, {"action": "act:escape", "t": "Intentar escapar", "s": "Muy arriesgado", "desc": "Una cuchara, un túnel y mucha paciencia.", "lock": ""})
        return items
    }
    if L.job != null { items = career_items() }
    if L.age < 18 && L.school != "" {
        list_push(items, {"action": "act:study", "t": "Estudiar más duro", "s": "Calificaciones " + str(L.grades), "desc": "Cuadernos, desvelos y la satisfacción de un 10. Sube tus calificaciones: abren becas y carreras exigentes.", "lock": ""})
        list_push(items, {"action": "act:skip", "t": "Saltarte clases", "s": "Felicidad, valor", "desc": "El centro comercial no se va a visitar solo. Tus calificaciones bajan.", "lock": ""})
    }
    if L.study != null {
        let d = degree_def(L.study.deg)
        let left = L.study.months
        list_push(items, {"action": "act:study_hard", "t": "Estudiar para " + d.n, "s": "Promedio " + str(L.study.gpa), "desc": "Te faltan " + str(left) + " " + plural(left, "mes", "meses") + ". Café, apuntes subrayados y crisis existenciales. Sube tu promedio (con menos de 65 pierdes la beca).", "lock": ""})
        list_push(items, {"action": "act:study_party", "t": "Fiesta universitaria", "s": "Felicidad, encanto", "desc": "Los mejores contactos se hacen en las fiestas. Tu promedio no opina lo mismo.", "lock": ""})
        list_push(items, {"action": "act:dropout", "t": "Dejar " + d.n, "s": "Adiós título", "desc": "Muchos millonarios dejaron la escuela. Muchos más no lo son.", "lock": ""})
    } else if L.age >= 18 {
        list_push(items, {"action": "act:studymenu", "t": "Universidad y técnicas", "s": "36 carreras", "desc": "Inscríbete a una universidad o técnica. Los títulos abren profesiones (las reguladas solo con título). Paga tu familia, una beca, un préstamo o tú con tu trabajo.", "lock": ""})
    }
    if L.age >= 18 && L.edu < 2 {
        list_push(items, {"action": "act:ged", "t": "Secundaria abierta", "s": "$1,500", "desc": "Nunca es tarde para terminar la escuela. Necesaria para la universidad.", "lock": ""})
    }
    if L.gig != null {
        for it in gig_action_items() { list_push(items, it) }
    }
    if L.age >= 16 {
        let sub = "100 trabajos sin experiencia"
        if L.gig != null { sub = "Cambiar de chamba" }
        list_push(items, {"action": "act:gigmenu", "t": "Chambas de medio tiempo", "s": sub, "desc": "Mesero, albañil, bartender, repartidor... Sin experiencia, medio tiempo y compatibles con estudiar. Cada turno es un minijuego y cada mes hay una minimisión con bono.", "lock": ""})
    }
    if L.age >= 16 && L.job == null {
        list_push(items, {"action": "act:jobsearch", "t": "Buscar carrera", "s": "Más de 120 carreras", "desc": "Catálogo completo por campos. Las profesiones piden título; sin él puedes entrar como amateur pasando una audición. Puedes tener dos carreras y fusionarlas.", "lock": ""})
    }
    return items
}

// ---------------------------------------------------------------- acciones

function info(title: string, text: string) {
    G.modal = {"kind": "info", "title": title, "text": text}
    G.modal_t0 = G.t
    return null
}

function toast(title: string, sub: string) {
    list_push(G.toasts, {"title": title, "sub": sub, "t0": G.t})
}

function do_act(id: string) {
    G.modal = null
    if do_job_act(id) { return null }
    let a = find_activity(id)
    if a == null { return null }
    if L.jail > 0 { return info(a.t, "Estás en prisión.") }
    if L.age < a.min { return info(a.t, "Eres demasiado joven para eso.") }
    let bl = body_lock(a.id)
    if bl != "" { return info(a.t, "Ahora no puede ser: " + str_lower(bl) + ".") }
    if a.need != null && rank(a.need) < a.rank {
        return info(a.t, "Necesitas " + SOCIAL_NAMES[a.need] + " rango " + str(a.rank) + " para esto.")
    }
    let price = local_price(a.cost)
    // De menor lo pagan tus papás, si les alcanza.
    if parents_pay(a.cost) { price = 0 }
    if a.cost > 0 && L.money < price {
        return info(a.t, "No te alcanza. Necesitas " + money_str(price) + " y tienes " + money_str(L.money) + ".")
    }
    let used = L.used[id]
    if used == null { used = 0 }
    if used >= 1 {
        return info(a.t, "Ya hiciste eso este mes. Avanza el tiempo un poco.")
    }
    L.used[id] = used + 1
    if a.code == true {
        code_activity(id, a)
        return null
    }
    L.money -= price
    if id == "weed" && weed_risk(12) { return null }
    let o = pick_outcome(a.o)
    if a.cat == "Crimen" {
        // Con la policía tras de ti, es más fácil que te atrapen.
        for x in a.o {
            if map_has(x, "jail") && !map_has(o, "jail") && chance(heat() / 4) { o = x }
        }
        if map_has(o, "jail") {
            if map_has(o, "karma") { L.karma += o.karma }
            return caught_for(o.jail, str_lower(a.t), fmt(o.log, {}))
        }
    }
    let msg = apply(o, {})
    if a.cat == "Crimen" { add_heat(8) }
    if a.tab == "night" { hito_once("first_night", "Vida", "Tu primera noche de fiesta") }
    if a.tab == "night" && has_trait("fiesta") && L.alive {
        L.happy = clamp100(L.happy + 4)
    }
    finish(a.t, msg, outcome_kind(o))
    return null
}

// Compatibilidad: las compras de lujo pasan por la tienda de lujos.
function buy(id: string) {
    return lujos_action("lx:buy:" + id)
}

function code_activity(id: string, a: map) {
    if id == "doctor" {
        L.used[id] = L.used[id] - 1
        return health_checkup()
    }
    if id == "rehab" {
        if L.alcohol + L.drugs < 10 {
            L.used[id] = L.used[id] - 1
            return info(a.t, "No tienes adicciones... de momento.")
        }
        L.money -= local_price(a.cost)
        special("rehab", {})
        L.happy -= 5
        return finish(a.t, "Pasaste 90 días en rehabilitación. Estás limpi" + oa(L.gender) + ".", "g")
    }
    if id == "surgery" {
        L.money -= local_price(a.cost)
        if chance(75) {
            L.looks += rint(8, 18)
            return finish(a.t, "La cirugía fue un éxito. Te ves espectacular.", "g")
        }
        L.looks -= rint(10, 20)
        L.health -= 10
        return finish(a.t, "La cirugía salió mal. Pareces un gato asustado.", "b")
    }
    if id == "lottery" {
        L.money -= local_price(a.cost)
        if rint(1, 2000) == 1 {
            L.money += 1000000
            L.happy = 100
            return finish(a.t, "¡GANASTE LA LOTERÍA! $1,000,000 a tu cuenta.", "g")
        }
        if rint(1, 30) == 1 {
            L.money += 500
            return finish(a.t, "Ganaste $500. Algo es algo.", "g")
        }
        return finish(a.t, "No ganaste nada. Como siempre.", "n")
    }
    if id == "dating" { return phone_go("flama") }
    let lk = ocio_lock(a)
    if lk != "" && find_ocio(id) != null {
        L.used[id] = L.used[id] - 1
        return info(a.t, "No se puede: " + lk + ".")
    }
    if id == "hookup" {
        let person = stranger()
        let odds = 35 + looks_eff() / 2 + rank("charm") * 4 + flirt_bonus()
        if has_trait("carisma") { odds += 15 }
        if chance(odds) {
            return open_hookup({"person": person})
        }
        return finish(a.t, "Nadie se interesó esta noche. Te fuiste a casa a ver videos.", "b")
    }
    if id == "casino" {
        L.used[id] = L.used[id] - 1
        G.modal = {"kind": "menu", "tab": "fin"}
        G.menu_cat = fin_cat_index("Casino")
        G.menu_page = 0
        G.menu_t0 = G.t
        return null
    }
    return ocio_code(id, a)
}

// ---------------------------------------------------------------- ocupación

function do_job_act(id: string) {
    if id == "study" {
        let used = L.used["study"]
        if used != null { info("Escuela", "Ya estudiaste extra este mes."); return true }
        L.used["study"] = 1
        L.smarts += rint(0, 2)
        L.grades = clamp(L.grades + rint(2, 5), 0, 100)
        gain("know", rint(1, 3))
        L.happy -= 1
        finish("Escuela", "Estudiaste como nunca. Tus calificaciones suben a " + str(L.grades) + ".", "g")
        return true
    }
    if id == "skip" {
        L.grades = clamp(L.grades - rint(2, 5), 0, 100)
        L.smarts -= rint(0, 1)
        L.happy += 4
        gain("guts", 3)
        finish("Escuela", "Te saltaste clases para ir al centro comercial.", "n")
        return true
    }
    if id == "ged" {
        if L.money < 1500 { info("Secundaria abierta", "No te alcanza. Cuesta $1,500."); return true }
        L.money -= 1500
        if L.smarts >= 25 || chance(60) {
            L.edu = 2
            gain("know", 5)
            finish("Secundaria abierta", "Terminaste la secundaria abierta. Nunca es tarde.", "g")
        } else {
            finish("Secundaria abierta", "Reprobaste el examen final. Inténtalo de nuevo.", "b")
        }
        return true
    }
    if id == "study_hard" || id == "study_party" || id == "dropout" {
        let used = L.used[id]
        if used != null && id != "dropout" { info("Estudios", "Ya hiciste eso este mes."); return true }
        L.used[id] = 1
        return study_action(id)
    }
    if id == "studymenu" {
        G.modal = {"kind": "menu", "tab": "study"}
        G.menu_cat = 0
        G.menu_page = 0
        G.menu_t0 = G.t
        return true
    }
    if id == "gigmenu" {
        G.modal = {"kind": "menu", "tab": "gigs"}
        G.menu_cat = 0
        G.menu_page = 0
        G.menu_t0 = G.t
        return true
    }
    if id == "gigwork" { gig_work(false); return true }
    if id == "gigeasy" { gig_work(true); return true }
    if id == "gigquit" { gig_quit(); return true }
    if id == "practice" { start_practice(); return true }
    if id == "certify" { start_certify(); return true }
    if id == "jobsearch" {
        G.modal = {"kind": "menu", "tab": "jobs"}
        G.menu_cat = 0
        G.menu_page = 0
        G.menu_t0 = G.t
        return true
    }
    if id == "specialize" {
        if L.job.level < 2 { info("Especialización", "Necesitas llegar al rango 3."); return true }
        open_specialize()
        return true
    }
    if id == "fuse" {
        fuse_jobs()
        return true
    }
    if id == "swap" {
        let tmp = L.job
        L.job = L.job2
        L.job2 = tmp
        finish("Carreras", "Ahora tu carrera principal es " + L.job.title + ".", "n")
        return true
    }
    if id == "shift2" {
        let used = L.used["shift2"]
        if used == null { used = 0 }
        if used >= 2 { info("Segunda carrera", "Ya le dedicaste suficiente este mes."); return true }
        L.used["shift2"] = used + 1
        // Medio tiempo de verdad: cada turno es como dos semanas de un sueldo
        // a una cuarta parte (y lo ilegal sigue siendo ilegal).
        let pay = pay_of(L.job2) * 15 / 1000
        L.money += pay
        L.health -= 1
        job_xp(L.job2, 20, " (2.ª carrera)")
        let d2 = job_def(L.job2.id)
        if d2 != null && d2.illegal && chance(6) {
            let t2 = L.job2.title
            let jail = go_to_jail(2)
            finish(t2, "Te agarraron en plena chamba." + jail, "b")
            return true
        }
        finish(L.job2.title, "Le dedicaste tiempo a tu segunda carrera. Ganaste " + money_str(pay) + " extra.", "g")
        return true
    }
    if id == "quit2" {
        let t = L.job2.title
        L.job2 = null
        finish("Carreras", "Dejaste tu segunda carrera como " + t + ".", "n")
        return true
    }
    if id == "work_hard" {
        if L.used["work_hard"] != null { info("Trabajo", "Ya hiciste horas extra este mes."); return true }
        L.used["work_hard"] = 1
        let boost = rint(3, 7)
        if has_trait("ambicion") { boost += 3 }
        L.job.perf = clamp100(L.job.perf + boost)
        career_xp(6)
        gain("skill", rint(1, 2))
        L.happy -= 2
        L.health -= 1
        finish("Trabajo", "Te quedaste horas extra todo el mes. Tu jefe lo notó.", "g")
        return true
    }
    if id == "raise" {
        if L.job.raise_age == L.age { info("Trabajo", "Ya pediste un aumento este año. Espera a tu próximo cumpleaños."); return true }
        L.job.raise_age = L.age
        let odds = 35 + rank("guts") * 6
        if has_trait("ambicion") { odds += 15 }
        if L.job.perf >= 60 && chance(odds) {
            L.job.bonus = L.job.bonus + 10
            gain("guts", 3)
            finish("Trabajo", "¡Te dieron un aumento! Ahora ganas " + money_str(job_pay(L.job)) + " al año.", "g")
        } else {
            L.job.perf -= 5
            finish("Trabajo", "Tu jefe se rió en tu cara.", "b")
        }
        return true
    }
    if id == "quit" {
        hito_me("Trabajo", "Renunciaste a tu trabajo como " + str_lower(L.job.title))
        L.last_job = L.job.title
        L.job = null
        finish("Trabajo", "Renunciaste. Libertad... y cero ingresos.", "n")
        return true
    }
    if id == "behave" {
        if chance(40) {
            L.jail -= 1
            if L.jail <= 0 {
                L.jail = 0
                finish("Prisión", "Te dieron libertad anticipada por buena conducta.", "g")
            } else {
                finish("Prisión", "Te redujeron la condena un año por buena conducta.", "g")
            }
        } else {
            finish("Prisión", "Te portaste bien. Nadie lo notó.", "n")
        }
        gain("kind", 2)
        return true
    }
    if id == "yard" {
        gain("guts", 4)
        if chance(40 + rank("guts") * 8) {
            L.happy += 5
            L.health -= 5
            finish("Prisión", "Ganaste la pelea. Ahora te respetan en el patio.", "g")
        } else {
            L.health -= 20
            finish("Prisión", "Te mandaron a la enfermería con tres costillas rotas.", "b")
        }
        return true
    }
    if id == "escape" {
        if chance(8 + rank("skill") * 3) {
            L.jail = 0
            L.record += 1
            flag("escape")
            hito_me("Vida", "Escapaste de prisión")
            finish("Prisión", "¡Escapaste! Ahora eres prófug" + oa(L.gender) + ".", "g")
        } else {
            L.jail += 2
            L.jail_total += 2
            finish("Prisión", "Te atraparon trepando la barda. Dos años más.", "b")
        }
        return true
    }
    return false
}

// ---------------------------------------------------------------- encuentros

function open_hookup(ctx: map) {
    let x = ctx.person
    if blood_rel(x) || x.age < 18 || L.age < 18 {
        return info("Encuentro", "No. Eso no va a pasar.")
    }
    let likes = ""
    if x.tags != null && len(x.tags) > 0 { likes = " Le gusta: " + kinks_text(x.tags, x.gender) + "." }
    let shared = shared_kinks(x)
    if len(shared) > 0 { likes = likes + " ¡Comparten gustos!" }
    open_choice(
        "ENCUENTRO CON " + str_upper(x.first),
        fmt("{x} ({edad} años, atractivo " + str(x.looks) + "%) está más que dispuest{xa}." + likes + " ¿Cómo quieres que sea?", ctx),
        ["Con protección", "Sin protección", "Mejor no"],
        ["", "", ""],
        "hookup",
        ctx
    )
    return null
}

function resolve_hookup(index: int, ctx: map) {
    G.modal = null
    let x = ctx.person
    if index == 2 {
        return finish("Encuentro", "Cambiaste de opinión y te fuiste a casa.", "n")
    }
    let o = {"log": pick(HOOKUP_LINES), "happy": 4 + x.looks / 12, "sex": true, "preg": 2, "charm": 2}
    G.sex_mode = "prot"
    if index == 1 {
        G.sex_mode = "raw"
        o.preg = 25
    }
    if has_kink("insaciable") { o.happy = o.happy + 3 }
    o.happy = max(0, o.happy + fx_sum("sexhappy"))
    let shared = shared_kinks(x)
    if len(shared) > 0 {
        o.log = o.log + " Descubrieron que comparten un gusto: " + kink_name(shared[0], L.gender) + ". Noche legendaria."
        o.happy = o.happy + 6
        o.flag = "kink"
        if has_kink("trios") && shared[0] == "trios" { o.count = 1 }
    }
    let msg = apply(o, ctx)
    G.sex_mode = ""
    return finish("Encuentro con " + x.first, msg, "x")
}

function open_dating() {
    let x = stranger()
    let ctx = {"person": x}
    open_choice(
        fmt("MATCH: {x}, {edad}", ctx),
        fmt("Su bio dice: «" + pick(BIOS) + "» Atractivo: " + str(x.looks) + "%.", ctx),
        [fmt("Invitarl{xlo} a una cita", ctx), "Ir directo al grano", "Deslizar a la izquierda"],
        ["", "", ""],
        "date",
        ctx
    )
    return null
}

function resolve_date(index: int, ctx: map) {
    G.modal = null
    let x = ctx.person
    if index == 0 {
        let odds = 55 + (looks_eff() - x.looks) / 3 + rank("charm") * 4 + flirt_bonus()
        if has_trait("carisma") || has_trait("romance") { odds += 10 }
        if chance(odds) {
            L.happy += 8
            gain("charm", 3)
            let msg = "La cita con " + x.first + " fue increíble. Hubo química."
            msg = msg + special("new_partner", ctx)
            return finish("Cita", msg, "x")
        }
        L.happy -= 4
        return finish("Cita", x.first + " habló de su ex toda la noche. Desastre.", "b")
    }
    if index == 1 {
        if looks_eff() + rint(0, 50) + rank("charm") * 5 + flirt_bonus() >= x.looks {
            return open_hookup(ctx)
        }
        L.happy -= 3
        return finish("App de citas", x.first + " te dejó en visto después de tu primer mensaje.", "b")
    }
    return finish("App de citas", "Deslizaste a la izquierda. Siguiente.", "n")
}

function open_casino() {
    let tenth = max(100, L.money / 10)
    open_choice(
        "CASINO",
        "Las luces, el ruido, la ruleta. Tienes " + money_str(L.money) + ". ¿Cuánto apuestas?",
        ["Apostar $100", "Apostar " + money_str(tenth), "Apostarlo TODO (" + money_str(L.money) + ")", "Mejor no"],
        ["", "", "", ""],
        "casino",
        {"amounts": [100, tenth, L.money]}
    )
    return null
}

function resolve_casino(index: int, ctx: map) {
    G.modal = null
    if index == 3 { return finish("Casino", "Te fuiste sin apostar. Sabia decisión.", "n") }
    let amount = ctx.amounts[index]
    if amount > L.money || amount <= 0 { return finish("Casino", "No tienes tanto dinero.", "b") }
    gain("guts", 2)
    if chance(45) {
        L.money += amount
        L.happy += 8
        return finish("Casino", "¡Ganaste " + money_str(amount) + "! La ruleta te ama.", "g")
    }
    L.money -= amount
    L.happy -= 8
    return finish("Casino", "Perdiste " + money_str(amount) + ". La casa siempre gana.", "b")
}

// ---------------------------------------------------------------- vínculos

function bond_gain(p: map, amount: int) {
    let before = conf_rank(p)
    let gained = amount
    if has_trait("romance") && amount > 0 { gained = amount * 3 / 2 }
    p.bond = clamp100(p.bond + gained)
    let after = conf_rank(p)
    if after >= 10 && before < 10 { add_hito(p, "Vínculo al máximo: confidentes para siempre") }
    if after > before {
        list_push(G.toasts, {"head": "¡CONFIDENTE!", "title": str_upper(arcana(p)) + " · RANGO " + str(after), "sub": "Tu vínculo con " + p.first + " se fortaleció.", "t0": G.t})
    }
}

// Cuánto dinero pueden darte tus papás: depende de la clase de la familia,
// de tu edad (un niño recibe para dulces) y de cuántas veces ya les pediste.
function parent_money_range() {
    let lo = 100
    let hi = 1500
    if L.family == "pobre" {
        lo = 20
        hi = 200
    }
    if L.family == "rica" {
        lo = 1000
        hi = 15000
    }
    if L.age < 12 {
        lo = max(5, lo / 20)
        hi = max(20, hi / 15)
    } else if L.age < 18 {
        lo = max(10, lo / 4)
        hi = max(50, hi / 3)
    }
    return [lo, hi]
}

function money_ask_hint(p: map) {
    if L.age >= 25 { return "A tu edad, da pena" }
    if L.age < 12 { return "Para dulces" }
    return "Si te quiere lo suficiente"
}

function ask_parent_money(p: map) {
    let name = p.first
    let odds = 60
    if L.age >= 18 { odds = 40 }
    if L.age >= 25 { odds = 25 }
    if p.bond < 50 { odds = odds / 3 }
    if L.age >= 25 { bond_gain(p, -2) }
    if chance(odds) {
        let r = parent_money_range()
        let amount = rint(r[0], r[1])
        if amount >= 100 { amount = amount / 10 * 10 }
        L.money += amount
        if L.age < 12 { return finish(name, name + " te dio " + money_str(amount) + " para tus cosas. «No le digas a tus hermanos.»", "g") }
        if L.age >= 25 { return finish(name, name + " suspiró y te prestó " + money_str(amount) + ". «¿Otra vez?»", "n") }
        return finish(name, name + " te dio " + money_str(amount) + ".", "g")
    }
    bond_gain(p, -3)
    if L.age < 12 { return finish(name, name + " te dijo que el dinero no crece en los árboles.", "b") }
    if L.age >= 25 { return finish(name, name + " te dijo que ya estás grandecit" + oa(L.gender) + " para eso.", "b") }
    return finish(name, name + " te dijo que te pongas a trabajar.", "b")
}

function do_person_act(action: string, p: map) {
    G.modal = null
    touch(p)
    let ctx = {"person": p}
    let name = p.first
    if action == "dlg" {
        let key = "dlg" + str(p.id)
        if L.used[key] != null { return info(name, name + " ya habló contigo este mes. Dale su espacio.") }
        L.used[key] = 1
        return start_dialog(tree_for(p), p)
    }
    if list_contains(["homework", "ground", "allowance", "kiduni", "kickout", "heir", "unheir"], action) {
        return do_kid_act(action, p)
    }
    if list_contains(PACT_MONTHLY, action) {
        if pact_used(action, p) { return info(name, "Ya lo hicieron este mes. Dale su espacio.") }
        L.used[pact_key(action, p)] = 1
    }
    if action == "wealth" {
        if p.bond < 40 && p.id != L.partner_id {
            bond_gain(p, -3)
            return finish(name, name + " cambió de tema. Preguntar eso tan pronto no fue elegante.", "b")
        }
        p.wealth_known = true
        return info(name, fortune_line(p))
    }
    if action == "babble" {
        bond_gain(p, rint(3, 6))
        L.happy += 2
        return finish(name, "Le dijiste «gugu» a " + name + " y le derretiste el corazón.", "g")
    }
    if action == "faces" || action == "sing" {
        bond_gain(p, rint(3, 7))
        L.happy += 2
        if action == "sing" { return finish(name, "Le cantaste a " + name + " hasta que se quedó dormid" + oa(p.gender) + ".", "g") }
        return finish(name, name + " se rió con tus caritas. Ese sonido lo cura todo.", "g")
    }
    if action == "tantrum" {
        bond_gain(p, -3)
        L.happy += 1
        return finish(name, "Hiciste un berrinche épico en el súper. " + name + " fingió que no te conocía.", "b")
    }
    if action == "time" {
        bond_gain(p, rint(5, 12))
        L.happy += 3
        gain("kind", 2)
        return finish(name, "Pasaste tiempo con " + name + ". Se divirtieron.", "g")
    }
    if action == "talk" {
        bond_gain(p, rint(2, 6))
        gain("kind", 1)
        return finish(name, "Platicaste con " + name + " de la vida.", "n")
    }
    if action == "argue" {
        add_hito(p, "Su primera pelea")
        bond_gain(p, -rint(8, 15))
        L.happy -= 3
        gain("guts", 1)
        return finish(name, "Discutiste con " + name + " por una tontería. Ahora no se hablan.", "b")
    }
    if action == "insult" {
        bond_gain(p, -20)
        L.karma -= 3
        return finish(name, "Le dijiste a " + name + " cosas que no se olvidan.", "b")
    }
    if action == "money" {
        return ask_parent_money(p)
    }
    if action == "romance" {
        if has_kink("romantico") { bond_gain(p, 5) }
        bond_gain(p, 10)
        L.happy += 8
        sex_with(p)
        return finish(name, "Cena, vino y una noche que terminó como tenía que terminar.", "x")
    }
    if action == "baby" {
        if p.gender == L.gender {
            return finish(name, "Biológicamente complicado. Tal vez podrían adoptar algún día.", "n")
        }
        let her_age = p.age
        if L.gender == "f" { her_age = L.age }
        if her_age > 45 { return finish(name, "A estas alturas ya no es posible.", "n") }
        if L.pregnant || L.partner_preg { return finish(name, "Ya viene un bebé en camino.", "n") }
        L.happy += 3
        G.sex_mode = "raw"
        sex_with(p)
        G.sex_mode = ""
        if chance(45) {
            if L.gender == "f" {
                L.pregnant = true
                L.preg_with = name
                return finish(name, "¡Estás embarazada! El bebé nacerá en unos meses.", "g")
            }
            L.partner_preg = true
            return finish(name, "¡" + name + " está embarazada! El bebé nacerá en unos meses.", "g")
        }
        return finish(name, "Lo intentaron mucho. Este mes no hubo suerte (pero sí diversión).", "x")
    }
    if action == "threesome" {
        let odds = 35 + rank("charm") * 6
        if has_kink("trios") { odds += 20 }
        if chance(odds) {
            let msg = apply({"log": name + " aceptó. Fue una noche épica.", "happy": 12, "count": 1, "bond": 5, "std": 8, "flag": "trio"}, ctx)
            return finish(name, msg, "x")
        }
        bond_gain(p, -20)
        return finish(name, name + " se ofendió muchísimo. Hoy duermes en el sillón.", "b")
    }
    if action == "propose" {
        if chance(p.bond - 10 + rank("guts") * 3) {
            add_hito(p, "Se comprometieron")
            hito_once("engaged", "Amor", "Te comprometiste")
            p["wed_by_them"] = false
            return begin_wedding(p)
        }
        bond_gain(p, -10)
        return finish(name, name + " dijo que no está list" + oa(p.gender) + ". Qué incómodo.", "b")
    }
    if action == "breakup" && p.id != L.partner_id {
        p.rel = "ex"
        p.cospouse = false
        L.happy -= 5
        return finish(name, "Te separaste de " + name + ".", "b")
    }
    if action == "breakup" {
        let was_married = L.married
        breakup()
        L.happy -= 5
        if was_married { return finish(name, "Te divorciaste de " + name + ".", "b") }
        return finish(name, "Terminaste con " + name + ".", "b")
    }
    if action == "again" {
        if L.partner_id == 0 && chance(p.bond) {
            make_partner(p)
            return finish(name, "Volvieron. Esta vez será diferente (no lo será).", "x")
        }
        return finish(name, name + " te dijo que ni loc" + oa(p.gender) + ".", "b")
    }
    if action == "hookup" { return open_hookup(ctx) }
    if action == "official" {
        make_partner(p)
        return finish(name, "Ahora es oficial: " + name + " y tú son pareja.", "g")
    }
    if action == "end" {
        p.rel = "ex"
        return finish(name, "Terminaste la aventura con " + name + ".", "n")
    }
    if action == "party" {
        bond_gain(p, 5)
        L.happy += 6
        L.alcohol += 4
        gain("charm", 2)
        return finish(name, "Salieron de fiesta y acabaron cantando en un karaoke.", "g")
    }
    return null
}

// ---------------------------------------------------------------- efectos especiales

// Lo que nunca debe abrirse para menores, venga del evento que venga.
const ADULT_SPECIALS = ["hookup", "hookup_young", "lovehotel", "swinger", "collab", "z_affair", "z_sugar_marry"]

// Una sobredosis no es una moneda al aire: casi siempre se sobrevive, salvo con
// el corazón ya dañado, la salud por los suelos o una adicción fuerte.
function coke_overdose() {
    let risk = 10
    if L.drugs >= 60 { risk += 40 }
    if has_ill("cardiopatia") { risk += 60 }
    if L.health < 30 { risk += 40 }
    if chance(min(90, risk)) {
        L.dying = "una sobredosis de cocaína"
        return "Tu corazón no aguantó."
    }
    L.health -= 30
    L.money -= emergency_cost(3000)
    hito_once("coke_od", "Salud", "Sobreviviste a una sobredosis")
    return "Sobredosis: el corazón se te desbocó y despertaste en urgencias con electrodos en el pecho. Los médicos dicen que tuviste suerte. La próxima vez, quizá no."
}

function special(name: string, ctx: map) {
    if name == "coke_od" { return coke_overdose() }
    if L.age < 18 && list_contains(ADULT_SPECIALS, name) { return "" }
    if str_starts_with(name, "z_") { return lazos_special(name, ctx) }
    if str_starts_with(name, "vd_") { return vida_special(name, ctx) }
    if str_starts_with(name, "oc_") { return ocio_special(name, ctx) }
    if str_starts_with(name, "of_") { return oficio_special(name, ctx) }
    if str_starts_with(name, "dn_") { return dinero_special(name, ctx) }
    if str_starts_with(name, "lx_") { return lujos_special(name, ctx) }
    if str_starts_with(name, "fe_") { return fe_special(name, ctx) }
    if str_starts_with(name, "pr_") { return prison_special(name, ctx) }
    if str_starts_with(name, "kid_") || name == "comeback" { return kid_special(name, ctx) }
    if str_starts_with(name, "hito:") || name == "sweet_end" || name == "sweet_moved" { return sweet_special(name, ctx) }
    if str_starts_with(name, "event:") {
        let ev = find_event(str_replace(name, "event:", ""))
        // Respeta la edad del evento (p. ej. ligar en un bar solo de adulto).
        if ev != null && (ev.min == null || L.age >= ev.min) && (ev.max == null || L.age <= ev.max) { open_event(ev, event_ctx(ev)) }
        return ""
    }
    if name == "hookup" {
        // Alguien de la familia o un menor nunca: entonces es otra persona.
        let p = ctx["person"]
        if p == null || blood_rel(p) || is_family(p) || p.age < 18 { ctx["person"] = stranger() }
        open_hookup(ctx)
        return ""
    }
    if name == "hookup_young" {
        ctx["person"] = stranger_aged(20, 26)
        open_hookup(ctx)
        return ""
    }
    if name == "new_partner" {
        let p = ctx["person"]
        if p == null { p = stranger() }
        if make_partner(p) {
            return " Ahora " + p.first + " es tu " + str_lower(rel_label(p)) + "."
        }
        if minor_mix(p) { return "" }
        return " " + p.first + " ahora es tu amante: llevas una doble vida."
    }
    if name == "vegas_marry" {
        let p = ctx["person"]
        if p != null && make_partner(p) {
            marry()
            return " Ahora " + p.first + " es tu " + str_lower(rel_label(p)) + "."
        }
        return ""
    }
    if name == "add_friend" {
        let p = ctx["person"]
        if p != null {
            if !p.known { add_person(p) }
            p.rel = "amigo"
        }
        return ""
    }
    if name == "breakup" {
        breakup()
        return ""
    }
    if name == "baby" {
        let other = "alguien"
        if ctx["person"] != null { other = ctx["person"].first }
        add_child(other)
        return ""
    }
    if name == "marry" {
        // Un anillo en un evento también pasa por la ley del país, el contrato y el estilo de boda.
        let pr = partner()
        if pr != null {
            // Te lo pidió a ti: la ventana de la boda lo dice así.
            pr["wed_by_them"] = true
            begin_wedding(pr)
        }
        return ""
    }
    if name == "rehab" {
        hito_me("Salud", "Saliste de rehabilitación")
        L.alcohol = 0
        L.drugs = 0
        L.health += 10
        // Sales limpi@: los hábitos adictivos se quedan en la clínica (y empieza
        // el año difícil de no recaer).
        let keep = []
        if L.quit == null { L.quit = {} }
        for x in L.habits {
            let h = habit_def(x)
            if h != null && h.addict {
                L.quit[x] = L.tm
            } else {
                list_push(keep, x)
            }
        }
        L.habits = keep
        return ""
    }
    if name == "family_hate" {
        for p in L.people {
            if p.alive && (p.rel == "padre" || p.rel == "madre" || p.rel == "hermano") {
                p.bond = clamp100(p.bond - 30)
            }
        }
        return ""
    }
    if name == "fired" {
        if L.job != null {
            L.last_job = L.job.title
            L.job = null
        }
        return ""
    }
    if name == "promo" {
        if L.job == null { return "" }
        L.job.bonus = L.job.bonus + 15
        L.job.perf = clamp100(L.job.perf + 10)
        return " Nuevo sueldo: " + money_str(job_pay(L.job)) + " al año."
    }
    if name == "creator" {
        if L.job != null { L.last_job = L.job.title }
        L.job = new_job("cam")
        remember_job("cam")
        L.job.level = 1
        L.job.xp = XP_TABLE[1]
        L.fame = clamp100(L.fame + 15)
        return " Ahora eres " + str_lower(L.job.title) + "."
    }
    if str_starts_with(name, "kink:") {
        let k = str_replace(name, "kink:", "")
        if has_kink(k) || len(L.tags) >= 5 { return "" }
        list_push(L.tags, k)
        return " Descubriste un nuevo gusto: " + kink_name(k, L.gender) + "."
    }
    if name == "lovehotel" {
        let p = partner()
        if p != null && both_adults(p) {
            bond_gain(p, 12)
            L.happy += 10
            sex_with(p)
            return "Una noche en la suite temática con " + p.first + ". Probaron el jacuzzi, el columpio y todo lo demás."
        }
        ctx["person"] = stranger()
        open_hookup(ctx)
        return ""
    }
    if name == "swinger" {
        let p = partner()
        if p != null && !both_adults(p) { p = null }
        if p != null && chance(55) {
            L.happy += 12
            L.partners += 1
            flag("trio")
            bond_gain(p, 5)
            return "Fueron con " + p.first + " y la noche fue... educativa. Volvieron más unidos."
        }
        if p != null {
            bond_gain(p, -15)
            return p.first + " se sintió incómod" + oa(p.gender) + " y se fueron a la media hora."
        }
        ctx["person"] = stranger()
        open_hookup(ctx)
        return ""
    }
    if name == "gig_raise" {
        if L.gig == null { return "" }
        L.gig.pay = L.gig.pay * 115 / 100
        L.gig.perf = clamp100(L.gig.perf + 10)
        return " Tu sueldo sube a " + money_str(L.gig.pay) + " al mes."
    }
    if name == "gig_fired" {
        if L.gig == null { return "" }
        let t = L.gig.title
        L.gig = null
        return " Perdiste tu trabajo como " + str_lower(t) + "."
    }
    if name == "gig_quit" {
        L.gig = null
        return ""
    }
    if name == "career_raise" {
        if L.job != null { L.job.bonus = L.job.bonus + 15 }
        return " Tus ingresos suben un 15%."
    }
    if name == "kink_scene" {
        if len(L.tags) == 0 { return "" }
        let t = pick(L.tags)
        career_xp(45)
        L.fame = clamp100(L.fame + 6)
        L.happy += 8
        L.money += 5000
        return "Grabaste una escena de tu especialidad («" + kink_name(t, L.gender) + "»). Se nota que lo disfrutas: los fans enloquecieron. +$5,000."
    }
    if name == "clinic" {
        career_xp(10)
        return its_test()
    }
    if name == "collab" {
        let p = stranger()
        p.tags = L.tags
        ctx["person"] = p
        career_xp(30)
        L.fame = clamp100(L.fame + 8)
        open_hookup(ctx)
        return ""
    }
    return ""
}

// Descubriste que tu pareja te engaña: tú decides qué hacer.
function maybe_caught_event() {
    if L.caught_id == null { return false }
    let p = find_person(L.caught_id)
    L.caught_id = null
    if p == null || !p.alive || p.id != L.partner_id { return false }
    let ctx = {"person": p}
    let leave = "Terminar con {x}"
    if L.married { leave = "Pedir el divorcio" }
    open_choice("LO DESCUBRISTE", fmt("Encontraste mensajes en el celular de {x}. Coquetos. Recientes. Te está engañando y te tiemblan las manos.", ctx),
        [fmt("Confrontarl{xlo}", ctx), "Fingir que no viste nada", fmt(leave, ctx)], ["", "", ""], "caught", ctx)
    return true
}

function resolve_caught(index: int, ctx: map) {
    G.modal = null
    let p = ctx.person
    if index == 0 {
        bond_gain(p, -10)
        L.happy -= 8
        if tree_for(p) != "" && L.used["dlg" + str(p.id)] == null {
            L.used["dlg" + str(p.id)] = 1
            log_add("Le pusiste el celular enfrente a " + p.first + ".", "b")
            return start_dialog(tree_for(p), p)
        }
        p.bond = clamp100(p.bond - 10)
        return finish(p.first, "Le pusiste el celular enfrente a " + p.first + ". Lloró, lo negó y luego lo admitió. Nada volverá a ser igual.", "b")
    }
    if index == 1 {
        bond_gain(p, -5)
        L.happy -= 12
        return finish(p.first, "Fingiste que no viste nada. Por dentro, algo se rompió.", "b")
    }
    let was_married = L.married
    breakup()
    L.happy -= 10
    gain("guts", 2)
    if was_married { return finish(p.first, "Le pediste el divorcio a " + p.first + ". Sin gritos: ya no había nada que decir.", "b") }
    return finish(p.first, "Terminaste con " + p.first + ". Te dolió, pero te elegiste a ti.", "b")
}

function dispatch_choice(index: int) {
    let m = G.modal
    if m == null || m.kind != "choice" { return null }
    if index < 0 || index >= len(m.choices) { return null }
    if m.locks != null && m.locks[index] != "" { return null }
    if m.handler == "event" { return resolve_event(m.ev, index, m.ctx) }
    if m.handler == "hookup" { return resolve_hookup(index, m.ctx) }
    if m.handler == "caught" { return resolve_caught(index, m.ctx) }
    if m.handler == "npc_invite" { return resolve_npc_invite(index, m.ctx) }
    if m.handler == "notices" { return resolve_notices(index, m.ctx) }
    if str_starts_with(m.handler, "bw_") { return bw_resolve(m.handler, index, m.ctx) }
    if m.handler == "date" { return resolve_date(index, m.ctx) }
    if m.handler == "casino" { return resolve_casino(index, m.ctx) }
    if m.handler == "takejob" { return resolve_takejob(index, m.ctx) }
    if m.handler == "spec" { return resolve_spec(index) }
    if m.handler == "exam" { return resolve_exam(index, m.ctx) }
    if m.handler == "enroll" { return resolve_enroll(index, m.ctx) }
    if m.handler == "audition" { return resolve_audition(index, m.ctx) }
    if m.handler == "dialog" { return dlg_choose(index) }
    if m.handler == "retire" { return resolve_retire(index) }
    if m.handler == "gift" { return resolve_gift(index, m.ctx) }
    if m.handler == "sex" { return resolve_sex(index, m.ctx) }
    if m.handler == "spicy" { return resolve_spicy(index, m.ctx) }
    if m.handler == "wedding" { return resolve_wedding(index, m.ctx) }
    if m.handler == "trio" { return resolve_trio(index, m.ctx) }
    if m.handler == "initiative" { return resolve_initiative(index, m.ctx) }
    if m.handler == "fin_life" {
        G.modal = null
        if index >= len(LIFESTYLES) { return null }
        L.lifestyle = LIFESTYLES[index]
        return finish("Estilo de vida", "Ahora llevas un estilo de vida " + str_lower(LIFE_NAMES[L.lifestyle]) + ".", "n")
    }
    if m.handler == "fin_amount" { return resolve_amount(index, m.ctx) }
    if m.handler == "stock" { return resolve_stock(index, m.ctx) }
    if m.handler == "loan" { return resolve_loan(index) }
    if m.handler == "house" { return resolve_house(index, m.ctx) }
    if m.handler == "home" { return resolve_home(index) }
    if m.handler == "taxes" { return resolve_taxes(index, m.ctx) }
    if m.handler == "prenup" { return resolve_prenup(index, m.ctx) }
    if m.handler == "faith_partner" || m.handler == "faith_job" || m.handler == "faith_livein" { return resolve_faith(m.handler, index, m.ctx) }
    if m.handler == "convert" { return resolve_convert(index, m.ctx) }
    if m.handler == "niche" { return resolve_niche(index) }
    if m.handler == "fprice" { return resolve_fprice(index) }
    if str_starts_with(m.handler, "z_") { return lazos_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "oc_") { return ocio_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "hx_") { return health_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "es_") { return escuela_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "of_") { return oficio_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "dn_") { return dinero_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "mk_") { return mercado_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "cs_") { return casino_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "lx_") { return lujos_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "fe_") { return fe_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "vl_") { return velo_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "kr_") { return corona_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "pl_") { return politica_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "cc_") { return contenido_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "sp_") { return marte_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "x8_") { return rutas18_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "ap_") { return apps_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "vd_") { return vida_choice(m.handler, index, m.ctx) }
    if str_starts_with(m.handler, "pa_") { return pais_choice(m.handler, index, m.ctx) }
    if m.handler == "ph_match" { return resolve_match(index, m.ctx) }
    if m.handler == "ph_flirt" { return resolve_flirt(index, m.ctx) }
    if m.handler == "ph_alma" { return resolve_alma(index, m.ctx) }
    if m.handler == "ph_plan" { return resolve_plan(index, m.ctx) }
    if m.handler == "ph_solo" { return resolve_solo(index, m.ctx) }
    if m.handler == "ph_couple" { return resolve_couple(index, m.ctx) }
    if m.handler == "crisis" { return resolve_crisis(index, m.ctx) }
    if m.handler == "claim" { return resolve_claim(index) }
    if m.handler == "party" { return resolve_party(index) }
    return null
}

// Lo físico depende del cuerpo: con yeso, quimioterapia, el corazón o los
// pulmones dañados, la salud por los suelos o muchos años, no todo se puede.
const BODY_ACTS = ["gym", "boxing", "dance", "climb", "marathon", "skydive", "rave", "gymflirt"]
const EXTREME_ACTS = ["boxing", "climb", "marathon", "skydive", "rave"]

function body_lock(id: string) {
    if !list_contains(BODY_ACTS, id) { return "" }
    if has_ill("fractura") { return "Lesión" }
    for i in L.ill {
        if i.treated && ill_def(i.id).type == "cancer" { return "Quimioterapia" }
    }
    if L.health < 25 { return "Salud baja" }
    if list_contains(EXTREME_ACTS, id) {
        if has_ill("cardiopatia") { return "Corazón" }
        if has_ill("epoc") { return "Pulmones" }
        if L.age >= 80 { return "Edad" }
    }
    return ""
}
