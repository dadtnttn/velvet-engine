// @edition 3
// Vida Sin Filtro — simulador de vida para adultos hecho en Velvet Script 3.
// Contrato del runtime declarativo: app_manifest / app_init / app_update / app_action,
// más app_fonts (métricas de texto) y app_storage (respuestas del guardado).

import "data.vel"
import "sim.vel"
import "events.vel"
import "acts.vel"
import "career.vel"
import "jobs.vel"
import "minigames.vel"
import "edu.vel"
import "gigs.vel"
import "dialogue.vel"
import "health.vel"
import "family.vel"
import "effects.vel"
import "relations.vel"
import "chat.vel"
import "sweethearts.vel"
import "milestones.vel"
import "bonds.vel"
import "finance.vel"
import "religion.vel"
import "routes.vel"
import "realm.vel"
import "space.vel"
import "lazos.vel"
import "ocio.vel"
import "medicina.vel"
import "escuela.vel"
import "oficio.vel"
import "dinero.vel"
import "mercado.vel"
import "casino.vel"
import "lujos.vel"
import "fe.vel"
import "velo.vel"
import "corona.vel"
import "politica.vel"
import "contenido.vel"
import "marte.vel"
import "rutas18.vel"
import "prision.vel"
import "phone.vel"
import "phone_ui.vel"
import "save.vel"
import "art.vel"
import "ui.vel"

export function app_manifest() {
    return {
        "app": {
            "title": "Vida Sin Filtro",
            "window_width": 1280,
            "window_height": 720,
            "minimum_width": 960,
            "minimum_height": 540,
            "canvas_width": 1280,
            "canvas_height": 720,
            "resizable": true
        },
        "capabilities": ["window", "render2d", "input", "storage"],
        "limits": {
            "max_commands_per_frame": 8192,
            "max_instructions": 40000000
        },
        "root": "assets",
        "fonts": [
            {"id": "ui", "path": "system:segoeui.ttf"},
            {"id": "bold", "path": "system:segoeuib.ttf"},
            {"id": "impact", "path": "system:impact.ttf"}
        ],
        "images": []
    }
}

export function app_init() {
    enter_title()
    request_boot_load()
    return frame()
}

// El host entrega el ancho de cada letra por fuente (a tamaño 100).
export function app_fonts(metrics: map) {
    FONTS = metrics
}

// Respuesta a storage.save / storage.load / storage.delete.
export function app_storage(result: map) {
    save_result(result)
    return frame()
}

export function app_update(dt: float, input: map) {
    G.frames += 1
    G.t += dt
    track_pointer(input.pointer)
    if G.mg != null {
        let before = snapshot()
        let phase = G.mg.phase
        mg_tick()
        if G.mg == null || G.mg.phase != phase { G.dirty = true }
        report(before, 0.0)
    }
    if G.roul != null && roulette_tick() { G.dirty = true }
    handle_input(input)
    if animating() { G.dirty = true }
    return frame()
}

export function app_action(action: string) {
    handle_action(action)
    G.dirty = true
    return frame()
}

// Evento para el host en el próximo frame.
function emit(kind: string, payload: map) {
    list_push(G.out, {"kind": kind, "payload": payload})
}

// Tareas largas del runtime: corren repartidas en varios frames.
export function app_task(name: string, arg: any) {
    match name {
        "years" => skip_years(int(arg))
        _ => {}
    }
    G.dirty = true
    return frame()
}

// Avanza varios años, uno por frame, con barra de progreso. Se detiene si algo
// requiere una decisión, si mueres o si cancelas (botón o Esc).
function skip_years(n: int) {
    if G.mode != "game" || !L.alive || G.modal != null { return null }
    let before = snapshot()
    G.skip = {"total": n, "done": 0, "from": L.age, "t0": G.t}
    let y = 0
    while y < n && L.alive && G.modal == null && G.mode == "game" {
        if advance_year() {
            y += 1
            autosave()
        }
        G.skip.done = y
        G.dirty = true
        let ev = yield(frame())
        G.t += ev.dt
        if ev.input != null { track_pointer(ev.input.pointer) }
        if ev.action == "skip:cancel" { break }
        if ev.input != null && list_contains(ev.input.pressed, "Escape") { break }
    }
    G.skip = null
    report(before, 0.0)
    if !L.alive { G.screen_t0 = G.t }
}

function frame() {
    if phone_resume() { G.dirty = true }
    if G.dirty {
        G.cache = build()
        G.dirty = false
        // El área bajo el puntero puede haber cambiado con el nuevo frame.
        if update_hover() { G.cache = build() }
    }
    let events = G.out
    G.out = []
    if G.quit { list_push(events, {"kind": "app.exit", "payload": {}}) }
    return {"time": G.t, "commands": G.cache, "events": events}
}

// ---------------------------------------------------------------- puntero y animación

function track_pointer(p: any) {
    if p == null { return null }
    if p.x == G.px && p.y == G.py { return null }
    G.px = p.x
    G.py = p.y
    if update_hover() { G.dirty = true }
    return null
}

// Recalcula la zona activa bajo el puntero; devuelve true si cambió.
function update_hover() {
    let found = ""
    for h in G.hot {
        if G.px >= h.x && G.py >= h.y && G.px < h.x + h.w && G.py < h.y + h.h {
            found = h.a
        }
    }
    if found == G.hover { return false }
    G.hover = found
    return true
}

function animating() {
    if G.t - G.screen_t0 < 0.8 { return true }
    if G.modal != null && G.t - G.menu_t0 < 0.6 { return true }
    if G.modal != null && G.t - G.modal_t0 < 0.35 { return true }
    if G.mg != null { return true }
    if G.roul != null && G.t - G.roul.t0 < 6.0 { return true }
    if G.chat != null && (G.t - G.chat.t0 < 2.0 || chat_pending()) { return true }
    if G.t - G.cut_t0 < 1.1 { return true }
    if len(G.toasts) > 0 { return true }
    for f in G.floats {
        if G.t - f.t0 < 1.7 { return true }
    }
    // Animación continua de los personajes (respirar, parpadear) a 30 fps.
    if G.mode == "title" || G.mode == "create" || G.mode == "game" {
        let tick = floor(G.t * 30.0)
        if tick != G.anim_tick {
            G.anim_tick = tick
            return true
        }
    }
    return false
}

// ---------------------------------------------------------------- teclado y rueda

function pressed(input: map, key: string) {
    return list_contains(input.pressed, key)
}

function handle_input(input: map) {
    if input.wheel != 0.0 && G.mode == "game" && G.modal == null {
        if input.wheel > 0.0 { G.scroll += 3 } else { G.scroll = max(0, G.scroll - 3) }
        G.dirty = true
    }
    if len(input.pressed) == 0 { return null }
    G.dirty = true
    if G.mode == "title" {
        if pressed(input, "Enter") { handle_action("new") }
        return null
    }
    if G.mode == "create" { return creator_keys(input) }
    if G.mode == "dead" {
        if pressed(input, "Enter") { handle_action("again") }
        return null
    }
    let m = G.modal
    if m == null {
        if pressed(input, "Space") || pressed(input, "Enter") { handle_action("age") }
        if pressed(input, "KeyY") { handle_action("year") }
        if pressed(input, "KeyU") { handle_action("skip:5") }
        if pressed(input, "KeyM") { handle_action("ph:open") }
        return null
    }
    if G.t < G.modal_t0 { return null }
    if m.kind == "minigame" {
        let before = snapshot()
        mg_keys(input)
        if pressed(input, "Escape") && G.mg != null { mg_action("mg:quit") }
        report(before, 0.0)
        return null
    }
    if m.kind == "info" {
        if pressed(input, "Enter") || pressed(input, "Space") || pressed(input, "Escape") { handle_action("ok") }
        return null
    }
    if m.kind == "chat" {
        if pressed(input, "Escape") { handle_action("chat:end"); return null }
        let k = 0
        while k < 5 {
            if pressed(input, "Digit" + str(k + 1)) || pressed(input, "Numpad" + str(k + 1)) {
                if G.chat != null && G.chat.over { handle_action("chat:end") } else { handle_action("chat:" + str(k)) }
                return null
            }
            k += 1
        }
        if pressed(input, "Enter") && G.chat != null && G.chat.over { handle_action("chat:end") }
        return null
    }
    if m.kind == "choice" {
        let i = 0
        while i < 6 {
            if pressed(input, "Digit" + str(i + 1)) || pressed(input, "Numpad" + str(i + 1)) {
                handle_action("choice:" + str(i))
                return null
            }
            i += 1
        }
        return null
    }
    if m.kind == "phone" {
        if pressed(input, "KeyM") {
            handle_action("ph:close")
        } else if pressed(input, "Escape") {
            if G.ph_app == "" { handle_action("ph:close") } else { handle_action("ph:home") }
        }
        return null
    }
    if pressed(input, "Escape") {
        if m.kind == "person" {
            handle_action("tab:rel")
        } else if m.kind == "menu" && (m.tab == "jobs" || m.tab == "study" || m.tab == "gigs") {
            handle_action("tab:job")
        } else {
            handle_action("close")
        }
    }
    return null
}

function creator_keys(input: map) {
    let c = G.cre
    for key in input.pressed {
        if key == "Enter" { return handle_action("cre:go") }
        if key == "Escape" { return handle_action("back") }
        if key == "Backspace" {
            if len(c.chars) > 0 { list_pop(c.chars) }
        } else if key == "Space" {
            if len(c.chars) > 0 && c.chars[len(c.chars) - 1] != " " { list_push(c.chars, " ") }
        } else if str_starts_with(key, "Key") && len(key) == 4 && len(str_join(c.chars, "")) < 24 {
            let letter = str_replace(key, "Key", "")
            if len(c.chars) > 0 && c.chars[len(c.chars) - 1] != " " { letter = str_lower(letter) }
            list_push(c.chars, letter)
        }
    }
    return null
}

// ---------------------------------------------------------------- pantallas

function enter_title() {
    ensure_rng()
    G.mode = "title"
    G.modal = null
    G.title_gender = pick(["m", "f"])
    G.title_look = random_look(G.title_gender)
    G.screen_t0 = G.t
}

function enter_creator() {
    ensure_rng()
    let gender = pick(["m", "f"])
    G.cre = {
        "chars": [],
        "gender": gender,
        "likes": by_gender(gender, "f", "m"),
        "look": random_look(gender),
        "trait": TRAITS[rint(0, len(TRAITS) - 1)].id,
        "tags": [],
        "page": 0,
        "route": "normal",
        "religion": random_religion()
    }
    G.mode = "create"
    G.modal = null
    G.screen_t0 = G.t
}

function start_from_creator() {
    let c = G.cre
    let name = str_trim(str_join(c.chars, ""))
    c.first = ""
    c.last = ""
    if name != "" {
        let parts = str_split(name, " ")
        c.first = parts[0]
        if len(parts) > 1 { c.last = str_join(list_slice(parts, 1, len(parts)), " ") }
    }
    new_life()
    G.screen_t0 = G.t
    G.floats = []
    G.toasts = []
}

// ---------------------------------------------------------------- acciones

function handle_action(action: string) {
    if action == "noop" { return null }
    if action == "quit" {
        autosave()
        G.quit = true
        return null
    }
    if action == "continue" {
        continue_saved()
        return null
    }
    if action == "restart" { return enter_title() }
    if action == "new" || action == "again" { return enter_creator() }
    if action == "quick" {
        enter_creator()
        G.cre.tags = random_kinks(rint(1, MAX_KINKS))
        return start_from_creator()
    }
    if G.mode == "create" { return creator_action(action) }
    if G.mode == "dead" && str_starts_with(action, "legacy:") {
        legacy_action(action)
        if action == "legacy:go" && G.mode == "game" { check_missions() }
        return null
    }
    if G.mode != "game" { return null }

    if action == "close" || action == "ok" {
        // Si la acción vino del móvil, se vuelve al móvil.
        if G.ph_on {
            G.back_pid = 0
            G.modal = null
            return null
        }
        // Al cerrar el resultado de una acción con alguien, vuelves a su pantalla.
        let back = find_person(G.back_pid)
        if G.modal != null && G.modal.kind == "info" && back != null && back.alive && L.alive {
            G.modal = {"kind": "person", "pid": back.id}
            G.menu_t0 = G.t
            return null
        }
        G.back_pid = 0
        G.modal = null
        return null
    }
    if action == "scroll:end" { G.scroll = 0; return null }
    if str_starts_with(action, "tab:") {
        G.ph_on = false
        G.back_pid = 0
        G.modal = {"kind": "menu", "tab": str_replace(action, "tab:", "")}
        G.menu_cat = 0
        G.menu_page = 0
        G.menu_t0 = G.t
        return null
    }
    if str_starts_with(action, "cat:") {
        G.menu_cat = action_num(action, "cat:", 20)
        G.menu_page = 0
        G.menu_t0 = G.t
        return null
    }
    if action == "page:+" { G.menu_page += 1; G.menu_t0 = G.t; return null }
    if action == "page:-" { G.menu_page = max(0, G.menu_page - 1); G.menu_t0 = G.t; return null }
    if str_starts_with(action, "mission:") || str_starts_with(action, "fx:") || str_starts_with(action, "hito:") || str_starts_with(action, "fin:info:") { return null }
    if str_starts_with(action, "person:") {
        G.ph_on = false
        for p in L.people {
            if action == "person:" + str(p.id) {
                G.modal = {"kind": "person", "pid": p.id}
                G.menu_page = 0
                G.menu_cat = 0
                G.menu_t0 = G.t
            }
        }
        return null
    }

    // Una app del móvil reutiliza acciones de los menús: se cierra la pantalla del
    // móvil para que se vea el resultado; al cerrarlo se vuelve al móvil.
    if G.modal != null && G.modal.kind == "phone" && !str_starts_with(action, "ph:") && !str_starts_with(action, "cat:") && !str_starts_with(action, "page:") { G.modal = null }

    // Acciones que cambian la vida: comparamos antes y después para los efectos.
    let before = snapshot()
    G.last_kind = ""
    if str_starts_with(action, "skip:") && action != "skip:cancel" {
        emit("app.task", {"name": "years", "arg": action_num(action, "skip:", 101)})
        return null
    }
    if action == "age" || action == "year" {
        let birthday = false
        if action == "year" { birthday = advance_year() } else { birthday = advance_month() }
        let delay = 0.0
        if birthday {
            G.cut_t0 = G.t
            delay = 0.8
            if G.modal != null { G.modal_t0 = G.t + 0.85 }
        }
        report(before, delay)
        if !L.alive { G.screen_t0 = G.t + 0.4 }
        if birthday { autosave() }
        return null
    }
    // "<grupo>:<resto>" → cada grupo tiene su despachador.
    let colon = str_index_of(action, ":")
    let head = action
    let rest = ""
    if colon >= 0 {
        head = str_sub(action, 0, colon)
        rest = str_sub(action, colon + 1)
    }
    match head {
        "choice" => dispatch_choice(action_num(action, "choice:", 6))
        "apply" => apply_job(rest)
        "act" => do_act(rest)
        "buy" => buy(rest)
        "career" => {
            G.modal = null
            start_career(rest)
        }
        "ph" => phone_action(action)
        "oc" => ocio_action(action)
        "pr" => prison_action(action)
        "ra" => route_action(rest)
        "faith" => faith_action(action)
        "fin" => fin_action(action)
        "chat" => chat_action(action)
        "mg" => mg_action(action)
        "enroll" => open_enroll(rest)
        "hx" => health_dispatch(action, rest)
        "es" => escuela_action(action)
        "of" => oficio_action(action)
        "dn" => dinero_action(action)
        "mk" => mercado_action(action)
        "cs" => casino_action(action)
        "lx" => lujos_action(action)
        "fe" => fe_action(action)
        "vl" => velo_action(action)
        "kr" => corona_action(action)
        "pl" => politica_action(action)
        "cc" => contenido_action(action)
        "sp" => marte_action(action)
        "x8" => rutas18_action(action)
        "habit" => toggle_habit(rest)
        "gig" => take_gig(rest)
        "cact" => do_career_act(rest)
        "ract", "pact" => {
            if action == "ract:makefriend" {
                G.modal = null
                make_friend()
            } else if G.modal != null && G.modal.kind == "person" {
                let p = find_person(G.modal.pid)
                if p != null {
                    G.back_pid = p.id
                    if head == "ract" { rel_do(rest, p) } else { do_person_act(rest, p) }
                }
            }
        }
        _ => {}
    }
    report(before, 0.0)
    if !L.alive { G.screen_t0 = G.t }
    return null
}

function health_dispatch(action: string, rest: string) {
    match rest {
        "checkup" => health_checkup()
        "its" => {
            G.modal = null
            finish("Pruebas de ITS", its_test(), "n")
        }
        _ => {
            if str_starts_with(rest, "tx:") { treat(str_sub(rest, 3)) } else { health_action(action) }
        }
    }
}

function creator_action(action: string) {
    let c = G.cre
    if action == "back" { return enter_title() }
    // "cre:<orden>:<valor>"
    let parts = str_split(action, ":")
    if len(parts) < 2 || parts[0] != "cre" { return null }
    let value = ""
    if len(parts) > 2 { value = parts[2] }
    match parts[1] {
        "go" => return start_from_creator()
        "name" => {
            let names = NAMES_M
            if c.gender == "f" { names = NAMES_F }
            c.chars = [pick(names)]
        }
        "random" => {
            let chars = c.chars
            let page = c.page
            let route = c.route
            enter_creator()
            G.cre.chars = chars
            G.cre.page = page
            G.cre.route = route
            G.cre.tags = random_kinks(rint(1, MAX_KINKS))
            G.screen_t0 = G.t - 1.0
        }
        "gender" => {
            if value == "m" || value == "f" {
                c.gender = value
                if c.likes != "ambos" { c.likes = by_gender(c.gender, "f", "m") }
            }
        }
        "likes" => c.likes = value
        "page" => c.page = action_num(action, "cre:page:", 4)
        "route" => c.route = ROUTES[cycle(id_index(ROUTES, c.route), action, len(ROUTES))].id
        "rel" => c.religion = RELIGIONS[cycle(id_index(RELIGIONS, c.religion), action, len(RELIGIONS))].id
        "trait" => c.trait = TRAITS[cycle(id_index(TRAITS, c.trait), action, len(TRAITS))].id
        "face" => c.look.face = cycle(c.look.face, action, len(FACES))
        "body" => c.look.body = cycle(c.look.body, action, len(BODIES))
        "mark" => c.look.mark = cycle(c.look.mark, action, len(MARKS))
        "lips" => c.look.lips = cycle(c.look.lips, action, len(LIPS))
        "hair" => c.look.hair = cycle(c.look.hair, action, len(HAIR_STYLES))
        "acc" => c.look.acc = cycle(c.look.acc, action, len(ACCESSORIES))
        "skin" => c.look.skin = action_num(action, "cre:skin:", len(SKINS))
        "hcolor" => c.look.hcolor = action_num(action, "cre:hcolor:", len(HAIR_COLORS))
        "eyes" => c.look.eyes = action_num(action, "cre:eyes:", len(EYE_COLORS))
        "outfit" => c.look.outfit = action_num(action, "cre:outfit:", len(OUTFITS))
        "kink" => {
            if list_contains(c.tags, value) {
                let keep = []
                for t in c.tags {
                    if t != value { list_push(keep, t) }
                }
                c.tags = keep
            } else if len(c.tags) < MAX_KINKS {
                list_push(c.tags, value)
            }
        }
        _ => {}
    }
    return null
}

// Posición del elemento con ese id (0 si no está).
function id_index(items: list, id: any) {
    let i = 0
    while i < len(items) {
        if items[i].id == id { return i }
        i += 1
    }
    return 0
}

function cycle(value: int, action: string, count: int) {
    if str_ends_with(action, ":+") { return (value + 1) % count }
    return (value + count - 1) % count
}

// ---------------------------------------------------------------- efectos de cambio

function snapshot() {
    if G.mode != "game" || !L.alive { return null }
    let s = {"happy": L.happy, "health": L.health, "smarts": L.smarts, "looks": L.looks, "money": L.money}
    for k in SOCIAL_KEYS { s[k] = L.social[k] }
    return s
}

// Convierte las diferencias en números flotantes y notificaciones de rango.
function report(before: any, delay: float) {
    if before == null || G.mode == "title" || L.social == null { return null }
    let keep = []
    for f in G.floats {
        if G.t - f.t0 < 2.0 { list_push(keep, f) }
    }
    G.floats = keep
    for k in ["happy", "health", "smarts", "looks", "money"] {
        let d = L[k] - before[k]
        if d != 0 { list_push(G.floats, {"k": k, "v": d, "t0": G.t + delay}) }
    }
    for k in SOCIAL_KEYS {
        let d = L.social[k] - before[k]
        if d != 0 { list_push(G.floats, {"k": k, "v": d, "t0": G.t + delay}) }
        let r0 = min(5, 1 + before[k] / 20)
        let r1 = rank(k)
        if r1 > r0 {
            list_push(G.toasts, {"title": str_upper(SOCIAL_NAMES[k]) + " · RANGO " + str(r1), "sub": "Ahora tu " + str_lower(SOCIAL_NAMES[k]) + " es: " + rank_title(k, r1) + ".", "t0": G.t + delay})
        }
    }
    check_missions()
    // Reacción del retrato según lo que acaba de pasar.
    let kind = G.last_kind
    let dh = L.happy - before.happy
    let dm = L.money - before.money
    if kind == "" || kind == "n" {
        if dh > 0 { kind = "g" } else if dh < 0 { kind = "b" } else { kind = "" }
    }
    if dm >= 5000 && kind != "b" { kind = "m" }
    if kind == "b" && dh <= -15 { kind = "a" }
    if kind != "" && L.alive { G.react = {"kind": kind, "t0": G.t + delay} }
    return null
}

// Número al final de una acción ("cat:3" → 3), acotado a [0, limit).
function action_num(action: string, prefix: string, limit: int) {
    if !str_starts_with(action, prefix) { return 0 }
    let v = parse_int(str_sub(action, len(prefix)), 0)
    if v < 0 || v >= limit { return 0 }
    return v
}
