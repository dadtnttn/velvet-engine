    "gossip": ["¿Ya supiste el chisme?", "No vas a creer lo que me contaron."],
    "past": ["Cuéntame de cuando eras joven.", "¿Cómo era todo antes?"],
    "secret": ["¿Me cuentas algo que nunca le hayas dicho a nadie?", "Confía en mí: ¿qué es lo que te guardas?"]
}

// Qué tan bien cae cada tono según el ánimo (lo que falta vale 0).
const MOOD_TONE = {
    "feliz": {"day": 1, "share": 1, "compliment": 1, "joke": 1, "flirt": 1, "dreams": 1, "memory": 1, "plan": 2, "love": 1, "gossip": 1, "past": 1, "school": 1},
    "carinoso": {"compliment": 2, "flirt": 2, "memory": 2, "love": 2, "plan": 1, "day": 1, "dreams": 1, "secret": 1},
    "triste": {"comfort": 2, "whatswrong": 2, "day": 1, "love": 1, "memory": 1, "joke": -1, "flirt": -2, "complain": -2, "gossip": -1, "plan": -1, "secret": 1},
    "enojado": {"whatswrong": 1, "comfort": 0, "joke": -2, "flirt": -2, "complain": -2, "compliment": -1, "gossip": -1, "share": -1, "school": -1, "secret": -2},
    "estresado": {"comfort": 2, "plan": 1, "day": 1, "joke": 1, "complain": -1, "share": -1, "school": -1, "advice": -1},
    "aburrido": {"plan": 2, "joke": 1, "gossip": 2, "share": 1, "dreams": 1, "past": 1, "day": -1}
