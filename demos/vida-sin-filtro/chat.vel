    "aburrido": ["Me aburroooo. Entretenme.", "¿Qué haces? Yo nada."]
}

// ---------------------------------------------------------------- personalidad y ánimo

function temper(p: map) {
    if p.temper == null { p.temper = TEMPERS[p.id * 7 % len(TEMPERS)] }
    return p.temper
}

function temper_name(p: map) {
    if p.gender == "f" { return TEMPER_F[temper(p)] }
    return TEMPER_M[temper(p)]
}

function mood(p: map) {
    if p.mood == null { p.mood = roll_mood(p) }
    return p.mood
}

function mood_name(p: map) {
    let n = MOOD_NAMES[mood(p)]
    if p.gender == "f" && (n == "Enojado" || n == "Estresado" || n == "Aburrido" || n == "Cariñoso") {
        return str_replace(n + "#", "o#", "a")
    }
    return n
}

function roll_mood(p: map) {
    let w = [30, 10, 12, 8, 15, 15]
    if p.bond >= 60 { w[1] = 18 }
    if p.bond < 35 {
        w[3] += 20
        w[2] += 10
    }
    if p.cheated_you == true { w[3] += 15 }
    if L.jail > 0 { w[2] += 15 }
    if p.age < 12 { w[4] = 3 }
    if p.age >= 70 { w[4] = 4 }
    return MOODS[weighted_choose(G.rng, w)]
}

// Cada mes cambia el ánimo de todos; tu pareja a veces te escribe.
function moods_month() {
    for p in L.people {
        if p.alive { p.mood = roll_mood(p) }
    }
    return null
}

function maybe_ping() {
    if G.modal != null || L.jail > 0 || !chance(8) { return false }
    if L.ph != null && L.ph.dnd { return false }
    let p = partner()
    if p != null && p.alive && chance(60) {
        start_chat(p, true)
        return true
    }
    // También te escriben tu familia y tus amigos cuando hace mucho que no hablan.
    if L.age < 10 { return false }
    for q in L.people {
        if q.alive && q.age >= 10 && can_chat(q) && neglect_months(q) >= 3 && q.bond >= 40 && close_rel(q) && chance(30) {
            start_chat(q, true)
            return true
        }
    }
    return false
}

// Un hito compartido para recordar en el chat ("" si no hay).
function memory_hito(p: map) {
    if p.hitos == null || len(p.hitos) == 0 { return "" }
    let h = p.hitos[rint(0, len(p.hitos) - 1)]
    return h.t
}

// ---------------------------------------------------------------- familia extendida

function add_extended_family() {
    let dad = first_rel("padre")
    let mom = first_rel("madre")
    for parent in [dad, mom] {
        if parent == null { continue }
        // Abuelos
        for g in ["m", "f"] {
            let age = parent.age + rint(20, 32)
            if age < 90 && chance(75) {
                let gp = make_person(g, "abuelo", age)
                gp.last = parent.last
                gp.look.skin = parent.look.skin
                gp.bond = rint(60, 90)
                add_person(gp)
            }
        }
        // Tíos y primos
        let n = rint(0, 2)
        let i = 0
        while i < n {
            let u = make_person(pick(["m", "f"]), "tio", max(18, parent.age + rint(-8, 8)))
            u.last = parent.last
            u.look.skin = parent.look.skin
            u.bond = rint(40, 80)
            add_person(u)
            if u.age >= 24 && chance(60) {
                let cage = rint(0, 10) - 4
                if cage < 0 { cage = 0 }
                let c = make_person(pick(["m", "f"]), "primo", cage)
                c.last = u.last
                c.look.skin = u.look.skin
                c.bond = rint(45, 80)
                add_person(c)
            }
            i += 1
        }
    }
    return null
}

// ---------------------------------------------------------------- conversación

function chat_group_tones(p: map) {
    let g = rel_group(p)
    let adult = L.age >= 18 && p.age >= 18
    let out = []
    if g == "partner" || g == "fling" { out = ["day", "share", "compliment", "joke", "dreams", "memory", "complain", "plan", "love"] }
    if g == "parent" { out = ["day", "share", "joke", "memory", "complain", "advice", "love", "past"] }
    if g == "grandparent" { out = ["day", "share", "joke", "memory", "past", "advice", "love"] }
    if g == "uncle" { out = ["day", "share", "joke", "gossip", "advice", "past", "plan"] }
    if g == "sibling" || g == "cousin" { out = ["day", "share", "joke", "gossip", "plan", "complain"] }
    if g == "child" || g == "grandchild" { out = ["day", "joke", "love", "plan", "share"] }
    if g == "friend" { out = ["day", "share", "joke", "gossip", "dreams", "complain", "plan", "advice", "memory"] }
    if g == "ex" { out = ["day", "memory", "complain", "compliment"] }
    if g == "inlaw" { out = ["day", "share", "joke", "advice", "past", "memory"] }
    if g == "nephew" { out = ["day", "joke", "love", "plan", "share"] }
    if g == "coworker" { out = ["day", "share", "joke", "gossip", "complain", "plan", "advice"] }
    if g == "rival" { out = ["day", "complain", "joke", "compliment"] }
    if g == "acq" { out = ["day", "share", "memory"] }
    if can_secret(p) { list_push(out, "secret") }
    if adult && (g == "partner" || g == "fling" || g == "ex") { list_push(out, "flirt") }
    if (g == "child" || g == "grandchild" || g == "cousin" || g == "sibling" || g == "partner" || g == "friend" || g == "nephew") && p.age >= 6 && p.age < 18 { list_push(out, "school") }
    return out
}

function can_chat(p: map) {
    return L.age >= 4 && p.age >= 4 && p.alive
}

function start_chat(p: map, npc_first: bool) {
    G.modal = null
    let ctx = {"person": p}
    touch(p)
    G.chat = {"pid": p.id, "lines": [], "opts": [], "turn": 0, "over": false, "gain": 0, "last": "", "t0": G.t, "refused": false}
    let m = mood(p)
    let t = temper(p)
    let max_turns = 5
    if t == "callado" { max_turns = 3 }
    if t == "parlanchin" { max_turns = 7 }
    G.chat.max = max_turns
    if npc_first {
        chat_add("npc", fmt(pick(PINGS[m]), ctx), 0.0)
    } else if (m == "triste" || m == "enojado") && (t == "callado" || t == "orgulloso" || p.bond < 35) && chance(60) {
        chat_add("npc", fmt(pick(REFUSE), ctx), 0.4)
        G.chat.refused = true
    } else {
        chat_add("npc", fmt(pick(GREET[m]), ctx), 0.4)
    }
    chat_options(p)
    G.modal = {"kind": "chat", "pid": p.id}
    G.modal_t0 = G.t
    return null
}

function chat_add(who: string, text: string, delay: float) {
    list_push(G.chat.lines, {"who": who, "t": text, "at": G.t + delay})
    G.chat.t0 = G.t
    if len(G.chat.lines) > 14 { G.chat.lines = list_slice(G.chat.lines, len(G.chat.lines) - 14, len(G.chat.lines)) }
}

function chat_options(p: map) {
    let c = G.chat
    let opts = []
    if c.refused {
        c.opts = ["insist", "leave"]
        return null
    }
    let m = mood(p)
    if (m == "triste" || m == "enojado" || m == "estresado") && c.last != "whatswrong" { list_push(opts, "whatswrong") }
    if (m == "triste" || m == "estresado") && c.last != "comfort" { list_push(opts, "comfort") }
    let pool = chat_group_tones(p)
    shuffle(G.rng, pool)
    for t in pool {
        if len(opts) >= 4 { break }
        if t != c.last && !list_contains(opts, t) { list_push(opts, t) }
    }
    c.opts = opts
    return null
}

function chat_label(tone: string, p: map) {
    if tone == "insist" { return "Insistir con cariño" }
    if tone == "leave" { return "Darle su espacio" }
    return fmt(TONE_LABELS[tone], {"person": p})
}

function chat_pending() {
    let c = G.chat
    if c == null { return false }
    for l in c.lines {
        if l.at > G.t { return true }
    }
    return false
}

function chat_choose(i: int) {
    let c = G.chat
    if c == null || c.over || chat_pending() || i >= len(c.opts) { return null }
    let p = find_person(c.pid)
    if p == null { return null }
    let tone = c.opts[i]
    let ctx = {"person": p}
    if tone == "leave" {
        chat_add("me", "Está bien. Aquí estoy cuando quieras.", 0.0)
        chat_add("npc", fmt("Gracias por entenderme.", ctx), 0.7)
        bond_gain(p, 2)
        c.gain += 2
        c.over = true
        return null
    }
    if tone == "insist" {
        chat_add("me", "Sé que no quieres hablar, pero me preocupas. ¿Qué pasa?", 0.0)
        if chance(35 + p.bond / 3 + rank("kind") * 5) {
            c.refused = false
            chat_add("npc", fmt(pick(WRONG_BY_MOOD[mood(p)]), ctx), 0.9)
            bond_gain(p, 3)
            c.gain += 3
            chat_options(p)
        } else {
            chat_add("npc", fmt(pick(BYE_ANGRY), ctx), 0.8)
            bond_gain(p, -2)
            c.gain -= 2
            c.over = true
        }
        return null
    }
    c.turn += 1
    c.last = tone
    let mine = fmt(pick(MY_LINES[tone]), ctx)
    let shared = memory_hito(p)
    if tone == "memory" && shared != "" { mine = "¿Te acuerdas? «" + shared + "». Qué tiempos." }
    chat_add("me", mine, 0.0)
    let m = mood(p)
    let t = temper(p)
    let r = rint(-1, 1)
    let mt = MOOD_TONE[m][tone]
    if mt != null { r += mt }
    let tt = TEMPER_TONE[t][tone]
    if tt != null { r += tt }
    if p.bond >= 75 { r += 1 }
    if p.bond < 30 { r -= 1 }
    if tone == "memory" && shared != "" { r += 1 }
    if tone == "flirt" && rel_group(p) == "ex" && p.bond < 50 { r -= 2 }
    if tone == "compliment" && looks_eff() >= 70 { r += 0 }
    let grade = "neutral"
    if r >= 1 { grade = "good" }
    if r <= -1 { grade = "bad" }
    let reply = chat_reply(p, tone, grade)
    if (tone == "dreams" || tone == "day") && grade == "good" { reply = reply + chat_reveal(p) }
    if tone == "secret" && grade == "good" {
        reply = secret_reveal(p)
        add_hito(p, "Te contó un secreto")
    }
    chat_add("npc", fmt(reply, ctx), 0.9)
    let gains = {"good": 3, "neutral": 1, "bad": -3}
    let gb = gains[grade]
    if r >= 3 { gb = 6 }
    if r <= -3 { gb = -7 }
    bond_gain(p, gb)
    c.gain += gb
    // El ánimo cambia con la conversación.
    if r >= 3 {
        if rel_group(p) == "partner" { p.mood = "carinoso" } else { p.mood = "feliz" }
    }
    if r <= -3 { p.mood = "enojado" }
    if grade == "good" && (m == "triste" || m == "estresado") && (tone == "comfort" || tone == "whatswrong") { p.mood = "feliz" }
    if tone == "plan" && grade == "good" { L.happy += 2 }
    if tone == "love" && grade == "good" && (rel_group(p) == "partner" || rel_group(p) == "fling") { add_hito(p, "Se dijeron «te quiero» por primera vez") }
    if r >= 3 { add_hito(p, "Su mejor plática") }
    if tone == "advice" && grade == "good" { gain("know", 1) }
    if tone == "past" && grade == "good" { gain("know", 1) }
    if tone == "joke" && grade == "good" { gain("charm", 1) }
    // ¿Se termina la plática?
    if r <= -3 && (t == "callado" || t == "orgulloso" || p.bond < 40) {
        chat_add("npc", fmt(pick(BYE_ANGRY), ctx), 1.6)
        c.over = true
        return null
    }
    if c.turn >= c.max {
        let bye = BYE_QUIET
        if t != "callado" { bye = ["Bueno, te dejo, que tengo cosas que hacer. ¡Me encantó platicar!", "Me tengo que ir, pero hablamos pronto, ¿va?"] }
        chat_add("npc", fmt(pick(bye), ctx), 1.6)
        c.over = true
        return null
    }
    chat_options(p)
    return null
}

function chat_reply(p: map, tone: string, grade: string) {
    let t = temper(p)
    let m = mood(p)
    if p.age < 10 { return pick(KID_LINES[grade]) }
    let line = ""
    if tone == "day" {
        line = pick(DAY_BY_MOOD[m])
    } else if tone == "whatswrong" {
        if grade == "bad" && t == "orgulloso" { line = "Nada. Estoy bien. Deja de preguntar." } else { line = pick(WRONG_BY_MOOD[m]) }
    } else {
        line = pick(REPLIES[tone][grade])
    }
    if t == "callado" && (tone != "whatswrong" || grade != "good") && chance(70) { line = pick(SHORT[grade]) }
    if t == "parlanchin" && grade != "bad" && chance(60) { line = line + " " + pick(TALKY) }
    if t == "bromista" && grade == "good" && chance(50) { line = "Jajaja. " + line }
    if t == "romantico" && grade == "good" && (rel_group(p) == "partner" || rel_group(p) == "fling") && chance(50) { line = line + " Te amo." }
    return line
}

function chat_end() {
    let c = G.chat
    if c == null { return null }
    let p = find_person(c.pid)
    G.chat = null
    G.modal = null
    if p == null { return null }
    let sign = ""
    if c.gain > 0 { sign = "+" }
    let kind = "n"
    if c.gain >= 4 { kind = "g" }
    if c.gain <= -3 { kind = "b" }
    let msg = "Platicaste con " + p.first + ". Cercanía " + sign + str(c.gain) + "."
    if c.gain >= 1 { add_hito(p, "Su primera plática") }
    if c.gain >= 8 { msg = "Gran plática con " + p.first + ": se sienten más unid" + oa(p.gender) + "s que nunca. Cercanía +" + str(c.gain) + "." }
    if c.gain <= -5 { msg = "La plática con " + p.first + " salió mal. Cercanía " + str(c.gain) + "." }
    G.back_pid = p.id
    return finish(p.first, msg, kind)
}

function chat_action(action: string) {
    if action == "chat:end" { return chat_end() }
    if str_starts_with(action, "chat:") { return chat_choose(action_num(action, "chat:", 6)) }
    return null
}

// ---------------------------------------------------------------- dibujo

function draw_chat() {
    let c = G.chat
    if c == null { return null }
    let p = find_person(c.pid)
    if p == null { return null }
    let e = ease(prog(G.modal_t0, 0.25))
    let px = 20 - (1.0 - e) * 300
    svg(px - 30, 230, 420, 420, burst_doc(420, 420, 18, HEX_WHITE, HEX_INK, 5, p.id % 9))
    let pm = "neutral"
    let m = mood(p)
    if m == "feliz" || m == "carinoso" { pm = "happy" }
    if m == "triste" { pm = "sad" }
    if m == "enojado" { pm = "angry" }
    portrait(px + 20, 250, 330, 396, p.look, p.gender, p.age, pm, p.id, false)
    svg(px + 30, 640, 300, 50, slant_doc(294, 44, 14, HEX_INK, HEX_WHITE, 3, HEX_RED, 6))
    textw(px + 56, 672, str_upper(p.first), 24, C_WHITE, "impact", 240)

    let x = 420
    let y = 40
    let w = 820
    let h = 640
    svg(x, y, w + 10, h + 10, slant_doc(w, h, 22, HEX_INK, HEX_WHITE, 4, HEX_RED, 10))
    textw(x + 40, y + 46, str_upper(p.first + " · " + rel_label(p)), 24, C_WHITE, "impact", 420)
    let mc = C_YELLOW
    if m == "triste" || m == "enojado" { mc = C_BAD }
    text(x + 40, y + 72, "Ánimo: " + mood_name(p) + " · " + temper_name(p) + " · Cercanía " + str(p.bond) + "%", 14, mc, "bold")

    // Mensajes (de abajo hacia arriba)
    let top = y + 92
    let bottom = y + 400
    let lines = []
    for l in c.lines {
        if l.at <= G.t { list_push(lines, l) }
    }
    let by = bottom
    let i = len(lines) - 1
    if chat_pending() {
        svg(x + 40, by - 34, 110, 30, slant_doc(104, 26, 8, "#262626", "", 0, "", 0))
        text(x + 58, by - 14, "escribiendo…", 13, C_GRAY, "bold")
        by -= 40
    }
    push({"op": "clip_push", "x": x + 20, "y": top, "w": w - 40, "h": bottom - top})
    while i >= 0 && by > top {
        let l = lines[i]
        let wrapped = wrap_f(l.t, 500, 16, "ui")
        let bh = len(wrapped) * 22 + 16
        let bw = 0
        for s in wrapped { bw = max(bw, measure(s, 16, "ui") + 34) }
        bw = min(560, bw)
        let bx = x + 40
        let fill = HEX_WHITE
        let color = C_INK
        if l.who == "me" {
            bx = x + w - 60 - bw
            fill = HEX_RED
            color = C_WHITE
        }
        let alpha = 1.0
        if i == len(lines) - 1 { alpha = clamp((G.t - l.at) / 0.2, 0.0, 1.0) }
        fade_push(alpha)
        svg(bx, by - bh, bw + 4, bh + 4, slant_doc(bw, bh, 8, fill, HEX_INK, 2, "", 0))
        let ty = by - bh + 22
        for s in wrapped {
            text(bx + 16, ty, s, 16, color, "ui")
            ty += 22
        }
        fade_pop()
        by -= bh + 10
        i -= 1
    }
    push({"op": "clip_pop"})

    // Opciones
    let oy = y + 408
    if c.over {
        if !chat_pending() { menu_word(x + 230, oy + 80, 360, 64, "TERMINAR", "chat:end", 30) }
        return null
    }
    if chat_pending() { return null }
    let j = 0
    while j < len(c.opts) {
        let action = "chat:" + str(j)
        dialog_option(x + 40 - j * 4, oy, w - 90, chat_label(c.opts[j], p), j, action, false, [], "")
        oy += 48
        j += 1
    }
    small_button(x + w - 190, y + h - 50, 160, 36, "DESPEDIRTE", "chat:end")
    return null
}
