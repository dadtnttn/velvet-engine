    "parlanchin": {"day": 1, "share": 1, "gossip": 1, "dreams": 1},
    "bromista": {"joke": 2, "complain": -1},
    "sensible": {"compliment": 1, "comfort": 1, "love": 1, "complain": -1, "joke": -1, "secret": 1},
    "orgulloso": {"whatswrong": -1, "comfort": -1, "compliment": 1, "advice": 1},
    "romantico": {"love": 1, "memory": 1, "flirt": 1}
}

