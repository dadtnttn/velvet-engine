    "day": "Preguntarle por su día", "share": "Contarle de tu día", "compliment": "Hacerle un cumplido",
    "joke": "Contarle un chiste", "flirt": "Coquetear", "dreams": "Preguntarle por sus sueños",
    "memory": "Recordar un buen momento", "whatswrong": "Preguntarle qué le pasa", "comfort": "Consolarl{xlo}",
    "complain": "Desahogarte", "plan": "Proponer un plan", "love": "Decirle que l{xlo} quieres",
    "school": "Preguntarle por la escuela", "advice": "Pedirle un consejo", "gossip": "Chismear",
    "past": "Pedirle historias de su juventud", "secret": "Contarse secretos"
}
