// @edition 3
// Chat: platicar con cualquier persona como en una app de mensajes. Cada quien tiene
// un temperamento (callado, parlanchín, bromista, sensible, orgulloso, romántico)
// y un ánimo que cambia cada mes (feliz, cariñoso, triste, enojado, estresado,
// aburrido). Lo que conviene decir depende de los dos: a quien está triste no le
// cuentes chistes; alguien callado y molesto puede ni contestarte.
// También: la familia extendida (abuelos, tíos y primos) y los mensajes que tu
// pareja te manda por iniciativa propia.

const TEMPERS = ["callado", "parlanchin", "bromista", "sensible", "orgulloso", "romantico"]
const TEMPER_M = {"callado": "Callado", "parlanchin": "Parlanchín", "bromista": "Bromista", "sensible": "Sensible", "orgulloso": "Orgulloso", "romantico": "Romántico"}
const TEMPER_F = {"callado": "Callada", "parlanchin": "Parlanchina", "bromista": "Bromista", "sensible": "Sensible", "orgulloso": "Orgullosa", "romantico": "Romántica"}
const MOODS = ["feliz", "carinoso", "triste", "enojado", "estresado", "aburrido"]
const MOOD_NAMES = {"feliz": "Feliz", "carinoso": "Cariñoso", "triste": "Triste", "enojado": "Enojado", "estresado": "Estresado", "aburrido": "Aburrido"}

// Lo que dices tú según el tono elegido.
