    "advice": {"good": ["Mira, haz lo que te haga feliz. Pero piénsalo bien.", "Yo que tú hablaría con la verdad. Siempre funciona."], "neutral": ["Mmm, no sé qué decirte.", "Haz lo que creas."], "bad": ["¿Y yo qué sé? Resuélvelo tú.", "No me metas en tus broncas."]},
    "gossip": {"good": ["¡No te creo! ¡Cuéntamelo TODO!", "Ay, ya sabía yo que algo pasaba ahí."], "neutral": ["Mm, no me interesa mucho.", "Ah, ¿sí?"], "bad": ["No me gusta hablar de los demás.", "Eso no es asunto nuestro."]},
    "secret": {"good": ["*te lo cuenta en voz baja*"], "neutral": ["Hay cosas que prefiero guardarme.", "Quizá otro día te cuento."], "bad": ["¿Por qué tanta curiosidad?", "Eso no te importa."]},
