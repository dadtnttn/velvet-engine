}
const SHORT = {"good": ["Gracias.", "Mm, me gusta.", "*sonríe*"], "neutral": ["Ajá.", "Mm.", "Ok."], "bad": ["...", "No.", "Déjalo."]}
const TALKY = ["¡Y eso no es todo! Luego pasó otra cosa, y otra...", "Ay, hablando de eso, ¿te conté lo de mi vecina?", "Perdón, hablo mucho, pero tenía que contártelo."]
const KID_LINES = {"good": ["¡Sííí!", "¡Te quiero muchote!", "*te abraza las piernas*"], "neutral": ["Mmm, ok.", "¿Puedo ver la tele?"], "bad": ["¡No quiero!", "*hace berrinche*"]}
const REFUSE = ["No quiero hablar ahorita.", "Déjame sol{xa}, por favor.", "*te deja en visto*"]
const BYE_QUIET = ["Bueno... me voy.", "Ya me cansé de hablar.", "Hablamos luego."]
const BYE_ANGRY = ["Mejor hablamos otro día.", "Ya no quiero seguir con esto.", "*se va sin despedirse*"]
const PINGS = {
    "feliz": ["¡Adivina qué! Me fue increíble hoy.", "Te mando un meme que me hizo pensar en ti."],
    "carinoso": ["¿Me extrañas? Porque yo sí.", "Solo quería decirte que te quiero."],
    "triste": ["¿Estás despiert{a}? No me siento bien.", "¿Podemos hablar?"],
    "enojado": ["Tenemos que hablar.", "¿Me puedes explicar algo?"],
