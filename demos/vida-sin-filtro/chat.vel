const GREET = {
    "feliz": ["¡Hola, {nombre}! ¿Qué onda?", "¡Hey! Justo pensaba en ti."],
    "carinoso": ["¡Mi {nombre}! Te extrañaba.", "Hola, tú. *sonríe*"],
