function find_event(id: string) {
    for ev in EVENTS {
        if ev.id == id { return ev }
    }
    return null
}

function meets(tag: string) {
    if tag == "" { return true }
    if tag == "school" { return L.school != "" }
    if tag == "job" { return L.job != null }
    if tag == "nojob" { return L.job == null }
    if tag == "partner" { return L.partner_id != 0 }
    if tag == "nopartner" { return L.partner_id == 0 }
    if tag == "married" { return L.married }
    if tag == "single" { return !L.married }
    if tag == "hasex" { return has_rel("ex") }
    if tag == "hot" { return L.looks >= 60 }
    if tag == "alcohol" { return L.alcohol >= 15 }
    if tag == "drugs" { return L.drugs >= 15 }
    if tag == "kids" { return L.kids > 0 }
    if tag == "money" { return L.money >= 1000 }
    if tag == "f" { return L.gender == "f" }
    if tag == "m" { return L.gender == "m" }
    if tag == "villain" { return L.karma < 30 }
    if tag == "uni" { return L.uni > 0 }
    if tag == "addict" { return L.alcohol + L.drugs >= 40 }
    return false
}

function eligible(ev: map) {
    if L.age < ev.min || L.age > ev.max || ev.w <= 0 { return false }
    if L.jail > 0 { return false }
    let last = L.seen[ev.id]
    if last != null && L.age - last < 6 { return false }
    for tag in str_split(ev.req, ",") {
        if !meets(str_trim(tag)) { return false }
    }
    return true
}

function maybe_event() {
    if L.age < 5 || !chance(70) { return null }
    let pool = []
    let weights = []
    for ev in EVENTS {
        if eligible(ev) {
            list_push(pool, ev)
            list_push(weights, ev.w)
        }
    }
    if len(pool) == 0 { return null }
    let ev = pool[weighted_choose(G.rng, weights)]
    open_event(ev, event_ctx(ev))
    return null
}

function event_ctx(ev: map) {
    let spec = ev["person"]
    if spec == null { return {} }
    if spec == "near" { return {"person": stranger()} }
    if spec == "ex" { return {"person": first_rel("ex")} }
    return {"person": stranger_aged(spec[0], spec[1])}
}

function open_event(ev: map, ctx: map) {
    L.seen[ev.id] = L.age
    let labels = []
    let locks = []
    let tags = []
    for c in ev.choices {
        list_push(labels, fmt(c.t, ctx))
        list_push(locks, choice_lock(c))
        list_push(tags, choice_tag(c))
    }
    open_choice(ev.title, fmt(ev.text, ctx), labels, locks, "event", ctx)
    G.modal.ev = ev
    G.modal.tags = tags
}

// Requisito pendiente de una opción ("" si se puede elegir).
function choice_lock(c: map) {
    if c.need != null && rank(c.need) < c.rank {
        return SOCIAL_NAMES[c.need] + " " + str(c.rank)
    }
    if c.cost != null && L.money < c.cost {
        return "Necesitas " + money_str(c.cost)
    }
    if c.req_partner == true && L.partner_id == 0 {
        return "Necesitas pareja"
    }
    return ""
}

// Etiqueta visible del requisito aunque ya se cumpla (estilo Persona).
function choice_tag(c: map) {
    if c.need != null { return SOCIAL_NAMES[c.need] + " " + str(c.rank) }
    return ""
}

function open_choice(title: string, text: string, labels: list, locks: list, handler: string, ctx: map) {
    let p = ctx["person"]
    G.modal = {
        "kind": "choice",
        "title": title,
        "text": text,
        "choices": labels,
        "locks": locks,
        "handler": handler,
        "ctx": ctx,
        "person": p
    }
    G.modal_t0 = G.t
}

// Los rasgos en `lucky` duplican la probabilidad del primer resultado.
function pick_outcome_for(choice: map) {
    let outcomes = choice.o
    let weights = []
    for o in outcomes { list_push(weights, o.w) }
    if choice.lucky != null && list_contains(choice.lucky, L.trait) {
        weights[0] = weights[0] * 2
    }
    return outcomes[weighted_choose(G.rng, weights)]
}

function pick_outcome(outcomes: list) {
    let weights = []
    for o in outcomes { list_push(weights, o.w) }
    return outcomes[weighted_choose(G.rng, weights)]
}

function resolve_event(ev: map, index: int, ctx: map) {
    G.modal = null
    let choice = ev.choices[index]
    let o = pick_outcome_for(choice)
    let msg = apply(o, ctx)
    finish(ev.title, msg, outcome_kind(o))
}

// Registra el resultado y lo muestra, salvo que un efecto ya abrió otra ventana.
function finish(title: string, msg: string, kind: string) {
    if msg != "" { log_add(msg, kind) }
    if L.dying != "" {
        die(L.dying)
        return null
    }
    if G.modal == null && L.alive && msg != "" {
        G.modal = {"kind": "info", "title": title, "text": msg}
        G.modal_t0 = G.t
    }
}

function outcome_kind(o: map) {
    if map_has(o, "sex") || map_has(o, "count") { return "x" }
    let score = 0
    for key in ["happy", "health", "smarts", "looks"] {
        if map_has(o, key) { score += o[key] }
    }
    if map_has(o, "jail") || map_has(o, "die") { return "b" }
    if score > 0 { return "g" }
    if score < 0 { return "b" }
    return "n"
}
