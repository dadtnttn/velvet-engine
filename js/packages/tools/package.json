    "@velvet/assets": "workspace:*",
    "@velvet/characters": "workspace:*",
    "@velvet/cards": "workspace:*",
    "@velvet/guion": "workspace:*",
    "@velvet/i18n": "workspace:*",
    "@velvet/artprep": "workspace:*",
    "@velvet/wasm": "workspace:*",
    "@velvet/audio": "workspace:*",
    "@velvet/achievements": "workspace:*",
    "@velvet/tiles": "workspace:*"
  }
