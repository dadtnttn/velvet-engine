    {
      "name": "persisted counters survive a restart, session counters do not",
      "steps": [
        {
          "do": "increment",
          "counter": "gold",
          "by": 120,
          "returns": 120,
          "events": [{ "type": "changed" }]
        },
        {
          "do": "increment",
          "counter": "steps",
          "by": 2,
          "returns": 2,
          "events": [{ "type": "changed" }]
        },
        {
          "do": "save",
          "returns": true,
          "events": []
        },
        {
          "do": "check",
          "writes": 1,
          "stored": {
            "format": "velvet-achievements",
            "version": 1,
            "kind": "progress",
            "counters": { "kills": 0, "gold": 120 },
            "unlocked": {}
          }
        },
        {
          "do": "restart",
          "status": "loaded",
          "events": [{ "type": "changed" }]
        },
        {
          "do": "check",
          "writes": 1,
          "counters": { "kills": 0, "gold": 120, "steps": 0 },
          "unlocked": {}
        }
      ]
