    { "formula": "min()", "error": "arity" },
    { "formula": "floor(1, 2)", "error": "arity" },
    { "formula": "1 +", "error": "expression" },
    { "formula": "(1 + 2", "error": "expression" },
    { "formula": "1 + 2)", "error": "expression" },
    { "formula": "2 3", "error": "expression" },
