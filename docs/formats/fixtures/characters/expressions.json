    { "formula": "10 / 4", "value": 2.5 },
    { "formula": "0.5 * 4", "value": 2 },
    { "formula": "-3 + 5", "value": 2 },
    { "formula": "2 * -3", "value": -6 },
    { "formula": "--4", "value": 4 },
    { "formula": "min(3, 1, 2)", "value": 1 },
    { "formula": "max(3, 9)", "value": 9 },
    { "formula": "max(-2)", "value": -2 },
    { "formula": "clamp(15, 0, 10)", "value": 10 },
    { "formula": "clamp(-3, 0, 10)", "value": 0 },
    { "formula": "clamp(4, 0, 10)", "value": 4 },
    { "formula": "floor(7 / 2)", "value": 3 },
