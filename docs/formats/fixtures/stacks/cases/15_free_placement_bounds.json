        { "event": "card_spawned", "card": 2, "def": "worker", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 2, "cards": [2] }
      ]
    },
    {
      "op": "drop", "card": 2, "onto": 1,
      "events": [
        { "event": "stack_changed", "stack": 2, "cards": [] },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2] },
        { "event": "job_started", "stack": 1, "recipe": "gather_wood" }
      ]
    },
    {
      "op": "tick", "dt": 2.0,
      "events": [
        { "event": "job_finished", "stack": 1, "recipe": "gather_wood" },
        { "event": "card_spawned", "card": 3, "def": "wood", "x": 2.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 3, "cards": [3] },
        { "event": "job_started", "stack": 1, "recipe": "gather_wood" }
      ]
    },
    {
      "op": "tick", "dt": 2.0,
      "events": [
        { "event": "job_finished", "stack": 1, "recipe": "gather_wood" },
        { "event": "card_spawned", "card": 4, "def": "wood", "x": 2.0, "y": -1.0 },
        { "event": "stack_changed", "stack": 4, "cards": [4] },
        { "event": "job_started", "stack": 1, "recipe": "gather_wood" }
      ]
    },
    { "op": "reload" },
    {
      "op": "tick", "dt": 2.0,
      "events": [
        { "event": "job_finished", "stack": 1, "recipe": "gather_wood" },
        { "event": "card_spawned", "card": 5, "def": "wood", "x": 2.0, "y": 1.0 },
        { "event": "stack_changed", "stack": 5, "cards": [5] },
        { "event": "job_started", "stack": 1, "recipe": "gather_wood" }
      ]
    },
    {
      "op": "tick", "dt": 2.0,
      "events": [
        { "event": "job_finished", "stack": 1, "recipe": "gather_wood" },
        { "event": "card_spawned", "card": 6, "def": "wood", "x": 3.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 6, "cards": [6] },
        { "event": "job_started", "stack": 1, "recipe": "gather_wood" }
      ]
    },
    {
      "op": "tick", "dt": 2.0,
      "events": [
        { "event": "job_finished", "stack": 1, "recipe": "gather_wood" },
        { "event": "card_spawned", "card": 7, "def": "wood", "x": 3.0, "y": -1.0 },
        { "event": "stack_changed", "stack": 7, "cards": [7] },
        { "event": "job_started", "stack": 1, "recipe": "gather_wood" }
      ]
    },
    {
      "op": "check",
      "position": { "3": [2.0, 0.0], "4": [2.0, -1.0], "5": [2.0, 1.0], "6": [3.0, 0.0], "7": [3.0, -1.0] }
    }
  ],
  "expect": {
    "cards": { "forest": 1, "worker": 1, "wood": 5 },
    "stacks": [[1, 2], [3], [4], [5], [6], [7]]
  }
