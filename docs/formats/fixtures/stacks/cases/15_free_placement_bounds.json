{
  "format": "velvet-stacks",
  "version": 1,
  "kind": "case",
  "name": "free placement inside bounds: spots outside the rectangle are skipped even when nearer, and a reload keeps the search going",
  "seed": "1",
  "placement": { "kind": "free", "footprint": [1.0, 1.0], "bounds": [2.0, -1.0, 2.0, 2.0] },
  "steps": [
    {
      "op": "spawn", "def": "forest", "at": [0.0, 0.0],
