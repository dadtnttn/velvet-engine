{
  "format": "velvet-stacks",
  "version": 1,
  "kind": "case",
  "name": "split a stack, move the part that was taken off, drop it back, then remove a card",
  "seed": "1",
  "steps": [
    {
      "op": "spawn", "def": "wood", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 1, "def": "wood", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 1, "cards": [1] }
      ]
    },
    {
      "op": "spawn", "def": "stone", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 2, "def": "stone", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 2, "cards": [2] }
      ]
    },
    {
      "op": "spawn", "def": "worker", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 3, "def": "worker", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 3, "cards": [3] }
      ]
    },
    {
      "op": "drop", "card": 2, "onto": 1,
      "events": [
        { "event": "stack_changed", "stack": 2, "cards": [] },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2] }
      ]
    },
    {
      "op": "drop", "card": 3, "onto": 2,
      "events": [
        { "event": "stack_changed", "stack": 3, "cards": [] },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2, 3] }
      ]
    },
    {
      "op": "split", "card": 2,
      "events": [
        { "event": "stack_changed", "stack": 1, "cards": [1] },
        { "event": "stack_changed", "stack": 4, "cards": [2, 3] }
      ]
    },
    { "op": "move", "card": 3, "to": [4.0, 2.0] },
    {
      "op": "check",
      "position": { "1": [0.0, 0.0], "2": [4.0, 2.0], "3": [4.0, 2.0] }
    },
    {
      "op": "drop", "card": 2, "onto": 1,
      "events": [
        { "event": "stack_changed", "stack": 4, "cards": [] },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2, 3] }
      ]
    },
    { "op": "check", "position": { "2": [0.0, 0.0], "3": [0.0, 0.0] } },
    {
      "op": "remove", "card": 2,
      "events": [
        { "event": "stack_changed", "stack": 1, "cards": [1, 3] }
      ]
    }
  ],
  "expect": {
    "cards": { "wood": 1, "worker": 1 },
    "stacks": [[1, 3]]
  }
}
