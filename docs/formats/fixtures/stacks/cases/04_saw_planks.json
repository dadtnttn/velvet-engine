{
  "format": "velvet-stacks",
  "version": 1,
  "kind": "case",
  "name": "a worker, a sawmill and a wood make two planks; only the wood is used up",
  "seed": "1",
  "steps": [
    {
      "op": "spawn", "def": "sawmill", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 1, "def": "sawmill", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 1, "cards": [1] }
      ]
    },
    {
      "op": "spawn", "def": "worker", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 2, "def": "worker", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 2, "cards": [2] }
      ]
    },
    {
      "op": "drop", "card": 2, "onto": 1,
      "events": [
        { "event": "stack_changed", "stack": 2, "cards": [] },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2] }
      ]
    },
    {
      "op": "spawn", "def": "wood", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 3, "def": "wood", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 3, "cards": [3] }
      ]
    },
    {
      "op": "drop", "card": 3, "onto": 2,
      "events": [
        { "event": "stack_changed", "stack": 3, "cards": [] },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2, 3] },
        { "event": "job_started", "stack": 1, "recipe": "saw_planks" }
      ]
    },
    { "op": "check", "running": { "1": "saw_planks" } },
    {
      "op": "tick", "dt": 3.0,
      "events": [
        { "event": "job_finished", "stack": 1, "recipe": "saw_planks" },
        { "event": "card_consumed", "card": 3, "def": "wood" },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2] },
        { "event": "card_spawned", "card": 4, "def": "plank", "x": 1.5, "y": 0.0 },
        { "event": "stack_changed", "stack": 4, "cards": [4] },
        { "event": "card_spawned", "card": 5, "def": "plank", "x": 3.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 5, "cards": [5] }
      ]
    },
    { "op": "check", "running": { "1": null } }
  ],
  "expect": {
    "cards": { "sawmill": 1, "worker": 1, "plank": 2 },
    "stacks": [[1, 2], [4], [5]]
  }
}
