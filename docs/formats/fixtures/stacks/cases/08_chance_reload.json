{
  "format": "velvet-stacks",
  "version": 1,
  "kind": "case",
  "name": "a 50% coin is decided by the seeded generator, and the next roll continues after a save and reload",
  "seed": "1",
  "steps": [
    {
      "op": "spawn", "def": "market", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 1, "def": "market", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 1, "cards": [1] }
      ]
    },
    {
      "op": "spawn", "def": "berries", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 2, "def": "berries", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 2, "cards": [2] }
      ]
    },
    {
      "op": "spawn", "def": "berries", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 3, "def": "berries", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 3, "cards": [3] }
      ]
    },
    {
      "op": "drop", "card": 2, "onto": 1,
      "events": [
        { "event": "stack_changed", "stack": 2, "cards": [] },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2] }
      ]
    },
    {
      "op": "drop", "card": 3, "onto": 1,
      "events": [
        { "event": "stack_changed", "stack": 3, "cards": [] },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2, 3] },
        { "event": "job_started", "stack": 1, "recipe": "sell_berries" }
      ]
    },
    {
      "op": "tick", "dt": 1.0,
      "events": [
        { "event": "job_finished", "stack": 1, "recipe": "sell_berries" },
        { "event": "card_consumed", "card": 2, "def": "berries" },
        { "event": "card_consumed", "card": 3, "def": "berries" },
        { "event": "stack_changed", "stack": 1, "cards": [1] },
        { "event": "card_spawned", "card": 4, "def": "coin", "x": 1.5, "y": 0.0 },
        { "event": "stack_changed", "stack": 4, "cards": [4] }
      ]
    },
    { "op": "reload" },
    {
      "op": "spawn", "def": "market", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 5, "def": "market", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 5, "cards": [5] }
      ]
    },
    {
      "op": "spawn", "def": "berries", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 6, "def": "berries", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 6, "cards": [6] }
      ]
    },
    {
      "op": "spawn", "def": "berries", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 7, "def": "berries", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 7, "cards": [7] }
      ]
    },
    {
      "op": "drop", "card": 6, "onto": 5,
      "events": [
        { "event": "stack_changed", "stack": 6, "cards": [] },
        { "event": "stack_changed", "stack": 5, "cards": [5, 6] }
      ]
    },
    {
      "op": "drop", "card": 7, "onto": 5,
      "events": [
        { "event": "stack_changed", "stack": 7, "cards": [] },
        { "event": "stack_changed", "stack": 5, "cards": [5, 6, 7] },
        { "event": "job_started", "stack": 5, "recipe": "sell_berries" }
      ]
    },
    {
      "op": "tick", "dt": 1.0,
      "events": [
        { "event": "job_finished", "stack": 5, "recipe": "sell_berries" },
        { "event": "card_consumed", "card": 6, "def": "berries" },
        { "event": "card_consumed", "card": 7, "def": "berries" },
        { "event": "stack_changed", "stack": 5, "cards": [5] }
      ]
    }
  ],
  "expect": {
    "cards": { "market": 2, "coin": 1 },
    "stacks": [[1], [4], [5]]
  }
}
