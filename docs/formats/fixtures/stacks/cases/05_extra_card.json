{
  "format": "velvet-stacks",
  "version": 1,
  "kind": "case",
  "name": "an extra card cancels a running job; taking it off starts the job again from zero",
  "seed": "1",
  "steps": [
    {
      "op": "spawn", "def": "forest", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 1, "def": "forest", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 1, "cards": [1] }
      ]
    },
    {
      "op": "spawn", "def": "worker", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 2, "def": "worker", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 2, "cards": [2] }
      ]
    },
    {
      "op": "drop", "card": 2, "onto": 1,
      "events": [
        { "event": "stack_changed", "stack": 2, "cards": [] },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2] },
        { "event": "job_started", "stack": 1, "recipe": "gather_wood" }
      ]
    },
    { "op": "tick", "dt": 1.0, "events": [] },
    { "op": "check", "progress": { "1": 0.5 } },
    {
      "op": "spawn", "def": "wood", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 3, "def": "wood", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 3, "cards": [3] }
      ]
    },
    {
      "op": "drop", "card": 3, "onto": 2,
      "events": [
        { "event": "stack_changed", "stack": 3, "cards": [] },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2, 3] },
        { "event": "job_cancelled", "stack": 1, "recipe": "gather_wood" }
      ]
    },
    { "op": "check", "running": { "1": null }, "progress": { "1": null } },
    {
      "op": "remove", "card": 3,
      "events": [
        { "event": "stack_changed", "stack": 1, "cards": [1, 2] },
        { "event": "job_started", "stack": 1, "recipe": "gather_wood" }
      ]
    },
    { "op": "check", "progress": { "1": 0.0 } },
    {
      "op": "tick", "dt": 2.0,
      "events": [
        { "event": "job_finished", "stack": 1, "recipe": "gather_wood" },
        { "event": "card_spawned", "card": 4, "def": "wood", "x": 1.5, "y": 0.0 },
        { "event": "stack_changed", "stack": 4, "cards": [4] },
        { "event": "job_started", "stack": 1, "recipe": "gather_wood" }
      ]
    }
  ],
  "expect": {
    "cards": { "forest": 1, "worker": 1, "wood": 1 },
    "stacks": [[1, 2], [4]]
  }
}
