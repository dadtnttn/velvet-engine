{
  "format": "velvet-stacks",
  "version": 1,
  "kind": "case",
  "name": "a worker tends a garden for berries again and again; a long tick finishes one run and carries the rest over",
  "seed": "1",
  "steps": [
    {
      "op": "spawn", "def": "garden", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 1, "def": "garden", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 1, "cards": [1] }
      ]
    },
    {
      "op": "spawn", "def": "worker", "at": [0.0, 0.0],
      "events": [
        { "event": "card_spawned", "card": 2, "def": "worker", "x": 0.0, "y": 0.0 },
        { "event": "stack_changed", "stack": 2, "cards": [2] }
      ]
    },
    {
      "op": "drop", "card": 2, "onto": 1,
      "events": [
        { "event": "stack_changed", "stack": 2, "cards": [] },
        { "event": "stack_changed", "stack": 1, "cards": [1, 2] },
        { "event": "job_started", "stack": 1, "recipe": "tend_garden" }
      ]
    },
    { "op": "tick", "dt": 1.5, "events": [] },
    { "op": "check", "progress": { "1": 0.5 } },
    {
      "op": "tick", "dt": 1.5,
      "events": [
        { "event": "job_finished", "stack": 1, "recipe": "tend_garden" },
        { "event": "card_spawned", "card": 3, "def": "berries", "x": 1.5, "y": 0.0 },
        { "event": "stack_changed", "stack": 3, "cards": [3] },
        { "event": "job_started", "stack": 1, "recipe": "tend_garden" }
      ]
    },
    {
      "op": "tick", "dt": 6.0,
      "events": [
        { "event": "job_finished", "stack": 1, "recipe": "tend_garden" },
        { "event": "card_spawned", "card": 4, "def": "berries", "x": 1.5, "y": 0.0 },
        { "event": "stack_changed", "stack": 4, "cards": [4] },
        { "event": "job_started", "stack": 1, "recipe": "tend_garden" }
      ]
    },
    { "op": "check", "progress": { "1": 1.0 } },
    {
      "op": "tick", "dt": 0.0,
      "events": [
        { "event": "job_finished", "stack": 1, "recipe": "tend_garden" },
        { "event": "card_spawned", "card": 5, "def": "berries", "x": 1.5, "y": 0.0 },
        { "event": "stack_changed", "stack": 5, "cards": [5] },
        { "event": "job_started", "stack": 1, "recipe": "tend_garden" }
      ]
    }
  ],
  "expect": {
    "cards": { "garden": 1, "worker": 1, "berries": 3 },
    "stacks": [[1, 2], [3], [4], [5]]
  }
}
